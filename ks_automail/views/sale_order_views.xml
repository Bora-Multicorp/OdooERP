<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sale Order Form View -->
    <record id="view_order_form_inherit_ks_automail" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ks.automail</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            
            <!-- Add Zone Field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <!-- 1. Shown for Indian Companies -->
                <field name="ks_zone"
                       invisible="is_overseas_company"
                       required="not is_overseas_company"
                       widget="filterable_selection"
                       options="{'horizontal': true, 'blacklisted_values': ['dafza', 'mainland', 'export', 'other']}"
                       readonly="state in ('sale', 'done', 'cancel')"
                       help="Select the zone. Automatic emails will only be sent for India and Dubai zones. This field cannot be changed once the order is confirmed."/>
                <!-- 2. Shown for Overseas Companies-->
                <field name="ks_zone"
                       invisible="not is_overseas_company"
                       required="is_overseas_company"
                       widget="filterable_selection"
                       options="{'horizontal': true, 'blacklisted_values': ['india', 'dubai', 'sez']}"
                       readonly="state in ('sale', 'done', 'cancel')"
                       help="Select the zone. Automatic emails will only be sent for India and Dubai zones. This field cannot be changed once the order is confirmed."/>
                <field name="ks_no_tax_allowed" optional="show"/>
                <field name="is_overseas_company" invisible="1"/>
            </xpath>
            <!-- When No Tax is checked, tax on order lines is readonly (and cleared by onchange/write) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            
            <!-- Email Settings Tab Removed - Configuration is now global -->
            <!-- All email settings are managed in Sales > Email Configurations -->
            <!-- No manual configuration needed per Sale Order -->
            
        </field>
    </record>
    
    <!-- Inherit Sale Order List View - Add Zone Column -->
    <record id="view_order_tree_inherit_ks_automail" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.ks.automail</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ks_zone" optional="show"/>
            </xpath>
        </field>
    </record>
    
</odoo>

