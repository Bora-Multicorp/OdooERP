<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Purchase Order Form View: Zone and No Tax -->
    <record id="view_purchase_order_form_inherit_ks_automail" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.ks.automail</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="ks_zone"
                       widget="radio"
                       options="{'horizontal': true}"
                       readonly="state in ('purchase', 'done', 'cancel')"/>
                <field name="ks_no_tax_allowed" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order List View: Zone column -->
    <record id="view_purchase_order_tree_inherit_ks_automail" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.ks.automail</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ks_zone" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
