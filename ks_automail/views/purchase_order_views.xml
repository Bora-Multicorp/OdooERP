<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Purchase Order Form View: Zone and No Tax -->
    <record id="view_purchase_order_form_inherit_ks_automail" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.ks.automail</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <!-- 1. Shown for Indian Companies -->
                <field name="ks_zone"
                       invisible="is_overseas_company"
                       required="not is_overseas_company"
                       widget="filterable_selection"
                       options="{'horizontal': true, 'blacklisted_values': ['dafza', 'mainland', 'export', 'other']}"
                       readonly="state in ('purchase', 'done', 'cancel')"/>
                <!-- 2. Shown for Overseas Companies-->
                <field name="ks_zone"
                       invisible="not is_overseas_company"
                       required="is_overseas_company"
                       widget="filterable_selection"
                       options="{'horizontal': true, 'blacklisted_values': ['india', 'dubai', 'sez']}"
                       readonly="state in ('purchase', 'done', 'cancel')"/>
                <field name="ks_no_tax_allowed" optional="show"/>
                <field name="is_overseas_company" invisible="1"/>
            </xpath>
            <!-- When No Tax is checked, tax on order lines is readonly (and cleared by onchange/write) -->
            <xpath expr="//field[@name='order_line']/list/field[@name='taxes_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order List View: Zone column -->
    <record id="view_purchase_order_tree_inherit_ks_automail" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.ks.automail</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ks_zone" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
