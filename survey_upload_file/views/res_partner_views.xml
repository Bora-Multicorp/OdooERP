<?xml version="1.0"?>
<odoo>
        <!-- Add contextual survey button on partner form view -->
        <record id="view_partner_form_survey1" model="ir.ui.view">
            <field name="name">view.res.partner.form.survey.inherited1</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field eval="1" name="priority"/>
            <field name="arch" type="xml">
                <data>
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button" type="object"
                            name="action_view_survey_response"
                            icon="fa-star"
                            groups="sales_team.group_sale_salesman"
                            context="{'default_partner_id': id}">
                            <field string="Survey" name="survey_count" widget="statinfo"/>
                        </button>
                    </div>
                </data>
            </field>
        </record>

</odoo>
