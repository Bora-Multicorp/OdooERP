<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Make Tax Field Readonly in Purchase Order Lines -->
    <record id="purchase_order_line_tax_readonly" model="ir.ui.view">
        <field name="name">purchase.order.line.tax.readonly</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Make taxes_id readonly in purchase order line list view and form view -->
            <xpath expr="//field[@name='taxes_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Make Tax Field Readonly in Sale Order Lines -->
    <record id="sale_order_line_tax_readonly" model="ir.ui.view">
        <field name="name">sale.order.line.tax.readonly</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Make tax_id readonly in sale order line form view -->
            <xpath expr="//field[@name='tax_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Make Tax Field Readonly in Invoice Lines (Account Move Line) -->
    <record id="account_move_line_tax_readonly" model="ir.ui.view">
        <field name="name">account.move.line.tax.readonly</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Make tax_ids readonly in invoice line form view (all instances) -->
            <xpath expr="//field[@name='tax_ids'][@widget='many2many_tags']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <!-- Make tax_ids readonly in invoice line list view with many2many_tax_tags widget -->
            <xpath expr="//field[@name='tax_ids'][@widget='many2many_tax_tags']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <!-- Make tax_ids readonly in invoice line list view with autosave_many2many_tags widget -->
            <xpath expr="//field[@name='tax_ids'][@widget='autosave_many2many_tags']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>

