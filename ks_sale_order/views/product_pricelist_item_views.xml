<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Pricelist Item Form View to add domain filter for products with stock -->
    <record id="product_pricelist_item_form_view_inherit_ks_sale_order" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.inherit.ks.sale.order</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_rule_method']//field[@name='product_tmpl_id']" position="attributes">
                <attribute name="domain">[('qty_available', '>', 0)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>

