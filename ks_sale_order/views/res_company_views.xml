<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_ks_iec_no" model="ir.ui.view">
        <field name="name">res.company.form.ks.iec.no</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_in.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_in_upi_id']" position="after">
                <field name="iec_no" invisible="country_code != 'IN'"/>
            </xpath>
        </field>
    </record>
</odoo>
