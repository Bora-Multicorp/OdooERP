<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="sale_order_line_price_incl_view">
        <field name="name">sale.order.line price incl. GST column</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="ks_is_indian_company" invisible="1"/>
            </xpath>
            <!-- Relabel existing column to make tax-exclusive explicit for Indian companies -->
            <xpath
                expr="//field[@name='order_line']//list//field[@name='price_unit']"
                position="attributes"
            >
                <attribute name="string">Unit Price (Excl. Tax)</attribute>
                <attribute name="column_invisible">not parent.ks_is_indian_company</attribute>
            </xpath>
            <!-- Insert single Unit Price column for Non-Indian companies and price_unit_incl for Indian companies -->
            <xpath
                expr="//field[@name='order_line']//list//field[@name='price_unit']"
                position="after"
            >
                <field
                    name="price_unit"
                    string="Unit Price"
                    column_invisible="parent.ks_is_indian_company"
                    readonly="qty_invoiced &gt; 0"
                />
                <field
                    name="price_unit_incl"
                    string="Unit Price (Incl. Tax)"
                    optional="show"
                    column_invisible="not parent.ks_is_indian_company"
                    readonly="qty_invoiced &gt; 0"
                />
            </xpath>
        </field>
    </record>
</odoo>
