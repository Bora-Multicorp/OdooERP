<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="account_move_line_price_incl_view">
        <field name="name">account.move.line price incl. GST column</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Relabel existing column to make tax-exclusive explicit -->
            <xpath
                expr="//field[@name='invoice_line_ids']//list//field[@name='price_unit']"
                position="attributes"
            >
                <attribute name="string">Unit Price (Excl. Tax)</attribute>
            </xpath>
            <!-- Insert tax-inclusive column immediately after price_unit -->
            <xpath
                expr="//field[@name='invoice_line_ids']//list//field[@name='price_unit']"
                position="after"
            >
                <field
                    name="price_unit_incl"
                    string="Unit Price (Incl. Tax)"
                    optional="show"
                />
            </xpath>
        </field>
    </record>
</odoo>
