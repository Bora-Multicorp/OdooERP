<odoo>
    <data noupdate="1">
        <record id="email_template_vendor_payment_confirmation" model="mail.template">
            <field name="name">Vendor Payment Confirmation</field>
            <field name="subject">Payment Initiated for Invoice {{ object.communication or '' }}</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="email_from">{{ user.company_id.email }}</field>
            <field name="email_to">{{ object.partner_id.email or '' }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear {{ object.partner_id.name or 'Vendor' }},</p>
                    <p>
                        We would like to inform you that a payment for invoice
                        <strong>{{ object.communication or '' }}</strong> has been initiated.
                    </p>
                    <p>
                        <strong>Payment Details:</strong>
                        <ul>
                            <li><strong>Amount:</strong> {{ object.amount or 'N/A' }} {{ object.currency_id.symbol or '' }}</li>
                            <li><strong>Payment Date:</strong> {{ object.date or '' }}</li>
                            <li><strong>Reference:</strong> {{ object.name or '' }}</li>
                        </ul>
                    </p>
                    <p>Thank you for your business. We look forward to our continued partnership.</p>
                    <br/>
                    <p>Sincerely,</p>
                    <p>{{ user.name }}</p>
                    <p>{{ user.company_id.name }}</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
