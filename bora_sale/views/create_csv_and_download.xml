<odoo>
    <record id="view_stock_move_operations_inherit_field" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.field</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <footer invisible="picking_code == 'incoming'">
                    <div style="width:100%; display:flex; justify-content:space-between; align-items:center;">
                        <div style="display:flex; gap:8px;">
                            <button string="Save" special="save" class="btn-primary"/>
                            <button string="Discard" class="btn-secondary" special="cancel"/>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px;">
                            <span style="font-size:13px; font-weight:500; color: var(--o-text-color);">Product's IMEI and Serial Numbers.</span>
                            <div style="display:flex; gap:8px;">
                                <button name="create_csv_and_save_in_order_documents" type="object" string="In Order Documents" class="btn-primary" icon="fa-share"/>
                                <button name="create_csv_and_download" type="object" string="Download" class="btn-primary" icon="fa-download"/>
                            </div>
                        </div>
                    </div>
                </footer>
                <footer invisible="picking_code != 'incoming'">
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </xpath>
        </field>
    </record>
</odoo>