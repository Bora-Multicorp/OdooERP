<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incoteerm_description_field" model="ir.ui.view">
        <field name="name">view.incoteerm.description.field</field>
        <field name="model">account.incoterms</field>
        <field name="inherit_id" ref="account.account_incoterms_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="description" required="1"/>
            </xpath>
        </field>
    </record>

        <record id="view_incoteerm_description_field_move_line" model="ir.ui.view">
        <field name="name">view.incoteerm.description.field.move.line</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='incoterm_location']" position="after">
                <field name="contract_date" required="1"/>
                <field name="contract_number" required="1"/>
            </xpath>
        </field>
    </record>

</odoo>