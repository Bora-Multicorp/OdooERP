<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pod_in_stock_picking" model="ir.ui.view">
        <field name="name">pod.in.stock.picking</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="send_pod_to_accounts_group" string="Send POD" type="object" icon="fa-paper-plane" class="oe_highlight" title="Send 'proff of delivery' to accounts group" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_view_form_inherit_smart_button_attachments" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.smart.button.attachments</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_attachments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not is_pod_needed">
                    <field name="attachment_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
