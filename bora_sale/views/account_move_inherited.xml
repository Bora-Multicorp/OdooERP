<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="show_payment_option_to_accounts_group" model="ir.ui.view">
        <field name="name">show.payment.option.to.accounts.group</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="groups">bora_sale.account_group_for_sales</attribute>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                <attribute name="groups">bora_sale.account_group_for_sales</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_invoice_inherit" model="ir.ui.view">
        <field name="name">view.sale.order.invoice.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="optional"/> 
            </xpath>
        </field>
    </record>

</odoo>
