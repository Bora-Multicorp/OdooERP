                                <!-- <p t-field="o.journal_id.bank_account_id.bank_id.name"/>
                                <p t-field="o.journal_id.bank_account_id.acc_number"/>
                                <p t-field="o.journal_id.bank_account_id.bank_id.bic"/> -->
