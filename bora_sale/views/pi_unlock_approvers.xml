<odoo>
    <record id="view_pi_unlock_approvers_form" model="ir.ui.view">
        <field name="name">sales.pi.unlock.approvers.form</field>
        <field name="model">pi.unlock.approvers</field>
        <field name="arch" type="xml">
            <form string="PI Unlock Approvers" class="oe_form_configuration o_base_settings" create="false">
                <sheet>
                    <group>
                        <field name="existing_user_ids" invisible="1"/>
                        <field name="user_id" options="{'no_create': True, 'no_create_edit': True}" domain="[('id', 'not in', existing_user_ids)]"/>
                        <field name="default_approver"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pi_unlock_approvers_tree" model="ir.ui.view">
        <field name="name">sales.pi.unlock.approvers.tree</field>
        <field name="model">pi.unlock.approvers</field>
        <field name="arch" type="xml">
            <list string="PI Unlock Approvers">
                <field name="sequence" widget="handle" class="o_data_cell_sequence"/>
                <field name="user_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                <field name="default_approver"/>
            </list>
        </field>
    </record>
    <record id="action_pi_unlock_approvers" model="ir.actions.act_window">
        <field name="name">PI Unlock Approvers</field>
        <field name="res_model">pi.unlock.approvers</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your PI unlock approvers here.
            </p>
        </field>
    </record>
    <!-- Add menu under Inventory > Operations -->
    <menuitem id="pi_unlock_approvers"
              name="PI Unlock Approvers"
              parent="sale.menu_sale_config"
              action="action_pi_unlock_approvers"
              sequence="2500"
              groups="base.user_admin"/>
</odoo>