<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_qa_smart_button_toggle" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.qc.smart.button.toggle</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">

                <button class="oe_stat_button"
                        name="action_toggle_qc_button"
                        type="object"
                        invisible="is_qc_done == False or state in ('draft', 'confirmed', 'done', 'cancel')"
                        confirm="Are you sure you want to revert the 'QC Passed' status?">
                    <span class="fa fa-check-circle text-success" style="font-size: 24px; margin-right:8px;"/>
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">QC</span>
                    </div>
                </button>

                <button class="oe_stat_button"
                        name="action_toggle_qc_button"
                        type="object"
                        invisible="is_qc_done == True or state in ('draft', 'confirmed', 'done', 'cancel')"
                        confirm="Are you sure you want to mark this document as 'QC Passed'?">
                    <span class="fa fa-check-circle text-primary" style="font-size: 24px; margin-right:8px;"/>
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">QC</span>
                    </div>
                </button>

            </xpath>
        </field>
    </record>
</odoo>
