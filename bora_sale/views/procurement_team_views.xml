<odoo>
    <record id="view_procurement_team_form" model="ir.ui.view">
        <field name="name">purchase.procurement.team.form</field>
        <field name="model">purchase.procurement.team</field>
        <field name="arch" type="xml">
            <form string="Procurement Team Settings" class="oe_form_configuration o_base_settings" create="false">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="res_user" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field> 
    </record>

    <record id="view_procurement_team_tree" model="ir.ui.view">
        <field name="name">purchase.procurement.team.tree</field>
        <field name="model">purchase.procurement.team</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Procurement Team Settings">
                <field name="sequence"/>
                <field name="res_user"/>
            </list>
        </field>
    </record>

    <record id="action_procurement_team" model="ir.actions.act_window">
        <field name="name">Procurement Team</field>
        <field name="res_model">purchase.procurement.team</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your procurement teams here.
            </p>
        </field>
    </record>

    <!-- Add menu under Inventory > Operations -->
    <menuitem id="menu_procurement_team"
              name="Procurement Team"
              parent="stock.menu_stock_procurement"
              action="action_procurement_team"
              sequence="6"
              groups="base.user_admin"/>
</odoo>
