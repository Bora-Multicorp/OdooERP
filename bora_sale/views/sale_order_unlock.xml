<!-- your_module/views/sale_order_inherit.xml -->
<odoo>
    <record id="view_sale_order_form_inherit_unlock_page" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.unlock.page</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="unlock_approval_authorities_page" string="Unlock Approval Authorities" invisible="not approval_users_ids">
                    <div class="o_row o_align_right" invisible="not assigned_to">
                        <label for="assigned_to"/>
                        <field name="assigned_to" options="{'no_edit': True, 'no_create': True, 'no_open': True}" readonly="1"/>
                        <button name="action_unlock_suspend" string="Suspend" type="object" class="btn-primary" groups="base.group_system"/>
                    </div>
                    <field name="approval_users_ids" nolabel="1" help="Define the PI Unlock approval roles." readonly="1">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="remark" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="action_date" readonly="1"/>
                        </list>
                        <form> 
                            <group>
                                <field name="user_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="state"/>
                                <field name="remark"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="send_documents_in_email" string="Send Documents" type="object" icon="fa-envelope" title="Send all documents to customer" invisible="state != 'sale'"/>
                <button name="%(approve_pi_unlock_wizard_action)d" string="Approve" type="action" class="oe_highlight" invisible="assigned_to != uid"/>
                <button name="%(reject_pi_wizard_action)d" string="Reject" type="action" class="oe_highlight" invisible="assigned_to != uid"/>
            </xpath>
            <xpath expr="//form/header/button[@name='action_unlock']" position="attributes">
                <attribute name="invisible">state in ('unlock_pending', 'cancel', 'draft', 'confirmation_pending', 'cancellation_pending')</attribute>
            </xpath>
            <xpath expr="//form/header/button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">state in ('unlock_pending', 'cancel', 'confirmation_pending', 'cancellation_pending')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
