<?xml version="1.0"?>
<odoo>
    <record id="unlock_so_suspend_po_wizard_view_form" model="ir.ui.view">
        <field name="name">unlock.so.suspend.po.wizard.view.form</field>
        <field name="model">suspend.so.unlock.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Suspend">
                <group> 
                    <div class="o_form_label o_text_warning" style="margin-bottom: 10px;">
                            Are you sure you want to suspend this unlock approval process?
                    </div>
                    <field name="remark" placeholder="Enter remarks for suspension"/>
                </group>
                <footer>
                    <button name="action_done" string="Suspend" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form> 
        </field>
    </record>
    <record id="unlock_so_suspend_confirm_wizard_action" model="ir.actions.act_window">
        <field name="name">Suspend PI Unlock Request</field>
        <field name="res_model">suspend.so.unlock.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="unlock_so_suspend_po_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{
            'default_order_id': active_id,
            }
        </field>
    </record>
</odoo>
