<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="survey_survey_form_view_iherit" model="ir.ui.view">
        <field name="name">survey.survey.form_.view.iherit</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form" />
        <field name="arch" type="xml">
        
            <!-- Allow_Roaming Field invisible  -->
            <xpath expr="//page[@name='options']//field[@name='users_can_go_back']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>