<?xml version="1.0"?>
<odoo>
    <record id="reject_po_unlck_wizard_view_form" model="ir.ui.view">
        <field name="name">reject.po.wizard.form</field>
        <field name="model">reject.po.unlock.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject PO Form">
                <group>
                    <!-- <field name="order_approval_id" readonly="1"/> -->
                    <field name="remark"  placeholder="Enter remarks for rejection"/>
                </group>
                <footer>
                    <button name="action_reject_po_unlock" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="reject_po_wizard_action" model="ir.actions.act_window">
        <field name="name">Reject PO Unlock Request</field>
        <field name="res_model">reject.po.unlock.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="reject_po_unlck_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_reject_po_unlock_wizard"/>
        <field name="context">{
            'default_order_approval_id': active_id,
            }
        </field>
    </record>
</odoo>
