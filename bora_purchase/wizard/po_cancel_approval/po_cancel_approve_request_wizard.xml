<?xml version="1.0"?>
<odoo>
    <record id="confirm_cancel_po_wizard_view_form" model="ir.ui.view">
        <field name="name">confirm.cancel.po.wizard.form</field>
        <field name="model">cancel.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Cancellation Request">
                <group> 
                    <field name="remark" placeholder="Enter remarks for purchase order cancellation"/>
                </group>
                <footer>
                    <button name="action_approve_po_cancel" string="Approve" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form> 
        </field>
    </record>
    <record id="approve_po_cancel_wizard_action" model="ir.actions.act_window">
        <field name="name">Approve Cancel Request</field>
        <field name="res_model">cancel.po.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="confirm_cancel_po_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{
            'default_order_id': active_id,
            }
        </field>
    </record>
</odoo>
