<?xml version="1.0"?>
<odoo>
    <record id="confirm_reject_po_wizard_view_form" model="ir.ui.view">
        <field name="name">reject.po.wizard.form</field>
        <field name="model">reject.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Rejection Confirmation Request">
                <group> 
                    <field name="remark" placeholder="Enter remarks for purchase order rejection"/>
                </group>
                <footer>
                    <button name="action_reject_po_confirm" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form> 
        </field>
    </record>
    <record id="reject_po_confirm_wizard_action" model="ir.actions.act_window">
        <field name="name">Reject Confirmation Request</field>
        <field name="res_model">reject.po.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="confirm_reject_po_wizard_view_form"/>
        <field name="target">new</field>
        <!-- <field name="binding_model_id" ref="model_approve_po_unlock_wizard"/> -->
        <field name="context">{
            'default_order_id': active_id,
            }
        </field>
    </record>
</odoo>
