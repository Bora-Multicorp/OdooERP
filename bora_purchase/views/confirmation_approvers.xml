<odoo>
    <record id="view_po_confirmation_approvers_form" model="ir.ui.view">
        <field name="name">purchase.purchase.order.confirmation.approvers.form</field>
        <field name="model">purchase.order.confirmation.approvers</field>
        <field name="arch" type="xml">
            <form string="Confirmaation Approvers" class="oe_form_configuration o_base_settings" create="false">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_po_confirmaation_approvers_tree" model="ir.ui.view">
        <field name="name">sales.purchase.order.confirmaation.approvers.tree</field>
        <field name="model">purchase.order.confirmation.approvers</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Confirmation Approvers">
                <field name="sequence"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="action_po_confirmation_approvers" model="ir.actions.act_window">
        <field name="name">Confirmation Approvers</field>
        <field name="res_model">purchase.order.confirmation.approvers</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your purchase order confirmation approvers here.
            </p>
        </field>
    </record>
    <menuitem id="po_confirmation_approvers"
              name="Confirmation"
              parent="product_approval_group_header_menu"
              action="action_po_confirmation_approvers"
              sequence="1000"
              groups="base.user_admin"/>
</odoo>