
<odoo> 
    <record id="view_purchase_order_form_inherit_cancel_page" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.cancel.page</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="old_state" invisible="0"/>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="confirm">Cancellation requires approval by authorities, an approval request will be generated.</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="cancel_approval_authorities_page" string="Cancellation Approval Authorities" invisible="not approval_users_ids_for_cancellation">
                    <group>
                        <field name="assigned_to_form_cancellation" options="{'no_edit': True, 'no_create': True, 'no_open': True}" invisible="not assigned_to_form_cancellation" readonly="1"/>
                    </group>
                    <field name="approval_users_ids_for_cancellation" nolabel="1" help="Define the PO cancel approval roles." readonly="1">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="remark"/>
                            <field name="state" readonly="1"/>
                            <field name="action_date" readonly="1"/>
                        </list>
                        <form>
                            <group>
                                <field name="user_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="state"/>
                                <field name="remark"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="%(approve_po_cancel_wizard_action)d" string="Approve" type="action" class="oe_highlight" invisible="assigned_to_form_cancellation != uid"/>
                <button name="%(reject_po_cancel_wizard_action)d" string="Reject" type="action" class="oe_highlight" invisible="assigned_to_form_cancellation != uid"/>
            </xpath>
        </field>
    </record>
</odoo>
 