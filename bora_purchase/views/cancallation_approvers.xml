<odoo>
    <record id="view_po_acnallation_approvers_form" model="ir.ui.view">
        <field name="name">purchase.purchase.order.confirmation.approvers.form</field>
        <field name="model">purchase.order.cancellation.approvers</field>
        <field name="arch" type="xml">
            <form string="Cancellation Approvers" class="oe_form_configuration o_base_settings" create="false">
                <sheet>
                    <group>
                        <field name="existing_user_ids" invisible="1"/>
                        <field name="user_id" options="{'no_create': True, 'no_create_edit': True}" domain="[('id', 'not in', existing_user_ids)]"/>
                        <field name="default_approver"/>
                    </group>
                </sheet>
            </form> 
        </field>
    </record>
    <record id="view_po_cancllation_approvers_tree" model="ir.ui.view">
        <field name="name">sales.purchase.order.cancellation.approvers.tree</field>
        <field name="model">purchase.order.cancellation.approvers</field>
        <field name="arch" type="xml">
            <list string="Cancellation  Approvers">
                <field name="sequence" widget="handle" class="o_data_cell_sequence"/>
                <field name="user_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                <field name="default_approver"/>
            </list>
        </field>
    </record>
    <record id="action_po_cancellation_approvers" model="ir.actions.act_window">
        <field name="name">Cancellation Approvers</field>
        <field name="res_model">purchase.order.cancellation.approvers</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your purchase order cancellation approvers here.
            </p>
        </field>
    </record>
    <menuitem id="po_cancellation_approvers"
              name="Cancellation"
              parent="product_approval_group_header_menu"
              action="action_po_cancellation_approvers"
              sequence="1001"
              groups="base.user_admin"/>
</odoo>