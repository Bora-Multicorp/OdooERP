<odoo>
    <record id="view_purchase_order_form_inherit_unlock_page" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.unlock.page</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="unlock_approval_authorities_page" string="Unlock Approval Authorities" invisible="not approval_users_ids">
                    <div class="o_row o_align_right" invisible="not assigned_to">
                        <label for="assigned_to"/>
                        <field name="assigned_to" options="{'no_edit': True, 'no_create': True, 'no_open': True}" readonly="1"/>
                        <button name="action_unlock_suspend" string="Suspend" type="object" class="btn-primary" groups="base.group_system"/>
                    </div>
                    <field name="approval_users_ids" nolabel="1" help="Define the PO Unlock approval roles." readonly="1">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="remark"/>
                            <field name="state" readonly="1"/>
                            <field name="action_date" readonly="1"/>
                        </list>
                        <form>
                            <group>
                                <field name="user_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="state"/>
                                <field name="remark"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="%(approve_po_unlock_wizard_action)d" string="Approve" type="action" class="oe_highlight" invisible="assigned_to != uid"/>
                <button name="%(reject_po_wizard_action)d" string="Reject" type="action" class="oe_highlight" invisible="assigned_to != uid"/>
            </xpath>
            <xpath expr="//header/button[@name='action_rfq_send'][1]" position="before">
                <button name="action_rfq_send" string="Send PO by Email" type="object" context="{'send_rfq':False}" invisible="state != 'done' or assigned_to == uid" class="oe_highlight"/>
            </xpath>
            <xpath expr="//form/header/button[@name='action_view_picking']" position="attributes">
                <attribute name="invisible">(is_shipped or state not in ('purchase', 'done') or incoming_picking_count == 0) or assigned_to == uid</attribute>
            </xpath>
            <xpath expr="//form/header/button[@name='confirm_reminder_mail']" position="attributes">
                <attribute name="invisible">(state not in ('purchase', 'done') or mail_reminder_confirmed or not date_planned or effective_date) or assigned_to == uid</attribute>
            </xpath>

            <xpath expr="//button[@name='action_create_invoice'][not(contains(@class, 'oe_highlight'))]" position="attributes">
                <attribute name="invisible">[ '|', '|', '|', ('state', 'not in', ('purchase', 'done')), ('invoice_status', 'not in', ('no', 'invoiced')), ('order_line', '=', False), ('is_assigned_to_current_user', '=', True)]</attribute>
            </xpath>
            <xpath expr="//form/header/button[@name='button_unlock']" position="attributes">
                <attribute name="invisible">state != 'done' or assigned_to == uid</attribute>
            </xpath>

        </field>
    </record>
</odoo>