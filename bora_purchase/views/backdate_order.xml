<odoo>
    <record id="view_purchase_order_backdate" model="ir.ui.view">
        <field name="name">view.purchase.order.backdate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='date_approve']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//label[@for='date_approve']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="before">
                <field name="date_approve" readonly="state in ['purchase', 'done', 'cancel', 'unlock_pending', 'cancellation_pending', 'unlock_pending']" required="1" />
            </xpath>


            <xpath expr="//header/button[@name='action_rfq_send'][1]" position="before">
                <button name="action_rfq_send"
                        string="Send PO by Email" 
                        type="object" 
                        context="{'send_rfq':False}"
                        invisible="state != 'done'"
                        class="oe_highlight"/>
            </xpath>

        </field>
    </record>
</odoo>