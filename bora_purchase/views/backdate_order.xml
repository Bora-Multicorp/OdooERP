<odoo>
    <record id="view_purchase_order_backdate" model="ir.ui.view">
        <field name="name">view.purchase.order.backdate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="before">
                <field name="create_date" string="Creation Date" required="1" readonly="state == 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>