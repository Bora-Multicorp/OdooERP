<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_tax_hide_dubai" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tax.hide.dubai</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="attributes">
                <attribute name="column_invisible">parent.hide_tax_column</attribute>
            </xpath>
        </field>
    </record>
</odoo>


