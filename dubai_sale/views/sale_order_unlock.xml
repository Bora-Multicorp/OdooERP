<!-- your_module/views/sale_order_inherit.xml -->
<odoo>
    <record id="view_sale_order_form_inherit_unlock_page" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.unlock.page</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="unlock_approval_authorities_page" string="Unlock Approval Authorities" invisible="not assigned_to">
                    <group>
                        <field name="show_unlock_approve_reject_buttons" invisible="1"/>
                        <field name="assigned_to"
                                           options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                                           invisible="not assigned_to" readonly="1"/>
                        <field name="existing_user_ids" invisible="1" widget="many2many_tags"/>
                    </group>
                    <field name="approval_users_ids" nolabel="1" help="Define the PI Unlock approval roles."
                                       readonly="1">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="user_id" widget="many2one_avatar_user"
                                               options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="remark"/>
                            <field name="state" readonly="1"/>
                            <field name="action_date" readonly="1"/>
                        </list>
                        <form>
                            <group>
                                <field name="user_id"
                                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="state"/>
                                <field name="remark"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <!-- <xpath expr="//button[@name='action_quotation_send']" position="attributes">
                <attribute name="string">Order</attribute>
                <attribute name="title">Send order details by email</attribute>
                <attribute name="icon">fa-envelope</attribute>
            </xpath> -->
            <!-- <xpath expr="//header/button[@name='action_quotation_send']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="string">Order</attribute>
                <attribute name="title">Send order details by email</attribute>
                <attribute name="icon">fa-envelope</attribute>
            </xpath> -->
            <xpath expr="//header" position="inside">
                <!-- <button name="%(approve_pi_unlock_wizard_action)d" string="Order" type="action" class="oe_highlight" icon="fa-envelope" title="Send order details by email"/> -->
                <button name="%(approve_pi_unlock_wizard_action)d" string="PI Unlock Approve" type="action" class="oe_highlight" invisible="not show_unlock_approve_reject_buttons"/>
                <button name="%(reject_pi_wizard_action)d" string="PI Unlock Reject" type="action" class="oe_highlight" invisible="not show_unlock_approve_reject_buttons"/>
            </xpath>
        </field>
    </record>
</odoo>