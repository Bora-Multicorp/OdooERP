<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- We will inherit the sale.view_order_form to modify the existing button -->
    <record id="sale_order_view_form_inherit_change_confirm" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.change.confirm</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- 
            Use XPath to locate the button you want to modify.
            In this case, we're targeting the 'action_unlock' button.
            `position="attributes"` is the key.
            -->
            <xpath expr="//button[@name='action_unlock']" position="attributes">
                <!-- 
                Change the 'confirm' attribute.
                If the button already has one, this will override it.
                If it doesn't, this will add it.
                -->
                <attribute name="confirm">Are you sure you want to unlock this order? Unlocking will require PI approval.</attribute>
            </xpath>
        </field>
    </record>
</odoo>
