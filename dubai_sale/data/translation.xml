<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================= -->
        <!--  Global translations from the 'sale' module   -->
        <!-- ============================================= -->

        <!-- Change "Quotations" menu item name -->
        <record id="translation_menu_sale_quotations" model="ir.translation">
            <field name="name">ir.ui.menu,name</field>
            <field name="lang">en_US</field>
            <field name="src">Quotations</field>
            <field name="value">Proforma Invoices (PI)</field>
            <field name="module">sale</field>
        </record>

        <!-- Change the 'Sales Order' report name, which is used for quotations -->
        <record id="translation_report_sale_order_name" model="ir.translation">
            <field name="name">ir.actions.report,name</field>
            <field name="res_id" ref="sale.action_report_saleorder"/>
            <field name="lang">en_US</field>
            <field name="src">Sales Order</field>
            <field name="value">Proforma Invoice (PI)</field>
            <field name="module">sale</field>
        </record>

        <!-- Change button label 'Send Quotation' in sales order form -->
        <record id="translation_button_send_quotation" model="ir.translation">
            <field name="name">ir.ui.view,arch_db</field>
            <field name="lang">en_US</field>
            <field name="src">Send Quotation</field>
            <field name="value">Send PI</field>
            <field name="module">sale</field>
        </record>
        
        <!-- Change the button label 'Create Quotation' -->
        <record id="translation_button_create_quotation" model="ir.translation">
            <field name="name">ir.ui.view,arch_db</field>
            <field name="lang">en_US</field>
            <field name="src">Create Quotation</field>
            <field name="value">Create PI</field>
            <field name="module">sale</field>
        </record>
        
        <!-- Change the text of the statusbar for the 'Quotation' state -->
        <record id="translation_statusbar_quotation_state" model="ir.translation">
            <field name="name">sale.order,state:selection</field>
            <field name="lang">en_US</field>
            <field name="src">Quotation</field>
            <field name="value">PI Draft</field>
            <field name="module">sale</field>
        </record>
        
        <!-- Change 'Quotation Date' field label -->
        <record id="translation_field_sale_order_date" model="ir.translation">
            <field name="name">sale.order,date_order</field>
            <field name="lang">en_US</field>
            <field name="src">Quotation Date</field>
            <field name="value">PI Date</field>
            <field name="module">sale</field>
        </record>

        <!-- Change 'Quotation Template' field label -->
        <record id="translation_field_sale_order_template" model="ir.translation">
            <field name="name">sale.order,sale_order_template_id</field>
            <field name="lang">en_US</field>
            <field name="src">Quotation Template</field>
            <field name="value">PI Template</field>
            <field name="module">sale</field>
        </record>


        <!-- ============================================= -->
        <!--  Translations for the 'crm' module            -->
        <!-- ============================================= -->
        
        <!-- Change 'Quotations' on kanban stage headers -->
        <record id="translation_crm_stage_quotation" model="ir.translation">
            <field name="name">ir.ui.view,arch_db</field>
            <field name="lang">en_US</field>
            <field name="src">Quotations</field>
            <field name="value">PI Sent</field>
            <field name="module">crm</field>
        </record>
        
        <!-- Change 'Quotation' in pipeline stage names -->
        <record id="translation_crm_stage_name_quotation" model="ir.translation">
            <field name="name">crm.stage,name</field>
            <field name="lang">en_US</field>
            <field name="src">Quotation</field>
            <field name="value">PI Draft</field>
            <field name="module">crm</field>
        </record>
        
        
        <!-- ============================================= -->
        <!--  Translations for the 'purchase' module       -->
        <!-- ============================================= -->
        
        <!-- The word 'Quotation' is not standard in Purchase, but 'Request for Quotation' is. We will assume you want to change that to 'Request for PI'. -->
        
        <!-- Change "Requests for Quotation" menu item name -->
        <record id="translation_menu_purchase_rfq" model="ir.translation">
            <field name="name">ir.ui.menu,name</field>
            <field name="lang">en_US</field>
            <field name="src">Requests for Quotation</field>
            <field name="value">Requests for PI</field>
            <field name="module">purchase</field>
        </record>

        <!-- Change the button label 'Send by Email' on RFQ -->
        <record id="translation_button_purchase_rfq_send" model="ir.translation">
            <field name="name">ir.ui.view,arch_db</field>
            <field name="lang">en_US</field>
            <field name="src">Send Request for Quotation</field>
            <field name="value">Send Request for PI</field>
            <field name="module">purchase</field>
        </record>
        
        <!-- Change the 'Request for Quotation' report name -->
        <record id="translation_report_purchase_rfq" model="ir.translation">
            <field name="name">ir.actions.report,name</field>
            <field name="res_id" ref="purchase.report_purchase_quotation"/>
            <field name="lang">en_US</field>
            <field name="src">Request for Quotation</field>
            <field name="value">Request for PI</field>
            <field name="module">purchase</field>
        </record>
        
        
        <!-- ============================================= -->
        <!--  Translations for the 'stock' module          -->
        <!-- ============================================= -->
        
        <!-- The 'stock' module doesn't use the word 'Quotation' in its standard terms,
             but sometimes 'Sales Quotation' is used in report headers or other text.
             This record will catch the phrase in any general context. -->
        <record id="translation_stock_quotation_text" model="ir.translation">
            <field name="name">ir.ui.view,arch_db</field>
            <field name="lang">en_US</field>
            <field name="src">Sales Quotation</field>
            <field name="value">Proforma Invoice</field>
            <field name="module">stock</field>
        </record>
        
    </data>
</odoo>