<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_stock_picking_receipt_approval_form" model="ir.ui.view">
        <field name="name">stock.picking.receipt.approval.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Hidden computed fields needed for button visibility and banners -->
            <xpath expr="//sheet" position="before">
                <field name="ks_is_receipt_pm_user" invisible="1"/>
                <field name="ks_is_receipt_admin" invisible="1"/>
                <field name="ks_is_receipt_dual_approval" invisible="1"/>
                <field name="ks_receipt_approved" invisible="1"/>
                <field name="ks_show_receipt_approve_button" invisible="1"/>
                <field name="ks_show_receipt_reject_button" invisible="1"/>
                <field name="ks_show_receipt_update_button" invisible="1"/>
                <field name="ks_receipt_pm1_id" invisible="1"/>
                <field name="ks_receipt_pm2_id" invisible="1"/>
                <field name="ks_receipt_pm1_approved" invisible="1"/>
                <field name="ks_receipt_pm2_approved" invisible="1"/>
                <field name="ks_receipt_request_user_id" invisible="1"/>
            </xpath>

            <!-- Approval action buttons before Validate -->
            <xpath expr="(//button[@name='button_validate'])[1]" position="before">
                <button name="action_update_receipt_approvals"
                        string="Update Approvals" type="object"
                        class="btn-warning"
                        invisible="not ks_show_receipt_update_button"
                        confirm="This will cancel the current approval request and let you choose new approvers. Continue?"/>
                <button name="ks_action_approve_receipt"
                        string="Approve" type="object"
                        class="btn-success"
                        invisible="not ks_show_receipt_approve_button"/>
                <button name="ks_action_reject_receipt"
                        string="Reject" type="object"
                        class="btn-danger"
                        invisible="not ks_show_receipt_reject_button"/>
            </xpath>

            <!-- Hide oe_highlight Validate when receipt_approval_pending -->
            <xpath expr="//button[@name='button_validate'][hasclass('oe_highlight')]" position="attributes">
                <attribute name="invisible">state in ('draft', 'confirmed', 'done', 'cancel', 'approval_pending', 'receipt_approval_pending')</attribute>
            </xpath>

            <!-- Hide o_btn_validate Validate when receipt_approval_pending -->
            <xpath expr="//button[@name='button_validate'][hasclass('o_btn_validate')]" position="attributes">
                <attribute name="invisible">state in ('waiting', 'assigned', 'done', 'cancel', 'approval_pending', 'receipt_approval_pending')</attribute>
            </xpath>

            <!-- Add receipt_approval_pending to the status bar -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,waiting,confirmed,assigned,receipt_approval_pending,done</attribute>
            </xpath>

            <!-- Banners (placed before sheet, same as delivery approval) -->
            <xpath expr="//sheet" position="before">

                <!-- Approval Pending banner -->
                <div class="alert alert-warning mb-0"
                     invisible="picking_type_code != 'incoming' or state != 'receipt_approval_pending'"
                     role="alert">
                    <strong>⏳ Receipt Approval Pending</strong> — This receipt is waiting for PM approval before it can be validated.
                    <br/>
                    <span invisible="not ks_receipt_pm1_id">
                        <strong>PM1 (<field name="ks_receipt_pm1_id" readonly="1" nolabel="1" class="d-inline"/>):</strong>
                        <span invisible="ks_receipt_pm1_approved"> ⏳ Pending</span>
                        <span invisible="not ks_receipt_pm1_approved"> ✅ Approved</span>
                    </span>
                    <span invisible="not ks_receipt_pm2_id">
                        &#160;&#160;|&#160;&#160;
                        <strong>PM2 (<field name="ks_receipt_pm2_id" readonly="1" nolabel="1" class="d-inline"/>):</strong>
                        <span invisible="ks_receipt_pm2_approved"> ⏳ Pending</span>
                        <span invisible="not ks_receipt_pm2_approved"> ✅ Approved</span>
                    </span>
                </div>

                <!-- Approved banner -->
                <div class="alert alert-success mb-0"
                     invisible="picking_type_code != 'incoming' or not ks_receipt_approved or state == 'done' or ks_is_receipt_admin or ks_is_receipt_pm_user"
                     role="alert">
                    ✅ <strong>Approved</strong> — Your receipt has been approved and is being completed.
                </div>

                <!-- Approval Required banner (ready state, not yet approved) -->
                <div class="alert alert-info mb-0"
                     invisible="picking_type_code != 'incoming' or state != 'assigned' or ks_receipt_approved or ks_is_receipt_admin or ks_is_receipt_pm_user"
                     role="alert">
                    🔒 <strong>Approval Required</strong> — Click <strong>Validate</strong> to submit this receipt for approval.
                </div>

            </xpath>

            <!-- Approval History tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Receipt Approval" name="receipt_approval_history"
                      invisible="picking_type_code != 'incoming' or (state != 'receipt_approval_pending' and not ks_receipt_pm1_id)">
                    <group>
                        <group string="Approval Request">
                            <field name="ks_receipt_request_user_id" string="Requested By" readonly="1"/>
                            <field name="ks_receipt_request_date" string="Request Date" readonly="1"/>
                            <field name="ks_receipt_request_reason" string="Reason" readonly="1"/>
                        </group>
                        <group string="Approvers">
                            <field name="ks_receipt_pm1_id" string="Approver 1 (PM1)" readonly="1"/>
                            <field name="ks_receipt_pm1_approved" string="PM1 Approved" readonly="1"/>
                            <field name="ks_receipt_pm2_id" string="Approver 2 (PM2)" readonly="1"
                                   invisible="not ks_receipt_pm2_id"/>
                            <field name="ks_receipt_pm2_approved" string="PM2 Approved" readonly="1"
                                   invisible="not ks_receipt_pm2_id"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
