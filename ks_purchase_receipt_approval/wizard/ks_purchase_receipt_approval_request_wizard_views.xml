<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_purchase_receipt_approval_request_wizard_form" model="ir.ui.view">
        <field name="name">ks.purchase.receipt.approval.request.wizard.form</field>
        <field name="model">ks.purchase.receipt.approval.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request for Approval">
                <field name="ks_picking_id" invisible="1"/>
                <field name="ks_approver1_user_ids" invisible="1"/>
                <field name="ks_approver2_user_ids" invisible="1"/>
                <field name="ks_approver1_filtered_ids" invisible="1"/>
                <field name="ks_approver2_filtered_ids" invisible="1"/>
                <field name="ks_show_approver2" invisible="1"/>
                <field name="ks_is_update_mode" invisible="1"/>
                <field name="ks_pm1_already_approved" invisible="1"/>
                <field name="ks_approval_info" widget="html" readonly="1" nolabel="1"/>
                <group>
                    <field name="ks_approver1_user"
                           options="{'no_create': True}"
                           domain="[('id', 'in', ks_approver1_filtered_ids), ('share', '=', False)]"
                           readonly="ks_pm1_already_approved"/>
                    <field name="ks_approver2_user"
                           options="{'no_create': True}"
                           domain="[('id', 'in', ks_approver2_filtered_ids), ('share', '=', False)]"
                           required="ks_show_approver2"
                           invisible="not ks_show_approver2"/>
                    <field name="ks_reason"/>
                </group>
                <footer>
                    <button name="action_confirm_request" string="OK" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
