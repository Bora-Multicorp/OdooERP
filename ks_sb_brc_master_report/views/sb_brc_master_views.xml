<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view: all columns in image order, editable, scrollable -->
    <record id="view_sb_brc_master_list" model="ir.ui.view">
        <field name="name">sb.brc.master.list</field>
        <field name="model">sb.brc.master</field>
        <field name="arch" type="xml">
            <list string="SB/BRC Master Report" editable="top" class="o_sb_brc_list_scrollable" create="1" delete="1">
<!--                <field name="sr_no" readonly="1"/>-->
                <field name="date"/>
                <field name="invoice_id" options="{'no_create': True}"/>
                <field name="sb_no"/>
<!--                <field name="be_no"/>-->
                <field name="consignee" readonly="1"/>
                <field name="buyer" readonly="1"/>
                <field name="awb_number"/>
                <field name="qty" readonly="1"/>
                <field name="sb_date"/>
<!--                <field name="unit_rate" readonly="1"/>-->
                <field name="currency_id" readonly="1"/>
<!--                <field name="calendar_date"/>-->
                <field name="invoice_amount_usd" readonly="1"/>
                <field name="ex_rate" readonly="1"/>
                <field name="sb_ex_rate"/>
                <field name="amount_inr" readonly="1"/>
                <field name="fob_value_inr"/>
                <field name="gst_rate"/>
                <field name="gst_amount"/>
                <field name="invoice_value" readonly="1"/>
                <field name="cha_id"/>
                <field name="for_calculation"/>
                <field name="other_charges"/>
                <field name="freight"/>
                <field name="agency_charges"/>
                <field name="doc_charges_fumigation"/>
                <field name="terminal_handling"/>
                <field name="drawback_charges"/>
                <field name="awb_charges"/>
                <field name="gate_pass"/>
                <field name="transportation_to_air_cargo"/>
                <field name="load_unload"/>
                <field name="pallet_charges"/>
                <field name="other_charges_2"/>
                <field name="sai_warehouse"/>
                <field name="insurance"/>
                <field name="total_charges" readonly="1"/>
                <field name="no_of_pallets"/>
                <field name="weight_as_per_awb"/>
                <field name="per_piece_costing" readonly="1"/>
                <field name="average_per_costing" readonly="1"/>
                <field name="airlines"/>
                <field name="country_id"/>
                <field name="port"/>
                <field name="brc_status"/>
                <field name="brc_date"/>
                <field name="brc_no"/>
                <field name="brc_amount_usd"/>
                <field name="diff_in_realization" readonly="1"/>
                <field name="sb_fob_value"/>
                <field name="fresh"/>
                <field name="activated"/>
                <field name="other_country"/>
                <field name="rodtep_amount" readonly="1"/>
                <field name="rodtep_amount_per_sb"/>
<!--                <field name="dbk_percentage"/>-->
                <field name="dbk_claimed"/>
                <field name="dbk_as_per_calculation" readonly="1"/>
                <field name="dbk_amount"/>
                <field name="application_status"/>
                <field name="drawback_received"/>
                <field name="remarks"/>
                <field name="fob_value"/>
                <field name="tax_able_amt"/>
                <field name="gst_amt"/>
                <field name="tds_amt"/>
                <field name="net_balance_payable"/>
<!--                <field name="received_date"/>-->
            </list>
        </field>
    </record>

    <record id="view_sb_brc_master_form" model="ir.ui.view">
        <field name="name">sb.brc.master.form</field>
        <field name="model">sb.brc.master</field>
        <field name="arch" type="xml">
            <form string="SB/BRC Master Report">
                <sheet>
                    <group>
                        <group>
<!--                            <field name="sr_no" readonly="1"/>-->
                            <field name="date"/>
                            <field name="invoice_id" options="{'no_create': True}"/>
                            <field name="sb_no"/>
<!--                            <field name="be_no"/>-->
                            <field name="awb_number"/>
                        </group>
                        <group>
                            <field name="consignee" readonly="1"/>
                            <field name="buyer" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Details" name="invoice_details">
                            <group>
                                <group>
                                    <field name="qty" readonly="1"/>
<!--                                    <field name="unit_rate" readonly="1"/>-->
                                    <field name="invoice_amount_usd" readonly="1"/>
                                    <field name="ex_rate" readonly="1"/>
<!--                                    <field name="sb_rate"/>-->
                                    <field name="amount_inr" readonly="1"/>
                                    <field name="fob_value_inr"/>
                                    <field name="gst_rate"/>
                                    <field name="gst_amount"/>
                                    <field name="invoice_value" readonly="1"/>
<!--                                    <field name="calendar_date"/>-->
                                </group>
                            </group>
                        </page>
                        <page string="Charges" name="charges">
                            <group>
                                <group>
                                    <field name="cha_id"/>
                                    <field name="for_calculation"/>
                                    <field name="other_charges"/>
                                    <field name="freight"/>
                                    <field name="agency_charges"/>
                                    <field name="doc_charges_fumigation"/>
                                    <field name="terminal_handling"/>
                                    <field name="drawback_charges"/>
                                    <field name="awb_charges"/>
                                    <field name="gate_pass"/>
                                    <field name="transportation_to_air_cargo"/>
                                    <field name="load_unload"/>
                                    <field name="pallet_charges"/>
                                    <field name="other_charges_2"/>
                                    <field name="sai_warehouse"/>
                                    <field name="insurance"/>
                                    <field name="total_charges" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Shipping &amp; BRC" name="shipping_brc">
                            <group>
                                <group>
                                    <field name="no_of_pallets"/>
                                    <field name="weight_as_per_awb"/>
                                    <field name="per_piece_costing" readonly="1"/>
                                    <field name="average_per_costing" readonly="1"/>
                                    <field name="airlines"/>
                                    <field name="country_id"/>
                                    <field name="port"/>
                                    <field name="brc_status"/>
                                    <field name="brc_date"/>
                                    <field name="brc_no"/>
                                    <field name="brc_amount_usd"/>
                                    <field name="diff_in_realization" readonly="1"/>
                                    <field name="sb_fob_value"/>
                                </group>
                            </group>
                        </page>
                        <page string="Product / RODTEP / DBK" name="product_rodtep_dbk">
                            <group>
                                <group>
                                    <field name="fresh"/>
                                    <field name="activated"/>
                                    <field name="other_country"/>
                                    <field name="rodtep_amount" readonly="1"/>
                                    <field name="rodtep_amount_per_sb"/>
<!--                                    <field name="dbk_percentage"/>-->
                                    <field name="dbk_claimed"/>
                                    <field name="dbk_as_per_calculation" readonly="1"/>
                                    <field name="dbk_amount"/>
                                    <field name="application_status"/>
                                    <field name="drawback_received"/>
<!--                                    <field name="received_date"/>-->
<!--                                    <field name="received_amount"/>-->
                                </group>
                                <group>
                                    <field name="tax_able_amt"/>
                                    <field name="gst_amt"/>
                                    <field name="tds_amt"/>
                                    <field name="net_balance_payable" readonly="1"/>
                                    <field name="remarks"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

