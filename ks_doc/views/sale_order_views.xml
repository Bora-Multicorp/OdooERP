<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sale Order Form View - Add Documents Tab -->
    <record id="view_order_form_inherit_ks_doc" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ks.doc</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Add Documents Smart Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="ks_document_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="ks_document_count"/>
                        </span>
                        <span class="o_stat_text">Documents</span>
                    </div>
                </button>
            </xpath>

            <!-- Add Send Documents Button -->
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button name="action_send_documents"
                        type="object"
                        string="Send Documents"
                        class="btn-secondary"
                        icon="fa-envelope"
                        invisible="ks_document_count == 0"
                        data-hotkey="shift+d"
                        help="Send all uploaded documents to the customer as a ZIP file"/>
            </xpath>

            <!-- Add Documents Tab -->
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Documents" name="ks_documents">
                    <!-- Documents Sent Banner -->
                    <div class="alert alert-success mb-3" role="alert"
                         invisible="not ks_documents_sent">
                        <i class="fa fa-check-circle me-2" title="Documents sent"/>
                        <strong>Documents sent to customer</strong> on 
                        <field name="ks_documents_sent_date" widget="datetime" readonly="1" class="d-inline"/>
                    </div>

                    <!-- Document Upload Section -->
                    <group>
                        <group string="Upload Documents" col="1">
                            <field name="ks_document_ids" 
                                   nolabel="1"
                                   context="{'default_sale_order_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="document_type"/>
                                    <field name="name" placeholder="Document name..."/>
                                    <field name="file" filename="file_name"/>
                                    <field name="file_name" column_invisible="1"/>
                                    <field name="upload_date" readonly="1" column_invisible="1"/>
                                    <field name="uploaded_by" readonly="1" optional="hide"/>
                                    <field name="notes" optional="hide" widget="text"/>
                                </list>
                            </field>
                        </group>
                    </group>

                    <!-- Help Text -->
                    <div class="alert alert-info mt-3" role="alert" 
                         invisible="ks_document_count > 0">
                        <h5><i class="fa fa-info-circle me-2"/>Document Upload Instructions</h5>
                        <p class="mb-2">Upload documents related to this sale order:</p>
                        <ul class="mb-0">
                            <li><strong>Airways Bill</strong> - Air transport documentation</li>
                            <li><strong>Packing List</strong> - Detailed packing information</li>
                            <li><strong>Transport Bill</strong> - Transportation charges and details</li>
                            <li><strong>EVR</strong> - Export Verification Report</li>
                            <li><strong>Export Bill</strong> - Export documentation</li>
                            <li><strong>Other</strong> - Any other related documents</li>
                        </ul>
                    </div>

                    <!-- Document Summary -->
                    <group invisible="ks_document_count == 0">
                        <group string="Document Summary">
                            <field name="ks_document_count" readonly="1" string="Total Documents"/>
                            <field name="ks_documents_sent" readonly="1" widget="boolean"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Sale Order List View - Add Document Count Column -->
    <record id="view_order_tree_inherit_ks_doc" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.ks.doc</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="ks_document_count" string="Docs" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Sale Order Search View - Add Document Filters -->
    <record id="view_order_search_inherit_ks_doc" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.ks.doc</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="has_documents" string="Has Documents" 
                        domain="[('ks_document_ids', '!=', False)]"/>
                <filter name="documents_sent" string="Documents Sent" 
                        domain="[('ks_documents_sent', '=', True)]"/>
                <filter name="documents_not_sent" string="Documents Not Sent" 
                        domain="[('ks_document_ids', '!=', False), ('ks_documents_sent', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>

