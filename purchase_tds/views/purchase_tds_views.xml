<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_tds_form" model="ir.ui.view">
        <field name="name">purchase.tds.form</field>
        <field name="model">purchase.tds</field>
        <field name="arch" type="xml">
            <form string="Purchase TDS">
                <sheet>
                    <group>
                        <group>
                            <field name="purchase_id"/>
                            <field name="date"/>
                            <field name="tax_id"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="base"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_tds_list" model="ir.ui.view">
        <field name="name">purchase.tds.list</field>
        <field name="model">purchase.tds</field>
        <field name="arch" type="xml">
            <list string="Purchase TDS">
                <field name="date"/>
                <field name="reference"/>
                <field name="purchase_id"/>
                <field name="tax_id"/>
                <field name="base"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>


</odoo>
