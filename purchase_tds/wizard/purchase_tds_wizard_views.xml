<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_tds_entry_wizard_form_action" model="ir.actions.act_window">
        <field name="name">Create TDS Entry</field>
        <field name="res_model">purchase.tds.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="purchase_tds_entry_wizard_form" model="ir.ui.view">
        <field name="name">purchase.tds.entry.wizard.view.form</field>
        <field name="model">purchase.tds.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning mt-1 mb-1" role="alert" invisible="not l10n_in_withholding_warning">
                    <div>
                        <field name="l10n_in_withholding_warning" widget="actionable_errors"/>
                    </div>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not l10n_in_tcs_tds_warning">
                    <field name="l10n_in_tcs_tds_warning" readonly="1"/>
                </div>
                <sheet>
                    <group>
                        <group id="header_left_group">
                            <field name="date"/>
                            <field name="reference"/>
                            <field name="base" widget="monetary" options="{'currency_field': 'currency_id'}" required="True"/>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="purchase_id" invisible="1"/>
                        </group>
                        <group id="header_right_group">
                            <field name="tax_id" domain="[('l10n_in_tds_tax_type', '=', 'purchase'),('company_id', '=',company_id)]" required="True"
                                options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm_tds" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
