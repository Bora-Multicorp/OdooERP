<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_delayed_payment_done_notification" model="ir.cron">
        <field name="name">Payment Done: Send Activities (20 Min Delay)</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_delayed_payment_done_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
