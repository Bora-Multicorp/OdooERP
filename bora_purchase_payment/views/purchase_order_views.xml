<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_bora_payment" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.bora.payment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_advance_payments']/field[@name='ks_advance_payment_count']" position="attributes">
                <attribute name="string">Payments</attribute>
            </xpath>
            <xpath expr="//button[@name='action_create_advance_payment']" position="attributes">
                <attribute name="string">Create Payment</attribute>
                <attribute name="help">Create a payment directly from this purchase order without creating a bill (requires approved payment approval request)</attribute>
            </xpath>
            <xpath expr="//button[@name='action_create_payment_approval_request']" position="attributes">
                <attribute name="help">Request payment approval. Approval type is set automatically: 'With Bill' if a posted vendor bill exists, otherwise 'Without Bill'.</attribute>
            </xpath>
            <xpath expr="//group[@name='advance_payment_summary']" position="attributes">
                <attribute name="string">Payment Summary</attribute>
            </xpath>
            <xpath expr="//field[@name='ks_advance_payment_amount']" position="attributes">
                <attribute name="string">Total Paid</attribute>
            </xpath>
        </field>
    </record>
</odoo>
