<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banking Authorised Approvers Form View -->
    <record id="view_banking_approval_config_form" model="ir.ui.view">
        <field name="name">banking.approval.config.form</field>
        <field name="model">banking.approval.config</field>
        <field name="arch" type="xml">
            <form string="Banking Authorised Approvers">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Global Banking Approval Configuration"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>Global Configuration:</strong> This configuration applies to all companies. Only one active configuration is allowed.
                    </div>
                    <group>
                        <group string="Approval Mode">
                            <field name="ks_approval_mode" widget="radio"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approvers" name="approvers">
                            <group>
                                <group string="Approver 1 Users">
                                    <field name="ks_approver_1_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"
                                           context="{'show_email': True}"
                                           placeholder="Select users for Approval 1"/>
                                </group>
                                <group string="Approver 2 Users"
                                       invisible="ks_approval_mode == 'single'">
                                    <field name="ks_approver_2_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"
                                           context="{'show_email': True}"
                                           placeholder="Select users for Approval 2"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 invisible="ks_approval_mode != 'single'">
                                <strong>Single Level Approval:</strong> All users in Approver 1 list will receive approval requests and to-do activities. Any one approver who approves will confirm the payment.
                            </div>
                            <div class="alert alert-info" role="alert"
                                 invisible="ks_approval_mode != 'two_way'">
                                <strong>Two Level Approval:</strong> All configured Approvers 1 and Approvers 2 will receive approval requests and to-do activities. Any one approver who approves will confirm the payment.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Banking Authorised Approvers List View -->
    <record id="view_banking_approval_config_list" model="ir.ui.view">
        <field name="name">banking.approval.config.list</field>
        <field name="model">banking.approval.config</field>
        <field name="arch" type="xml">
            <list string="Banking Authorised Approvers">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="ks_approval_mode"/>
                <field name="ks_approver_1_ids" widget="many2many_tags"/>
                <field name="ks_approver_2_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Banking Authorised Approvers Action -->
    <record id="action_banking_approval_config" model="ir.actions.act_window">
        <field name="name">Banking Authorised Approvers</field>
        <field name="res_model">banking.approval.config</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Banking Payment Authorised Approvers
            </p>
            <p>
                Set up approvers for payment approval requests in Accounting.
                When a payment is submitted for approval, all configured approvers will receive the request and a to-do activity.
                Once any one approver approves, the payment is confirmed and remaining activities are automatically cancelled.
            </p>
        </field>
    </record>

    <!-- Menu: Accounting > Configuration > Banking Authorised Approvers -->
    <menuitem id="menu_banking_approval_config"
              name="Banking Authorised Approvers"
              parent="account.menu_finance_configuration"
              action="action_banking_approval_config"
              sequence="50"
              groups="account.group_account_manager"/>
</odoo>
