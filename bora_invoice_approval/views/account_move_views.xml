<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bora_invoice_approval_move_form" model="ir.ui.view">
        <field name="name">bora.invoice.approval.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Hidden computed fields. All UI is gated on _is_customer_invoice()
                 logic: move_type == 'out_invoice' and not debit_origin_id.
                 Since debit_origin_id is already declared by bora_debit_note_approval,
                 we use bora_is_debit_note from bora_vendor_bill_approval if installed,
                 or gate directly on debit_origin_id being absent. -->
            <xpath expr="//sheet" position="before">
                <field name="bora_is_inv_pm_user" invisible="1"/>
                <field name="bora_is_inv_admin" invisible="1"/>
                <field name="bora_inv_approved" invisible="1"/>
                <field name="bora_inv_is_local_sale" invisible="1"/>
                <field name="bora_inv_sale_type_label" invisible="1"/>
                <field name="bora_show_inv_approve_button" invisible="1"/>
                <field name="bora_show_inv_reject_button" invisible="1"/>
                <field name="bora_show_inv_update_button" invisible="1"/>
                <field name="bora_inv_pm1_id" invisible="1"/>
                <field name="bora_inv_pm2_id" invisible="1"/>
                <field name="bora_inv_pm1_approved" invisible="1"/>
                <field name="bora_inv_pm2_approved" invisible="1"/>
                <field name="bora_inv_request_user_id" invisible="1"/>
            </xpath>

            <!-- Approval action buttons before the Confirm button.
                 Gated on move_type == 'out_invoice' so they never appear on
                 vendor bills, debit notes, or journal entries. -->
            <xpath expr="//button[@name='action_post']" position="before">

                <!-- Re-open wizard when stuck with no PM1 -->
                <button name="bora_action_request_inv_approval"
                        string="Select Approvers"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'invoice_approval_pending' or bora_inv_pm1_id or move_type != 'out_invoice'"/>

                <!-- Update approvers (original requester) -->
                <button name="action_update_inv_approvers"
                        string="Update Approvers"
                        type="object"
                        class="btn-warning"
                        invisible="not bora_show_inv_update_button"
                        confirm="This will cancel the current approval request and let you choose new approvers. Continue?"/>

                <!-- Approve -->
                <button name="bora_action_approve_inv"
                        string="Approve"
                        type="object"
                        class="btn-success"
                        invisible="not bora_show_inv_approve_button"/>

                <!-- Reject -->
                <button name="bora_action_reject_inv"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        invisible="not bora_show_inv_reject_button"/>

            </xpath>

            <!-- Hide Confirm while any approval is pending (covers all modules). -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible">state in ('bill_approval_pending', 'debit_note_approval_pending', 'journal_entry_approval_pending', 'invoice_approval_pending', 'credit_note_approval_pending')</attribute>
            </xpath>

            <!-- Status bar: common states only; current pending state auto-appears. -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,posted,cancel</attribute>
            </xpath>

            <!-- Banners — gated strictly on move_type == 'out_invoice' -->
            <xpath expr="//sheet" position="before">

                <!-- Approval Pending banner with sale type badge -->
                <div class="alert alert-warning mb-0"
                     invisible="move_type != 'out_invoice' or state != 'invoice_approval_pending'"
                     role="alert">
                    <strong>⏳ Invoice Approval Pending</strong>
                    <span class="badge bg-primary ms-2" invisible="not bora_inv_is_local_sale">🇮🇳 Local Sale</span>
                    <span class="badge bg-warning text-dark ms-2" invisible="bora_inv_is_local_sale">✈️ Export Sale</span>
                    — This invoice is waiting for approver confirmation.
                    <br/>
                    <span invisible="not bora_inv_pm1_id">
                        <strong>PM1 (<field name="bora_inv_pm1_id" readonly="1" nolabel="1" class="d-inline"/>):</strong>
                        <span invisible="bora_inv_pm1_approved"> ⏳ Pending</span>
                        <span invisible="not bora_inv_pm1_approved"> ✅ Approved</span>
                    </span>
                    <span invisible="not bora_inv_pm2_id">
                        &#160;&#160;|&#160;&#160;
                        <strong>PM2 (<field name="bora_inv_pm2_id" readonly="1" nolabel="1" class="d-inline"/>):</strong>
                        <span invisible="bora_inv_pm2_approved"> ⏳ Pending</span>
                        <span invisible="not bora_inv_pm2_approved"> ✅ Approved</span>
                    </span>
                </div>

                <!-- Approved banner -->
                <div class="alert alert-success mb-0"
                     invisible="move_type != 'out_invoice' or not bora_inv_approved or state == 'posted' or bora_is_inv_admin or bora_is_inv_pm_user"
                     role="alert">
                    ✅ <strong>Approved</strong> — Your invoice has been approved and is being confirmed.
                </div>

                <!-- Approval Required info banner -->
                <div class="alert alert-info mb-0"
                     invisible="move_type != 'out_invoice' or state != 'draft' or bora_inv_approved or bora_is_inv_admin or bora_is_inv_pm_user"
                     role="alert">
                    🔒 <strong>Approval Required</strong> — Click <strong>Confirm</strong> to submit this invoice for approval.
                </div>

            </xpath>

            <!-- Invoice Approval History tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Invoice Approval" name="inv_approval_history"
                      invisible="move_type != 'out_invoice' or (state != 'invoice_approval_pending' and not bora_inv_pm1_id)">
                    <group>
                        <group string="Approval Request">
                            <field name="bora_inv_request_user_id" string="Requested By" readonly="1"/>
                            <field name="bora_inv_request_date" string="Request Date" readonly="1"/>
                            <field name="bora_inv_sale_type_label" string="Sale Type" readonly="1"/>
                            <field name="bora_inv_request_reason" string="Reason" readonly="1"/>
                        </group>
                        <group string="Approvers">
                            <field name="bora_inv_pm1_id" string="Approver 1 (PM1)" readonly="1"/>
                            <field name="bora_inv_pm1_approved" string="PM1 Approved" readonly="1"/>
                            <field name="bora_inv_pm2_id" string="Approver 2 (PM2)" readonly="1"
                                   invisible="not bora_inv_pm2_id"/>
                            <field name="bora_inv_pm2_approved" string="PM2 Approved" readonly="1"
                                   invisible="not bora_inv_pm2_id"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
