<odoo>
    <record id="seq_buyer_ref" model="ir.sequence">
        <field name="name">Buyer's Ref/Order No</field>
        <field name="code">sale.order.buyer.ref</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>

    </record>

    <record id="seq_voucher_no" model="ir.sequence">
        <field name="name">Voucher No</field>
        <field name="code">sale.order.voucher.no</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
         <field name="company_id" eval="False"/>
    </record>
</odoo>
