<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_account_invoice_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">

            <div class="page" style="font-size:11px; font-family:Arial, sans-serif; padding-top:0;">
                <t t-set="sale_order"
                   t-value="o.invoice_line_ids and o.invoice_line_ids[0].sale_line_ids and o.invoice_line_ids[0].sale_line_ids[0].order_id or False"/>
                <h2 style="text-align:center; font-weight:bold; text-transform:uppercase; margin-bottom:8px; margin-top:0;">
                    Commercial Invoice
                </h2>

                <table style="width:100%; border-collapse:collapse; margin-bottom:0;">
                    <tr>
                        <td style="width:50%; vertical-align:top; border:1px solid black; padding:0;">
                            <div style="padding:5px; border-bottom:1px solid black;">
                                <div t-field="o.company_id.partner_id"
                                     t-options='{"widget":"contact","fields":["name","address"],"no_marker":True}'/>
                                <t t-if="o.company_id.vat">TRN:
                                    <span t-field="o.company_id.vat"/>
                                </t>
                            </div>
                            <div style="padding:5px; border-bottom:1px solid black;">
                                <div>
                                    <strong>Consignee</strong>
                                </div>
                                <div>
                                    <strong>Captains Freight Services FZCO</strong>
                                </div>
                                <div>D-15, Dubai Airport Freezone, Dubai, U.A.E.</div>
                            </div>
                            <div style="padding:5px;">
                                <div>
                                    <strong>Buyer</strong>
                                </div>
                                <div t-field="o.partner_id"
                                     t-options='{"widget":"contact","fields":["name","address","phone","email"],"no_marker":True}'/>
                                <t t-if="o.partner_id.vat">
                                    <div>TRN:
                                        <span t-field="o.partner_id.vat"/>
                                    </div>
                                </t>
                                <t t-if="o.partner_id.email">
                                    <div>E-Mail:
                                        <span t-field="o.partner_id.email"/>
                                    </div>
                                </t>
                            </div>
                        </td>

                        <td style="width:50%; vertical-align:top; border:1px solid black; padding:0;">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="padding:5px; border-bottom:1px solid black; border-right:1px solid black;">
                                        <div>
                                            <strong>Voucher No.</strong>
                                        </div>
                                        <div>
                                            <span t-esc="sale_order and sale_order.voucher_no or ''"/>
                                        </div>
                                    </td>
                                    <td style="padding:5px; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Dated</strong>
                                        </div>
                                        <div>
                                            <span t-field="o.invoice_date" t-options='{"widget":"date"}'/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:5px; border-right:1px solid black; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Delivery Note</strong>
                                        </div>
                                        <div>
                                            <span t-field="o.delivery_note"/>
                                        </div>
                                    </td>
                                    <td style="padding:5px; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Mode/Terms of Payment</strong>
                                        </div>
                                        <div>
                                            <span t-esc="o.invoice_payment_term_id.name or ''"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:5px; border-right:1px solid black; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Supplier's Ref.</strong>
                                        </div>
                                        <div>
                                            <span t-field="o.invoice_origin"/>
                                        </div>
                                    </td>
                                    <td style="padding:5px; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Other Reference(s)</strong>
                                        </div>
                                        <div>
                                            <span t-field="o.ref"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:5px; border-right:1px solid black; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Buyer Order No.</strong>
                                        </div>
                                        <div>
                                            <span t-esc="sale_order and sale_order.buyer_ref_no or ''"/>
                                        </div>
                                    </td>
                                    <td style="padding:5px; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Dated</strong>
                                        </div>
                                        <div>
                                            <span t-field="o.buyer_date"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:5px; border-right:1px solid black; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Despatch Document No.</strong>
                                        </div>
                                        <div>
                                            <span t-field="o.despatch_doc_no"/>
                                        </div>
                                    </td>
                                    <td style="padding:5px; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Delivery Note Date</strong>
                                        </div>
                                        <div>
                                            <span t-field="o.delivery_note_date" t-options='{"widget":"date"}'/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:5px; border-right:1px solid black; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Despatch Through</strong>
                                        </div>
                                        <div>
                                            <span t-field="sale_order and sale_order.dispatch_id"/>
                                        </div>
                                    </td>
                                    <td style="padding:5px; border-bottom:1px solid black;">
                                        <div>
                                            <strong>Destination</strong>
                                        </div>
                                        <div>
                                            <span t-field="sale_order and sale_order.warehouse_id"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="padding:5px;">
                                        <div>
                                            <strong>Terms of Delivery</strong>
                                        </div>
                                        <div>
                                            <span t-field="o.narration"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:11px; margin-bottom:0;">
                    <thead>
                        <tr style="background-color:#f0f0f0;">
                            <th style="border-right:1px solid black; padding:4px; width:5%;">Sl No.</th>
                            <th style="border-right:1px solid black; padding:4px;">Description of Goods</th>
                            <th style="border-right:1px solid black; padding:4px; text-align:right;">Quantity</th>
                            <th style="border-right:1px solid black; padding:4px; text-align:right;">Rate</th>
                            <th style="border-right:1px solid black; padding:4px;">per</th>
                            <th style="padding:4px; text-align:right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="enumerate(o.invoice_line_ids, start=1)" t-as="row">
                            <tr>
                                <td style="border-right:1px solid black; padding:4px; text-align:center;">
                                    <t t-esc="row[0]"/>
                                </td>
                                <td style="border-right:1px solid black; padding:4px;">
                                    <span t-field="row[1].name"/>
                                    <br/>
                                    <span style="font-size:9px; font-style:italic;">Made in
                                        <span t-field="row[1].product_id.made_country"/>
                                    </span>
                                </td>
                                <td style="border-right:1px solid black; padding:4px; text-align:right;">
                                    <t t-esc="'%0.0f pcs' % row[1].quantity"/>
                                </td>
                                <td style="border-right:1px solid black; padding:4px; text-align:right;">
                                    <span t-esc="o.currency_id.symbol"/>
                                    <span t-esc="'%0.2f' % o.company_id.currency_id.round(row[1].price_unit)"/>
                                </td>
                                <td style="border-right:1px solid black; padding:4px;">
                                    <t t-esc="row[1].quantity > 1 and 'pcs' or 'pc'"/>
                                </td>
                                <td style="padding:4px; text-align:right;">
                                    <span t-esc="o.currency_id.symbol"/>
                                    <span t-esc="'%0.2f' % o.company_id.currency_id.round(row[1].price_subtotal)"/>
                                </td>
                            </tr>
                        </t>
                        <tr style="border-top:1px solid black;">
                            <td colspan="2"
                                style="padding:4px; text-align:right; font-weight:bold; border-right:1px solid black;">
                                Total
                            </td>
                             <td style="padding:4px; text-align:right; border-left:1px solid black; border-right:1px solid black; font-weight:bold;">
                                <span t-esc="'%0.0f' % sum(line.quantity for line in o.invoice_line_ids)"/>
                                pcs
                            </td>
                            <td style="padding:4px;border-left:1px solid black; border-right:1px solid black;"></td>
                            <td style="padding:4px;border-left:1px solid black; border-right:1px solid black;"></td>
                            <td style="padding:4px; text-align:right; font-weight:bold;">
                                <span t-esc="o.currency_id.symbol"/>
                                <span t-esc="'%0.2f' % o.amount_total"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <table style="width:100%; border-collapse:collapse; border:1px solid black; font-size:10px; margin-top:0;">
                    <tr>
                        <td style="width:60%; padding:5px; vertical-align:top;">
                            <strong>Amount Chargeable (in words):</strong>
                            <br/>
                            <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                        </td>
                        <td style="width:40%; vertical-align:top; padding:5px;">
                            <div style="text-align:right; font-style:italic;">E. &amp; O.E</div>
                            <br/>
                            <div t-if="o.company_id.partner_id.bank_ids">
                                <div style="font-size:10px; text-align:left;">
                                    <strong>Company's Bank Details</strong>
                                </div>
                                <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                                    <table style="width:100%; font-size:10px;">
                                        <tr>
                                            <td style="width:30%;">
                                                <strong>Bank Name</strong>
                                            </td>
                                            <td style="width:70%;">:
                                                <span t-field="bank.bank_id.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="width:30%;">
                                                <strong>A/c No.</strong>
                                            </td>
                                            <td style="width:70%;">:
                                                <span t-field="bank.acc_number"/>
                                            </td>
                                        </tr>
                                        <t t-if="bank.acc_type == 'iban'">
                                            <tr>
                                                <td style="width:30%;">
                                                    <strong>IBAN</strong>
                                                </td>
                                                <td style="width:70%;">:
                                                    <span t-field="bank.acc_number"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td style="width:30%;">
                                                <strong>SWIFT Code</strong>
                                            </td>
                                            <td style="width:70%;">:
                                                <span t-field="bank.bank_id.bic"/>
                                            </td>
                                        </tr>
                                    </table>
                                </t>
                            </div>
                        </td>
                    </tr>
                </table>

                <table style="width:100%; margin-top:0; border-collapse: collapse; border:1px solid black; font-size:10px;">
                    <tr>
                        <td style="width:50%; vertical-align:bottom; padding:5px; border-right:1px solid black;">
                            <div style="text-align:left;">
                                <br/>
                                <br/>
                                <br/>
                                Customer's Seal and Signature
                            </div>
                        </td>
                        <td style="width:50%; vertical-align:bottom; padding:5px;">
                            <div style="text-align:right;">
                                for
                                <strong>
                                    <span t-field="o.company_id.name"/>
                                </strong>
                                <br/>
                                <br/>
                                <br/>
                                Authorised Signatory
                            </div>
                        </td>
                    </tr>
                </table>
                <div style="font-size:9px; text-align:center; margin-top:8px;">
                    This is a Computer Generated Invoice
                </div>
            </div>
        </xpath>
    </template>
</odoo>