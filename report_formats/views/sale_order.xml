<odoo>
    <record id="view_order_form_dispatch_voucher" model="ir.ui.view">
        <field name="name">sale.order.form.dispatch.voucher</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="dispatch_id" readonly="state == 'sale'"/>
                <field name="buyer_ref_no"/>
                <field name="voucher_no"/>
            </xpath>
        </field>
    </record>
</odoo>