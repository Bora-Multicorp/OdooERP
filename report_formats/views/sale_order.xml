<odoo>
    <record id="view_order_form_dispatch_voucher" model="ir.ui.view">
        <field name="name">sale.order.form.dispatch.voucher</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="dispatch_id" readonly="state in ('sale','unlock_pending','cancel')"/>
                <field name="buyer_ref_no"/>
                <field name="voucher_no"/>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_incoterm_fields" model="ir.ui.view">
        <field name="name">sale.order.form.invoice.incoterm</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='incoterm_location']" position="after">
                <field name="contract_date" required="1" readonly="state in ('sale','unlock_pending','cancel')"/>
                <field name="contract_number" required="1" readonly="state in ('sale','unlock_pending','cancel')"/>
                <field name="incoterm_description" required="1" readonly="state in ('sale','unlock_pending','cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>