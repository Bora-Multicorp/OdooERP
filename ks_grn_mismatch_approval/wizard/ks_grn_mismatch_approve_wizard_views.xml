<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_grn_mismatch_approve_wizard_form_view" model="ir.ui.view">
        <field name="name">ks.grn.mismatch.approve.wizard.form</field>
        <field name="model">ks.grn.mismatch.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="GRN Mismatch Approval">
                <group>
                    <field name="ks_grn_mismatch_approval_id" readonly="1"/>
                    <field name="approve"/>
                    <field name="reason" placeholder="Enter reason (required)..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
