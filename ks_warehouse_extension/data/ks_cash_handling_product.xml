<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Product template: Cash handling charges (for Dubai zone SO - 1.2% default) -->
        <record id="product_template_cash_handling_charges" model="product.template">
            <field name="name">Cash handling charges</field>
            <field name="default_code">CASH-HANDLING</field>
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>
    </data>
</odoo>
