<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_blocked_pan" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.blocked.pan</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('supplier_rank', '&gt;', 0), ('pan_blocked', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
