<odoo>
    <!-- Inherit Product Template Form View -->
    <record id="custom_inherit" model="ir.ui.view">
        <field name="name">custom.contact.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="before">
                <field name="gst_status"/>
                <field name="pan_blocked"/>
            </xpath>
            <xpath expr="//field[@name='l10n_in_pan']" position="attributes">
                <attribute name="readonly">parent_id or gst_status in ['cancelled', 'suo_moto']</attribute>
            </xpath>
        </field>
    </record>
</odoo>