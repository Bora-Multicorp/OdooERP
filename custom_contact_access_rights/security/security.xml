<odoo>
    <data noupdate="0">
        <record id="group_account_team" model="res.groups">
            <field name="name">Account Team</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
            <field name="comment">The user will have access to all contacts with create, read, and write rights.</field>
        </record>
        <record id="res_partner_rule_sales_own_documents" model="ir.rule">
            <field name="name">Contacts: Own Contact or Assigned as Salesperson</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <!-- Show if user is the salesperson or the contact is the user -->
            <field name="domain_force">['|', ('user_id', '=', user.id), ('id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Rule for "User: All Documents" to override the above -->
        <record id="res_partner_rule_all_documents" model="ir.rule">
            <field name="name">Contacts: All Documents (Unrestricted)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
            <!-- No domain = full access -->
            <field name="domain_force">[]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
