<odoo>
    <record id="view_account_payment_form_inherit_so" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.so</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">context.get('force_readonly_from_so', True)</attribute>
            </xpath>
            <xpath expr="//group[@name='main_group']/group[@name='group1']/div[@name='amount_div']/field[@name='currency_id']" position="attributes">
                <attribute name="readonly">context.get('force_readonly_from_so', True)</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="readonly">context.get('force_readonly_from_so', True)</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="before">
                <h1 class="mx-2">
                    <field name="sale_order_name" readonly="1"/>
                </h1>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="before">
                <h1 invisible="state != 'draft'">
                    <span>Draft</span>
                </h1>
                <h1 invisible="state == 'draft'">
                    <field name="name" readonly="1"/>
                </h1>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="replace"/>
            <xpath expr="//header/button[@name='action_post']" position="attributes">
                <attribute name="confirm">Are you sure you want to submit the advance payment request?</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_validate']" position="attributes">
                <attribute name="groups">bora_sale.account_group_for_sales</attribute>
            </xpath>
            <xpath expr="//header/button[@name='mark_as_sent']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_draft']" position="attributes">
                <attribute name="invisible">state in ('draft', 'paid')</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_account_payment_form_inherit_so_list" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.so.list</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="sale_order_name" readonly="1" string="Salee Order" optional="hidden"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_payment_search_inherit_so" model="ir.ui.view">
        <field name="name">account.payment.search.inherit.so</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="sale_order_name" string="Sale Order Payment" filter_domain="[('sale_order_name', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>