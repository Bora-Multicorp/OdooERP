<odoo>
    <record id="view_order_form_inherit_payment" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_advance_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="advance_payment_total" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">
                            Advance Payments (<field name="advance_payment_count" nolabel="1"/>)
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>