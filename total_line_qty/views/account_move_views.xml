<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_total_qty" model="ir.ui.view">
        <field name="name">account.move.form.inherit.total.qty</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='quantity']" position="attributes">
                <attribute name="sum">Total Qty:</attribute>
            </xpath>
        </field>
    </record>
</odoo>
