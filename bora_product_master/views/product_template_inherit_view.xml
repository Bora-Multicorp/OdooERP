<odoo>
    <data>
        <record id="view_product_template_form_inherit1" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_ids']" position="replace"/>
                <xpath expr="//field[@name='default_code']" position="replace"/>
                <xpath expr="//field[@name='barcode']" position="replace"/>
                <xpath expr="//field[@name='supplier_taxes_id']" position="replace"/>
                <xpath expr="//field[@name='categ_id']" position="replace"/>
                <xpath expr="//field[@name='invoice_policy']" position="replace"/>
                <xpath expr="//field[@name='lot_valuated']" position="replace"/>
                <xpath expr="//field[@name='product_tooltip']" position="replace"/>
                <xpath expr="//field[@name='type']" position="replace"/>
                <xpath expr="//field[@name='combo_ids']" position="replace"/>
                <xpath expr="//label[@for='list_price']" position="replace"/>
                <xpath expr="//label[@for='taxes_id']" position="replace"/>
                <xpath expr="//label[@for='standard_price']" position="replace"/>
                <xpath expr="//label[@for='is_storable']" position="replace"/>
                <xpath expr="//div[@name='list_price_uom']" position="replace"/>
                <xpath expr="//div[@name='taxes_div']" position="replace"/>
                <xpath expr="//div[@name='standard_price_uom']" position="replace"/>
                <xpath expr="//div[hasclass('o_row') and hasclass('w-100')]" position="inside"/>
                <xpath expr="//button[@name='%(stock.action_product_replenish)d']" position="replace"/>
                <xpath expr="//div[contains(@class, 'o_row') and .//field[@name='is_storable']]" position="replace"/>
                <xpath expr="//field[@name='attribute_id']" position="attributes">
                    <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True}</attribute>
                </xpath>
            </field>
        </record>
        <record id="view_product_template_form_inherit2" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='attribute_id']" position="attributes">
                    <attribute name="domain">[('id', 'in', parent.attribute_ids)]</attribute>
                </xpath>
                <xpath expr="//field[@name='image_1920']" position="attributes">
                    <attribute name="options">{'preview_image': 'image_128'}</attribute>
                    <attribute name="style">float: left;</attribute>
                    <attribute name="class" remove="oe_avatar" add="m-3" separator=" " />
                </xpath>
                <field name="name" position="attributes">
                    <attribute name="placeholder">e.g. IPHONE 16</attribute>
                    <attribute name="widget">upper_case</attribute>
                </field>
                <xpath expr="//group[@name='group_general']" position="attributes">
                    <attribute name="string">Product Configuration</attribute>
                </xpath>
                <xpath expr="//group[@name='group_general']" position="inside">
                    <field name="is_mobile_category_selected" invisible="1"/>
                    <field name="is_packaging_material" invisible="1"/>
                    <!-- Inventory Type field -->
                    <field name="type" widget="radio" options="{'horizontal': True}" readonly="1"/>
                    <field name="combo_ids" widget="many2many_tags" placeholder="e.g. Starter - Meal - Desert" invisible="type != 'combo'" options="{'no_quick_create': True,'edit_tags': True,}"/>
                    <!-- Track inventory -->
                    <label for="is_storable" class="oe_inline" invisible="type != 'consu'"/>
                    <div class="o_row w-100" invisible="type != 'consu'">
                        <field name="is_storable" readonly="1"/>
                        <field name="tracking" invisible="not is_storable" groups="stock.group_production_lot" readonly="1"/>
                    </div>
                    <field name="product_tooltip" class="fst-italic text-muted" string="" invisible="not product_tooltip"/>
                    <field name="lot_valuated" invisible="tracking == 'none'" widget="confirm_boolean"/>
                    <field name="invoice_policy" required="1" invisible="not sale_ok or type == 'combo'"/>
                    <field name="categ_id" string="Category" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="is_dual_sim" invisible="not is_mobile_category_selected"/>
                </xpath>
                <xpath expr="//group[@name='group_standard_price']" position="attributes">
                    <attribute name="string">Product Specification</attribute>
                </xpath>
                <xpath expr="//group[@name='group_standard_price']" position="inside">
                    <!-- <field name="specs_dubai"/> -->
                    <!-- <field name="made_for_dubai"/> -->
                    <!-- <field name="made_in_india"/> -->
                    <field name="loose_or_master_carton" required="1"/>
                    <field name="brand_id"/>
                    <field name="model"/>
                </xpath>
                <xpath expr="//page[@name='general_information']/group[1]" position="after">
                    <group >

                        <xpath expr="//group[@name='group_standard_price']" position="after">
                            <group string="Pricing &amp; Taxation">
                                <!-- Sales Price field -->
                                <label for="list_price"/>
                                <div name="list_price_uom">
                                    <field name="list_price" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                                    <span name="uom_span" groups="uom.group_uom" invisible="type == 'combo'">
                                per
                                        <field name="uom_id" class="oe_inline" style="max-width:136px" options="{'no_create': True}"/>
                                    </span>
                                </div>
                                <!-- Sales Taxes -->
                                <label for="taxes_id" invisible="type == 'combo'"/>
                                <div name="taxes_div" class="o_row" invisible="type == 'combo'">
                                    <field name="taxes_id" widget="many2many_tags" class="oe_inline" context="{
                                'default_type_tax_use': 'sale',
                                'search_default_sale': 1,
                                'search_default_service': type == 'service',
                                'search_default_goods': type == 'consu',
                                }" />
                                    <field name="tax_string" class="oe_inline"/>
                                </div>
                                <!-- Cost Field -->
                                <label for="standard_price" invisible="(id and product_variant_count != 1 and not is_product_variant) or type == 'combo'" id="standard_price_label"/>
                                <div name="standard_price_uom" invisible="(id and product_variant_count != 1 and not is_product_variant) or type == 'combo'">
                                    <field name="standard_price" class="oe_inline" widget="monetary" options="{
                                            'currency_field': 'cost_currency_id',
                                            'field_digits': True,
                                        }"/>
                                    <span groups="uom.group_uom">
                                            per
                                        <field name="uom_name" class="oe_inline"/>
                                    </span>
                                </div>
                                <!-- Purchase taxes -->
                                <field name="supplier_taxes_id" widget="many2many_tags"/>
                            </group>
                        </xpath>
                        <group string="Reference &amp; Identification">
                            <field name="default_code" readonly="1" invisible="not default_code"/>
                            <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
