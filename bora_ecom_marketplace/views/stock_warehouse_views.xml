<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Warehouse Form View Inheritance -->
    <record id="view_warehouse_form_ecom" model="ir.ui.view">
        <field name="name">stock.warehouse.form.ecom.marketplace</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="is_ecommerce_warehouse"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Warehouse Tree / List View Inheritance -->
    <record id="view_warehouse_tree_ecom" model="ir.ui.view">
        <field name="name">stock.warehouse.tree.ecom.marketplace</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_ecommerce_warehouse" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Warehouse Search View Inheritance -->
    <record id="view_warehouse_search_ecom" model="ir.ui.view">
        <field name="name">stock.warehouse.search.ecom.marketplace</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.stock_warehouse_view_search"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <filter name="filter_ecommerce_warehouse" string="E-Commerce Warehouse" domain="[('is_ecommerce_warehouse', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
