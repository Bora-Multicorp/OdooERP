<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_bora_ecom_master_tree" model="ir.ui.view">
        <field name="name">bora.ecom.master.list</field>
        <field name="model">bora.ecom.master</field>
        <field name="arch" type="xml">
            <list string="E-Com Master">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_ecommerce" widget="boolean_toggle"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bora_ecom_master_form" model="ir.ui.view">
        <field name="name">bora.ecom.master.form</field>
        <field name="model">bora.ecom.master</field>
        <field name="arch" type="xml">
            <form string="E-Com Master">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Business Category Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Domestic, E-Commerce, Export..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. ECOMMERCE"/>
                            <field name="is_ecommerce"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description_page">
                            <field name="description" placeholder="Add any details, notes or instructions regarding this category..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bora_ecom_master_search" model="ir.ui.view">
        <field name="name">bora.ecom.master.search</field>
        <field name="model">bora.ecom.master</field>
        <field name="arch" type="xml">
            <search string="Search E-Com Master">
                <field name="name" string="Business Category"/>
                <field name="code"/>
                <filter name="filter_ecommerce" string="E-Commerce Categories" domain="[('is_ecommerce', '=', True)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bora_ecom_master" model="ir.actions.act_window">
        <field name="name">E-Com Master</field>
        <field name="res_model">bora.ecom.master</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bora_ecom_master_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new E-Com business category
            </p>
            <p>
                Maintain business categories such as Domestic, E-Commerce, Export, and future categories.
            </p>
        </field>
    </record>
</odoo>
