<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add exchanged_amount field below tax_totals (which shows amount_total) in account.move form view -->
    <record id="view_move_form_exchanged_amount" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.exchange.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add exchanged_amount below tax_totals (which shows amount_total) -->
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="exchanged_amount" 
                       digits="[16,2]"
                       readonly="1"
                       invisible="is_exchange == False or currency_id == company_currency_id"
                       widget="monetary"
                       options="{'currency_field': 'company_currency_id'}"/>
            </xpath>
            <!-- Add exchanged_amount to invoice lines -->
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='price_subtotal']" position="after">
                <field name="company_currency_id" column_invisible="1"/>
                <field name="exchanged_amount" 
                       digits="[16,2]"
                       readonly="1"
                       invisible="move_id.is_exchange == False or move_id.currency_id == company_currency_id"
                       widget="monetary"
                       options="{'currency_field': 'company_currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
