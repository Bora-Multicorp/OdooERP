<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Product used as a deduction line on purchase order when advance payment is made (reduces PO total) -->
        <record id="product_template_advance_deduction" model="product.template">
            <field name="name">Advance Payment Deduction</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
            <field name="list_price">0</field>
            <field name="description">Deduction applied on purchase order for advance payment made. Reduces the total amount to be billed.</field>
        </record>
    </data>
</odoo>
