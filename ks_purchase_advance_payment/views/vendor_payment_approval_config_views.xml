<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_payment_approval_config_list" model="ir.ui.view">
        <field name="name">vendor.payment.approval.config.list</field>
        <field name="model">vendor.payment.approval.config</field>
        <field name="arch" type="xml">
            <list string="Vendor Payment Approval Settings" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="user_id" string="Approver"/>
                <field name="approver_type" string="Approver Type"/>
            </list>
        </field>
    </record>
    <record id="view_vendor_payment_approval_config_form" model="ir.ui.view">
        <field name="name">vendor.payment.approval.config.form</field>
        <field name="model">vendor.payment.approval.config</field>
        <field name="arch" type="xml">
            <form string="Vendor Payment Approval Settings">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="user_id" string="Approver"/>
                        <field name="approver_type"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vendor_payment_approval_config" model="ir.actions.act_window">
        <field name="name">Vendor Payment Approval Settings</field>
        <field name="res_model">vendor.payment.approval.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approvers configured.
            </p>
            <p>
                Configure one Approver 1 and one Approver 2. Both must approve each payment request in sequence.
            </p>
        </field>
    </record>
    <menuitem id="menu_vendor_payment_approval_config"
              name="Vendor Payment Approval Settings"
              parent="purchase.menu_purchase_config"
              action="action_vendor_payment_approval_config"
              groups="purchase.group_purchase_manager"
              sequence="50"/>
</odoo>
