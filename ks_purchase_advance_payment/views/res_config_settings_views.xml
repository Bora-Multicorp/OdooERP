<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_purchase_banking_team" model="ir.ui.view">
        <field name="name">res.config.settings.purchase.banking.team</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='matrix_setting_container']" position="after">
                <block title="Banking Team" name="banking_team_setting_container">
                    <setting string="Banking Team Users"
                             help="These users will receive an email notification when a payment approval request is fully approved.">
                        <field name="banking_team_user_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
