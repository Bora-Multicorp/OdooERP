<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Form - Add Advance Payment Button and Smart Button -->
    <record id="view_purchase_order_form_inherit_advance_payment" model="ir.ui.view">
        <field name="name">purchase.order.form.advance.payment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Smart Button for Payment Approval Requests -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_payment_approval_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-square-o"
                        invisible="payment_approval_request_count == 0">
                    <field name="payment_approval_request_count" widget="statinfo" string="Payment Approval"/>
                </button>
                <button name="action_view_advance_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="ks_advance_payment_count == 0">
                    <field name="ks_advance_payment_count" widget="statinfo" string="Advance Payments"/>
                </button>
            </xpath>

            <!-- Add hidden fields for visibility logic -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="ks_advance_payment_amount" invisible="1"/>
                <field name="ks_advance_payment_in_payment_amount" invisible="1"/>
                <field name="ks_advance_payment_balance" invisible="1"/>
                <field name="has_approved_advance_payment_request" invisible="1"/>
                <field name="payment_approval_request_count" invisible="1"/>
            </xpath>

            <!-- Request Payment Approval and Advance Payment buttons in header -->
            <xpath expr="//button[@name='action_create_invoice']" position="after">
                <button name="action_create_payment_approval_request"
                        type="object"
                        string="Request For Payment"
                        class="btn-secondary"
                        invisible="state not in ('purchase', 'done')"
                        help="Request payment approval. Approval type is set automatically: 'With Bill' if a posted vendor bill exists, otherwise 'Advance Payment'."/>
                <button name="action_create_advance_payment"
                        type="object"
                        string="Create Advance Payment"
                        class="btn-secondary"
                        groups="ks_payment_access_control.group_ks_payment_access"
                        invisible="state not in ('purchase', 'done') or not has_approved_advance_payment_request"
                        help="Create a payment directly from this purchase order without creating a bill (requires approved advance payment approval request)"/>
            </xpath>

            <!-- Add Advance Payment Summary in the Other Information tab -->
            <xpath expr="//page[@name='purchase_delivery_invoice']//group" position="after">
                <group string="Advance Payment Summary"
                       name="advance_payment_summary"
                       invisible="ks_advance_payment_count == 0">
                    <group>
                        <field name="ks_advance_payment_amount" string="Total Advance Paid"/>
                        <field name="ks_advance_payment_balance" string="Balance Due"/>
                        <field name="total_invoice_payment_made" string="Total Bill Payment Made"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Advance deduction lines: make all editable columns readonly for saved lines -->
    <record id="view_purchase_order_form_advance_line_readonly" model="ir.ui.view">
        <field name="name">purchase.order.form.advance.line.readonly</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='display_type']" position="after">
                <field name="ks_is_advance_line" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="readonly">state in ('purchase', 'to approve', 'done', 'cancel') or is_downpayment or ks_is_advance_line</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="attributes">
                <attribute name="readonly">is_downpayment or ks_is_advance_line</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced != 0 or ks_is_advance_line</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_uom']" position="attributes">
                <attribute name="readonly">state in ('purchase', 'done', 'cancel') or is_downpayment or ks_is_advance_line</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='date_planned']" position="attributes">
                <attribute name="readonly">is_downpayment or ks_is_advance_line</attribute>
            </xpath>
        </field>
    </record>

    <!-- Add Purchase Order reference field & Payment Approval to Payment Form View -->
    <record id="view_account_payment_form_inherit_purchase_order" model="ir.ui.view">
        <field name="name">account.payment.form.purchase.order</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ks_can_approve" invisible="1"/>
                <field name="ks_is_requester" invisible="1"/>
            </xpath>
            <xpath expr="//header//button[@name='action_post']" position="before">
                <button name="action_submit_and_open_wizard" string="Submit for Approval" type="object" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_update_approvals" string="Update Approvals" type="object"
                        class="btn-warning"
                        invisible="state != 'pending_approval' or not ks_is_requester"
                        confirm="This will cancel the current approval request and let you choose new approvers. Continue?"/>
                <button name="action_approve_wizard" string="Approve" type="object" class="btn-primary"
                        invisible="not ks_can_approve"/>
                <button name="action_reject_wizard" string="Reject" type="object" class="btn-secondary"
                        invisible="not ks_can_approve"/>
                <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('pending_approval', 'rejected')"/>
            </xpath>
            <xpath expr="//header//button[@name='action_post']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ks_purchase_order_id"
                       string="Purchase Order"
                       readonly="state != 'draft'"
                       invisible="is_insurance_payment or (not ks_purchase_order_id and state != 'draft')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Approval Lines" name="approval_lines" invisible="state == 'draft'">
                    <field name="approval_line_ids" readonly="1" nolabel="1">
                        <list decoration-success="state == 'approved'"
                              decoration-danger="state == 'rejected'"
                              decoration-warning="state == 'pending'"
                              decoration-muted="state == 'cancelled'">
                            <field name="sequence" optional="hide"/>
                            <field name="approver_type"/>
                            <field name="user_id"/>
                            <field name="state" widget="badge"/>
                            <field name="action_date"/>
                            <field name="remark"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Add Purchase Order column to Payment List View -->
    <record id="view_account_payment_list_inherit_purchase_order" model="ir.ui.view">
        <field name="name">account.payment.list.purchase.order</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ks_purchase_order_id" string="Purchase Order" optional="show"
                       invisible="is_insurance_payment"/>
            </xpath>
        </field>
    </record>

    <!-- List view: bulk Request For Payment (for PO with/without Vendor Bill menus) -->
    <record id="view_purchase_order_list_inherit_advance_payment" model="ir.ui.view">
        <field name="name">purchase.order.list.advance.payment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_bulk_request_payment"
                        type="object"
                        string="Request For Payment"
                        class="btn-secondary"
                        invisible="not context.get('show_payment_buttons')"
                        help="Create payment approval requests for selected POs. Type is set automatically per PO."/>
            </xpath>
        </field>
    </record>
</odoo>
