<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide Register Payment / Pay button on vendor bill when PO(s) have no approved "with bill" payment request -->
    <record id="view_move_form_inherit_vendor_payment_approval" model="ir.ui.view">
        <field name="name">account.move.form.vendor.payment.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Make Pay button invisible when vendor bill has no approved bill payment request on linked PO(s) -->
            <xpath expr="//button[@name='action_register_payment']" position="attributes">
                <attribute name="invisible">not ks_can_register_vendor_payment</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="ks_can_register_vendor_payment" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
