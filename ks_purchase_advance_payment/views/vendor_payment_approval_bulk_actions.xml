<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_bulk_approve_payment_approval" model="ir.actions.server">
        <field name="name">Approve</field>
        <field name="model_id" ref="model_vendor_payment_approval_request"/>
        <field name="binding_model_id" ref="model_vendor_payment_approval_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env.ref('ks_purchase_advance_payment.action_vendor_payment_approval_approve_wizard').read()[0]
action['context'] = dict(env.context, active_ids=records.ids, active_model='vendor.payment.approval.request')
action</field>
    </record>
    <record id="action_bulk_reject_payment_approval" model="ir.actions.server">
        <field name="name">Reject</field>
        <field name="model_id" ref="model_vendor_payment_approval_request"/>
        <field name="binding_model_id" ref="model_vendor_payment_approval_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env.ref('ks_purchase_advance_payment.action_vendor_payment_approval_reject_wizard').read()[0]
action['context'] = dict(env.context, active_ids=records.ids, active_model='vendor.payment.approval.request')
action</field>
    </record>
</odoo>
