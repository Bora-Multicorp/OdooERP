<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_payment_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">vendor.payment.approval.reject.wizard.form</field>
        <field name="model">vendor.payment.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Payment Request">
                <group>
                    <field name="reason" placeholder="Enter rejection reason (required)..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_vendor_payment_approval_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Payment Request</field>
        <field name="res_model">vendor.payment.approval.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
