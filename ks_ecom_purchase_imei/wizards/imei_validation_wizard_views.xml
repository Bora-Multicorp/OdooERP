<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- IMEI Validation Wizard Form View -->
    <record id="view_imei_validation_wizard_form" model="ir.ui.view">
        <field name="name">imei.validation.wizard.form</field>
        <field name="model">imei.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="IMEI Validation Errors">
                <header>
                    <field name="total_mismatches" invisible="1"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-heading">
                            <i class="fa fa-exclamation-triangle"/> IMEI Validation Failed
                        </h4>
                        <p>
                            The receipt cannot be validated because <strong><field name="total_mismatches" readonly="1" class="oe_inline"/></strong> 
                            IMEI mismatches were found. Please correct the issues below before validating.
                        </p>
                    </div>
                    
                    <group>
                        <group>
                            <field name="picking_id" readonly="1"/>
                        </group>
                        <group>
                            <div class="d-flex gap-3">
<!--                                <span class="badge bg-warning text-dark">-->
<!--                                    <i class="fa fa-question-circle"/> Missing: <field name="missing_count" readonly="1" class="oe_inline"/>-->
<!--                                </span>-->
<!--                                <span class="badge bg-danger">-->
<!--                                    <i class="fa fa-times-circle"/> Wrong: <field name="wrong_count" readonly="1" class="oe_inline"/>-->
<!--                                </span>-->
<!--                                <span class="badge bg-info">-->
<!--                                    <i class="fa fa-plus-circle"/> Extra: <field name="extra_count" readonly="1" class="oe_inline"/>-->
<!--                                </span>-->
                            </div>
                        </group>
                    </group>
                    
                    <field name="line_ids" nolabel="1">
<!--                        <list string="Mismatch Details" create="false" delete="false" editable="false"-->
<!--                              decoration-warning="mismatch_type == 'missing'"-->
<!--                              decoration-danger="mismatch_type == 'wrong'"-->
<!--                              decoration-info="mismatch_type == 'extra'">-->

                        <list create="0" delete="0" edit="0">
                            <field name="product_id"/>
<!--                            <field name="expected_imei"/>-->
<!--                            <field name="expected_imei2"/>-->
                            <field name="scanned_imei"/>
                            <field name="scanned_imei2"/>
                            <field name="mismatch_type_display" string="Issue"/>
                            <field name="mismatch_type" column_invisible="True"/>
                        </list>
                    </field>
                    
                    <group>
                        <div class="alert alert-info mt-3" role="alert">
                            <strong>How to resolve:</strong>
                            <ul class="mb-0">
                                <li><strong>Missing:</strong> Scan the correct IMEI for the product on the receipt.</li>
                                <li><strong>Wrong:</strong> The scanned IMEI does not match the expected IMEI from the manifest. Verify the physical device.</li>
                                <li><strong>Extra:</strong> The scanned IMEI was not found in the manifest. Contact the supplier.</li>
                            </ul>
                        </div>
                    </group>
                </sheet>
                
                <footer>
                    <button string="Close" name="action_close" type="object" class="btn-primary"/>
                    <button string="Validate" name="action_validate" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- IMEI Validation Wizard Action -->
    <record id="action_imei_validation_wizard" model="ir.actions.act_window">
        <field name="name">IMEI Validation Errors</field>
        <field name="res_model">imei.validation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

