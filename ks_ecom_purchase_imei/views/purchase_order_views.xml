<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Purchase Order Form View -->
    <record id="purchase_order_form_inherit_manifest" model="ir.ui.view">
        <field name="name">purchase.order.form.manifest</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Upload Manifest button in header -->
            <xpath expr="//button[@name='button_confirm']" position="before">
                <button name="action_open_manifest_upload_wizard"
                        string="Upload Manifest"
                        type="object"
                        class="btn-secondary"
                        icon="fa-upload"/>
<!--                        invisible="not is_ecommerce_vendor or state not in ['draft','sent']"-->
<!--                        />-->
<!--                invisible="state in ('purchase', 'done')"-->
            </xpath>
            
            <!-- Add smart button for Manifest Lines -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_manifest_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-barcode"
                        invisible="manifest_line_count == 0">
                    <field name="manifest_line_count" widget="statinfo" string="Manifest Lines"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Extend Purchase Order Tree View -->
    <record id="purchase_order_tree_inherit_manifest" model="ir.ui.view">
        <field name="name">purchase.order.tree.manifest</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <!-- Add Import Manifest button in tree view header -->
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Server Action: Import Manifest from Receipts -->
    <record id="action_import_manifest_from_receipts" model="ir.actions.server">
        <field name="name">Import Manifest from Receipts</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_import_manifest_from_receipts()
        </field>
    </record>

    <!-- Server Action: Upload Manifest (Multi-PO) -->
    <record id="action_upload_manifest_multi_po" model="ir.actions.server">
        <field name="name">Upload Manifest</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_open_multi_po_manifest_upload_wizard()
        </field>
    </record>

</odoo>

