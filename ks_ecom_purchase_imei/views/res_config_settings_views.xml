<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Settings View to add IMEI On Hold Location -->
    <record id="res_config_settings_view_form_imei" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.imei</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[.//field[@name='group_stock_tracking_lot']]" position="after">
                <block title="IMEI Management" id="imei_management_block">
                    <setting id="imei_on_hold_setting"
                             string="IMEI On Hold Location"
                             help="Location where products with IMEI mismatches will be placed.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="imei_on_hold_location_id" class="col-lg-4 o_light_label"/>
                                <field name="imei_on_hold_location_id" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
