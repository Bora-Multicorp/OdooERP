<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Manifest Line List View -->
    <record id="view_po_manifest_line_tree" model="ir.ui.view">
        <field name="name">po.manifest.line.list</field>
        <field name="model">po.manifest.line</field>
        <field name="arch" type="xml">
            <list string="Manifest Lines" default_order="id desc">
                <field name="order_id" optional="hide"/>
                <field name="product_id"/>
                <field name="sku"/>
                <field name="imei"/>
                <field name="imei2"/>
                <field name="qty"/>
                <field name="is_received" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Manifest Line Form View -->
    <record id="view_po_manifest_line_form" model="ir.ui.view">
        <field name="name">po.manifest.line.form</field>
        <field name="model">po.manifest.line</field>
        <field name="arch" type="xml">
            <form string="Manifest Line">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="sku"/>
                            <field name="imei"/>
                            <field name="imei2"/>
                            <field name="qty"/>
                        </group>
                    </group>
                    <group>
                        <field name="is_received"/>
                        <field name="received_move_line_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Manifest Line Search View -->
    <record id="view_po_manifest_line_search" model="ir.ui.view">
        <field name="name">po.manifest.line.search</field>
        <field name="model">po.manifest.line</field>
        <field name="arch" type="xml">
            <search string="Search Manifest Lines">
                <field name="sku"/>
                <field name="imei"/>
                <field name="imei2"/>
                <field name="product_id"/>
                <field name="order_id"/>
                <separator/>
                <filter string="Not Received" name="not_received" domain="[('is_received', '=', False)]"/>
                <filter string="Received" name="received" domain="[('is_received', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Purchase Order" name="group_order" context="{'group_by': 'order_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="SKU" name="group_sku" context="{'group_by': 'sku'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Manifest Line Action -->
    <record id="action_po_manifest_line" model="ir.actions.act_window">
        <field name="name">Manifest Lines</field>
        <field name="res_model">po.manifest.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_po_manifest_line_search"/>
        <field name="context">{'search_default_not_received': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No manifest lines found
            </p>
            <p>
                Upload a CSV manifest from a Purchase Order to create manifest lines.
            </p>
        </field>
    </record>

    <!-- Menu Item (under Purchase) -->
    <menuitem id="menu_po_manifest_line"
              name="Manifest Lines"
              parent="purchase.menu_procurement_management"
              action="action_po_manifest_line"
              sequence="100"/>

</odoo>
