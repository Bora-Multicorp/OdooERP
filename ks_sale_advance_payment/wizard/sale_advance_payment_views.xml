<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_advance_payment" model="ir.ui.view">
        <field name="name">Create Advance Payment</field>
        <field name="model">sale.advance.payment</field>
        <field name="arch" type="xml">
            <form string="Create Advance Payment">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="order_currency_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group>
                    <field name="payment_currency_id" options="{'no_create': True}"/>
                    <field name="amount" required="1"/>
                    <field name="use_manual_rate" invisible="payment_currency_id == order_currency_id"/>
                    <field name="manual_rate" invisible="not use_manual_rate or payment_currency_id == order_currency_id"/>
                    <field name="amount_in_order_currency" invisible="payment_currency_id == order_currency_id"/>
                    <field name="payment_date" required="1"/>
                    <field name="journal_id" required="1" options="{'no_create': True}"/>
                    <field name="payment_method_line_id" 
                           domain="[('id', 'in', available_payment_method_line_ids)]"
                           options="{'no_create': True}"/>
                    <field name="memo" placeholder="Internal note about this payment..."/>
                </group>
                <footer>
                    <button name="action_create_payment" type="object"
                            string="Create Payment" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_view_sale_advance_payment" model="ir.actions.act_window">
        <field name="name">Create Advance Payment</field>
        <field name="res_model">sale.advance.payment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_sale_order_id': active_id}</field>
    </record>
</odoo>

