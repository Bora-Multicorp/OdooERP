<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree/List View -->
    <record id="view_ks_warehouse_insurance_tree" model="ir.ui.view">
        <field name="name">ks.warehouse.insurance.tree</field>
        <field name="model">ks.warehouse.insurance</field>
        <field name="arch" type="xml">
            <list string="Warehouse Insurance">
                <field name="warehouse_id"/>
                <field name="insurance_amount" sum="Total Insurance"/>
                <field name="total_value" sum="Total Value"/>
                <field name="tolerance"/>
                <field name="value_over_under" sum="Total Over/Under"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ks_warehouse_insurance_form" model="ir.ui.view">
        <field name="name">ks.warehouse.insurance.form</field>
        <field name="model">ks.warehouse.insurance</field>
        <field name="arch" type="xml">
            <form string="Warehouse Insurance">
                <sheet>
                    <group>
                        <group>
                            <field name="warehouse_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="insurance_amount"/>
                            <field name="total_value"/>
                        </group>
                        <group>
                            <field name="tolerance"/>
                            <field name="value_over_under" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_ks_warehouse_insurance_search" model="ir.ui.view">
        <field name="name">ks.warehouse.insurance.search</field>
        <field name="model">ks.warehouse.insurance</field>
        <field name="arch" type="xml">
            <search string="Warehouse Insurance">
                <field name="warehouse_id"/>
                <field name="insurance_amount"/>
                <field name="total_value"/>
                <field name="tolerance"/>
                <field name="value_over_under"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ks_warehouse_insurance" model="ir.actions.act_window">
        <field name="name">Warehouse Insurance</field>
        <field name="res_model">ks.warehouse.insurance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Warehouse Insurance record
            </p>
            <p>
                Manage warehouse insurance and value tolerance calculations.
                Track insurance amounts and calculate value over/under based on tolerance percentage.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_ks_warehouse_insurance"
              name="Warehouse Insurance"
              action="action_ks_warehouse_insurance"
              parent="account.menu_finance"
              sequence="100"/>

</odoo>

