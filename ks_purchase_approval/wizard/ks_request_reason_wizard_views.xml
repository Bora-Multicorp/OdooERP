<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_request_reason_wizard_form_view" model="ir.ui.view">
        <field name="name">ks.request.reason.wizard.form</field>
        <field name="model">ks.request.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Reason">
                <group>
                    <field name="ks_purchase_order_id" readonly="1"/>
                    <field name="ks_request_type" invisible="1"/>
                    <field name="ks_request_type_label" string="Request Type" readonly="1"/>
                    <field name="ks_reason" 
                           placeholder="Please enter a reason for your request (required)..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_submit_request" 
                            string="Submit Request" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
