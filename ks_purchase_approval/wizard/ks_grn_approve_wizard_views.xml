<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_grn_approve_wizard_form_view" model="ir.ui.view">
        <field name="name">ks.grn.approve.wizard.form</field>
        <field name="model">ks.grn.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve GRN (Receipt)">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="ks_reason"
                           placeholder="Enter reason for approval (required)..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_submit_approval"
                            string="Approve"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
