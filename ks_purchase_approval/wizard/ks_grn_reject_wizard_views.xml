<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_grn_reject_wizard_form_view" model="ir.ui.view">
        <field name="name">ks.grn.reject.wizard.form</field>
        <field name="model">ks.grn.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject GRN (Receipt)">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="ks_reason"
                           placeholder="Enter reason for rejection (required)..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_submit_rejection"
                            string="Reject"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
