<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_approve_update_reason_wizard_form_view" model="ir.ui.view">
        <field name="name">ks.approve.update.reason.wizard.form</field>
        <field name="model">ks.approve.update.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Update">
                <group>
                    <field name="ks_purchase_order_id" readonly="1"/>
                    <field name="ks_reason" 
                           placeholder="Please enter a reason for approving this update (required)..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_submit_approval" 
                            string="Approve" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

