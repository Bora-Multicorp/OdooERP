<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_approval_confirmation_wizard_form_view" model="ir.ui.view">
        <field name="name">ks.approval.confirmation.wizard.form</field>
        <field name="model">ks.approval.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Approvers for Confirmation">
                <group>
                    <field name="ks_purchase_order_id" invisible="1"/>
                    <field name="ks_available_approver_1_ids" invisible="1"/>
                    <field name="ks_available_approver_2_ids" invisible="1"/>
                    <field name="ks_is_update_mode" invisible="1"/>
                    <field name="ks_pm1_already_approved" invisible="1"/>
                </group>
                <field name="ks_pm1_approved_status" widget="html" nolabel="1" readonly="1"
                       invisible="not ks_pm1_approved_status"/>
                <div class="alert alert-info" role="alert" style="margin: 16px;">
                    <p><strong>Please select approvers for confirmation approval:</strong></p>
                    <p invisible="not ks_is_two_way_approval">Both approvers are mandatory. Approval process is sequential (Approver 1 must approve before Approver 2).</p>
                    <p invisible="ks_is_two_way_approval">Only Approver 1 is required for Single Level Approval mode.</p>
                </div>
                <group>
                    <field name="ks_is_two_way_approval" invisible="1"/>
                    <field name="ks_approver_1_id"
                           options="{'no_create': True}"
                           domain="[('id', 'in', ks_available_approver_1_ids), ('share', '=', False), ('id', '!=', ks_approver_2_id)]"
                           required="1"
                           readonly="ks_pm1_already_approved"/>
                    <field name="ks_approver_2_id" 
                           options="{'no_create': True}"
                           domain="[('id', 'in', ks_available_approver_2_ids), ('share', '=', False), ('id', '!=', ks_approver_1_id)]"
                           required="ks_is_two_way_approval"
                           invisible="not ks_is_two_way_approval"/>
                </group>
                <footer>
                    <button name="action_confirm_send" 
                            string="Submit for Approval" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

