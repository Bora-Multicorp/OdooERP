<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_reject_reason_wizard_form_view" model="ir.ui.view">
        <field name="name">ks.reject.reason.wizard.form</field>
        <field name="model">ks.reject.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Rejection Reason">
                <group>
                    <field name="ks_purchase_order_id" readonly="1"/>
                    <field name="ks_rejection_type" invisible="1"/>
                    <field name="ks_rejection_type_label" string="Rejection Type" readonly="1"/>
                    <field name="ks_reason" 
                           placeholder="Please enter a reason for rejection (required)..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_submit_rejection" 
                            string="Confirm Rejection" 
                            type="object" 
                            class="btn-danger"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
