<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration Form View -->
    <record id="ks_purchase_approval_config_form_view" model="ir.ui.view">
        <field name="name">ks.purchase.approval.config.form</field>
        <field name="model">ks.purchase.approval.config</field>
        <field name="arch" type="xml">
            <form string="Purchase Approval Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>Purchase Order Approval Configuration</h1>
                    </div>
                    <group>
                        <field name="user_id" 
                               options="{'no_create': True}"
                               domain="[('share', '=', False)]"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="ks_confirm_approver_type" 
                               widget="radio" 
                               options="{'horizontal': true}"/>
                        <field name="ks_update_approver_type" 
                               widget="radio" 
                               options="{'horizontal': true}"/>
                        <field name="ks_cancel_approver_type" 
                               widget="radio" 
                               options="{'horizontal': true}"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong> 
                        <ul>
                            <li>Each user can be configured as Approver 1 or Approver 2 for each approval type (Confirmation, Update, Cancel).</li>
                            <li>The same user can be selected as both Approver 1 and Approver 2 for different approval types.</li>
                            <li>When submitting for approval, users will select approvers from the configured list.</li>
                            <li>Both approvers are mandatory and approval process is sequential (Approver 1 must approve before Approver 2).</li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Configuration Tree View -->
    <record id="ks_purchase_approval_config_tree_view" model="ir.ui.view">
        <field name="name">ks.purchase.approval.config.tree</field>
        <field name="model">ks.purchase.approval.config</field>
        <field name="arch" type="xml">
            <list string="Purchase Approval Configurations">
                <field name="user_id"/>
                <field name="ks_confirm_approver_type"/>
                <field name="ks_update_approver_type"/>
                <field name="ks_cancel_approver_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Configuration Action -->
    <record id="ks_purchase_approval_config_action" model="ir.actions.act_window">
        <field name="name">Approval Configuration</field>
        <field name="res_model">ks.purchase.approval.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1, 'default_active': True}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Purchase Order Approval Workflow
            </p>
            <p>
                Set up approvers for:
                <ul>
                    <li>PO Confirmation</li>
                    <li>PO Update Requests</li>
                    <li>PO Cancellation Requests</li>
                </ul>
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_ks_purchase_approval_config"
              name="Approval Configuration"
              parent="purchase.menu_purchase_config"
              action="ks_purchase_approval_config_action"
              sequence="5"
              groups="purchase.group_purchase_manager"/>
</odoo>

