<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Purchase Order Form View - Add Approval Buttons and Fields -->
    <record id="ks_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.ks.approval.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Add computed fields for button visibility (invisible) -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="ks_is_pm_user" invisible="1"/>
                <field name="ks_is_normal_user" invisible="1"/>
                <field name="ks_can_edit" invisible="1"/>
                <field name="ks_show_request_update_button" invisible="1"/>
                <field name="ks_show_request_cancel_button" invisible="1"/>
                <field name="ks_show_approve_confirm_button" invisible="1"/>
                <field name="ks_show_reject_confirm_button" invisible="1"/>
                <field name="ks_show_approve_update_button" invisible="1"/>
                <field name="ks_show_reject_update_button" invisible="1"/>
                <field name="ks_show_approve_cancel_button" invisible="1"/>
                <field name="ks_show_reject_cancel_button" invisible="1"/>
                <field name="ks_show_unlock_button" invisible="1"/>
                <field name="ks_show_complete_update_button" invisible="1"/>
                <field name="ks_update_approved" invisible="1"/>
                <field name="ks_confirm_pm1_approved" invisible="1"/>
                <field name="ks_confirm_pm2_approved" invisible="1"/>
                <field name="ks_update_pm1_approved" invisible="1"/>
                <field name="ks_update_pm2_approved" invisible="1"/>
                <field name="ks_cancel_pm1_approved" invisible="1"/>
                <field name="ks_cancel_pm2_approved" invisible="1"/>
                <field name="ks_update_request_user_id" invisible="1"/>
            </xpath>

            <!-- 
                Keep the original Confirm Order buttons visible - they work for everyone.
                PM users: Will confirm directly
                Normal users: Will go to Pending Approval (no popup)
                
                The "Send by Email" buttons (action_rfq_send) are overridden in Python
                to open our combined Email + WhatsApp wizard instead.
            -->

            <!-- Hide original Cancel button for normal users when PO is confirmed -->
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">state == 'purchase' and ks_is_normal_user</attribute>
            </xpath>

            <!-- Hide original Unlock button - we have our own controlled version -->
            <xpath expr="//button[@name='button_unlock']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add PM Approval Buttons and Custom Buttons -->
            <xpath expr="//button[@name='button_done']" position="before">
                <!-- ====== PM USER BUTTONS ====== -->
                
                <!-- Approve Confirmation Button (PM Users only) -->
                <button name="ks_action_approve_confirmation" 
                        type="object"
                        string="Approve Confirmation"
                        class="btn-success"
                        invisible="not ks_show_approve_confirm_button"
                        data-hotkey="v"/>
                
                <!-- Reject Confirmation Button (PM Users only) -->
                <button name="ks_action_reject_confirmation" 
                        type="object"
                        string="Reject Confirmation"
                        class="btn-danger"
                        invisible="not ks_show_reject_confirm_button"
                        data-hotkey="r"/>

                <!-- Approve Update Button (PM Users only) -->
                <button name="ks_action_approve_update" 
                        type="object"
                        string="Approve Update"
                        class="btn-success"
                        invisible="not ks_show_approve_update_button"
                        data-hotkey="v"/>
                
                <!-- Reject Update Button (PM Users only) -->
                <button name="ks_action_reject_update" 
                        type="object"
                        string="Reject Update"
                        class="btn-danger"
                        invisible="not ks_show_reject_update_button"
                        data-hotkey="r"/>

                <!-- Approve Cancel Button (PM Users only) -->
                <button name="ks_action_approve_cancel" 
                        type="object"
                        string="Approve Cancel"
                        class="btn-success"
                        invisible="not ks_show_approve_cancel_button"
                        data-hotkey="v"/>
                
                <!-- Reject Cancel Button (PM Users only) -->
                <button name="ks_action_reject_cancel" 
                        type="object"
                        string="Reject Cancel"
                        class="btn-danger"
                        invisible="not ks_show_reject_cancel_button"
                        data-hotkey="r"/>

                <!-- Unlock Button (PM Users only, when PO is locked/done) -->
                <button name="button_unlock" 
                        type="object" 
                        string="Unlock" 
                        invisible="not ks_show_unlock_button"
                        data-hotkey="l"/>

                <!-- ====== NORMAL USER BUTTONS ====== -->

                <!-- Request Update Button (Normal Users only, when PO is confirmed) -->
                <button name="ks_action_request_update" 
                        type="object"
                        string="Request Update"
                        class="btn-warning"
                        invisible="not ks_show_request_update_button"
                        data-hotkey="u"/>

                <!-- Request Cancel Button (Normal Users only, when PO is confirmed) -->
                <button name="ks_action_request_cancel" 
                        type="object"
                        string="Request Cancel"
                        class="btn-danger"
                        invisible="not ks_show_request_cancel_button"
                        data-hotkey="c"/>

                <!-- Complete Update Button (Normal user who requested update, after approval) -->
                <button name="ks_action_complete_update" 
                        type="object"
                        string="Complete Update"
                        class="btn-primary"
                        invisible="not ks_show_complete_update_button"
                        data-hotkey="d"/>
            </xpath>

            <!-- Update statusbar to show new states -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,pending_approval,purchase</attribute>
            </xpath>

            <!-- Add Approval Info Section in Other Information tab -->
            <xpath expr="//page[@name='purchase_delivery_invoice']//group[@name='other_info']" position="after">
                <group name="ks_approval_info" string="Approval Information" 
                       invisible="state not in ('pending_approval', 'update_requested', 'cancel_requested', 'purchase')">
                    <!-- Confirmation Request Info -->
                    <group string="Confirmation Request" 
                           invisible="state != 'pending_approval'">
                        <field name="ks_confirm_request_user_id" readonly="1"/>
                        <field name="ks_confirm_request_date" readonly="1"/>
                        <field name="ks_confirm_pm1_approved" readonly="1" widget="boolean" string="PM1 Approved"/>
                        <field name="ks_confirm_pm2_approved" readonly="1" widget="boolean" string="PM2 Approved"/>
                    </group>
                    
                    <!-- Update Request Info -->
                    <group string="Update Request" 
                           invisible="state != 'update_requested' and not ks_update_approved">
                        <field name="ks_update_request_user_id" readonly="1"/>
                        <field name="ks_update_request_date" readonly="1"/>
                        <field name="ks_update_request_reason" readonly="1"/>
                        <field name="ks_update_pm1_approved" readonly="1" widget="boolean" string="PM1 Approved"/>
                        <field name="ks_update_pm2_approved" readonly="1" widget="boolean" string="PM2 Approved"/>
                        <field name="ks_update_approved" readonly="1" widget="boolean" 
                               invisible="state != 'purchase'"
                               string="Currently Editable"/>
                    </group>
                    
                    <!-- Cancel Request Info -->
                    <group string="Cancel Request" 
                           invisible="state != 'cancel_requested'">
                        <field name="ks_cancel_request_user_id" readonly="1"/>
                        <field name="ks_cancel_request_date" readonly="1"/>
                        <field name="ks_cancel_request_reason" readonly="1"/>
                        <field name="ks_cancel_pm1_approved" readonly="1" widget="boolean" string="PM1 Approved"/>
                        <field name="ks_cancel_pm2_approved" readonly="1" widget="boolean" string="PM2 Approved"/>
                    </group>
                </group>
            </xpath>

            <!-- Make order lines readonly based on ks_can_edit -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">not ks_can_edit or state in ('done', 'cancel')</attribute>
            </xpath>

            <!-- Make partner_id readonly when not in edit mode -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or state in ('cancel', 'done', 'purchase', 'pending_approval', 'update_requested', 'cancel_requested')</attribute>
            </xpath>

            <!-- Make currency_id readonly when not in edit mode -->
            <xpath expr="//field[@name='currency_id'][@groups='base.group_multi_currency']" position="attributes">
                <attribute name="readonly">not ks_can_edit or state in ('cancel', 'done', 'purchase', 'pending_approval', 'update_requested', 'cancel_requested')</attribute>
            </xpath>

            <!-- Make date_order readonly when not in edit mode -->
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="readonly">not ks_can_edit or state in ('cancel', 'done', 'purchase', 'pending_approval', 'update_requested', 'cancel_requested')</attribute>
            </xpath>

        </field>
    </record>

    <!-- Inherit List View to show new states -->
    <record id="ks_purchase_order_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree.ks.approval.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="decoration-danger">state in ('pending_approval', 'update_requested', 'cancel_requested')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit Search View to add filters for new states -->
    <record id="ks_purchase_order_search_inherit" model="ir.ui.view">
        <field name="name">purchase.order.search.ks.approval.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_approve']" position="after">
                <filter name="pending_approval" string="Pending Approval" 
                        domain="[('state', '=', 'pending_approval')]"/>
                <filter name="update_requested" string="Update Requested" 
                        domain="[('state', '=', 'update_requested')]"/>
                <filter name="cancel_requested" string="Cancel Requested" 
                        domain="[('state', '=', 'cancel_requested')]"/>
            </xpath>
        </field>
    </record>

    <!-- Add banner for approval states -->
    <record id="ks_purchase_order_form_banner" model="ir.ui.view">
        <field name="name">purchase.order.form.ks.approval.banner</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <!-- Pending Approval Banner -->
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'pending_approval'">
                    <strong>⏳ Pending Approval:</strong> This Purchase Order is waiting for confirmation approval from PM1 and PM2.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_confirm_pm1_approved">✓ PM1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_confirm_pm1_approved">⏳ PM1 Pending</span>
                    &amp;nbsp;
                    <span class="badge bg-success" invisible="not ks_confirm_pm2_approved">✓ PM2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_confirm_pm2_approved">⏳ PM2 Pending</span>
                </div>

                <!-- Update Requested Banner -->
                <div class="alert alert-info mb-0" role="alert"
                     invisible="state != 'update_requested'">
                    <strong>📝 Update Requested:</strong> This Purchase Order is waiting for update approval from PM1 and PM2.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_update_pm1_approved">✓ PM1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_update_pm1_approved">⏳ PM1 Pending</span>
                    &amp;nbsp;
                    <span class="badge bg-success" invisible="not ks_update_pm2_approved">✓ PM2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_update_pm2_approved">⏳ PM2 Pending</span>
                </div>

                <!-- Cancel Requested Banner -->
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="state != 'cancel_requested'">
                    <strong>🚫 Cancellation Requested:</strong> This Purchase Order is waiting for cancel approval from PM1 and PM2.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_cancel_pm1_approved">✓ PM1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_cancel_pm1_approved">⏳ PM1 Pending</span>
                    &amp;nbsp;
                    <span class="badge bg-success" invisible="not ks_cancel_pm2_approved">✓ PM2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_cancel_pm2_approved">⏳ PM2 Pending</span>
                </div>

                <!-- Update Approved Banner (Editable Mode for the requester) -->
                <div class="alert alert-success mb-0" role="alert"
                     invisible="not ks_show_complete_update_button">
                    <strong>✏️ Edit Mode:</strong> Update has been approved. You can now edit this Purchase Order. 
                    Click <strong>"Complete Update"</strong> when done to lock the PO again.
                </div>

                <!-- Locked PO Banner for Normal Users -->
                <div class="alert alert-secondary mb-0" role="alert"
                     invisible="state != 'purchase' or ks_is_pm_user or ks_update_approved">
                    <strong>🔒 Locked:</strong> This Purchase Order is confirmed and locked. 
                    Use <strong>"Request Update"</strong> to request edit permission or <strong>"Request Cancel"</strong> to request cancellation.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
