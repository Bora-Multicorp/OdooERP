<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Purchase Order Form View - Add Approval Buttons and Fields -->
    <record id="ks_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.ks.approval.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Add computed fields for button visibility (invisible) -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="ks_is_pm_user" invisible="1"/>
                <field name="ks_is_normal_user" invisible="1"/>
                <field name="ks_can_edit" invisible="1"/>
                <field name="ks_show_request_approval_button" invisible="1"/>
                <field name="ks_show_approve_button" invisible="1"/>
                <field name="ks_show_reject_button" invisible="1"/>
                <field name="ks_show_unlock_button" invisible="1"/>
                <field name="ks_show_request_cancel_button" invisible="1"/>
                <field name="ks_show_approve_cancel_button" invisible="1"/>
                <field name="ks_show_reject_cancel_button" invisible="1"/>
                <field name="ks_show_request_edit_button" invisible="1"/>
                <field name="ks_show_approve_edit_button" invisible="1"/>
                <field name="ks_show_reject_edit_button" invisible="1"/>
                <field name="ks_show_complete_edit_button" invisible="1"/>
                <field name="ks_pm1_approved" invisible="1"/>
                <field name="ks_pm2_approved" invisible="1"/>
                <field name="ks_cancel_pm1_approved" invisible="1"/>
                <field name="ks_cancel_pm2_approved" invisible="1"/>
                <field name="ks_edit_pm1_approved" invisible="1"/>
                <field name="ks_edit_pm2_approved" invisible="1"/>
                <field name="ks_edit_approved" invisible="1"/>
            </xpath>

            <!-- 
                Keep the original Confirm Order buttons visible - they work for everyone.
                PM users: Will confirm directly
                Normal users: Will go to Pending Approval (no popup)
                
                The "Send by Email" buttons (action_rfq_send) use the base Odoo email functionality.
            -->

            <!-- Hide original Cancel button based on state and user type -->
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">
                    state in ('cancel', 'draft') or (ks_is_normal_user and state in ('pending_approval', 'purchase', 'done'))
                </attribute>
            </xpath>

            <!-- Hide original Unlock button - we have our own controlled version -->
            <xpath expr="//button[@name='button_unlock']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_done']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>


            <!-- Add PM Approval Buttons and Custom Buttons -->
            <xpath expr="//button[@name='button_done']" position="before">
                <!-- ====== PM USER BUTTONS ====== -->

                <!-- Approve Button (PM Users only) -->
                <button name="ks_action_approve"
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="not ks_show_approve_button"
                        data-hotkey="v"/>

                <!-- Reject Button (PM Users only) -->
                <button name="ks_action_reject"
                        type="object"
                        string="Reject"
                        class="btn-danger"
                        invisible="not ks_show_reject_button"
                        data-hotkey="r"/>

                <!-- Unlock Button (PM Users only, when PO is locked/done) -->
                <button name="button_unlock"
                        type="object"
                        string="Unlock"
                        invisible="not ks_show_unlock_button"
                        data-hotkey="l"/>

                <!-- ====== NORMAL USER BUTTONS ====== -->

                <!-- Request Cancel Button (Normal Users only, when PO is confirmed) -->
                <button name="action_cancel"
                        type="object"
                        string="Request Cancel"
                        class="btn-warning"
                        invisible="not ks_show_request_cancel_button"
                        data-hotkey="c"/>

                <!-- Request Edit Button (Normal Users only, when PO is confirmed) -->
                <button name="ks_action_request_edit" 
                        type="object"
                        string="Request Edit"
                        class="btn-info"
                        invisible="not ks_show_request_edit_button"
                        data-hotkey="e"/>

                <!-- Complete Edit Button (Normal user who requested edit, after approval) -->
                <button name="ks_action_complete_edit" 
                        type="object"
                        string="Complete Edit"
                        class="btn-primary"
                        invisible="not ks_show_complete_edit_button"
                        data-hotkey="d"/>

                <!-- ====== APPROVER BUTTONS FOR CANCEL ====== -->
                
                <!-- Approve Cancel Button (Approvers only) -->
                <button name="ks_action_approve_cancel"
                        type="object"
                        string="Approve Cancel"
                        class="btn-success"
                        invisible="not ks_show_approve_cancel_button"/>

                <!-- Reject Cancel Button (Approvers only) -->
                <button name="ks_action_reject_cancel"
                        type="object"
                        string="Reject Cancel"
                        class="btn-danger"
                        invisible="not ks_show_reject_cancel_button"/>

                <!-- ====== APPROVER BUTTONS FOR EDIT ====== -->
                
                <!-- Approve Edit Button (Approvers only) -->
                <button name="ks_action_approve_edit"
                        type="object"
                        string="Approve Edit"
                        class="btn-success"
                        invisible="not ks_show_approve_edit_button"/>

                <!-- Reject Edit Button (Approvers only) -->
                <button name="ks_action_reject_edit"
                        type="object"
                        string="Reject Edit"
                        class="btn-danger"
                        invisible="not ks_show_reject_edit_button"/>
            </xpath>

            <!-- Update statusbar to show new states -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,pending_approval,cancel_pending,edit_pending,purchase</attribute>
            </xpath>

            <!-- Add banner for approval states -->
            <xpath expr="//sheet" position="before">
                <!-- Pending Approval Banner -->
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'pending_approval'">
                    <strong>⏳ Pending Approval:</strong>
                    This Purchase Order is waiting for approval from Approver 1 and Approver 2.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_pm1_approved">✓ Approver 1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_pm1_approved">⏳ Approver 1 Pending</span>
                    &amp;nbsp;
                    <span class="badge bg-success" invisible="not ks_pm2_approved">✓ Approver 2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_pm2_approved">⏳ Approver 2 Pending</span>
                </div>

                <!-- Cancel Pending Banner -->
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="state != 'cancel_pending'">
                    <strong>🚫 Cancel Pending:</strong> This Purchase Order is waiting for cancellation approval.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_cancel_pm1_approved">✓ Approver 1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_cancel_pm1_approved">⏳ Approver 1 Pending</span>
                    &amp;nbsp;
                    <span class="badge bg-success" invisible="not ks_cancel_pm2_approved">✓ Approver 2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_cancel_pm2_approved">⏳ Approver 2 Pending</span>
                </div>

                <!-- Edit Pending Banner -->
                <div class="alert alert-info mb-0" role="alert"
                     invisible="state != 'edit_pending'">
                    <strong>📝 Edit Pending:</strong> This Purchase Order is waiting for edit approval.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_edit_pm1_approved">✓ Approver 1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_edit_pm1_approved">⏳ Approver 1 Pending</span>
                    &amp;nbsp;
                    <span class="badge bg-success" invisible="not ks_edit_pm2_approved">✓ Approver 2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_edit_pm2_approved">⏳ Approver 2 Pending</span>
                </div>

                <!-- Edit Approved Banner (Editable Mode for the requester) -->
                <div class="alert alert-success mb-0" role="alert"
                     invisible="not ks_show_complete_edit_button">
                    <strong>✏️ Edit Mode:</strong> Edit has been approved. You can now edit this Purchase Order. 
                    Click <strong>"Complete Edit"</strong> when done to lock the PO again.
                </div>

                <!-- Locked PO Banner for Normal Users -->
                <div class="alert alert-secondary mb-0" role="alert"
                     invisible="state != 'purchase' or ks_is_pm_user or ks_edit_approved">
                    <strong>🔒 Confirmed:</strong>
                    This Purchase Order is confirmed. Use <strong>"Request Edit"</strong> to request edit permission or <strong>"Request Cancel"</strong> to request cancellation.
                </div>
            </xpath>

            <!-- Make order lines readonly based on ks_can_edit -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">not ks_can_edit or state in ('done', 'cancel')</attribute>
            </xpath>

            <!-- Make partner_id readonly when not in edit mode -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or state in ('cancel', 'done', 'purchase', 'pending_approval')</attribute>
            </xpath>

            <!-- Make currency_id readonly when not in edit mode -->
            <xpath expr="//field[@name='currency_id'][@groups='base.group_multi_currency']" position="attributes">
                <attribute name="readonly">not ks_can_edit or state in ('cancel', 'done', 'purchase', 'pending_approval')</attribute>
            </xpath>

            <!-- Make date_order readonly when not in edit mode -->
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="readonly">not ks_can_edit or state in ('cancel', 'done', 'purchase', 'pending_approval')</attribute>
            </xpath>

            <!-- Add Linked Sale Orders field -->
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="ks_linked_sale_order_ids" 
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"
                       readonly="state in ('done', 'cancel')"
                       domain="[('state', 'in', ('sale', 'done'))]"
                       placeholder="Select Sale Orders..."/>
            </xpath>

        </field>
    </record>

    <!-- Inherit List View to show new states -->
    <record id="ks_purchase_order_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree.ks.approval.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="decoration-danger">state == 'pending_approval'</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit Search View to add filters for new states -->
    <record id="ks_purchase_order_search_inherit" model="ir.ui.view">
        <field name="name">purchase.order.search.ks.approval.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_approve']" position="after">
                <filter name="pending_approval" string="Pending Approval"
                        domain="[('state', '=', 'pending_approval')]"/>
            </xpath>
        </field>
    </record>

</odoo>
