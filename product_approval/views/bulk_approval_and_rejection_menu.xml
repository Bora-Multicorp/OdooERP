<odoo>
    <data>
            <record id="action_bulk_submit_for_approval" model="ir.actions.server">
            <field name="name">Submit for Approvals</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">
# Instead of directly calling bulk_approval, open the confirmation wizard
action = env.ref('product_approval.action_open_product_bulk_submit_for_approval_wizard').sudo().copy_data()[0]
# Pass active_ids from the server action context to the window action context
action['context'] = {'active_ids': records.ids}
            </field>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_view_types">list</field>
            <field name="sequence">5</field>
        </record>
