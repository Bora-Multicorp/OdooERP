<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bora_vendor_bill_approval_move_form" model="ir.ui.view">
        <field name="name">bora.vendor.bill.approval.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Hidden computed fields needed for button visibility and banners.
                 bora_is_debit_note avoids re-declaring debit_origin_id (added by
                 bora_debit_note_approval) and lets us scope all vendor-bill UI to
                 real bills only. -->
            <xpath expr="//sheet" position="before">
                <field name="bora_is_debit_note" invisible="1"/>
                <field name="bora_is_bill_pm_user" invisible="1"/>
                <field name="bora_is_bill_admin" invisible="1"/>
                <field name="bora_is_bill_dual_approval" invisible="1"/>
                <field name="bora_bill_approved" invisible="1"/>
                <field name="bora_show_bill_approve_button" invisible="1"/>
                <field name="bora_show_bill_reject_button" invisible="1"/>
                <field name="bora_show_bill_update_button" invisible="1"/>
                <field name="bora_bill_pm1_id" invisible="1"/>
                <field name="bora_bill_pm2_id" invisible="1"/>
                <field name="bora_bill_pm1_approved" invisible="1"/>
                <field name="bora_bill_pm2_approved" invisible="1"/>
                <field name="bora_bill_request_user_id" invisible="1"/>
            </xpath>

            <!-- Approval action buttons before the Confirm button.
                 All guarded by "not bora_is_debit_note" so they never appear
                 on debit notes (those are handled by bora_debit_note_approval). -->
            <xpath expr="//button[@name='action_post']" position="before">

                <!-- Re-open wizard when stuck in bill_approval_pending with no PM1 -->
                <button name="bora_action_request_bill_approval"
                        string="Select Approvers"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'bill_approval_pending' or bora_bill_pm1_id or bora_is_debit_note"/>

                <!-- Update approvers (original requester while pending) -->
                <button name="action_update_bill_approvers"
                        string="Update Approvers"
                        type="object"
                        class="btn-warning"
                        invisible="not bora_show_bill_update_button"
                        confirm="This will cancel the current approval request and let you choose new approvers. Continue?"/>

                <!-- Approve button (visible to assigned PM) -->
                <button name="bora_action_approve_bill"
                        string="Approve"
                        type="object"
                        class="btn-success"
                        invisible="not bora_show_bill_approve_button"/>

                <!-- Reject button (visible to assigned PM) -->
                <button name="bora_action_reject_bill"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        invisible="not bora_show_bill_reject_button"/>
            </xpath>

            <!-- Hide the Confirm button while ANY approval is pending.
                 Covers both pending states so the last-loaded module always hides
                 Confirm correctly regardless of install order. -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible">state in ('bill_approval_pending', 'debit_note_approval_pending', 'journal_entry_approval_pending', 'invoice_approval_pending')</attribute>
            </xpath>

            <!-- Status bar: only list the common milestone states.
                 Odoo always adds the CURRENT state even if not listed here,
                 so bill_approval_pending only appears when the record is in that
                 state — it never shows on debit notes. -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,posted,cancel</attribute>
            </xpath>

            <!-- Banners — gated on move_type == 'in_invoice' AND not bora_is_debit_note
                 so they are strictly limited to real vendor bills. -->
            <xpath expr="//sheet" position="before">

                <!-- Approval Pending banner -->
                <div class="alert alert-warning mb-0"
                     invisible="move_type != 'in_invoice' or bora_is_debit_note or state != 'bill_approval_pending'"
                     role="alert">
                    <strong>⏳ Bill Approval Pending</strong> — This vendor bill is waiting for approver confirmation.
                    <br/>
                    <span invisible="not bora_bill_pm1_id">
                        <strong>PM1 (<field name="bora_bill_pm1_id" readonly="1" nolabel="1" class="d-inline"/>):</strong>
                        <span invisible="bora_bill_pm1_approved"> ⏳ Pending</span>
                        <span invisible="not bora_bill_pm1_approved"> ✅ Approved</span>
                    </span>
                    <span invisible="not bora_bill_pm2_id">
                        &#160;&#160;|&#160;&#160;
                        <strong>PM2 (<field name="bora_bill_pm2_id" readonly="1" nolabel="1" class="d-inline"/>):</strong>
                        <span invisible="bora_bill_pm2_approved"> ⏳ Pending</span>
                        <span invisible="not bora_bill_pm2_approved"> ✅ Approved</span>
                    </span>
                </div>

                <!-- Approved banner -->
                <div class="alert alert-success mb-0"
                     invisible="move_type != 'in_invoice' or bora_is_debit_note or not bora_bill_approved or state == 'posted' or bora_is_bill_admin or bora_is_bill_pm_user"
                     role="alert">
                    ✅ <strong>Approved</strong> — Your vendor bill has been approved and is being confirmed.
                </div>

                <!-- Approval Required info banner -->
                <div class="alert alert-info mb-0"
                     invisible="move_type != 'in_invoice' or bora_is_debit_note or state != 'draft' or bora_bill_approved or bora_is_bill_admin or bora_is_bill_pm_user"
                     role="alert">
                    🔒 <strong>Approval Required</strong> — Click <strong>Confirm</strong> to submit this vendor bill for approval.
                </div>

            </xpath>

            <!-- Bill Approval History tab — scoped to real vendor bills only -->
            <xpath expr="//notebook" position="inside">
                <page string="Bill Approval" name="bill_approval_history"
                      invisible="move_type != 'in_invoice' or bora_is_debit_note or (state != 'bill_approval_pending' and not bora_bill_pm1_id)">
                    <group>
                        <group string="Approval Request">
                            <field name="bora_bill_request_user_id" string="Requested By" readonly="1"/>
                            <field name="bora_bill_request_date" string="Request Date" readonly="1"/>
                            <field name="bora_bill_request_reason" string="Reason" readonly="1"/>
                        </group>
                        <group string="Approvers">
                            <field name="bora_bill_pm1_id" string="Approver 1 (PM1)" readonly="1"/>
                            <field name="bora_bill_pm1_approved" string="PM1 Approved" readonly="1"/>
                            <field name="bora_bill_pm2_id" string="Approver 2 (PM2)" readonly="1"
                                   invisible="not bora_bill_pm2_id"/>
                            <field name="bora_bill_pm2_approved" string="PM2 Approved" readonly="1"
                                   invisible="not bora_bill_pm2_id"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
