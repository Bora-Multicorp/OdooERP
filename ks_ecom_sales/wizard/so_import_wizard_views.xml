<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ks_so_import_wizard_form" model="ir.ui.view">
        <field name="name">ks.so.import.wizard.form</field>
        <field name="model">ks.so.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Sale Orders (E-com)">
                <group>
                    <group string="Upload XLSX File">
                        <field name="file_name" placeholder="example.xlsx"/>
                        <field name="file_data" filename="file_name"/>
                    </group>
                    <group string="Expected Columns">
                        <div colspan="2" class="text-muted">
                            <p>
                                <strong>Required:</strong> Order ID, ASIN, Quantity
                            </p>
                            <p>
                                <strong>Optional:</strong>
                                Order Date, Customer, Rate, Total Amount, Discount, TAX,
                                Warehouse, Company, Title, Invoice Amount, Invoice ID,
                                Invoice Date, Shipment Id, Shipment Date, Shipment Charges,
                                Shipping Address
                            </p>
                        </div>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_import_sale_orders"
                        string="Import"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="action_download_template"
                        string="Download Template"
                        type="object"
                        class="btn-secondary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ks_so_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Sale Orders (E-com)</field>
        <field name="res_model">ks.so.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ks_so_import_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
