<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_po_receipt_import_wizard_form" model="ir.ui.view">
        <field name="name">ks.po.receipt.import.wizard.form</field>
        <field name="model">ks.po.receipt.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import XLSX Receipt Data">
                <sheet>
                    <group>
                        <group>
                            <field name="file_name" placeholder="example.xlsx"/>
                            <field name="file_data" filename="file_name" widget="binary" 
                                   options="{'accept': '.xlsx'}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p><strong>Instructions:</strong></p>
                        <ul>
                            <li>Upload an XLSX file containing receipt data</li>
                            <li>Required columns: Order ID, ASIN, Quantity Done</li>
                            <li>The system will match Purchase Orders by Order ID and update receipt quantities by ASIN</li>
                        </ul>
                    </div>
                </sheet>
                <footer>
                    <button name="action_import_receipt_data" string="Import Receipt Data" 
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_po_receipt_import_wizard" model="ir.actions.act_window">
        <field name="name">Import XLSX Receipt Data</field>
        <field name="res_model">ks.po.receipt.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

