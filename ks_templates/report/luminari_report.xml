<odoo>
<record id="paperformat_luminari_saleorder" model="report.paperformat">
            <field name="name">US Letter</field>
            <field name="default" eval="True" />
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
            <field name="css_margins" eval="True" />
        </record>
    <!-- Define the new report action for sale order -->
    <record id="action_report_luminari_dubai" model="ir.actions.report">
        <field name="name">Commercial Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.report_luminari_invoice</field>
        <field name="report_file">ks_templates.report_luminari_invoice</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Commercial Invoice - %s' % (object.name)) or 'Commercial Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="paperformat_id" ref="paperformat_luminari_saleorder"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_luminari_invoice">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="doc">
        <main>
        <t t-set="lum_sale" t-value="doc.get_sale_order_info()"/>
        <t t-set="sale_order" t-value="lum_sale"/>
        <t t-set="consignee_partner" t-value="doc.partner_shipping_id or doc.partner_id"/>

        <!-- SINGLE UNIFIED TABLE -->
        <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:11px;">

            <!-- TITLE ROW -->
            <tr>
                <td style="text-align:center; border:1px solid #000; font-weight:bold; font-size:14px; padding:6px;" colspan="7">
                    Commercial Invoice
                </td>
            </tr>

            <!-- COMPANY INFO + INVOICE DETAILS ROW -->
            <tr>
                <!-- LEFT SIDE -->
                <td style="width:55%; vertical-align:top; border:1px solid #000; padding:6px;" colspan="4">
                    <strong><t t-esc="doc.company_id.name or 'BORA ELECTRONICS FZCO'"/></strong><br/>
                    <t t-if="doc.company_id.partner_id.street" t-esc="doc.company_id.partner_id.street"/>
                    <t t-if="doc.company_id.partner_id.street and doc.company_id.partner_id.street2">, </t>
                    <t t-if="doc.company_id.partner_id.street2" t-esc="doc.company_id.partner_id.street2"/>
                    <t t-if="(doc.company_id.partner_id.street or doc.company_id.partner_id.street2) and doc.company_id.partner_id.city">, </t>
                    <t t-if="doc.company_id.partner_id.city" t-esc="doc.company_id.partner_id.city"/>
                    <t t-if="doc.company_id.partner_id.city and doc.company_id.partner_id.country_id">, </t>
                    <t t-if="doc.company_id.partner_id.country_id" t-esc="doc.company_id.partner_id.country_id.name or ''"/>
                    <t t-if="doc.company_id.partner_id.zip"> P.O.Box <t t-esc="doc.company_id.partner_id.zip"/></t><br/>
                    <t t-if="doc.company_id.partner_id.state_id">
                        <t t-if="doc.company_id.partner_id.country_id.code == 'IN'">State : </t>
                        <t t-else="">Emirate : </t>
                        <t t-esc="doc.company_id.partner_id.state_id.name or ''"/><br/>
                    </t>
                    <t t-if="doc.company_id.vat">
                        <t t-if="doc.company_id.partner_id.country_id.code == 'IN'">GSTN : </t>
                        <t t-else="">TRN : </t>
                        <t t-esc="doc.company_id.vat"/><br/>
                    </t>
                    <t t-if="doc.company_id.partner_id.country_id.code == 'IN'">
                        <t t-set="company_pan" t-value="doc.get_company_pan()"/>
                        <t t-if="company_pan">PAN : <t t-esc="company_pan"/><br/></t>
                        <t t-set="company_iec" t-value="doc.get_company_iec()"/>
                        <t t-if="company_iec">IEC No : <t t-esc="company_iec"/><br/></t>
                    </t>
                    <t t-if="doc.company_id.partner_id.email">E-Mail : <t t-esc="doc.company_id.partner_id.email"/></t>
                    <div style="border-top:1px solid black;height:1px;"/>

                    Consignee<br/>
                    <strong><t t-esc="consignee_partner.name or 'Captains Freight Services FZCO'"/></strong><br/>
                    <t t-if="consignee_partner.street" t-esc="consignee_partner.street"/>
                    <t t-if="consignee_partner.street and consignee_partner.street2">, </t>
                    <t t-if="consignee_partner.street2" t-esc="consignee_partner.street2"/>
                    <t t-if="(consignee_partner.street or consignee_partner.street2) and consignee_partner.city">, </t>
                    <t t-if="consignee_partner.city" t-esc="consignee_partner.city"/>
                    <t t-if="consignee_partner.city and consignee_partner.country_id">, </t>
                    <t t-if="consignee_partner.country_id" t-esc="consignee_partner.country_id.name or ''"/>
                    <t t-if="lum_sale and lum_sale.ks_zone == 'india' and consignee_partner.l10n_in_pan">
                        <br/>PAN : <t t-esc="consignee_partner.l10n_in_pan"/>
                    </t>
                    <br/>
                    <br/>
                    <div style="border-top:1px solid black;height:1px;"/>
                    Buyer<br/>
                    <strong><t t-esc="doc.partner_id.name or 'LUMINARI TRADING FZCO'"/></strong><br/>
                    <t t-if="doc.partner_id.street" t-esc="doc.partner_id.street"/>
                    <t t-if="doc.partner_id.street and doc.partner_id.street2">, </t>
                    <t t-if="doc.partner_id.street2" t-esc="doc.partner_id.street2"/>
                    <t t-if="(doc.partner_id.street or doc.partner_id.street2) and doc.partner_id.city">, </t>
                    <t t-if="doc.partner_id.city" t-esc="doc.partner_id.city"/>
                    <t t-if="doc.partner_id.city and doc.partner_id.country_id">, </t>
                    <t t-if="doc.partner_id.country_id" t-esc="doc.partner_id.country_id.name or ''"/><br/>
                    <t t-if="doc.partner_id.state_id">
                        Emirate : <t t-esc="doc.partner_id.state_id.name or ''"/><br/>
                    </t>
                    <t t-if="doc.partner_id.country_id">
                        Country : <t t-esc="doc.partner_id.country_id.name or ''"/>
                    </t>
                    <t t-if="lum_sale and lum_sale.ks_zone == 'india' and doc.partner_id.l10n_in_pan">
                        <br/>PAN : <t t-esc="doc.partner_id.l10n_in_pan"/>
                    </t>
                </td>

                <!-- RIGHT SIDE -->
                <td style="width:45%; vertical-align:top; padding:0; border:1px solid #000;" colspan="3">
                    <table style="width:100%; border-collapse:collapse; border-color:white;">
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;">Invoice No.</td>
                            <td style="padding:1px;" colspan="3">Dated</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong><t t-esc="doc.name or ''"/></strong></td>
                            <td style="border-left:1px solid #000; padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.invoice_date" t-esc="doc.invoice_date.strftime('%d-%b-%y')"/>
                                    <t t-elif="doc.date" t-esc="doc.date.strftime('%d-%b-%y')"/>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Delivery Note</td>
                            <td style="border-left:1px solid #000; border-right:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Mode/Terms of Payment</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><t t-esc="doc.ks_delivery_note or ''"/></td>
                            <td style="border-right:1px solid #000; padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.invoice_payment_term_id" t-esc="doc.invoice_payment_term_id.name or ''"/>
                                    <t t-else="">FOB DUBAI</t>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Supplier's Ref.</td>
                            <td style="border-left:1px solid #000; border-right:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Other Reference(s)</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong><t t-esc="doc.ks_supplier_reference or ''"/></strong></td>
                            <td style="border-right:1px solid #000; padding:1px;" colspan="3"><strong><t t-esc="doc.invoice_user_id.name or ''"/></strong></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Buyer's Order No.</td>
                            <td style="border-left:1px solid #000; border-right:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Dated</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;">
                                <t t-if="sale_order" t-esc="sale_order.name or ''"/>
                            </td>
                            <td style="border-right:1px solid #000; padding:1px;" colspan="3">
                                <t t-if="sale_order and sale_order.date_order" t-esc="sale_order.date_order.strftime('%d-%b-%y')"/>
                                <t t-elif="sale_order and sale_order.create_date" t-esc="sale_order.create_date.strftime('%d-%b-%y')"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Despatch Document No.</td>
                            <td style="border-left:1px solid #000; border-right:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Delivery Note Date</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><t t-esc="doc.ks_despatch_document_no or ''"/></td>
                            <td style="border-right:1px solid #000; padding:1px;" colspan="3">
                                <t t-if="doc.ks_delivery_note_date" t-esc="doc.ks_delivery_note_date.strftime('%d-%b-%y')"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Despatch through</td>
                            <td style="border-left:1px solid #000; border-right:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Destination</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><t t-esc="doc.ks_despatched_through or ''"/></td>
                            <td style="border-right:1px solid #000; padding:1px;" colspan="3"><t t-esc="doc.ks_city_port_of_discharge or ''"/></td>
                        </tr>
                        <tr>
                            <td style="border-top:1px solid #000; padding:1px;" colspan="3"><strong>Terms of Delivery</strong></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="lum_sale and lum_sale.incoterm">
                                        [<t t-esc="lum_sale.incoterm.code or ''"/>] <t t-esc="lum_sale.incoterm.name or ''"/>
                                        <t t-if="lum_sale.incoterm_location">, <t t-esc="lum_sale.incoterm_location or ''"/></t>
                                    </t>
                                </strong>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <!-- PRODUCT TABLE HEADER (merged — no separate table) -->
            <tr>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:5%;">Sl No.</th>
                <th style="border:1px solid #000; padding:4px; text-align:left; background-color:#f0f0f0; width:35%;">Description of Goods</th>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:10%;">HSN/SAC</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:11%;">Quantity</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:15%;">Rate</th>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:8%;">Per</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:16%;">Amount</th>
            </tr>

            <!-- PRODUCT LINES -->
            <t t-set="line_num" t-value="0"/>
            <t t-set="total_qty" t-value="0"/>
            <t t-foreach="doc.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">
                <t t-set="line_num" t-value="line_num + 1"/>
                <t t-set="total_qty" t-value="total_qty + line.quantity"/>
                <tr>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line_num"/>
                    <td style="border:1px solid #000; padding:4px;">
                        <strong><t t-esc="line.name or ''"/></strong>
                        <t t-set="made_in_country" t-value="(line.sale_line_ids and line.sale_line_ids[0].made_in_country_id) or (line.purchase_line_id and line.purchase_line_id.made_in_country_id) or (line.product_id and line.product_id.product_tmpl_id.made_country)"/>
                        <t t-if="made_in_country">
                            <br/>(Made <t t-esc="'in ' + (made_in_country.name or '')"/>
                            <t t-if="line.product_id.product_tmpl_id.ks_unlocked">, Unlocked</t>)
                        </t>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:center;"><t t-esc="doc.get_line_hsn_code(line)"/></td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <strong><t t-esc="doc.format_number(line.quantity, digits=0)"/> pcs</strong>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <strong><t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_unit, digits=2)"/></strong>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line.product_uom_id.name or 'pcs'"/>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <strong><t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_subtotal, digits=2)"/></strong>
                    </td>
                </tr>
            </t>

            <!-- TOTAL ROW -->
            <tr>
                <td colspan="6" style="border:1px solid #000; padding:4px; text-align:right;"><strong>Total</strong></td>

                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <strong><t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(doc.amount_total, digits=2)"/></strong>
                </td>
            </tr>

            <!-- CURRENCY CONVERSION LINE -->
            <t t-set="lum_inv_currency" t-value="doc.currency_id"/>
            <t t-set="lum_comp_currency" t-value="doc.company_id.currency_id"/>
            <t t-set="lum_conversion_date" t-value="doc.invoice_date or doc.date or doc.create_date.date()"/>
            <t t-set="lum_invoice_currency_rate" t-value="doc.invoice_currency_rate or 1.0"/>
            <t t-set="lum_total_amount" t-value="doc.amount_total"/>
            <t t-set="lum_converted_amount" t-value="lum_total_amount"/>
            <t t-if="lum_inv_currency and lum_comp_currency and lum_inv_currency != lum_comp_currency">
                <t t-set="lum_converted_amount" t-value="lum_inv_currency._convert(lum_total_amount, lum_comp_currency, doc.company_id, lum_conversion_date, round=True)"/>
            </t>
            <t t-if="lum_inv_currency and lum_comp_currency and lum_inv_currency != lum_comp_currency">
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:right;" colspan="7">
                    <strong>
                        <t t-set="lum_exchange_rate" t-value="1.0 / lum_invoice_currency_rate if lum_invoice_currency_rate else 1.0"/>
                        Total Invoice Amount in <t t-esc="lum_inv_currency.name or 'USD'"/> <t t-esc="doc.format_number(lum_total_amount, digits=2)"/> @ <t t-esc="lum_comp_currency.name or 'INR'"/> <t t-esc="doc.format_number(lum_invoice_currency_rate, digits=4)"/> / 1 <t t-esc="lum_comp_currency.name or 'INR'"/> = <t t-esc="doc.format_number(lum_exchange_rate, digits=4)"/> <t t-esc="lum_inv_currency.name or 'USD'"/>
                    </strong>
                </td>
            </tr>
            </t>

            <!-- AMOUNT IN WORDS -->
            <tr>
                <td style="border:1px solid #000; padding:6px;" colspan="7">
                    Amount Chargeable (in words)<br/>
                    <strong>
                        <t t-set="invoice_amount_words" t-value="doc.get_amount_in_words_currency(lum_total_amount, lum_inv_currency)"/>
                        <t t-esc="invoice_amount_words or ''"/>
                    </strong>
                </td>
            </tr>

            <!-- REMARKS + DECLARATION + BANK DETAILS + SIGNATORY ROW -->
            <tr>
                <td style="border:1px solid #000; padding:6px; vertical-align:top;" colspan="4">
                    <t t-if="lum_sale and lum_sale.ks_remarks">
                        <strong>Remarks</strong><br/>
                        <t t-esc="lum_sale.ks_remarks"/><br/><br/>
                    </t>
                    <t t-if="lum_sale and lum_sale.note">
                        <strong>Declaration</strong><br/>
                        <span t-out="lum_sale.note"/>
                    </t>
                </td>
                <td style="border:1px solid #000; padding:6px; vertical-align:top;" colspan="3">
                    <t t-set="inv_bank" t-value="doc.ks_bank_id"/>
                    <strong>Company's Bank Details</strong><br/>
                    1. Bank Name : <strong><t t-esc="inv_bank.name if inv_bank else ''"/></strong><br/>
                    2. Account Number (A/c No.) : <strong><t t-esc="inv_bank.bic if inv_bank else ''"/></strong><br/>
                    3. IFSC Code : <strong><t t-esc="inv_bank.ifsc_code if inv_bank else ''"/></strong><br/>
                    4. Branch &amp; SWIFT Code : <strong>
                        <t t-esc="inv_bank.city if inv_bank else ''"/>
                        <t t-if="inv_bank and inv_bank.city and (inv_bank.swift_code or inv_bank.bic)"> / </t>
                        <t t-esc="(inv_bank.swift_code or inv_bank.bic) if inv_bank else ''"/>
                    </strong><br/>
                    <div style="border-top:1px solid #000; margin-top:20px;"/>
                    <div style="text-align:right; margin-top:10px;">
                        <t t-if="lum_sale and lum_sale.ks_authorized_signature">
                            <img t-att-src="image_data_uri(lum_sale.ks_authorized_signature)"
                                 style="max-height:60px; max-width:180px; display:block; margin:0 0 4px auto;"/>
                        </t>
                        Authorised Signatory<br/><br/>
                        For <strong><t t-esc="doc.company_id.name or 'BORA ELECTRONICS FZCO'"/></strong>
                    </div>
                </td>
            </tr>

        </table>

        </main>
        <footer class="pt-0">

                <p style="text-align:center; font-size:10px;">
                    This is a Computer Generated Invoice
                </p>

         </footer>
        </t>
    </t>
</template>



</odoo>