<odoo>

    <record id="action_report_domestic_tax_invoice_inr_converted" model="ir.actions.report">
        <field name="name">Domestic Sales - Tax Invoice (INR Converted)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.domestic_tax_invoice_inr_converted_report</field>
        <field name="report_file">ks_templates.domestic_tax_invoice_inr_converted_report</field>
        <field name="print_report_name">'Domestic Sales - Tax Invoice (INR) - %s' % (object.name)</field>
        <field name="domain">['&amp;', ('ks_zone', '=', 'india'), ('currency_id.name', '!=', 'INR')]</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="paperformat_id" ref="paperformat_with_gst_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <template id="domestic_tax_invoice_inr_converted_report">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
            <main>
                <t t-set="sale_order" t-value="doc.get_sale_order_info()"/>
                <t t-set="delivery_partner" t-value="doc.partner_shipping_id or doc.partner_id"/>
                <t t-set="total_qty" t-value="sum(line.quantity for line in doc.get_printable_invoice_lines())"/>
                <t t-set="total_untaxed" t-value="doc.amount_untaxed"/>
                <t t-set="total_tax" t-value="doc.amount_tax"/>
                <t t-set="total_amount" t-value="doc.amount_total"/>
                <t t-set="gst_info" t-value="doc.get_invoice_gst_tax_info()"/>
                <t t-set="total_taxable" t-value="gst_info['total_taxable']"/>
                <t t-set="total_cgst" t-value="gst_info['total_cgst']"/>
                <t t-set="total_sgst" t-value="gst_info['total_sgst']"/>
                <t t-set="total_igst" t-value="gst_info['total_igst']"/>
                <t t-set="total_tax_amt" t-value="total_cgst + total_sgst + total_igst"/>
                <t t-set="inv_bank" t-value="doc.ks_bank_id"/>
                <t t-set="inv_currency" t-value="doc.currency_id"/>
                <t t-set="curr_symbol" t-value="inv_currency.symbol or '$'"/>
                <t t-set="inr_rate" t-value="doc.get_invoice_inr_rate()"/>
                <t t-set="inr_currency" t-value="env['res.currency'].search([('name', '=', 'INR')], limit=1)"/>

                <table style="width:100%; border-collapse:collapse; border-color:white;">
                    <tr>
                        <td style="text-align:center; font-weight:bold; font-size:16px;">Tax Invoice</td>
                    </tr>
                </table>

                <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:11px;">

                    <!-- COMPANY INFO + INVOICE DETAILS ROW -->
                    <tr>
                        <td style="width:55%; vertical-align:top; border:1px solid #000; padding:6px;" colspan="5">
                            <strong t-esc="doc.company_id.name or ''"/><br/>
                            <t t-if="doc.company_id.partner_id.street" t-esc="doc.company_id.partner_id.street"/><br/>
                            <t t-if="doc.company_id.partner_id.street2" t-esc="doc.company_id.partner_id.street2"/><br/>
                            <t t-if="doc.company_id.partner_id.city" t-esc="doc.company_id.partner_id.city"/>
                            <t t-if="doc.company_id.partner_id.city and doc.company_id.partner_id.zip"> - </t>
                            <t t-if="doc.company_id.partner_id.zip" t-esc="doc.company_id.partner_id.zip"/><br/>
                            <t t-if="doc.company_id.vat">GSTIN/UIN: <t t-esc="doc.company_id.vat"/><br/></t>
                            <t t-if="doc.company_id.partner_id.state_id">
                                State Name : <t t-esc="doc.company_id.partner_id.state_id.name or ''"/>
                                <t t-if="doc.company_id.partner_id.state_id.code">, Code : <t t-esc="doc.company_id.partner_id.state_id.code or ''"/></t><br/>
                            </t>
                            <t t-if="doc.company_id.company_registry">CIN: <t t-esc="doc.company_id.company_registry"/><br/></t>
                            <t t-set="company_pan" t-value="doc.get_company_pan()"/>
                            <t t-if="company_pan">PAN : <t t-esc="company_pan"/><br/></t>
                            <t t-if="doc.company_id.partner_id.email">E-Mail : <t t-esc="doc.company_id.partner_id.email"/></t>
                            <hr/>
                            Consignee (Ship to)<br/>
                            <strong t-esc="delivery_partner.name or ''"/><br/>
                            <t t-if="delivery_partner.street" t-esc="delivery_partner.street"/><br/>
                            <t t-if="delivery_partner.street2" t-esc="delivery_partner.street2"/><br/>
                            <t t-if="delivery_partner.city" t-esc="delivery_partner.city"/>
                            <t t-if="delivery_partner.city and delivery_partner.zip"> - </t>
                            <t t-if="delivery_partner.zip" t-esc="delivery_partner.zip"/><br/>
                            <t t-if="delivery_partner.state_id">State : <t t-esc="delivery_partner.state_id.name or ''"/><br/></t>
                            <t t-if="delivery_partner.vat">GSTIN : <t t-esc="delivery_partner.vat"/><br/></t>
                            <hr/>
                            Buyer (Bill to)<br/>
                            <strong t-esc="doc.partner_id.name or ''"/><br/>
                            <t t-if="doc.partner_id.street" t-esc="doc.partner_id.street"/><br/>
                            <t t-if="doc.partner_id.street2" t-esc="doc.partner_id.street2"/><br/>
                            <t t-if="doc.partner_id.city" t-esc="doc.partner_id.city"/>
                            <t t-if="doc.partner_id.city and doc.partner_id.zip"> - </t>
                            <t t-if="doc.partner_id.zip" t-esc="doc.partner_id.zip"/><br/>
                            <t t-if="doc.partner_id.state_id">State Name : <t t-esc="doc.partner_id.state_id.name or ''"/></t>
                            <t t-if="doc.partner_id.vat"><br/>GSTIN : <t t-esc="doc.partner_id.vat"/></t>
                            <t t-if="doc.partner_id.l10n_in_pan"><br/>PAN : <t t-esc="doc.partner_id.l10n_in_pan"/></t>
                        </td>
                        <td style="width:45%; vertical-align:top; padding:0; border:1px solid #000;" colspan="3">
                            <table style="width:100%; border-collapse:collapse; border-color:white;">
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">Invoice No.</td>
                                    <td style="padding:1px;" colspan="3">Dated</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                                    <td style="border-left:1px solid #000; border-bottom:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="doc.invoice_date" t-esc="doc.invoice_date.strftime('%d-%b-%y')"/>
                                            <t t-elif="doc.date" t-esc="doc.date.strftime('%d-%b-%y')"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">Delivery Note</td>
                                    <td style="padding:1px;" colspan="3">Mode/Terms of Payment</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:1px;">
                                        <strong><t t-esc="doc.ks_delivery_note or ''"/></strong>
                                    </td>
                                    <td style="border-left:1px solid #000; border-bottom:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="sale_order and sale_order.payment_term_id" t-esc="sale_order.payment_term_id.name or ''"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">Reference No. &amp; Date</td>
                                    <td style="padding:1px;" colspan="3">Other References</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:1px;">
                                        <strong>
                                            <t t-if="doc.ks_reference_no_date" t-esc="doc.ks_reference_no_date"/>
                                            <t t-else="">
                                                <t t-esc="doc.name or ''"/>
                                                <t t-if="doc.invoice_date"> dt. <t t-esc="doc.invoice_date.strftime('%d-%b-%y')"/></t>
                                            </t>
                                        </strong>
                                    </td>
                                    <td style="border-left:1px solid #000; border-bottom:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="sale_order" t-esc="sale_order.ks_other_reference or ''"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">Buyer's Order No.</td>
                                    <td style="padding:1px;" colspan="3">Dated</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:1px;">
                                        <strong><t t-esc="doc.get_all_sale_order_names()"/></strong>
                                    </td>
                                    <td style="border-left:1px solid #000; border-bottom:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="sale_order and sale_order.date_order" t-esc="sale_order.date_order.strftime('%d-%b-%y')"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:1px;">Despatch Document No.</td>
                                    <td style="border-top:1px solid #000; border-left:1px solid #000; padding:1px;" colspan="3">Delivery Note Date</td>
                                </tr>
                                <tr>
                                    <td style="border-bottom:1px solid #000; border-right:1px solid #000; padding:1px;">
                                        <strong><t t-esc="doc.ks_despatch_document_no or ''"/></strong>
                                    </td>
                                    <td style="border-bottom:1px solid #000; border-left:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="doc.ks_delivery_note_date" t-esc="doc.ks_delivery_note_date.strftime('%d-%b-%y')"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:1px;">Despatched Through</td>
                                    <td style="border-top:1px solid #000; border-left:1px solid #000; padding:1px;" colspan="3">Destination</td>
                                </tr>
                                <tr>
                                    <td style="border-bottom:1px solid #000; border-right:1px solid #000; padding:1px;">
                                        <strong><t t-esc="doc.ks_despatched_through or ''"/></strong>
                                    </td>
                                    <td style="border-bottom:1px solid #000; border-left:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="sale_order" t-esc="sale_order.ks_city_port_of_discharge or ''"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-top:1px solid #000; padding:1px;" colspan="4"><strong>Terms of Delivery</strong></td>
                                </tr>
                                <tr>
                                    <td style="padding:1px;" colspan="4">
                                        <strong>
                                            <t t-if="sale_order and sale_order.incoterm">
                                                [<t t-esc="sale_order.incoterm.code or ''"/>] <t t-esc="sale_order.incoterm.name or ''"/>
                                                <t t-if="sale_order.incoterm_location">, <t t-esc="sale_order.incoterm_location or ''"/></t>
                                            </t>
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- PRODUCT TABLE HEADER -->
                    <tr>
                        <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:5%;">Sl No.</th>
                        <th style="border:1px solid #000; padding:4px; text-align:left; background-color:#f0f0f0; width:30%;">Description of Goods</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:10%;">HSN/SAC</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:8%;">GST Rate</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:12%;">Quantity</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:12%;">Rate (&#8377;)</th>
                        <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:7%;">Per</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:16%;">Amount (&#8377;)</th>
                    </tr>

                    <!-- PRODUCT ROWS -->
                    <t t-set="line_num" t-value="0"/>
                    <t t-foreach="doc.get_printable_invoice_lines()" t-as="line">
                        <t t-set="line_num" t-value="line_num + 1"/>
                        <t t-set="ltr" t-value="doc.get_invoice_line_tax_rates(line)"/>
                        <t t-set="l_cgst_rate" t-value="ltr[0]"/>
                        <t t-set="l_sgst_rate" t-value="ltr[1]"/>
                        <t t-set="l_igst_rate" t-value="ltr[2]"/>
                        <t t-set="line_total_gst" t-value="l_cgst_rate + l_sgst_rate + l_igst_rate"/>
                        <tr>
                            <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line_num"/>
                            <td style="border:1px solid #000; padding:4px;">
                                <t t-esc="line.name or ''"/>
                                <t t-if="l_cgst_rate"><br/><em><strong>Output CGST @ <t t-esc="doc.format_number(l_cgst_rate, digits=0)"/>%</strong></em></t>
                                <t t-if="l_sgst_rate"><br/><em><strong>Output SGST @ <t t-esc="doc.format_number(l_sgst_rate, digits=0)"/>%</strong></em></t>
                                <t t-if="l_igst_rate"><br/><em><strong>Output IGST @ <t t-esc="doc.format_number(l_igst_rate, digits=0)"/>%</strong></em></t>
                            </td>
                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                <t t-esc="doc.get_line_hsn_code(line)"/>
                            </td>
                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                <t t-if="line_total_gst"><t t-esc="doc.format_number(line_total_gst, digits=0)"/>%</t>
                            </td>
                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                <t t-esc="doc.format_number(line.quantity, digits=2)"/> <t t-esc="line.product_uom_id.name or 'pcs'"/>
                            </td>
                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                &#8377; <t t-esc="doc.format_number(line.price_unit * inr_rate, digits=2)"/>
                            </td>
                            <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line.product_uom_id.name or 'pcs'"/>
                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                &#8377; <t t-esc="doc.format_number(line.price_subtotal * inr_rate, digits=2)"/>
                            </td>
                        </tr>
                    </t>

                    <!-- SUBTOTAL ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:4px;" colspan="7"></td>
                        <td style="border:1px solid #000; padding:4px; text-align:right;">
                            &#8377; <t t-esc="doc.format_number(total_untaxed * inr_rate, digits=2)"/>
                        </td>
                    </tr>

                    <!-- TAX ROWS (CGST / SGST / IGST per group) -->
                    <t t-foreach="gst_info['groups']" t-as="grp">
                        <t t-if="grp['cgst_rate']">
                            <tr>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;">Output CGST @ <t t-esc="doc.format_number(grp['cgst_rate'], digits=0)"/>%</td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px; text-align:right;"><t t-esc="doc.format_number(grp['cgst_rate'], digits=0)"/></td>
                                <td style="border:1px solid #000; padding:4px; text-align:center;">%</td>
                                <td style="border:1px solid #000; padding:4px; text-align:right;">&#8377; <t t-esc="doc.format_number(grp['cgst_amount'] * inr_rate, digits=2)"/></td>
                            </tr>
                        </t>
                        <t t-if="grp['sgst_rate']">
                            <tr>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;">Output SGST @ <t t-esc="doc.format_number(grp['sgst_rate'], digits=0)"/>%</td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px; text-align:right;"><t t-esc="doc.format_number(grp['sgst_rate'], digits=0)"/></td>
                                <td style="border:1px solid #000; padding:4px; text-align:center;">%</td>
                                <td style="border:1px solid #000; padding:4px; text-align:right;">&#8377; <t t-esc="doc.format_number(grp['sgst_amount'] * inr_rate, digits=2)"/></td>
                            </tr>
                        </t>
                        <t t-if="grp['igst_rate']">
                            <tr>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;">Output IGST @ <t t-esc="doc.format_number(grp['igst_rate'], digits=0)"/>%</td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px;"></td>
                                <td style="border:1px solid #000; padding:4px; text-align:right;"><t t-esc="doc.format_number(grp['igst_rate'], digits=0)"/></td>
                                <td style="border:1px solid #000; padding:4px; text-align:center;">%</td>
                                <td style="border:1px solid #000; padding:4px; text-align:right;">&#8377; <t t-esc="doc.format_number(grp['igst_amount'] * inr_rate, digits=2)"/></td>
                            </tr>
                        </t>
                    </t>

                    <!-- TOTAL ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:4px;"></td>
                        <td style="border:1px solid #000; padding:4px;"><strong>Total</strong></td>
                        <td style="border:1px solid #000; padding:4px;"></td>
                        <td style="border:1px solid #000; padding:4px;"></td>
                        <td style="border:1px solid #000; padding:4px; text-align:right;">
                            <strong><t t-esc="doc.format_number(total_qty, digits=2)"/> pcs</strong>
                        </td>
                        <td style="border:1px solid #000; padding:4px;"></td>
                        <td style="border:1px solid #000; padding:4px;"></td>
                        <td style="border:1px solid #000; padding:4px; text-align:right;">
                            <strong>&#8377; <t t-esc="doc.format_number(total_amount * inr_rate, digits=2)"/></strong>
                        </td>
                    </tr>

                    <!-- EXCHANGE RATE ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px; text-align:right;" colspan="8">
                            Exchange Rate: <t t-esc="curr_symbol"/> 1 = &#8377; <t t-esc="doc.format_number(inr_rate, digits=4)"/>
                            &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;
                            Total Invoice Amount in <t t-esc="curr_symbol"/> <t t-esc="doc.format_number(total_amount, digits=2)"/>
                            @ &#8377; <t t-esc="doc.format_number(inr_rate, digits=4)"/>/<t t-esc="curr_symbol"/>
                            = &#8377; <t t-esc="doc.format_number(total_amount * inr_rate, digits=2)"/>
                        </td>
                    </tr>

                    <!-- AMOUNT IN WORDS ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px;" colspan="8">
                            Amount Chargeable (in words)<br/>
                            <strong>
                                <t t-esc="doc.get_amount_in_words_inr(total_amount * inr_rate)"/>
                            </strong>
                            <span style="float:right;">E. &amp; O.E</span>
                        </td>
                    </tr>

                    <!-- TAX SUMMARY ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:0;" colspan="8">
                            <table style="width:100%; border-collapse:collapse; font-size:11px;">
                                <tr>
                                    <td style="width:20%; border-right:1px solid #000; border-bottom:1px solid #000; padding:4px;" rowspan="2">HSN/SAC</td>
                                    <td style="width:15%; border-right:1px solid #000; border-bottom:1px solid #000; padding:4px;" rowspan="2">Taxable Value</td>
                                    <td style="width:20%; border-right:1px solid #000; border-bottom:1px solid #000; padding:4px; text-align:center;" colspan="2">CGST</td>
                                    <td style="width:20%; border-right:1px solid #000; border-bottom:1px solid #000; padding:4px; text-align:center;" colspan="2">SGST/UTGST</td>
                                    <td style="width:25%; border-bottom:1px solid #000; padding:4px;" rowspan="2">Total Tax Amount</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:4px;">Rate</td>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:4px;">Amount</td>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:4px;">Rate</td>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:4px;">Amount</td>
                                </tr>
                                <t t-foreach="gst_info['groups']" t-as="grp">
                                    <t t-set="grp_inr_taxable" t-value="grp['taxable_amount'] * inr_rate"/>
                                    <t t-set="grp_inr_cgst" t-value="grp['cgst_amount'] * inr_rate"/>
                                    <t t-set="grp_inr_sgst_igst" t-value="(grp['sgst_amount'] + grp['igst_amount']) * inr_rate"/>
                                    <t t-set="grp_inr_total" t-value="(grp['cgst_amount'] + grp['sgst_amount'] + grp['igst_amount']) * inr_rate"/>
                                    <t t-set="grp_hsn">
                                        <t t-foreach="doc.get_printable_invoice_lines()" t-as="ln">
                                            <t t-set="ltr2" t-value="doc.get_invoice_line_tax_rates(ln)"/>
                                            <t t-if="ltr2[0] == grp['cgst_rate'] and ltr2[1] == grp['sgst_rate'] and ltr2[2] == grp['igst_rate']">
                                                <t t-esc="doc.get_line_hsn_code(ln)"/>
                                            </t>
                                        </t>
                                    </t>
                                    <tr>
                                        <td style="border-right:1px solid #000; padding:4px;"><t t-esc="grp_hsn"/></td>
                                        <td style="border-right:1px solid #000; padding:4px;">&#8377; <t t-esc="doc.format_number(grp_inr_taxable, digits=2)"/></td>
                                        <td style="border-right:1px solid #000; padding:4px; text-align:center;"><t t-esc="doc.format_number(grp['cgst_rate'], digits=0)"/>%</td>
                                        <td style="border-right:1px solid #000; padding:4px; text-align:right;">&#8377; <t t-esc="doc.format_number(grp_inr_cgst, digits=2)"/></td>
                                        <td style="border-right:1px solid #000; padding:4px; text-align:center;"><t t-esc="doc.format_number(grp['sgst_rate'] or grp['igst_rate'], digits=0)"/>%</td>
                                        <td style="border-right:1px solid #000; padding:4px; text-align:right;">&#8377; <t t-esc="doc.format_number(grp_inr_sgst_igst, digits=2)"/></td>
                                        <td style="padding:4px; text-align:right;">&#8377; <t t-esc="doc.format_number(grp_inr_total, digits=2)"/></td>
                                    </tr>
                                </t>
                                <t t-set="total_inr_taxable" t-value="total_taxable * inr_rate"/>
                                <t t-set="total_inr_cgst" t-value="total_cgst * inr_rate"/>
                                <t t-set="total_inr_sgst_igst" t-value="(total_sgst + total_igst) * inr_rate"/>
                                <t t-set="total_inr_tax" t-value="total_tax_amt * inr_rate"/>
                                <tr>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:4px;"><strong>Total</strong></td>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:4px;"><strong>&#8377; <t t-esc="doc.format_number(total_inr_taxable, digits=2)"/></strong></td>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:4px;"></td>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:4px;"><strong>&#8377; <t t-esc="doc.format_number(total_inr_cgst, digits=2)"/></strong></td>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:4px;"></td>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:4px;"><strong>&#8377; <t t-esc="doc.format_number(total_inr_sgst_igst, digits=2)"/></strong></td>
                                    <td style="border-top:1px solid #000; padding:4px;"><strong>&#8377; <t t-esc="doc.format_number(total_inr_tax, digits=2)"/></strong></td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- TAX AMOUNT IN WORDS ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px;" colspan="8">
                            Tax Amount (in words):<br/>
                            <strong>
                                <t t-esc="doc.get_amount_in_words_inr(total_inr_tax)"/>
                            </strong>
                        </td>
                    </tr>

                    <!-- DECLARATION + BANK DETAILS + SIGNATORY ROW -->
                    <tr>
                        <td style="vertical-align:top; padding:6px; border:1px solid #000;" colspan="5">
                            <t t-if="sale_order and sale_order.ks_remarks">
                                <strong>Remarks</strong><br/>
                                <t t-esc="sale_order.ks_remarks"/><br/><br/>
                            </t>
                            <t t-if="sale_order and sale_order.note">
                                <strong>Declaration</strong><br/>
                                <span t-out="sale_order.note"/>
                            </t>
                        </td>
                        <td style="vertical-align:top; padding:6px; border:1px solid #000;" colspan="3">
                            <p style="font-weight:bold; margin:0 0 4px 0;">Company's Bank Details</p>
                            <span><strong>Bank Name:</strong> <t t-esc="inv_bank.name if inv_bank else ''"/></span><br/>
                            <span><strong>A/c No.:</strong> <t t-esc="inv_bank.bic if inv_bank else ''"/></span><br/>
                            <span><strong>Branch &amp; IFS Code:</strong>
                                <t t-esc="inv_bank.city if inv_bank else ''"/>
                                <t t-if="inv_bank and inv_bank.ifsc_code"> (<t t-esc="inv_bank.ifsc_code"/>)</t>
                            </span><br/>
                            <span><strong>SWIFT Code:</strong> <t t-esc="(inv_bank.swift_code or inv_bank.bic) if inv_bank else ''"/></span>
                            <div style="border-top:1px solid #000; margin-top:20px;"/>
                            <div style="text-align:center; margin-top:10px;">
                                <t t-if="sale_order and sale_order.ks_authorized_signature">
                                    <img t-att-src="image_data_uri(sale_order.ks_authorized_signature)"
                                         style="max-height:60px; max-width:180px; display:block; margin:0 auto 4px auto;"/>
                                </t>
                                Authorised Signatory<br/><br/>
                                for <t t-esc="doc.company_id.name or ''"/>
                            </div>
                        </td>
                    </tr>

                    <!-- COMPUTER GENERATED ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:4px; text-align:center; font-size:10px;" colspan="8">
                            This is a Computer Generated Invoice
                        </td>
                    </tr>

                </table>

            </main>
            </t>
        </t>
    </template>

</odoo>
