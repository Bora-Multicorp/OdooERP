<odoo>

    <record id="paperformat_dubai_saleorder" model="report.paperformat">
            <field name="name">US Letter</field>
            <field name="default" eval="True" />
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
            <field name="css_margins" eval="True" />
        </record>
    <!-- Define the new report action for sale order -->
    <record id="action_report_saleorder_dubai" model="ir.actions.report">
        <field name="name">Dubai Quotation / Order</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.report_saleorder_dubai</field>
        <field name="report_file">ks_templates.report_saleorder_dubai</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Custom Quotation - %s' % (object.name)) or 'Custom Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="paperformat_id" ref="paperformat_dubai_saleorder"/>
        <field name="binding_type">report</field>
    </record>



    <template id="report_saleorder_dubai">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>

                <style>
                    @page {
                        size: A4;
                        margin: 1cm;
                    }
                    body {
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 10pt;
                        margin: 0;
                        padding: 0;
                    }
                    .header-table {
                        width: 100%;
                        margin-bottom: 15px;
                    }
                    .company-name {
                        font-size: 12pt;
                        font-weight: bold;
                    }
                    .document-title {
                        font-size: 12pt;
                        font-weight: bold;
                        text-align: right;
                    }
                    .reference-table {
                        width: 100%;
                        margin-bottom: 15px;
                        border-collapse: collapse;
                    }
                    .reference-table td {
                        padding: 5px;
                        vertical-align: top;
                    }
                    .partner-section {
                        width: 100%;
                        margin-bottom: 15px;
                        border-collapse: collapse;
                    }
                    .partner-section td {
                        padding: 8px;
                        vertical-align: top;
                        width: 50%;
                    }
                    .partner-label {
                        font-weight: bold;
                        font-size: 10pt;
                        margin-bottom: 5px;
                    }
                    .product-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 15px;
                    }
                    .product-table th {
                        border: 1px solid #000;
                        padding: 8px;
                        text-align: left;
                        background-color: #f0f0f0;
                        font-weight: bold;
                        font-size: 10pt;
                    }
                    .product-table td {
                        border: 1px solid #000;
                        padding: 8px;
                        font-size: 10pt;
                    }
                    .product-table .text-right {
                        text-align: right;
                    }
                    .product-table .text-center {
                        text-align: center;
                    }
                    .totals-table {
                        width: 100%;
                        margin-bottom: 15px;
                        border-collapse: collapse;
                    }
                    .totals-table td {
                        padding: 5px;
                        font-size: 10pt;
                    }
                    .totals-table .label-cell {
                        text-align: right;
                        font-weight: bold;
                        width: 70%;
                    }
                    .totals-table .value-cell {
                        text-align: right;
                        width: 30%;
                    }
                    .bank-table {
                        width: 100%;
                        margin-bottom: 15px;
                        border-collapse: collapse;
                    }
                    .bank-table td {
                        padding: 5px;
                        font-size: 10pt;
                    }
                    .bank-table .label-cell {
                        font-weight: bold;
                        width: 20%;
                    }
                    .footer-text {
                        font-size: 10pt;
                        margin-top: 10px;
                    }
                    .signatory {
                        text-align: right;
                        margin-top: 30px;
                        font-size: 10pt;
                    }
                </style>
                <!-- Main Single Table Structure - Everything in One Box -->
                <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-family: Arial, sans-serif; font-size: 11px;">
                    <!-- Header Row with Title -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px; text-align:center; font-weight:bold; font-size:14px;" colspan="2">
                            PROFORMA INVOICE
                        </td>
                    </tr>

                    <!-- Company and Invoice Details Row -->
                    <tr>
                        <!-- LEFT COLUMN -->
                        <td style="width:55%; border:1px solid #000; vertical-align:top; padding:6px;">
                            <!-- Company Information -->
                            <strong t-esc="doc.company_id.name or ''"/>
                            <br t-if="doc.company_id.partner_id.street"/>
                            <t t-if="doc.company_id.partner_id.street" t-esc="doc.company_id.partner_id.street"/>
                            <t t-if="doc.company_id.partner_id.street and doc.company_id.partner_id.street2">, </t>
                            <t t-if="doc.company_id.partner_id.street2" t-esc="doc.company_id.partner_id.street2"/>
                            <t t-if="(doc.company_id.partner_id.street or doc.company_id.partner_id.street2) and doc.company_id.partner_id.city">, </t>
                            <t t-if="doc.company_id.partner_id.city" t-esc="doc.company_id.partner_id.city"/>
                            <t t-if="doc.company_id.partner_id.city and doc.company_id.partner_id.country_id">, </t>
                            <t t-if="doc.company_id.partner_id.country_id" t-esc="doc.company_id.partner_id.country_id.name or ''"/>
                            <t t-if="doc.company_id.partner_id.zip"> P.O.Box <t t-esc="doc.company_id.partner_id.zip"/></t>
                            <br t-if="doc.company_id.partner_id.state_id"/>
                            <t t-if="doc.company_id.partner_id.state_id">Emirate : <t t-esc="doc.company_id.partner_id.state_id.name or ''"/></t>
                            <br t-if="doc.company_id.vat"/>
                            <t t-if="doc.company_id.vat">TRN : <t t-esc="doc.company_id.vat"/></t>
                            <br t-if="doc.company_id.partner_id.email"/>
                            <t t-if="doc.company_id.partner_id.email">E-Mail : <t t-esc="doc.company_id.partner_id.email"/></t>
                            <div style="border-top:1px solid black;height:1px; margin-top:5px; margin-bottom:5px;"/>

                            <!-- Consignee Information -->
                            <t t-set="consignee_partner" t-value="doc.partner_shipping_id or doc.partner_id"/>
                            Consignee<br/>
                            <strong t-esc="consignee_partner.name or ''"/>
                            <br t-if="consignee_partner.street"/>
                            <t t-if="consignee_partner.street" t-esc="consignee_partner.street"/>
                            <t t-if="consignee_partner.street and consignee_partner.street2">, </t>
                            <t t-if="consignee_partner.street2" t-esc="consignee_partner.street2"/>
                            <t t-if="(consignee_partner.street or consignee_partner.street2) and consignee_partner.city">, </t>
                            <t t-if="consignee_partner.city" t-esc="consignee_partner.city"/>
                            <t t-if="consignee_partner.city and consignee_partner.country_id">, </t>
                            <t t-if="consignee_partner.country_id" t-esc="consignee_partner.country_id.name or ''"/>
                            <t t-if="doc.ks_zone == 'india' and consignee_partner.l10n_in_pan">
                                <br/>PAN : <t t-esc="consignee_partner.l10n_in_pan"/>
                            </t>
                            <br/>
                            <br/>
                            <div style="border-top:1px solid black;height:1px; margin-top:5px; margin-bottom:5px;"/>

                            <!-- Buyer Information -->
                            Buyer<br/>
                            <strong t-esc="doc.partner_id.name or ''"/>
                            <br t-if="doc.partner_id.street"/>
                            <t t-if="doc.partner_id.street" t-esc="doc.partner_id.street"/>
                            <t t-if="doc.partner_id.street and doc.partner_id.street2">, </t>
                            <t t-if="doc.partner_id.street2" t-esc="doc.partner_id.street2"/>
                            <t t-if="(doc.partner_id.street or doc.partner_id.street2) and doc.partner_id.city">, </t>
                            <t t-if="doc.partner_id.city" t-esc="doc.partner_id.city"/>
                            <t t-if="doc.partner_id.city and doc.partner_id.country_id">, </t>
                            <t t-if="doc.partner_id.country_id" t-esc="doc.partner_id.country_id.name or ''"/>
                            <br t-if="doc.partner_id.state_id"/>
                            <t t-if="doc.partner_id.state_id">Emirate : <t t-esc="doc.partner_id.state_id.name or ''"/></t>
                            <br t-if="doc.partner_id.country_id"/>
                            <t t-if="doc.partner_id.country_id">Country : <t t-esc="doc.partner_id.country_id.name or ''"/></t>
                            <t t-if="doc.ks_zone == 'india' and doc.partner_id.l10n_in_pan">
                                <br/>PAN : <t t-esc="doc.partner_id.l10n_in_pan"/>
                            </t>
                        </td>

                        <!-- RIGHT COLUMN -->
                        <td style="width:45%;vertical-align:top; padding:0; border-left:1px solid #000;">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">Voucher No.</td>
                                    <td style="padding:1px;" colspan="3">Dated</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                                    <td style="border-left:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="doc.date_order" t-esc="doc.date_order.strftime('%d-%b-%y')"/>
                                            <t t-elif="doc.create_date" t-esc="doc.create_date.strftime('%d-%b-%y')"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;border-top:1px solid #000; padding:1px;">Buyer's Ref./Order No.</td>
                                    <td style="border-left:1px solid #000; padding:1px;border-right:1px solid #000; padding:1px;border-top:1px solid #000; padding:1px;" colspan="3">Other Reference(s)</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                                    <td style="border-right:1px solid #000; padding:1px;" colspan="3"><strong t-esc="doc.user_id.name or ''"/></td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;border-top:1px solid #000; padding:1px;">Despatch through</td>
                                    <td style="border-left:1px solid #000; padding:1px;border-right:1px solid #000; padding:1px;border-top:1px solid #000; padding:1px;" colspan="3">Destination</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">
                                        <t t-esc="doc.ks_despatched_through or ''"/>
                                    </td>
                                    <td style="border-right:1px solid #000; padding:1px;" colspan="3">
                                        <t t-esc="doc.ks_city_port_of_discharge or ''"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-top:1px solid #000; padding:1px;" colspan="4">
                                        <strong>Terms of Delivery</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;" colspan="4">
                                        <strong>
                                            <t t-if="doc.note">
                                                <span t-out="doc.note"/>
                                            </t>
                                            <t t-else="">
                                                <t t-if="doc.incoterm">
                                                    <t t-esc="doc.incoterm.code or ''"/>
                                                    <t t-if="doc.incoterm_location">, <t t-esc="doc.incoterm_location or ''"/></t>
                                                </t>
                                                <t t-else="">FOB Dubai, Delivery - DAFZA to DAFZA</t>
                                            </t>
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>















