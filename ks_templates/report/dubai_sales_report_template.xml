                <!-- Partner Section: Consignee and Buyer -->
<!--                <table class="partner-section">-->
<!--                    <tr>-->
<!--                        <td>-->
<!--                            <div class="partner-label">Consignee:</div>-->
<!--                            <div style="font-size: 10pt;">Captains Freight Services FZCO</div>-->
