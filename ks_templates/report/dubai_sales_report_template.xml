                    <!-- Product Table Row -->
                    <tr>
                        <td style="border:1px solid #000; padding:0;" colspan="2">
                            <t t-set="total_qty" t-value="sum(line.product_uom_qty for line in doc.order_line.filtered(lambda l: l.display_type not in ('line_section', 'line_note')))"/>
                            <t t-set="total_usd" t-value="doc.amount_total"/>
                            <t t-set="exchange_rate" t-value="3.676"/>
                            <t t-set="total_aed" t-value="total_usd * exchange_rate"/>
                            <table style="width:100%; border-collapse:collapse; border:0;">
                                <thead>
                                    <tr>
                                        <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; font-weight:bold; font-size:10pt;">Sl No.</th>
                                        <th style="border:1px solid #000; padding:4px; text-align:left; background-color:#f0f0f0; font-weight:bold; font-size:10pt;">Description of Goods</th>
                                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; font-weight:bold; font-size:10pt;">Quantity</th>
                                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; font-weight:bold; font-size:10pt;">Rate</th>
                                        <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; font-weight:bold; font-size:10pt;">per</th>
                                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; font-weight:bold; font-size:10pt;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="line_num" t-value="0"/>
                                    <t t-foreach="doc.order_line.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">
                                        <t t-set="line_num" t-value="line_num + 1"/>
                                        <tr>
                                            <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line_num"/>
                                            <td style="border:1px solid #000; padding:4px;">
                                                <t t-esc="line.name or ''"/>
                                                <t t-set="made_in_country" t-value="line.made_in_country_id or (line.product_id and line.product_id.product_tmpl_id.made_country)"/>
                                                <t t-if="made_in_country">
                                                    <br/><span style="margin-left: 1em;"><t t-esc="'Made in ' + (made_in_country.name or '')"/></span>
                                                </t>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px; text-align:right;" t-esc="doc.format_number(line.product_uom_qty, digits=0)"/>
                                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                                <strong><t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_unit, digits=2)"/></strong>
                                            </td>
                                            <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line.product_uom.name or 'pcs'"/>
                                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                                <strong><t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_subtotal, digits=2)"/></strong>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Total Row -->
                                    <tr>
                                        <td style="border:1px solid #000; padding:4px; text-align:center;"></td>
                                        <td style="border:1px solid #000; padding:4px;"><strong>Total</strong></td>
                                        <td style="border:1px solid #000; padding:4px; text-align:right;"><strong><t t-esc="doc.format_number(total_qty, digits=0)"/> pcs</strong></td>
                                        <td style="border:1px solid #000; padding:4px; text-align:right;"></td>
                                        <td style="border:1px solid #000; padding:4px; text-align:center;"></td>
                                        <td style="border:1px solid #000; padding:4px; text-align:right;"><strong><t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(total_usd, digits=2)"/></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>

                    <!-- Totals Summary Row -->
                    <tr>
                        <t t-set="invoice_currency" t-value="doc.currency_id"/>
                        <t t-set="company_currency" t-value="doc.company_id.currency_id"/>
                        <t t-set="conversion_date" t-value="doc.date_order or doc.create_date.date()"/>
                        <t t-set="total_invoice_amount" t-value="total_usd"/>
                        <t t-set="converted_amount" t-value="total_usd"/>
                        <t t-set="invoice_currency_rate" t-value="1.0"/>
                        <t t-set="exchange_rate" t-value="1.0"/>
                        <t t-set="company_to_invoice_rate" t-value="1.0"/>
                        <t t-if="invoice_currency and company_currency and invoice_currency != company_currency">
                            <t t-set="converted_amount"
                               t-value="invoice_currency._convert(total_usd, company_currency, doc.company_id, conversion_date, round=True)"/>
                            <t t-set="invoice_currency_rate"
                               t-value="doc.env['res.currency']._get_conversion_rate(invoice_currency, company_currency, doc.company_id, conversion_date)"/>
                            <t t-set="exchange_rate" t-value="invoice_currency_rate"/>
                            <t t-set="company_to_invoice_rate"
                               t-value="1.0 / invoice_currency_rate if invoice_currency_rate else 1.0"/>
                        </t>
                    </tr>

                    <!-- Amount in Words Row -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px; font-size:10pt;" colspan="2">
                            <t t-set="exchange_currency_code" t-value="company_currency.name or 'AED'"/>
                            <t t-set="exchanged_amount" t-value="converted_amount"/>
                            <t t-set="invoice_amount_words" t-value="doc.get_amount_in_words_currency(total_invoice_amount, invoice_currency)"/>
                            <strong>Amount Chargeable (in words)</strong><br/>
                            <strong>
                                <t t-esc="invoice_amount_words or ''"/> (<t t-esc="exchange_currency_code + ' ' + doc.format_number(exchanged_amount, digits=2)"/>)
                            </strong>
                        </td>
                    </tr>

                    <!-- Bank Details and Footer Row -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px; font-size:11px; vertical-align:top;">
                            <t t-set="company_bank" t-value="doc.company_id.partner_id.bank_ids[:1]"/>
                            <t t-set="bank_info" t-value="doc.get_company_bank_info()"/>
                            <t t-set="iban_number" t-value="doc.get_company_iban()"/>
                            <t t-set="branch_val" t-value="(bank_info.get('branch') or '') if bank_info else ''"/>
                            <t t-set="swift_val" t-value="''"/>
                            <t t-if="company_bank and company_bank.journal_id and company_bank.journal_id.code">
                                <t t-set="swift_val" t-value="company_bank.journal_id.code"/>
                            </t>
                            <t t-if="not swift_val and bank_info and bank_info.get('swift_code')">
                                <t t-set="swift_val" t-value="bank_info.get('swift_code') or ''"/>
                            </t>
                            <t t-if="not swift_val and company_bank and company_bank.bank_id and company_bank.bank_id.bic">
                                <t t-set="swift_val" t-value="company_bank.bank_id.bic or ''"/>
                            </t>
                            <t t-set="bank_name_display" t-value="''"/>
                            <t t-set="acc_number_display" t-value="''"/>
                            <t t-set="iban_display" t-value="iban_number or ''"/>
                            <!-- When sale order has ks_bank_id, use bank_info (from ks_bank_id) for Company's Bank Details -->
                            <t t-if="doc.ks_bank_id and bank_info">
                                <t t-set="bank_name_display" t-value="bank_info.get('bank_name') or ''"/>
                                <t t-set="acc_number_display" t-value="bank_info.get('acc_number') or ''"/>
                                <t t-set="iban_display" t-value="''"/>
                            </t>
                            <t t-elif="company_bank and company_bank.bank_id">
                                <t t-set="bank_name_display" t-value="(company_bank.bank_id.name or '') + (company_bank.currency_id and (' - ' + company_bank.currency_id.name + ' A/C') or ' - AED A/C')"/>
                                <t t-set="acc_number_display" t-value="company_bank.acc_number or ''"/>
                            </t>
                            <t t-elif="company_bank and company_bank.bank_name">
                                <t t-set="bank_name_display" t-value="(company_bank.bank_name or '') + (company_bank.currency_id and (' - ' + company_bank.currency_id.name + ' A/C') or ' - AED A/C')"/>
                                <t t-set="acc_number_display" t-value="company_bank.acc_number or ''"/>
                            </t>
                            <strong>Company's Bank Details</strong><br/>
                            Bank Name : <t t-esc="bank_name_display or ''"/><br/>
                            A/c No. : <t t-esc="acc_number_display or ''"/><br/>
                            IBAN : <t t-esc="iban_display or ''"/><br/>
                            Branch &amp; SWIFT Code : <t t-if="branch_val" t-esc="branch_val"/><t t-if="branch_val and swift_val"> / </t><t t-if="swift_val" t-esc="swift_val"/><br/>
                            <t t-if="doc.company_id.name">for <t t-esc="doc.company_id.name or ''"/></t>
                        </td>
                        <td style="border:1px solid #000; padding:6px; text-align:center; vertical-align:bottom; font-size:10pt;">
                            <t t-if="doc.ks_authorized_signature">
                                <img t-att-src="image_data_uri(doc.ks_authorized_signature)"
                                     style="max-height:60px; max-width:180px; display:block; margin:0 auto 4px auto;"/>
                            </t>
                            Authorised Signatory
                        </td>
                    </tr>

                    <!-- Footer Row -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px; text-align:center; font-size:9pt;" colspan="2">
                            <div style="margin-bottom: 5px;">SUBJECT TO <t t-esc="(doc.company_id.city or 'DUBAI').upper()"/>, <t t-esc="(doc.company_id.country_id.name or 'U.A.E.').upper()"/> JURISDICTION</div>
                            <div>This is a Computer Generated Document</div>
                        </td>
                    </tr>
                </table>
            </t>
        </t>
    </template>
</odoo>


