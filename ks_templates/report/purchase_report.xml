<odoo>
<record id="paperformat_custom_purchase_order" model="report.paperformat">
            <field name="name">US Letter</field>
            <field name="default" eval="True" />
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
            <field name="css_margins" eval="True" />
        </record>
    <!-- Define the new report action for sale order -->
    <record id="action_report_purchase_custom" model="ir.actions.report">
        <field name="name">Purchase / Order Custom</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.purchase_order_custom_report</field>
        <field name="report_file">ks_templates.purchase_order_custom_report</field>
        <field name="print_report_name">'Purchase Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="paperformat_id" ref="paperformat_custom_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="purchase_order_custom_report">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="doc">
        <main>
        <t t-set="doc" t-value="doc.sudo()"/>

        <!-- Variables -->
        <t t-set="total_qty" t-value="sum(line.product_qty for line in doc.get_printable_order_lines())"/>
        <t t-set="total_usd" t-value="doc.amount_untaxed + doc.amount_tax"/>
        <t t-set="invoice_currency" t-value="doc.currency_id.sudo()"/>
        <t t-set="company_currency" t-value="doc.company_id.sudo().currency_id.sudo()"/>
        <t t-set="conversion_date" t-value="doc.date_order or doc.create_date.date()"/>
        <t t-set="total_invoice_amount" t-value="total_usd"/>
        <t t-set="po_rate_info" t-value="doc.get_exchange_rate_info()"/>
        <t t-set="po_has_exchange" t-value="po_rate_info['has_exchange']"/>
        <t t-set="po_large_rate" t-value="po_rate_info['large_rate']"/>
        <t t-set="po_small_rate" t-value="po_rate_info['small_rate']"/>
        <t t-set="exchange_currency_code" t-value="company_currency.name or 'AED'"/>
        <t t-set="invoice_amount_words" t-value="doc.get_amount_in_words_currency(total_invoice_amount, invoice_currency)"/>

        <!-- TITLE — kept separate -->
        <table style="width:100%; border-collapse:collapse; border-color:white;">
            <tr>
                <td style="text-align:center; font-weight:bold; font-size:14px;">
                    PURCHASE ORDER
                </td>
            </tr>
        </table>

        <!-- SINGLE UNIFIED TABLE (6 columns) -->
        <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:11px;">

            <!-- HEADER ROW: Company + Invoice Details -->
            <tr>
                <!-- LEFT SIDE -->
                <td style="width:55%; vertical-align:top; border:1px solid #000; padding:6px;" colspan="4">
                    Invoice To<br/>
                    <t t-set="bill_to" t-value="(doc.bill_to_id or doc.company_id.sudo().partner_id).sudo()"/>
                    <strong t-esc="doc.get_bill_to_company_name()"/><br/>
                    <t t-if="bill_to.street" t-esc="bill_to.street"/><br/>
                    <t t-if="bill_to.street2" t-esc="bill_to.street2"/><br/>
                    <t t-if="bill_to.city" t-esc="bill_to.city"/>
                    <t t-if="bill_to.city and bill_to.country_id">, </t>
                    <t t-if="bill_to.country_id" t-esc="bill_to.country_id.name or ''"/><br/>
                    <t t-if="bill_to.zip">P.O.Box <t t-esc="bill_to.zip"/><br/></t>
                    <t t-if="bill_to.state_id">
                        <t t-if="bill_to.country_id and bill_to.country_id.code == 'IN'">State : </t>
                        <t t-else="">Emirate : </t>
                        <t t-esc="bill_to.state_id.name or ''"/><br/>
                    </t>
                    <t t-if="bill_to.vat">
                        <t t-if="bill_to.country_id and bill_to.country_id.code == 'IN'">GSTN : </t>
                        <t t-else="">TRN : </t>
                        <t t-esc="bill_to.vat"/><br/>
                    </t>
                    <t t-if="bill_to.country_id and bill_to.country_id.code == 'IN'">
                        <t t-set="bill_to_pan" t-value="bill_to.l10n_in_pan or doc.get_company_pan()"/>
                        <t t-if="bill_to_pan">PAN : <t t-esc="bill_to_pan"/><br/></t>
                        <t t-set="company_iec" t-value="doc.get_company_iec()"/>
                        <t t-if="company_iec">IEC No : <t t-esc="company_iec"/><br/></t>
                    </t>
                    <t t-if="bill_to.email">E-Mail : <t t-esc="bill_to.email"/><br/></t>
                    <t t-if="bill_to.phone">Phone : <t t-esc="bill_to.phone"/><br/></t>
                    <div style="border-top:1px solid black; height:1px;"/>
                    <t t-set="consignee" t-value="(doc.picking_type_id.sudo().warehouse_id.sudo().partner_id or doc.dest_address_id or doc.company_id.sudo().partner_id).sudo()"/>
                    Consignee (Ship to)<br/>
                    <strong t-esc="doc.get_ship_to_company_name()"/><br/>
                    <t t-if="consignee and consignee.street and consignee.street != consignee.name"><t t-esc="consignee.street"/><br/></t>
                    <t t-if="consignee and consignee.street2 and consignee.street2 != consignee.name"><t t-esc="consignee.street2"/><br/></t>
                    <t t-if="consignee and consignee.city"><t t-esc="consignee.city"/><t t-if="consignee.state_id">, <t t-esc="consignee.state_id.name or ''"/></t><br/></t>
                    <t t-if="consignee and consignee.country_id"><t t-esc="consignee.country_id.name or ''"/><t t-if="consignee.zip"> - <t t-esc="consignee.zip"/></t><br/></t>
                    <t t-if="consignee and consignee.vat">
                        <t t-if="consignee.country_id and consignee.country_id.code == 'IN'">GSTIN : </t>
                        <t t-else="">TRN : </t>
                        <t t-esc="consignee.vat"/><br/>
                    </t>
                    <t t-if="consignee and consignee.phone">Phone : <t t-esc="consignee.phone"/><br/></t>
                    <t t-if="consignee and consignee.email">E-Mail : <t t-esc="consignee.email"/><br/></t>
                    <div style="border-top:1px solid black; height:1px;"/>
                    Supplier<br/>
                    <strong t-esc="doc.partner_id.sudo().name or ''"/><br/>
                    <t t-if="doc.partner_id.sudo().street" t-esc="doc.partner_id.sudo().street"/><br/>
                    <t t-if="doc.partner_id.sudo().street2" t-esc="doc.partner_id.sudo().street2"/><br/>
                    <t t-if="doc.partner_id.sudo().city" t-esc="doc.partner_id.sudo().city"/>
                    <t t-if="doc.partner_id.sudo().city and doc.partner_id.sudo().state_id">, </t>
                    <t t-if="doc.partner_id.sudo().state_id" t-esc="doc.partner_id.sudo().state_id.sudo().name or ''"/>
                    <t t-if="doc.partner_id.sudo().city and doc.partner_id.sudo().country_id">, </t>
                    <t t-if="doc.partner_id.sudo().country_id" t-esc="doc.partner_id.sudo().country_id.sudo().name or ''"/><br/>
                    <t t-if="doc.partner_id.sudo().country_id">Country : <t t-esc="doc.partner_id.sudo().country_id.sudo().name or ''"/><br/></t>
                    <t t-if="doc.partner_id.sudo().vat">GSTIN : <t t-esc="doc.partner_id.sudo().vat"/><br/></t>
                    <t t-if="doc.partner_id.sudo().l10n_in_pan">PAN : <t t-esc="doc.partner_id.sudo().l10n_in_pan"/></t>
                </td>

                <!-- RIGHT SIDE -->
                <td style="width:45%; vertical-align:top; padding:0; border:1px solid #000;" colspan="3">
                    <table style="width:100%; border-collapse:collapse; border-color:white;">
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;">Voucher No.</td>
                            <td style="padding:1px;" colspan="3">Dated</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                            <td style="border-left:1px solid #000; padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.date_order" t-esc="doc.date_order.strftime('%d/%m/%Y')"/>
                                    <t t-elif="doc.create_date" t-esc="doc.create_date.strftime('%d/%m/%Y')"/>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;"></td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Mode/Terms of Payment</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"></td>
                            <td style="padding:1px;" colspan="3"><strong><t t-esc="doc.payment_term_id.name or ''"/></strong></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Supplier's Ref./Order No.</td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Other Reference(s)</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                            <td style="padding:1px;" colspan="3"><strong t-esc="doc.user_id.name or ''"/></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Dispatch through</td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Destination</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px; height:11px;"><strong t-esc="doc.ks_despatched_through or ''"/></td>
                            <td style="padding:1px; height:11px;" colspan="3"><strong t-esc="doc.ks_destination or ''"/></td>
                        </tr>
                        <tr>
                            <td style="border-top:1px solid #000; padding:1px;" colspan="3"><strong>Terms of Delivery</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.incoterm_id">
                                        [<t t-esc="doc.incoterm_id.code or ''"/>] <t t-esc="doc.incoterm_id.name or ''"/>
                                    </t>
                                </strong>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <!-- PRODUCT TABLE HEADER -->
            <tr>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:5%;">Sl No.</th>
                <th style="border:1px solid #000; padding:4px; text-align:left; background-color:#f0f0f0; width:33%;">Description of Goods</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:12%;">Quantity</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:12%;">Rate</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:14%;">Rate (Incl. Tax)</th>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:7%;">Per</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:17%;">Amount</th>
            </tr>

            <!-- PRODUCT ROWS -->
            <t t-set="line_num" t-value="0"/>
            <t t-foreach="doc.get_printable_order_lines()" t-as="line">
                <t t-set="line_num" t-value="line_num + 1"/>
                <tr>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line_num"/>
                    <td style="border:1px solid #000; padding:4px;">
                        <t t-esc="line.name or ''"/>
                        <t t-set="made_in_country" t-value="line.made_in_country_id or (line.product_id and line.product_id.product_tmpl_id.made_country)"/>
                        <t t-if="made_in_country"><br/><t t-esc="'Made in ' + (made_in_country.name or '')"/></t>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.format_number(line.product_qty, digits=0)"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_unit, digits=2)"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_unit_incl, digits=2)"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line.product_uom.name or 'pcs'"/>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_subtotal, digits=2)"/>
                    </td>
                </tr>
            </t>

            <!-- TOTAL ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"><strong>Total</strong></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <strong><t t-esc="doc.format_number(total_qty, digits=0)"/> pcs</strong>
                </td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <strong><t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(total_usd, digits=2)"/></strong>
                </td>
            </tr>

            <!-- CURRENCY CONVERSION ROW -->
            <t t-if="po_has_exchange">
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:right;" colspan="7">
                    <strong>Total Invoice Amount in <t t-esc="invoice_currency.name or 'USD'"/> <t t-esc="doc.format_number(total_invoice_amount, digits=2)"/> @ <t t-esc="company_currency.name"/> <t t-esc="doc.format_number(po_large_rate, digits=4)"/> / 1 <t t-esc="company_currency.name"/> = <t t-esc="doc.format_number(po_small_rate, digits=4)"/> <t t-esc="invoice_currency.name or 'USD'"/></strong>
                </td>
            </tr>
            </t>

            <!-- AMOUNT IN WORDS ROW -->
            <tr>
                <td style="border:1px solid #000; padding:6px;" colspan="7">
                    Amount Chargeable (in words)<br/>
                    <strong>
                        <t t-esc="doc.get_amount_in_words_currency(total_invoice_amount, invoice_currency)"/>
                    </strong>
                </td>
            </tr>

            <!-- REMARKS + TERMS & CONDITIONS + SIGNATORY ROW -->
            <tr>
                <td style="border:1px solid #000; padding:6px; vertical-align:top;" colspan="4">
                    <t t-if="doc.ks_remarks">
                        <strong>Remarks</strong><br/>
                        <t t-esc="doc.ks_remarks"/><br/><br/>
                    </t>
                    <t t-if="doc.notes">
                        <strong>Terms &amp; Conditions</strong><br/>
                        <span t-out="doc.notes"/>
                    </t>
                </td>
                <td style="border:1px solid #000; padding:6px; text-align:center; vertical-align:bottom;" colspan="3">
                    <t t-set="company_stamp" t-value="(doc and doc.company_id and (doc.company_id.effective_stamp_image or doc.company_id.stamp_image or (doc.company_id.parent_id and doc.company_id.parent_id.stamp_image))) or (env.company and (env.company.effective_stamp_image or env.company.stamp_image or (env.company.parent_id and env.company.parent_id.stamp_image)))"/>
                    <div style="text-align:center; margin-bottom:4px;">
                        <t t-if="company_stamp">
                            <img t-att-src="image_data_uri(company_stamp)" style="max-height:60px; max-width:120px; vertical-align:middle; margin:0 4px;"/>
                            <br/>
                        </t>
                    </div>
                    for <t t-esc="doc.company_id.name or ''"/><br/><br/>
                    Authorised Signatory
                </td>
            </tr>

            <!-- COMPUTER GENERATED ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:center; font-size:10px;" colspan="7">
                    This is a Computer Generated Invoice
                </td>
            </tr>

        </table>

        </main>
        </t>
    </t>
</template>



</odoo>