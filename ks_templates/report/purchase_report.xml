<odoo>
<record id="paperformat_custom_purchase_order" model="report.paperformat">
            <field name="name">US Letter</field>
            <field name="default" eval="True" />
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
            <field name="css_margins" eval="True" />
        </record>
    <!-- Define the new report action for sale order -->
    <record id="action_report_purchase_custom" model="ir.actions.report">
        <field name="name">Purchase / Order Custom</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.purchase_order_custom_report</field>
        <field name="report_file">ks_templates.purchase_order_custom_report</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Custom Quotation - %s' % (object.name)) or 'Custom Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="paperformat_id" ref="paperformat_custom_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="purchase_order_custom_report">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="doc">
        <main>

        <!-- Variables -->
        <t t-set="total_qty" t-value="sum(line.product_qty for line in doc.order_line.filtered(lambda l: l.display_type not in ('line_section', 'line_note')))"/>
        <t t-set="total_usd" t-value="doc.amount_total"/>
        <t t-set="invoice_currency" t-value="doc.currency_id"/>
        <t t-set="company_currency" t-value="doc.company_id.currency_id"/>
        <t t-set="conversion_date" t-value="doc.date_order or doc.create_date.date()"/>
        <t t-set="total_invoice_amount" t-value="total_usd"/>
        <t t-set="converted_amount" t-value="total_usd"/>
        <t t-set="exchange_rate" t-value="1.0"/>
        <t t-set="company_to_invoice_rate" t-value="1.0"/>
        <t t-if="invoice_currency and company_currency and invoice_currency != company_currency">
            <t t-set="converted_amount" t-value="invoice_currency._convert(total_usd, company_currency, doc.company_id, conversion_date, round=True)"/>
            <t t-set="invoice_currency_rate" t-value="doc.env['res.currency']._get_conversion_rate(invoice_currency, company_currency, doc.company_id, conversion_date)"/>
            <t t-set="exchange_rate" t-value="invoice_currency_rate"/>
            <t t-set="company_to_invoice_rate" t-value="1.0 / invoice_currency_rate if invoice_currency_rate else 1.0"/>
        </t>
        <t t-set="exchange_currency_code" t-value="company_currency.name or 'AED'"/>
        <t t-set="invoice_amount_words" t-value="doc.get_amount_in_words_currency(total_invoice_amount, invoice_currency)"/>

        <!-- TITLE — kept separate -->
        <table style="width:100%; border-collapse:collapse; border-color:white;">
            <tr>
                <td style="text-align:center; font-weight:bold; font-size:14px;">
                    PURCHASE ORDER
                </td>
            </tr>
        </table>

        <!-- SINGLE UNIFIED TABLE (6 columns) -->
        <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:11px;">

            <!-- HEADER ROW: Company + Invoice Details -->
            <tr>
                <!-- LEFT SIDE -->
                <td style="width:55%; vertical-align:top; border:1px solid #000; padding:6px;" colspan="3">
                    Invoice To<br/>
                    <strong t-esc="doc.company_id.name or ''"/><br/>
                    <t t-if="doc.company_id.partner_id.street" t-esc="doc.company_id.partner_id.street"/><br/>
                    <t t-if="doc.company_id.partner_id.street2" t-esc="doc.company_id.partner_id.street2"/><br/>
                    <t t-if="doc.company_id.partner_id.city" t-esc="doc.company_id.partner_id.city"/>
                    <t t-if="doc.company_id.partner_id.city and doc.company_id.partner_id.country_id">, </t>
                    <t t-if="doc.company_id.partner_id.country_id" t-esc="doc.company_id.partner_id.country_id.name or ''"/><br/>
                    <t t-if="doc.company_id.partner_id.zip">P.O.Box <t t-esc="doc.company_id.partner_id.zip"/><br/></t>
                    <t t-if="doc.company_id.partner_id.state_id">Emirate : <t t-esc="doc.company_id.partner_id.state_id.name or ''"/><br/></t>
                    <t t-if="doc.company_id.vat">TRN : <t t-esc="doc.company_id.vat"/><br/></t>
                    <t t-if="doc.company_id.partner_id.email">E-Mail : <t t-esc="doc.company_id.partner_id.email"/></t>
                    <div style="border-top:1px solid black; height:1px;"/>
                    Consignee<br/>
                    <strong>Crown Logistics</strong><br/>
                    G12, Row G2, LIU, Dubai Airport Freezone, Dubai, U.A.E.<br/>
                    TRN: 100562443000003<br/><br/>
                    <div style="border-top:1px solid black; height:1px;"/>
                    Supplier<br/>
                    <strong t-esc="doc.partner_id.name or ''"/><br/>
                    <t t-if="doc.partner_id.street" t-esc="doc.partner_id.street"/><br/>
                    <t t-if="doc.partner_id.street2" t-esc="doc.partner_id.street2"/><br/>
                    <t t-if="doc.partner_id.city" t-esc="doc.partner_id.city"/>
                    <t t-if="doc.partner_id.city and doc.partner_id.state_id">, </t>
                    <t t-if="doc.partner_id.state_id" t-esc="doc.partner_id.state_id.name or ''"/>
                    <t t-if="doc.partner_id.city and doc.partner_id.country_id">, </t>
                    <t t-if="doc.partner_id.country_id" t-esc="doc.partner_id.country_id.name or ''"/><br/>
                    <t t-if="doc.partner_id.country_id">Country : <t t-esc="doc.partner_id.country_id.name or ''"/></t>
                </td>
                <!-- RIGHT SIDE -->
                <td style="width:45%; vertical-align:top; padding:0; border:1px solid #000;" colspan="3">
                    <table style="width:100%; border-collapse:collapse; border-color:white;">
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;">Voucher No.</td>
                            <td style="padding:1px;" colspan="3">Dated</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                            <td style="border-left:1px solid #000; padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.date_order" t-esc="doc.date_order.strftime('%d-%b-%y')"/>
                                    <t t-elif="doc.create_date" t-esc="doc.create_date.strftime('%d-%b-%y')"/>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;"></td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Mode/Terms of Payment</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"></td>
                            <td style="padding:1px;" colspan="3"><strong>100% Advance</strong></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Supplier's Ref./Order No.</td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Other Reference(s)</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                            <td style="padding:1px;" colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Despatch through</td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Destination</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px; height:11px;"></td>
                            <td style="padding:1px; height:11px;" colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="border-top:1px solid #000; padding:1px;" colspan="3"><strong>Terms of Delivery</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.notes">
                                        <span t-out="doc.notes"/>
                                    </t>
                                    <t t-else="">CIF Dubai, U.A.E.</t>
                                </strong>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <!-- PRODUCT TABLE HEADER -->
            <tr>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:5%;">Sl No.</th>
                <th style="border:1px solid #000; padding:4px; text-align:left; background-color:#f0f0f0; width:43%;">Description of Goods</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:15%;">Quantity</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:15%;">Rate</th>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:8%;">Per</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:14%;">Amount</th>
            </tr>

            <!-- PRODUCT ROWS -->
            <t t-set="line_num" t-value="0"/>
            <t t-foreach="doc.order_line.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">
                <t t-set="line_num" t-value="line_num + 1"/>
                <tr>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line_num"/>
                    <td style="border:1px solid #000; padding:4px;">
                        <t t-esc="line.name or ''"/>
                        <t t-set="made_in_country" t-value="line.made_in_country_id or (line.product_id and line.product_id.product_tmpl_id.made_country)"/>
                        <t t-if="made_in_country"><br/><t t-esc="'Made in ' + (made_in_country.name or '')"/></t>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.format_number(line.product_qty, digits=0)"/> <t t-esc="line.product_uom.name or 'pcs'"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_unit, digits=2)"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line.product_uom.name or 'pcs'"/>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_subtotal, digits=2)"/>
                    </td>
                </tr>
            </t>

            <!-- TOTAL ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"><strong>Total</strong></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <strong><t t-esc="doc.format_number(total_qty, digits=0)"/> pcs</strong>
                </td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <strong><t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(total_usd, digits=2)"/></strong>
                </td>
            </tr>

            <!-- CURRENCY CONVERSION ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:right;" colspan="6">
                    <strong>Total Invoice Amount in <t t-esc="invoice_currency.name or 'USD'"/> <t t-esc="doc.format_number(total_invoice_amount, digits=2)"/> @ <t t-esc="company_currency.name or 'AED'"/> <t t-esc="doc.format_number(exchange_rate, digits=3)"/> / 1 <t t-esc="company_currency.name or 'AED'"/> = <t t-esc="doc.format_number(company_to_invoice_rate, digits=4)"/> <t t-esc="invoice_currency.name or 'USD'"/> = <t t-esc="company_currency.name or 'AED'"/> <t t-esc="doc.format_number(converted_amount, digits=2)"/></strong>
                </td>
            </tr>

            <!-- AMOUNT IN WORDS ROW -->
            <tr>
                <td style="border:1px solid #000; padding:6px;" colspan="6">
                    Amount Chargeable (in words)<br/>
                    <strong>
                        <t t-esc="invoice_amount_words or ''"/> (<t t-esc="exchange_currency_code + ' ' + doc.format_number(converted_amount, digits=2)"/>)
                    </strong>
                </td>
            </tr>

            <!-- REMARKS + SIGNATORY ROW -->
            <tr>
                <td style="border:1px solid #000; padding:6px; vertical-align:top;" colspan="3">
                    <strong>Remarks:</strong><br/>
                    all neat &amp; clean stocks will be accepted.<br/>
                    Dirty, damage will not be accepted and will be retuned back
                </td>
                <td style="border:1px solid #000; padding:6px; text-align:center; vertical-align:bottom;" colspan="3">
                    <t t-if="doc.ks_authorised_signatory">
                        <img t-att-src="image_data_uri(doc.ks_authorised_signatory)"
                             style="max-height:60px; max-width:180px; display:block; margin:0 auto 4px auto;"/>
                    </t>
                    for <t t-esc="doc.company_id.name or ''"/><br/><br/>
                    Authorised Signatory
                </td>
            </tr>

            <!-- COMPUTER GENERATED ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:center; font-size:10px;" colspan="6">
                    This is a Computer Generated Invoice
                </td>
            </tr>

        </table>

        </main>
        </t>
    </t>
</template>



</odoo>