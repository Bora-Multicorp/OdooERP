<odoo>
<record id="paperformat_savex_purchase_order" model="report.paperformat">
            <field name="name">US Letter</field>
            <field name="default" eval="True" />
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
            <field name="css_margins" eval="True" />
        </record>
    <!-- Define the new report action for sale order -->
    <record id="action_report_purchase_savex" model="ir.actions.report">
        <field name="name">Import Purchase Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.purchase_order_savex_report</field>
        <field name="report_file">ks_templates.purchase_order_savex_report</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Custom Quotation - %s' % (object.name)) or 'Custom Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="paperformat_id" ref="paperformat_savex_purchase_order"/>
        <field name="domain">[('currency_id.name', '!=', 'INR'), ('state', 'in', ('purchase', 'done'))]</field>
        <field name="binding_type">report</field>
    </record>

    <!-- New report action for Purchase / without Discount Order -->
    <record id="action_report_purchase_without_discount" model="ir.actions.report">
        <field name="name">Purchase Order Domestic</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.purchase_order_without_discount_report</field>
        <field name="report_file">ks_templates.purchase_order_without_discount_report</field>
        <field name="print_report_name">'Purchase Order Domestic - %s' % (object.name)</field>
        <field name="domain">[('currency_id.name', '=', 'INR'), ('state', 'in', ('purchase', 'done'))]</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="paperformat_id" ref="paperformat_savex_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Shared content macro for both Discount and Without-Discount reports -->
    <template id="purchase_order_savex_common_content">
        <!-- Variables -->
        <t t-set="doc" t-value="doc.sudo()"/>
        <t t-set="total_qty" t-value="sum(line.product_qty for line in doc.get_printable_order_lines())"/>
        <t t-set="discount_amount" t-value="doc.get_discount_amount() if show_discount else 0.0"/>
        <t t-set="tax_info" t-value="doc.get_cgst_sgst_info()"/>
        <t t-set="tds_info" t-value="doc.get_tds_info()"/>
        <t t-set="round_off" t-value="doc.ks_round_off"/>
        <t t-set="svx_inv_currency" t-value="doc.currency_id.sudo()"/>
        <t t-set="svx_comp_currency" t-value="doc.company_id.sudo().currency_id.sudo()"/>
        <t t-set="svx_total_amount" t-value="doc.amount_total"/>
        <t t-set="svx_rate_info" t-value="doc.get_exchange_rate_info()"/>
        <t t-set="svx_has_exchange" t-value="svx_rate_info['has_exchange']"/>
        <t t-set="svx_large_rate" t-value="svx_rate_info['large_rate']"/>
        <t t-set="svx_small_rate" t-value="svx_rate_info['small_rate']"/>

        <!-- TITLE — kept separate -->
        <table style="width:100%; border-collapse:collapse; border-color:white; margin-bottom:4px;">
            <tr>
                <td style="text-align:center; font-weight:bold; font-size:14px;">PURCHASE ORDER</td>
            </tr>
        </table>

        <!-- SINGLE UNIFIED TABLE (7 columns) -->
        <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:11px;">

            <!-- HEADER ROW -->
            <tr>
                <td style="width:55%; vertical-align:top; border:1px solid #000; padding:6px;" colspan="4">
                    Invoice To<br/>
                    <t t-set="bill_to" t-value="(doc.bill_to_id or doc.company_id.sudo().partner_id).sudo()"/>
                    <strong t-esc="doc.get_bill_to_company_name()"/><br/>
                    <t t-if="bill_to.street" t-esc="bill_to.street"/><br/>
                    <t t-if="bill_to.street2" t-esc="bill_to.street2"/><br/>
                    <t t-if="bill_to.city" t-esc="bill_to.city"/>
                    <t t-if="bill_to.city and bill_to.state_id">, </t>
                    <t t-if="bill_to.state_id" t-esc="bill_to.state_id.name or ''"/><br/>
                    <t t-if="bill_to.vat">
                        <t t-if="bill_to.country_id and bill_to.country_id.code == 'IN'">GSTIN/UIN : </t>
                        <t t-else="">TRN : </t>
                        <t t-esc="bill_to.vat"/><br/>
                    </t>
                    <t t-if="bill_to.state_id">State Name : <t t-esc="bill_to.state_id.name or ''"/><t t-if="bill_to.state_id.l10n_in_tin">, Code : <t t-esc="bill_to.state_id.l10n_in_tin"/></t><br/></t>
                    <t t-set="bill_to_pan" t-value="bill_to.l10n_in_pan or doc.get_company_pan()"/>
                    <t t-if="bill_to_pan">PAN : <t t-esc="bill_to_pan"/><br/></t>
                    <t t-set="company_iec" t-value="doc.get_company_iec()"/>
                    <t t-if="company_iec">IEC No : <t t-esc="company_iec"/><br/></t>
                    <t t-if="bill_to.email">E-Mail : <t t-esc="bill_to.email"/><br/></t>
                    <t t-if="bill_to.phone">Phone : <t t-esc="bill_to.phone"/><br/></t>
                    <div style="border-top:1px solid black; height:1px;"/>
                    <t t-set="consignee" t-value="(doc.picking_type_id.sudo().warehouse_id.sudo().partner_id or doc.dest_address_id or doc.company_id.sudo().partner_id).sudo()"/>
                    <strong>Consignee (Ship to)</strong><br/>
                    <strong t-esc="doc.get_ship_to_company_name()"/><br/>
                    <t t-if="consignee and consignee.street and consignee.street != consignee.name" t-esc="consignee.street"/><br/>
                    <t t-if="consignee and consignee.street2 and consignee.street2 != consignee.name" t-esc="consignee.street2"/><br/>
                    <t t-if="consignee and consignee.city" t-esc="consignee.city"/>
                    <t t-if="consignee and consignee.state_id">, <t t-esc="consignee.state_id.name or ''"/></t><br/>
                    <t t-if="consignee and consignee.country_id" t-esc="consignee.country_id.name or ''"/><t t-if="consignee and consignee.zip"> - <t t-esc="consignee.zip"/></t><br/>
                    <t t-if="consignee and consignee.vat">
                        <t t-if="consignee.country_id and consignee.country_id.code == 'IN'">GSTIN/UIN : </t>
                        <t t-else="">TRN : </t>
                        <t t-esc="consignee.vat"/><br/>
                    </t>
                    <t t-if="consignee and consignee.phone">Phone : <t t-esc="consignee.phone"/><br/></t>
                    <t t-if="consignee and consignee.email">E-Mail : <t t-esc="consignee.email"/><br/></t>
                    <div style="border-top:1px solid black; height:1px;"/>
                    Supplier (Bill from)<br/>
                    <strong t-esc="doc.partner_id.sudo().name or ''"/><br/>
                    <t t-if="doc.partner_id.sudo().street" t-esc="doc.partner_id.sudo().street"/><br/>
                    <t t-if="doc.partner_id.sudo().street2" t-esc="doc.partner_id.sudo().street2"/><br/>
                    <t t-if="doc.partner_id.sudo().city" t-esc="doc.partner_id.sudo().city"/>
                    <t t-if="doc.partner_id.sudo().city and doc.partner_id.sudo().state_id">, </t>
                    <t t-if="doc.partner_id.sudo().state_id" t-esc="doc.partner_id.sudo().state_id.sudo().name or ''"/><br/>
                    <t t-if="doc.partner_id.sudo().vat">GSTIN/UIN : <t t-esc="doc.partner_id.sudo().vat"/><br/></t>
                    <t t-if="doc.partner_id.sudo().state_id">State Name : <t t-esc="doc.partner_id.sudo().state_id.sudo().name or ''"/><t t-if="doc.partner_id.sudo().state_id.sudo().l10n_in_tin">, Code : <t t-esc="doc.partner_id.sudo().state_id.sudo().l10n_in_tin"/></t><br/></t>
                    <t t-if="doc.partner_id.sudo().l10n_in_pan">PAN : <t t-esc="doc.partner_id.sudo().l10n_in_pan"/></t>

                </td>
                <td style="width:45%; vertical-align:top; padding:0; border:1px solid #000;" colspan="4">
                    <table style="width:100%; border-collapse:collapse; border-color:white;">
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;">Voucher No.</td>
                            <td style="padding:1px;" colspan="3">Dated</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                            <td style="border-left:1px solid #000; padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.date_order" t-esc="doc.date_order.strftime('%d/%m/%Y')"/>
                                    <t t-elif="doc.create_date" t-esc="doc.create_date.strftime('%d/%m/%Y')"/>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;"></td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Mode/Terms of Payment</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"></td>
                            <td style="padding:1px;" colspan="3"><strong><t t-esc="doc.payment_term_id.name or ''"/></strong></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Reference No. &amp; Date.</td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Other Reference(s)</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                            <td style="padding:1px;" colspan="3"><strong t-esc="doc.user_id.name or ''"/></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Dispatched through</td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Destination</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px; height:11px;"><strong t-esc="doc.ks_despatched_through or ''"/></td>
                            <td style="padding:1px; height:11px;" colspan="3"><strong t-esc="doc.ks_destination or ''"/></td>
                        </tr>
                        <tr>
                            <td style="border-top:1px solid #000; padding:1px;" colspan="3"><strong>Terms of Delivery</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.incoterm_id">
                                        [<t t-esc="doc.incoterm_id.code or ''"/>] <t t-esc="doc.incoterm_id.name or ''"/>
                                    </t>
                                </strong>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <!-- PRODUCT HEADER -->
            <tr>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:5%;">Sl No.</th>
                <th style="border:1px solid #000; padding:4px; text-align:left; background-color:#f0f0f0; width:28%;">Description of Goods and Services</th>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:9%;">HSN/SAC</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:11%;">Quantity</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:11%;">Rate</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:13%;">Rate (Incl. Tax)</th>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:7%;">Per</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:16%;">Amount</th>
            </tr>

            <!-- PRODUCT ROWS -->
            <t t-set="line_num" t-value="0"/>
            <t t-foreach="doc.get_printable_order_lines()" t-as="line">
                <t t-set="line_num" t-value="line_num + 1"/>
                <tr>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line_num"/>
                    <td style="border:1px solid #000; padding:4px;">
                        <t t-esc="line.name or ''"/>
                        <t t-set="made_in_country" t-value="line.made_in_country_id or (line.product_id and line.product_id.product_tmpl_id.made_country)"/>
                        <t t-if="made_in_country"><br/><t t-esc="'Made in ' + (made_in_country.name or '')"/></t>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:center;"><t t-esc="doc.get_line_hsn_code(line)"/></td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.format_number(line.product_qty, digits=2)"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '₹'"/> <t t-esc="doc.format_number(line.price_unit, digits=2)"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '₹'"/> <t t-esc="doc.format_number(line.price_unit_incl, digits=2)"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line.product_uom.name or 'NOS'"/>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '₹'"/> <t t-esc="doc.format_number(line.price_subtotal, digits=2)"/>
                    </td>
                </tr>
            </t>

            <!-- TAX / DISCOUNT / TDS ROW -->
            <t t-set="gst_summary" t-value="doc.get_purchase_gst_summary()"/>
            <t t-if="show_tax_rows">
            <tr>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;">
                    <t t-if="show_discount and discount_amount > 0">Less: Discount Before GST/IGST<br/></t>
                    <t t-foreach="gst_summary" t-as="gst_row">
                        <t t-esc="gst_row['name']"/><br/>
                    </t>
                    <t t-if="tds_info['tds_amount'] > 0">Less: <t t-esc="tds_info['tds_name']"/><br/></t>
                    <t t-if="show_round_off">Round Off</t>
                </td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <t t-if="show_discount and discount_amount > 0"><br/></t>
                    <t t-foreach="gst_summary" t-as="gst_row"><br/></t>
                    <t t-if="tds_info['tds_amount'] > 0"><br/></t>
                </td>
                <td style="border:1px solid #000; padding:4px; text-align:center;">
                    <t t-if="show_discount and discount_amount > 0"><br/></t>
                    <t t-foreach="gst_summary" t-as="gst_row"><br/></t>
                    <t t-if="tds_info['tds_amount'] > 0"><br/></t>
                </td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <t t-if="show_discount and discount_amount > 0">(-)<t t-esc="doc.format_number(discount_amount, digits=2)"/><br/></t>
                    <t t-foreach="gst_summary" t-as="gst_row">
                        <t t-esc="doc.format_number(gst_row['amount'], digits=2)"/><br/>
                    </t>
                    <t t-if="tds_info['tds_amount'] > 0">(-)<t t-esc="doc.format_number(tds_info['tds_amount'], digits=2)"/><br/></t>
                    <t t-if="show_round_off">
                        <t t-if="round_off != 0">
                            <t t-if="round_off &gt; 0">(-)</t><t t-esc="doc.format_number(abs(round_off), digits=2)"/>
                        </t>
                        <t t-else="">0.00</t>
                    </t>
                </td>
            </tr>
            </t>

            <!-- TOTAL ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"><strong>Total</strong></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;"><strong><t t-esc="doc.format_number(total_qty, digits=2)"/></strong></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px; text-align:center;"><strong>NOS</strong></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <strong><t t-esc="doc.currency_id.symbol or '₹'"/> <t t-esc="doc.format_number(doc.amount_total, digits=2)"/></strong>
                </td>
            </tr>

            <!-- CURRENCY CONVERSION ROW -->
            <t t-if="svx_has_exchange">
            <t t-set="svx_inr_amount" t-value="svx_total_amount * svx_large_rate"/>
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:right;" colspan="8">
                    <strong>
                        Total Invoice Amount in
                        <t t-esc="svx_inv_currency.symbol or svx_inv_currency.name or 'USD'"/>
                        <t t-esc="doc.format_number(svx_total_amount, digits=3)"/>
                        @ INR <t t-esc="doc.format_number(svx_large_rate, digits=4)"/>/<t t-esc="svx_inv_currency.symbol or svx_inv_currency.name or 'USD'"/>
                        = INR <t t-esc="doc.format_number(svx_inr_amount, digits=2)"/>
                    </strong>
                </td>
            </tr>
            </t>

            <!-- AMOUNT IN WORDS ROW -->
            <t t-set="svx_words_amount" t-value="svx_total_amount * svx_large_rate if svx_has_exchange else svx_total_amount"/>
            <t t-set="svx_inr_currency" t-value="env['res.currency'].search([('name', '=', 'INR')], limit=1)"/>
            <t t-set="svx_words_currency" t-value="svx_inr_currency if svx_has_exchange else svx_inv_currency"/>
            <tr>
                <td style="border:1px solid #000; padding:6px;" colspan="8">
                    Amount Chargeable (in words)<br/>
                    <strong><t t-esc="doc.get_amount_in_words_currency(svx_words_amount, svx_words_currency)"/></strong>
                </td>
            </tr>

            <!-- REMARKS + TERMS & CONDITIONS + SIGNATORY ROW -->
            <tr>
                <td style="border:1px solid #000; padding:6px; vertical-align:top;" colspan="4">
                    <t t-if="doc.ks_remarks">
                        <strong>Remarks:</strong><br/>
                        <t t-out="doc.ks_remarks"/><br/><br/>
                    </t>
                    <t t-if="doc.notes">
                        <strong>Terms &amp; Conditions:</strong><br/>
                        <span t-out="doc.notes"/>
                    </t>
                </td>
                <td style="border:1px solid #000; padding:6px; text-align:center; vertical-align:bottom;" colspan="4">
                    <t t-set="company_stamp" t-value="(doc and doc.company_id and (doc.company_id.effective_stamp_image or doc.company_id.stamp_image or (doc.company_id.parent_id and doc.company_id.parent_id.stamp_image))) or (env.company and (env.company.effective_stamp_image or env.company.stamp_image or (env.company.parent_id and env.company.parent_id.stamp_image)))"/>
                    <div style="text-align:center; margin-bottom:4px;">
                        <t t-if="company_stamp">
                            <img t-att-src="image_data_uri(company_stamp)" style="max-height:60px; max-width:120px; vertical-align:middle; margin:0 4px;"/>
                            <br/>
                        </t>
                    </div>
                    for <t t-esc="doc.company_id.name or ''"/><br/><br/>
                    Authorised Signatory
                </td>
            </tr>

            <!-- COMPUTER GENERATED ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:center; font-size:10px;" colspan="8">
                    This is a Computer Generated Invoice
                </td>
            </tr>

        </table>
    </template>

    <template id="purchase_order_savex_report">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="doc">
        <main>
            <t t-set="show_discount" t-value="True"/>
            <t t-set="show_round_off" t-value="False"/>
            <t t-set="show_tax_rows" t-value="False"/>
            <t t-call="ks_templates.purchase_order_savex_common_content"/>
        </main>
        </t>
    </t>
    </template>

    <!-- Template for Purchase / without Discount Order -->
    <template id="purchase_order_without_discount_report">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="doc">
        <main>
            <t t-set="show_discount" t-value="False"/>
            <t t-set="show_round_off" t-value="False"/>
            <t t-set="show_tax_rows" t-value="True"/>
            <t t-call="ks_templates.purchase_order_savex_common_content"/>
        </main>
        </t>
    </t>
    </template>



</odoo>