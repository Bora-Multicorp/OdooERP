               vertical-align:bottom;
text-align:right;padding-right:4px;">
        for BORA ELECTRONICS FZCO
        <br/><br/>
        Authorised Signatory
    </td>
</tr>
        </table>



        </main>
        </t>
        <footer class="pt-0">

                <p style="text-align:center; font-size:10px;">
                    This is a Computer Generated Invoice
                </p>

         </footer>
    </t>

</template>

