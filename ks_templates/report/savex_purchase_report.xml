                </td>
                <td style="border:1px solid #000; text-align:right;"></td>
                <td style="border:1px solid #000; text-align:center;"></td>
                <td style="border:1px solid #000; text-align:right;padding-right:4px;">
                    <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(doc.amount_total, digits=2)"/>
                </td>
            </tr>
            <tr>
                    <td style="width:100%; border-top:1px solid #000;border-bottom:1px solid white;border-left:1px solid #000;border-right:1px solid #000; padding:6px;"
                        colspan="7">
                        Amount Chargeable (in words)
                        <br/>
                        <strong>
                            <t t-esc="doc.get_amount_in_words_inr(doc.amount_total)"/> (INR <t t-esc="doc.format_number(doc.amount_total, digits=2)"/>)
                        </strong>
                    </td>
            </tr>
            <tr>
                    <td style="width:100%; border-left:1px solid #000;border-right:1px solid #000; padding:6px;height:40px;"
                        colspan="7">

                    </td>
            </tr>
            <tr>
                    <td style="width:100%; border-left:1px solid #000;border-right:1px solid #000;border-top:1px solid white; padding:6px;padding-left:4px;text-align:left;"
                        colspan="7">
                         Remarks:<br/>
                        all neat &amp; clean stocks will be accepted.<br/>
                        Dirty, damage will not be accepted and will be retuned back
                    </td>
            </tr>
