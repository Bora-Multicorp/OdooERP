<odoo>
<record id="paperformat_savex_purchase_order" model="report.paperformat">
            <field name="name">US Letter</field>
            <field name="default" eval="True" />
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
            <field name="css_margins" eval="True" />
        </record>
    <!-- Define the new report action for sale order -->
    <record id="action_report_purchase_savex" model="ir.actions.report">
        <field name="name">Purchase / Discount Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.purchase_order_savex_report</field>
        <field name="report_file">ks_templates.purchase_order_savex_report</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Custom Quotation - %s' % (object.name)) or 'Custom Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="paperformat_id" ref="paperformat_savex_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- New report action for Purchase / without Discount Order -->
    <record id="action_report_purchase_without_discount" model="ir.actions.report">
        <field name="name">Purchase / without Discount Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.purchase_order_without_discount_report</field>
        <field name="report_file">ks_templates.purchase_order_without_discount_report</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Custom Quotation - %s' % (object.name)) or 'Custom Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="paperformat_id" ref="paperformat_savex_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Shared content macro for both Discount and Without-Discount reports -->
    <template id="purchase_order_savex_common_content">
        <!-- Variables -->
        <t t-set="total_qty" t-value="sum(line.product_qty for line in doc.order_line.filtered(lambda l: l.display_type not in ('line_section', 'line_note')))"/>
        <t t-set="discount_amount" t-value="doc.get_discount_amount() if show_discount else 0.0"/>
        <t t-set="tax_info" t-value="doc.get_cgst_sgst_info()"/>
        <t t-set="tds_info" t-value="doc.get_tds_info()"/>
        <t t-set="round_off" t-value="doc.ks_round_off"/>

        <!-- TITLE — kept separate -->
        <table style="width:100%; border-collapse:collapse; border-color:white; margin-bottom:4px;">
            <tr>
                <td style="text-align:center; font-weight:bold; font-size:14px;">PURCHASE ORDER</td>
            </tr>
        </table>

        <!-- SINGLE UNIFIED TABLE (7 columns) -->
        <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:11px;">

            <!-- HEADER ROW -->
            <tr>
                <td style="width:55%; vertical-align:top; border:1px solid #000; padding:6px;" colspan="4">
                    Invoice To<br/>
                    <strong t-esc="doc.company_id.name or ''"/><br/>
                    <t t-if="doc.company_id.partner_id.street" t-esc="doc.company_id.partner_id.street"/><br/>
                    <t t-if="doc.company_id.partner_id.city" t-esc="doc.company_id.partner_id.city"/>
                    <t t-if="doc.company_id.partner_id.city and doc.company_id.partner_id.state_id">, </t>
                    <t t-if="doc.company_id.partner_id.state_id" t-esc="doc.company_id.partner_id.state_id.name or ''"/><br/>
                    <t t-if="doc.company_id.vat">GSTIN/UIN: <t t-esc="doc.company_id.vat"/><br/></t>
                    <t t-if="doc.company_id.partner_id.state_id">State Name : <t t-esc="doc.company_id.partner_id.state_id.name or ''"/><t t-if="doc.company_id.partner_id.state_id.code">, Code : <t t-esc="doc.company_id.partner_id.state_id.code"/></t></t>
                    <div style="border-top:1px solid black; height:1px;"/>
                    <strong>Consignee (Ship to)</strong><br/>
                    <strong t-esc="doc.dest_address_id.name or doc.company_id.name or ''"/><br/>
                    <t t-if="doc.dest_address_id and doc.dest_address_id.street" t-esc="doc.dest_address_id.street"/><br/>
                    <t t-if="doc.dest_address_id and doc.dest_address_id.city" t-esc="doc.dest_address_id.city"/>
                    <t t-if="doc.dest_address_id and doc.dest_address_id.state_id">, <t t-esc="doc.dest_address_id.state_id.name or ''"/></t><br/>
                    <div style="border-top:1px solid black; height:1px;"/>
                    Supplier (Bill from)<br/>
                    <strong t-esc="doc.partner_id.name or ''"/><br/>
                    <t t-if="doc.partner_id.street" t-esc="doc.partner_id.street"/><br/>
                    <t t-if="doc.partner_id.street2" t-esc="doc.partner_id.street2"/><br/>
                    <t t-if="doc.partner_id.city" t-esc="doc.partner_id.city"/>
                    <t t-if="doc.partner_id.city and doc.partner_id.state_id">, </t>
                    <t t-if="doc.partner_id.state_id" t-esc="doc.partner_id.state_id.name or ''"/><br/>
                    <t t-if="doc.partner_id.vat">GSTIN/UIN : <t t-esc="doc.partner_id.vat"/><br/></t>
                    <t t-if="doc.partner_id.state_id">State Name : <t t-esc="doc.partner_id.state_id.name or ''"/><t t-if="doc.partner_id.state_id.code">, Code : <t t-esc="doc.partner_id.state_id.code"/></t></t>
                </td>
                <td style="width:45%; vertical-align:top; padding:0; border:1px solid #000;" colspan="3">
                    <table style="width:100%; border-collapse:collapse; border-color:white;">
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;">Voucher No.</td>
                            <td style="padding:1px;" colspan="3">Dated</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                            <td style="border-left:1px solid #000; padding:1px;" colspan="3">
                                <strong>
                                    <t t-if="doc.date_order" t-esc="doc.date_order.strftime('%d-%b-%y')"/>
                                    <t t-elif="doc.create_date" t-esc="doc.create_date.strftime('%d-%b-%y')"/>
                                </strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;"></td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Mode/Terms of Payment</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"></td>
                            <td style="padding:1px;" colspan="3"><strong><t t-esc="doc.payment_term_id.name or '100% Advance'"/></strong></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Reference No. &amp; Date.</td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Other Reference(s)</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                            <td style="padding:1px;" colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Despatched through</td>
                            <td style="border-left:1px solid #000; border-top:1px solid #000; padding:1px;" colspan="3">Destination</td>
                        </tr>
                        <tr>
                            <td style="border-right:1px solid #000; padding:1px; height:11px;"></td>
                            <td style="padding:1px; height:11px;" colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="border-top:1px solid #000; padding:1px;" colspan="3"><strong>Terms of Delivery</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:1px;" colspan="3">
                                <t t-if="doc.notes"><span t-out="doc.notes"/></t>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <!-- PRODUCT HEADER -->
            <tr>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:5%;">Sl No.</th>
                <th style="border:1px solid #000; padding:4px; text-align:left; background-color:#f0f0f0; width:35%;">Description of Goods and Services</th>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:10%;">HSN/SAC</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:13%;">Quantity</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:13%;">Rate</th>
                <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:8%;">Per</th>
                <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:16%;">Amount</th>
            </tr>

            <!-- PRODUCT ROWS -->
            <t t-set="line_num" t-value="0"/>
            <t t-foreach="doc.order_line.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">
                <t t-set="line_num" t-value="line_num + 1"/>
                <tr>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line_num"/>
                    <td style="border:1px solid #000; padding:4px;">
                        <t t-esc="line.name or ''"/>
                        <t t-set="made_in_country" t-value="line.made_in_country_id or (line.product_id and line.product_id.product_tmpl_id.made_country)"/>
                        <t t-if="made_in_country"><br/><t t-esc="'Made in ' + (made_in_country.name or '')"/></t>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:center;"><t t-esc="doc.get_line_hsn_code(line)"/></td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.format_number(line.product_qty, digits=2)"/> <t t-esc="line.product_uom.name or 'NOS'"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '₹'"/> <t t-esc="doc.format_number(line.price_unit, digits=2)"/>
                    </td>
                    <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line.product_uom.name or 'NOS'"/>
                    <td style="border:1px solid #000; padding:4px; text-align:right;">
                        <t t-esc="doc.currency_id.symbol or '₹'"/> <t t-esc="doc.format_number(line.price_subtotal, digits=2)"/>
                    </td>
                </tr>
            </t>

            <!-- TAX / DISCOUNT / TDS ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;">
                    <t t-if="show_discount and discount_amount > 0">Less: Discount Before GST/IGST<br/></t>
                    Input CGST @ <t t-esc="doc.format_number(tax_info['cgst_rate'], digits=2)"/>%<br/>
                    Input SGST @ <t t-esc="doc.format_number(tax_info['sgst_rate'], digits=2)"/>%<br/>
                    <t t-if="tds_info['tds_amount'] > 0">Less: <t t-esc="tds_info['tds_name']"/><br/></t>
                    Round Off
                </td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <t t-if="show_discount and discount_amount > 0"><br/></t>
                    <t t-esc="doc.format_number(tax_info['cgst_rate'], digits=2)"/><br/>
                    <t t-esc="doc.format_number(tax_info['sgst_rate'], digits=2)"/><br/>
                    <t t-if="tds_info['tds_amount'] > 0"><br/></t>
                </td>
                <td style="border:1px solid #000; padding:4px; text-align:center;">
                    <t t-if="show_discount and discount_amount > 0"><br/></t>
                    %<br/>
                    %<br/>
                    <t t-if="tds_info['tds_amount'] > 0"><br/></t>
                </td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <t t-if="show_discount and discount_amount > 0">(-)<t t-esc="doc.format_number(discount_amount, digits=2)"/><br/></t>
                    <t t-esc="doc.format_number(tax_info['cgst_amount'], digits=2)"/><br/>
                    <t t-esc="doc.format_number(tax_info['sgst_amount'], digits=2)"/><br/>
                    <t t-if="tds_info['tds_amount'] > 0">(-)<t t-esc="doc.format_number(tds_info['tds_amount'], digits=2)"/><br/></t>
                    <t t-if="round_off != 0">
                        <t t-if="round_off &gt; 0">(-)</t><t t-esc="doc.format_number(abs(round_off), digits=2)"/>
                    </t>
                    <t t-else="">0.00</t>
                </td>
            </tr>

            <!-- TOTAL ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"><strong>Total</strong></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;"><strong><t t-esc="doc.format_number(total_qty, digits=2)"/> NOS</strong></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px;"></td>
                <td style="border:1px solid #000; padding:4px; text-align:right;">
                    <strong><t t-esc="doc.currency_id.symbol or '₹'"/> <t t-esc="doc.format_number(doc.amount_total, digits=2)"/></strong>
                </td>
            </tr>

            <!-- AMOUNT IN WORDS ROW -->
            <tr>
                <td style="border:1px solid #000; padding:6px;" colspan="7">
                    Amount Chargeable (in words)<br/>
                    <strong><t t-esc="doc.get_amount_in_words_inr(doc.amount_total)"/> (INR <t t-esc="doc.format_number(doc.amount_total, digits=2)"/>)</strong>
                </td>
            </tr>

            <!-- REMARKS + SIGNATORY ROW -->
            <tr>
                <td style="border:1px solid #000; padding:6px; vertical-align:top;" colspan="4">
                    <strong>Remarks:</strong><br/>
                    all neat &amp; clean stocks will be accepted.<br/>
                    Dirty, damage will not be accepted and will be retuned back
                </td>
                <td style="border:1px solid #000; padding:6px; text-align:center; vertical-align:bottom;" colspan="3">
                    <t t-if="doc.ks_authorised_signatory">
                        <img t-att-src="image_data_uri(doc.ks_authorised_signatory)"
                             style="max-height:60px; max-width:180px; display:block; margin:0 auto 4px auto;"/>
                    </t>
                    for <t t-esc="doc.company_id.name or ''"/><br/><br/>
                    Authorised Signatory
                </td>
            </tr>

            <!-- COMPUTER GENERATED ROW -->
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:center; font-size:10px;" colspan="7">
                    This is a Computer Generated Invoice
                </td>
            </tr>

        </table>
    </template>

    <template id="purchase_order_savex_report">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="doc">
        <main>
            <t t-set="show_discount" t-value="True"/>
            <t t-call="ks_templates.purchase_order_savex_common_content"/>
        </main>
        </t>
    </t>
    </template>

    <!-- Template for Purchase / without Discount Order -->
    <template id="purchase_order_without_discount_report">
    <t t-call="web.basic_layout">
        <t t-foreach="docs" t-as="doc">
        <main>
            <t t-set="show_discount" t-value="False"/>
            <t t-call="ks_templates.purchase_order_savex_common_content"/>
        </main>
        </t>
    </t>
    </template>



</odoo>