                        <t t-esc="doc.format_number(tax_info['cgst_rate'], digits=2)"/><br/>
                    </t>
                    <t t-if="tax_info['sgst_amount'] > 0">
                        <t t-esc="doc.format_number(tax_info['sgst_rate'], digits=2)"/><br/>
                    </t>
                    <t t-if="tds_info['tds_amount'] > 0"><br/></t>
                </td>
                <td style="border:1px solid #000; text-align:center;">
                    <t t-if="tax_info['cgst_amount'] > 0">%<br/></t>
                    <t t-if="tax_info['sgst_amount'] > 0">%<br/></t>
                    <t t-if="tds_info['tds_amount'] > 0"><br/></t>
                </td>
                <td style="border:1px solid #000; text-align:right;padding-right:4px;">
                    <t t-if="tax_info['cgst_amount'] > 0">
                        <t t-esc="doc.format_number(tax_info['cgst_amount'], digits=2)"/><br/>
                    </t>
                    <t t-if="tax_info['sgst_amount'] > 0">
                        <t t-esc="doc.format_number(tax_info['sgst_amount'], digits=2)"/><br/>
                    </t>
                    <t t-if="tds_info['tds_amount'] > 0">
                        (-)<t t-esc="doc.format_number(tds_info['tds_amount'], digits=2)"/><br/>
                    </t>
                    <t t-set="round_off" t-value="doc.amount_total - (doc.amount_untaxed + doc.amount_tax - tds_info['tds_amount'])"/>
                    <t t-if="round_off != 0">
                        <t t-if="round_off &lt; 0">(-)</t><t t-esc="doc.format_number(abs(round_off), digits=2)"/>
                    </t>
                </td>
            </tr>

            <!-- TOTAL -->
            <t t-set="total_qty" t-value="sum(line.product_qty for line in doc.order_line.filtered(lambda l: l.display_type not in ('line_section', 'line_note')))"/>
            <tr>
