<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Dubai Quotation / Order PDF: add Sale Order Bank Information (ks_bank_id) -->
    <template id="report_saleorder_dubai_inherit_bank" inherit_id="ks_templates.report_saleorder_dubai">
        <!-- Add Bank Information section (Sale Order selected bank) before Company's Bank Details row -->
        <xpath expr="//tr[.//strong[contains(text(), &quot;Company's Bank Details&quot;)]]" position="before">
            <tr t-if="doc.ks_bank_id">
                <td style="border:1px solid #000; padding:6px; font-size:10pt; background-color:#f8f8f8;" colspan="2">
                    <strong>Bank Information</strong><br/>
                    Bank Name : <t t-esc="doc.ks_bank_id.name or ''"/><br/>
                    Account Number / BIC / Swift : <t t-esc="doc.ks_bank_id.bic or ''"/>
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
