                        <!--                        </tr>-->
                        <!--                        <tr>-->
                        <!--                            <td style="border:1px solid #000; padding:4px;"><strong>Despatched through</strong></td>-->
                        <!--                            <td style="border:1px solid #000; padding:4px;"></td>-->
                        <!--                            <td style="border:1px solid #000; padding:4px;"><strong>Destination</strong></td>-->
                        <!--                            <td style="border:1px solid #000; padding:4px;"></td>-->
                        <!--                        </tr>-->
                        <!--                        <tr>-->
                        <!--                            <td style="border:1px solid #000; padding:4px;"><strong>Terms of Delivery</strong></td>-->
                        <!--                            <td colspan="3" style="border:1px solid #000; padding:4px;">-->
                        <!--                                <strong>Delivery - Dafza to Dafza</strong><br/>-->
                        <!--                                At - Captains Freight Services-->
                        <!--                            </td>-->
                        <!--                        </tr>-->
                        <!--                    </table>-->
