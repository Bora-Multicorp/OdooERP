<odoo>
    <record id="paperformat_without_gst_invoice" model="report.paperformat">
        <field name="name">US Letter</field>
        <field name="default" eval="True"/>
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="action_report_without_gst_invoice" model="ir.actions.report">
        <field name="name">Without GST Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ks_templates.without_gst_invoice_report</field>
        <field name="report_file">ks_templates.without_gst_invoice_report</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Custom Quotation - %s' % (object.name)) or 'Custom Order - %s' % (object.name)
        </field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="paperformat_id" ref="paperformat_without_gst_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <template id="without_gst_invoice_report">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
            <main>
                <!-- Variables set once at top -->
                <t t-set="nogst_sale" t-value="doc.get_sale_order_info()"/>
                <t t-set="sale_order" t-value="nogst_sale"/>
                <t t-set="delivery_partner" t-value="doc.partner_shipping_id or doc.partner_id"/>
                <t t-set="total_qty" t-value="sum(line.quantity for line in doc.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note')))"/>
                <t t-set="total_amount" t-value="doc.amount_total"/>
                <t t-set="invoice_currency" t-value="doc.currency_id"/>
                <t t-set="company_currency" t-value="doc.company_id.currency_id"/>
                <t t-set="conversion_date" t-value="doc.invoice_date or doc.date or doc.create_date.date()"/>
                <t t-set="invoice_currency_rate" t-value="doc.invoice_currency_rate or 1.0"/>
                <t t-set="converted_amount" t-value="total_amount"/>
                <t t-set="exchange_rate" t-value="1.0"/>
                <t t-set="company_to_invoice_rate" t-value="invoice_currency_rate"/>
                <t t-if="invoice_currency and company_currency and invoice_currency != company_currency">
                    <t t-set="converted_amount" t-value="invoice_currency._convert(total_amount, company_currency, doc.company_id, conversion_date, round=True)"/>
                    <t t-set="exchange_rate" t-value="1.0 / invoice_currency_rate"/>
                </t>
                <t t-set="bank_info" t-value="doc.get_company_bank_info()"/>

                <!-- TITLE — kept separate as requested -->
                <table style="width:100%; border-collapse:collapse; border-color:white;">
                    <tr>
                        <td style="text-align:center; font-weight:bold; font-size:16px;">
                            EXPORT INVOICE
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align:center; font-weight:bold; font-size:11px;">
                            (SUPPLY MEANT FOR EXPORT/SUPPLY TO SEZ UNIT OR SEZ DEVELOPER FOR AUTHORISED OPERATIONS ON
                            PAYMENT OF IGST)
                        </td>
                    </tr>
                </table>

                <!-- SINGLE UNIFIED TABLE (7 columns) -->
                <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:11px;">

                    <!-- COMPANY INFO + INVOICE DETAILS ROW -->
                    <tr>
                        <!-- LEFT SIDE -->
                        <td style="width:55%; vertical-align:top; border:1px solid #000; padding:6px;" colspan="4">
                            <strong t-esc="doc.company_id.name or ''"/><br/>
                            <t t-if="doc.company_id.partner_id.street" t-esc="doc.company_id.partner_id.street"/><br/>
                            <t t-if="doc.company_id.partner_id.street2" t-esc="doc.company_id.partner_id.street2"/><br/>
                            <t t-if="doc.company_id.partner_id.city" t-esc="doc.company_id.partner_id.city"/>
                            <t t-if="doc.company_id.partner_id.city and doc.company_id.partner_id.zip"> - </t>
                            <t t-if="doc.company_id.partner_id.zip" t-esc="doc.company_id.partner_id.zip"/><br/>
                            <t t-if="doc.company_id.vat">GSTIN/UIN: <t t-esc="doc.company_id.vat"/><br/></t>
                            <t t-if="doc.company_id.partner_id.state_id">
                                State Name : <t t-esc="doc.company_id.partner_id.state_id.name or ''"/>
                                <t t-if="doc.company_id.partner_id.state_id.code">, Code : <t t-esc="doc.company_id.partner_id.state_id.code or ''"/></t><br/>
                            </t>
                            <t t-if="doc.company_id.company_registry">CIN: <t t-esc="doc.company_id.company_registry"/><br/></t>
                            <t t-set="company_pan" t-value="doc.get_company_pan()"/>
                            <t t-if="company_pan">PAN : <t t-esc="company_pan"/><br/></t>
                            <t t-set="company_iec" t-value="doc.get_company_iec()"/>
                            <t t-if="company_iec">IEC No : <t t-esc="company_iec"/><br/></t>
                            <t t-if="doc.company_id.partner_id.email">E-Mail : <t t-esc="doc.company_id.partner_id.email"/></t>
                            <hr/>
                            Consignee (Ship to)<br/>
                            <strong>CUSTOMER FROM MOSCO: RUSSIA</strong><br/>
                            CONSIGNEE AS PER GIVEN ON PURCHASE ORDER<br/>
                            <br/>
                            <hr/>
                            Delivery Address<br/>
                            <strong t-esc="delivery_partner.name or ''"/><br/>
                            <t t-if="delivery_partner.street" t-esc="delivery_partner.street"/><br/>
                            <t t-if="delivery_partner.street2" t-esc="delivery_partner.street2"/><br/>
                            <t t-if="delivery_partner.city" t-esc="delivery_partner.city"/>
                            <t t-if="delivery_partner.city and delivery_partner.country_id">, </t>
                            <t t-if="delivery_partner.country_id" t-esc="delivery_partner.country_id.name or ''"/><br/>
                            <t t-if="delivery_partner.state_id">State Name : <t t-esc="delivery_partner.state_id.name or ''"/></t>
                            <t t-if="nogst_sale and nogst_sale.ks_zone == 'india' and delivery_partner.l10n_in_pan">
                                <br/>PAN : <t t-esc="delivery_partner.l10n_in_pan"/>
                            </t>
                        </td>
                        <!-- RIGHT SIDE -->
                        <td style="width:45%; vertical-align:top; padding:0; border:1px solid #000;" colspan="3">
                            <table style="width:100%; border-collapse:collapse; border-color:white;">
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">Invoice No.</td>
                                    <td style="padding:1px;" colspan="3">Dated</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;"><strong t-esc="doc.name or ''"/></td>
                                    <td style="border-left:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="doc.invoice_date" t-esc="doc.invoice_date.strftime('%d-%b-%y')"/>
                                            <t t-elif="doc.date" t-esc="doc.date.strftime('%d-%b-%y')"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; border-top:1px solid #000; padding:1px;">Delivery Note</td>
                                    <td style="border-top:1px solid #000; padding:1px;" colspan="3">Mode/Terms of Payment</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:1px;">
                                        <strong><t t-esc="doc.ks_delivery_note or ''"/></strong>
                                    </td>
                                    <td style="border-left:1px solid #000; border-bottom:1px solid #000; padding:1px;" colspan="3">
                                        <strong>70 Advance / 30 After Readiness of goods</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">Supplier's Reference</td>
                                    <td style="padding:1px;" colspan="3">Reference No. and Date.</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; border-bottom:1px solid #000; padding:1px;">
                                        <strong><t t-esc="doc.ks_supplier_reference or ''"/></strong>
                                    </td>
                                    <td style="border-left:1px solid #000; border-bottom:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="doc.ks_reference_no_date" t-esc="doc.ks_reference_no_date"/>
                                            <t t-else="">
                                                <t t-esc="doc.name or ''"/>
                                                <t t-if="doc.invoice_date"> dt. <t t-esc="doc.invoice_date.strftime('%d-%b-%y')"/></t>
                                                <t t-elif="doc.date"> dt. <t t-esc="doc.date.strftime('%d-%b-%y')"/></t>
                                            </t>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">Buyer's Order No.</td>
                                    <td style="padding:1px;" colspan="3">Dated</td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;">
                                        <strong><t t-if="sale_order" t-esc="sale_order.name or ''"/></strong>
                                    </td>
                                    <td style="border-left:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="sale_order and sale_order.date_order" t-esc="sale_order.date_order.strftime('%d-%b-%y')"/>
                                            <t t-elif="sale_order and sale_order.create_date" t-esc="sale_order.create_date.strftime('%d-%b-%y')"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:1px;">Despatch Document No.</td>
                                    <td style="border-top:1px solid #000; border-left:1px solid #000; padding:1px;" colspan="3">Delivery Note Date</td>
                                </tr>
                                <tr>
                                    <td style="border-bottom:1px solid #000; border-right:1px solid #000; padding:1px;">
                                        <strong><t t-esc="doc.ks_despatch_document_no or ''"/></strong>
                                    </td>
                                    <td style="border-bottom:1px solid #000; border-left:1px solid #000; padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="doc.ks_delivery_note_date" t-esc="doc.ks_delivery_note_date.strftime('%d-%b-%y')"/>
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-top:1px solid #000; border-right:1px solid #000; padding:1px;">Despatched Through</td>
                                    <td style="border-top:1px solid #000; border-left:1px solid #000; padding:1px;" colspan="3">Destination</td>
                                </tr>
                                <tr>
                                    <td style="border-bottom:1px solid #000; border-right:1px solid #000; padding:1px;">
                                        <strong><t t-esc="doc.ks_despatched_through or ''"/></strong>
                                    </td>
                                    <td style="border-bottom:1px solid #000; border-left:1px solid #000; padding:1px;" colspan="3"></td>
                                </tr>
                                <tr>
                                    <td style="border-right:1px solid #000; padding:1px;"><strong>Country:</strong></td>
                                    <td style="padding:1px;" colspan="3"></td>
                                </tr>
                                <tr>
                                    <td style="border-top:1px solid #000; padding:1px;" colspan="3"><strong>Terms of Delivery</strong></td>
                                </tr>
                                <tr>
                                    <td style="padding:1px;" colspan="3">
                                        <strong>
                                            <t t-if="nogst_sale and nogst_sale.incoterm">
                                                [<t t-esc="nogst_sale.incoterm.code or ''"/>] <t t-esc="nogst_sale.incoterm.name or ''"/>
                                                <t t-if="nogst_sale.incoterm_location">, <t t-esc="nogst_sale.incoterm_location or ''"/></t>
                                            </t>
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- PRODUCT TABLE HEADER (merged — no separate table) -->
                    <tr>
                        <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:5%;">Sl No.</th>
                        <th style="border:1px solid #000; padding:4px; text-align:left; background-color:#f0f0f0; width:35%;">Description of Goods</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:10%;">HSN/SAC</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:13%;">Quantity</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:13%;">Rate</th>
                        <th style="border:1px solid #000; padding:4px; text-align:center; background-color:#f0f0f0; width:8%;">Per</th>
                        <th style="border:1px solid #000; padding:4px; text-align:right; background-color:#f0f0f0; width:16%;">Amount</th>
                    </tr>

                    <!-- PRODUCT LINES -->
                    <t t-set="line_num" t-value="0"/>
                    <t t-foreach="doc.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">
                        <t t-set="line_num" t-value="line_num + 1"/>
                        <tr>
                            <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line_num"/>
                            <td style="border:1px solid #000; padding:4px;">
                                <t t-esc="line.name or ''"/>
                                <t t-set="made_in_country" t-value="(line.sale_line_ids and line.sale_line_ids[0].made_in_country_id) or (line.purchase_line_id and line.purchase_line_id.made_in_country_id) or (line.product_id and line.product_id.product_tmpl_id.made_country)"/>
                                <t t-if="made_in_country">
                                    <br/><t t-esc="'Made in ' + (made_in_country.name or '')"/>
                                </t>
                            </td>
                            <td style="border:1px solid #000; padding:4px; text-align:right;"><t t-esc="doc.get_line_hsn_code(line)"/></td>
                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                <t t-esc="doc.format_number(line.quantity, digits=2)"/> <t t-esc="line.product_uom_id.name or 'pcs'"/>
                            </td>
                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_unit, digits=2)"/>
                            </td>
                            <td style="border:1px solid #000; padding:4px; text-align:center;" t-esc="line.product_uom_id.name or 'pcs'"/>
                            <td style="border:1px solid #000; padding:4px; text-align:right;">
                                <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_subtotal, digits=2)"/>
                            </td>
                        </tr>
                    </t>

                    <!-- TOTAL ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:4px; text-align:center;"></td>
                        <td style="border:1px solid #000; padding:4px;">Total</td>
                        <td style="border:1px solid #000; padding:4px;"></td>
                        <td style="border:1px solid #000; padding:4px; text-align:right;">
                            <t t-esc="doc.format_number(total_qty, digits=2)"/> pcs
                        </td>
                        <td style="border:1px solid #000; padding:4px;"></td>
                        <td style="border:1px solid #000; padding:4px;"></td>
                        <td style="border:1px solid #000; padding:4px; text-align:right;">
                            <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(total_amount, digits=2)"/>
                        </td>
                    </tr>

                    <!-- CURRENCY CONVERSION ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:4px; text-align:right;" colspan="7">
                            <strong>
                                Total Invoice Amount in <t t-esc="invoice_currency.name or 'USD'"/> <t t-esc="doc.format_number(total_amount, digits=2)"/> @ <t t-esc="company_currency.name or 'AED'"/> <t t-esc="doc.format_number(exchange_rate, digits=3)"/> / 1 <t t-esc="company_currency.name or 'AED'"/> = <t t-esc="doc.format_number(company_to_invoice_rate, digits=4)"/> <t t-esc="invoice_currency.name or 'USD'"/> = <t t-esc="company_currency.name or 'AED'"/> <t t-esc="doc.format_number(converted_amount, digits=2)"/>
                            </strong>
                        </td>
                    </tr>

                    <!-- AMOUNT IN WORDS ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px;" colspan="7">
                            Amount Chargeable (in words)<br/>
                            <strong>
                                <t t-set="invoice_amount_words" t-value="doc.get_amount_in_words_currency(total_amount, invoice_currency)"/>
                                <t t-esc="invoice_amount_words or ''"/> (<t t-esc="(company_currency.name or 'AED') + ' ' + doc.format_number(converted_amount, digits=2)"/>)
                            </strong>
                        </td>
                    </tr>

                    <!-- REMARKS + DECLARATION + BANK DETAILS + SIGNATORY -->
                    <tr>
                        <td style="vertical-align:top; padding:6px; border:1px solid #000;" colspan="4">
                            <t t-if="nogst_sale and nogst_sale.ks_remarks">
                                <strong>Remarks</strong><br/>
                                <t t-esc="nogst_sale.ks_remarks"/><br/><br/>
                            </t>
                            <t t-if="nogst_sale and nogst_sale.note">
                                <strong>Declaration</strong><br/>
                                <span t-out="nogst_sale.note"/>
                            </t>
                        </td>
                        <td style="vertical-align:top; padding:6px; border:1px solid #000;" colspan="3">

                                <p style="font-weight:bold; margin:0 0 4px 0;">Company's Bank Details</p>
                                <strong>Bank Name:</strong> <strong><t t-esc="(bank_info.get('bank_name') or '') if bank_info else ''"/></strong><br/>
                                <strong>A/c No.:</strong> <strong><t t-esc="(bank_info.get('acc_number') or '') if bank_info else ''"/></strong><br/>
                                <strong>Branch IFS Code:</strong> <strong><t t-esc="(bank_info.get('city') or '') if bank_info else ''"/><t t-if="bank_info and bank_info.get('ifsc_code')"> (<t t-esc="bank_info.get('ifsc_code')"/>)</t></strong><br/>
                                <strong>SWIFT Code:</strong> <strong><t t-esc="(bank_info.get('swift_code') or '') if bank_info else ''"/></strong>

                            <div style="border-top:1px solid #000; margin-top:20px;"/>
                            <div style="text-align:center; margin-top:10px;">
                                <t t-if="nogst_sale and nogst_sale.ks_authorized_signature">
                                    <img t-att-src="image_data_uri(nogst_sale.ks_authorized_signature)"
                                         style="max-height:60px; max-width:180px; display:block; margin:0 auto 4px auto;"/>
                                </t>
                                Authorised Signatory<br/><br/>
                                for <t t-esc="doc.company_id.name or ''"/>
                            </div>
                        </td>
                    </tr>

                    <!-- FOOTER ROW -->
                    <tr>
                        <td style="border:1px solid #000; padding:6px; text-align:center; font-size:10px;" colspan="7">
                            This is a Computer Generated Invoice
                        </td>
                    </tr>

                </table>

            </main>
            </t>
        </t>
    </template>


</odoo>
