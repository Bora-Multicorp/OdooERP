                    </tr>
                </table>

                <!-- ITEMS TABLE (DYNAMIC DATA - NO TAX) -->
                <t t-set="total_qty" t-value="sum(line.quantity for line in doc.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note')))"/>
                <t t-set="total_untaxed" t-value="doc.amount_untaxed"/>
                <t t-set="total_amount" t-value="doc.amount_total"/>
                <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:11px; margin-top:5px;">
                    <tr>
                        <th style="border:1px solid #000;">Sl No.</th>
                        <th style="border:1px solid #000;">Description of Goods</th>
                        <th style="border:1px solid #000;">HSN/SAC</th>
                        <th style="border:1px solid #000;">Quantity</th>
                        <th style="border:1px solid #000;">Rate</th>
                        <th style="border:1px solid #000;">Per</th>
                        <th style="border:1px solid #000;">Amount</th>
                    </tr>

                    <!-- Dynamic Data for Invoice Items -->
                    <t t-set="line_num" t-value="0"/>
                    <t t-foreach="doc.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">
                        <t t-set="line_num" t-value="line_num + 1"/>
                        <tr>
                            <td style="border:1px solid #000; text-align:center;" t-esc="line_num"/>
                            <td style="border:1px solid #000;">
                                <t t-esc="line.name or ''"/>
                                <t t-if="line.product_id and line.product_id.product_tmpl_id.made_country">
                                    <br/><t t-esc="'Made in ' + (line.product_id.product_tmpl_id.made_country.name or '')"/>
                                </t>
                            </td>
                            <td style="border:1px solid #000; text-align:right;">
                                <t t-esc="doc.get_line_hsn_code(line)"/>
                            </td>
                            <td style="border:1px solid #000; text-align:right;">
                                <t t-esc="doc.format_number(line.quantity, digits=2)"/> <t t-esc="line.product_uom_id.name or 'pcs'"/>
                            </td>
                            <td style="border:1px solid #000; text-align:right;">
                                <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_unit, digits=2)"/>
                            </td>
                            <td style="border:1px solid #000; text-align:center;" t-esc="line.product_uom_id.name or 'pcs'"/>
                            <td style="border:1px solid #000; text-align:right;">
                                <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(line.price_subtotal, digits=2)"/>
                            </td>
                        </tr>
                    </t>

                    <!-- TOTAL (No tax row) -->
                    <tr>
                        <td style="border:1px solid #000; text-align:center;"></td>
                        <td style="border:1px solid #000;">
                            Total
                        </td>
                        <td style="border:1px solid #000; text-align:right;"></td>
                        <td style="border:1px solid #000; text-align:right;">
                            <t t-esc="doc.format_number(total_qty, digits=2)"/> pcs
                        </td>
                        <td style="border:1px solid #000; text-align:right;"></td>
                        <td style="border:1px solid #000; text-align:center;"></td>
                        <td style="border:1px solid #000; text-align:right;">
                            <t t-esc="doc.currency_id.symbol or '$'"/> <t t-esc="doc.format_number(total_amount, digits=2)"/>
                        </td>
                    </tr>
                </table>

                <!-- Currency Conversion Section -->
                <t t-set="invoice_currency" t-value="doc.currency_id"/>
                <t t-set="company_currency" t-value="doc.company_id.currency_id"/>
                <t t-set="conversion_date" t-value="doc.invoice_date or doc.date or doc.create_date.date()"/>
                <t t-set="invoice_currency_rate" t-value="doc.invoice_currency_rate or 1.0"/>
                <t t-set="converted_amount" t-value="total_amount"/>
                <t t-set="exchange_rate" t-value="1.0"/>
                <t t-set="company_to_invoice_rate" t-value="invoice_currency_rate"/>
                <t t-if="invoice_currency and company_currency and invoice_currency != company_currency">
                    <t t-set="converted_amount" t-value="invoice_currency._convert(total_amount, company_currency, doc.company_id, conversion_date, round=True)"/>
                    <t t-set="exchange_rate" t-value="1.0 / invoice_currency_rate"/>
                </t>
                <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:5px;">
                    <tr>
                        <td style="border:1px solid #000; text-align:right; padding:4px;" colspan="7">
                            <strong>
                                Total Invoice Amount in <t t-esc="invoice_currency.name or 'USD'"/> <t t-esc="doc.format_number(total_amount, digits=2)"/> @ <t t-esc="company_currency.name or 'AED'"/> <t t-esc="doc.format_number(exchange_rate, digits=3)"/> / 1 <t t-esc="company_currency.name or 'AED'"/> = <t t-esc="doc.format_number(company_to_invoice_rate, digits=4)"/> <t t-esc="invoice_currency.name or 'USD'"/> = <t t-esc="company_currency.name or 'AED'"/> <t t-esc="doc.format_number(converted_amount, digits=2)"/>
                            </strong>
                        </td>
                    </tr>
                </table>

                <!-- FOOTER (Dynamic - No Tax) -->
                <t t-set="exchange_currency_code" t-value="company_currency.name or 'AED'"/>
                <t t-set="exchanged_amount" t-value="converted_amount"/>
                <t t-set="invoice_amount_words" t-value="doc.get_amount_in_words_currency(total_amount, invoice_currency)"/>
                <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:10px;">
                    <tr>
                        <td style="width:100%; border:1px solid #000; padding:6px;">
                            Amount Chargeable (in words)
                            <br/>
                            <strong>
                                <t t-esc="invoice_amount_words or ''"/> (<t t-esc="exchange_currency_code + ' ' + doc.format_number(exchanged_amount, digits=2)"/>)
                            </strong>
                        </td>
                    </tr>
                </table>

                <!-- Remarks and Bank Details (No Tax Summary) -->
                <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 10px;">
                    <!-- Second Row (Bank Details) -->
                    <tr>
                        <td colspan="2" style="border: 1px solid #000; padding: 6px; font-weight: bold;">Remarks:</td>
                    </tr>

                    <!-- Get bank info from payment first, then fallback to company bank info -->
                    <t t-set="payment_bank_info" t-value="doc.get_payment_bank_info()"/>
                    <t t-set="company_bank_info" t-value="doc.get_company_bank_info()"/>
                    <t t-set="bank_info" t-value="payment_bank_info if payment_bank_info.get('has_payment') else company_bank_info"/>
                    
                    <tr style="border: 1px solid #000; padding: 6px; ">
                        <td>
                            BANK AD CODE NO: 
                            <t t-if="bank_info.get('ad_code')" t-esc="bank_info.get('ad_code')"/>
                            <t t-else="">
                                CODE
                            </t>
                            <t t-if="bank_info.get('swift_code')">, SWIFT CODE: <t t-esc="bank_info.get('swift_code')"/></t>
                            <t t-if="bank_info.get('branch')">, BRANCH SOL ID: <t t-esc="bank_info.get('branch')"/> Seal</t>
                        </td>
                    </tr>
                    <tr style="border: 1px solid #000; padding: 6px; ">
                        <td>
                            Company's PAN/IEC Code:
                            <t t-if="doc.company_id.partner_id.vat" t-esc="doc.company_id.partner_id.vat"/>
                            <t t-elif="doc.company_id.vat" t-esc="doc.company_id.vat"/>
                        </td>
                    </tr>

                    <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 10px;">
                        <!-- Declaration and Bank Details in two columns -->
                        <tr>
                            <td style="width: 50%; vertical-align: top; padding: 6px; border: 1px solid #000;">
                                <!-- Declaration -->
                                <p style="font-weight: bold;">Declaration</p>
                                <ul>
