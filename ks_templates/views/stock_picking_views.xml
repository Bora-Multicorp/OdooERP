<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit stock.picking form view to add packing list fields -->
        <record id="view_stock_picking_form_inherit_ks_templates" model="ir.ui.view">
            <field name="name">stock.picking.form.ks.templates</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Packing List print button: only visible for Sale Deliveries (outgoing) -->
                <xpath expr="//header/button[@name='action_cancel']" position="before">
                    <button name="action_print_packing_list"
                            string="Packing List"
                            type="object"
                            groups="base.group_user"
                            invisible="picking_type_code != 'outgoing'"/>
                </xpath>
                <!-- Invisible field to ensure picking_type_code is loaded for JS filtering -->
                <xpath expr="//sheet" position="inside">
                    <field name="picking_type_code" invisible="1"/>
                </xpath>
                <!-- Add fields to existing Additional Info tab -->
                <xpath expr="//page[@name='extra']" position="inside">
                    <group string="Packing List Information">
                        <group>
                            <field name="ks_exporter_ref" placeholder="Exporter's Ref"/>
                            <field name="ks_other_reference" placeholder="Other Reference(s)"/>
                            <field name="ks_supplier_reference" placeholder="Supplier's Reference"/>
                            <field name="ks_reference_no_date" placeholder="Reference No. and Date"/>
                        </group>
                        <group>
                            <field name="ks_country_of_origin" placeholder="Country of Origin of Goods"/>
                            <field name="ks_country_of_final_destination" placeholder="Country of Final Destination"/>
                            <field name="ks_pre_carriage_by" placeholder="Pre-Carriage by"/>
                            <field name="ks_place_of_receipt_by_pre_carrier" placeholder="Place of Receipt by Pre-Carrier"/>
                        </group>
                        <group>
                            <field name="ks_vessel_flight_no" placeholder="Vessel / Flight No."/>
                            <field name="ks_port_of_loading" placeholder="Port of Loading"/>
                            <field name="ks_port_of_discharge" placeholder="Port of Discharge"/>
                            <field name="ks_final_destination" placeholder="Final Destination"/>
                            <field name="ks_gross_weight" placeholder="Gross Weight"/>
                            <field name="ks_net_weight" placeholder="Net Weight"/>
                        </group>
                    </group>
                    <group string="Terms of Delivery">
                        <group>
                            <field name="ks_contact_date" placeholder="Contact Date"/>
                            <field name="ks_contact_no" placeholder="Contact No"/>
                            <field name="ks_lut_no" placeholder="LUT No"/>
                            <field name="ks_lut_date" placeholder="Date"/>
                        </group>
                    </group>
                    <group string="User Signature">
                        <group>
                            <field name="ks_user_signature" widget="signature" string="User Signature" options="{'size': [300, 100]}"/>
                        </group>
                    </group>
                </xpath>
                <!-- Add line-wise Dimensions, Packages, Remarks, Made In to Operations (move_ids_without_package) list -->
                <xpath expr="//field[@name='move_ids_without_package']//list/field[@name='quantity']" position="after">
                    <field name="x_dimensions" string="Dimensions (L*B*H)" optional="show"/>
                    <field name="x_package_info" string="No. &amp; Kind of Packages" optional="show"/>
                    <field name="x_line_remark" string="Remark" optional="show"/>
                    <field name="made_in_country_id" string="Made In" optional="show"/>
                </xpath>
            </field>
        </record>

        </data>
</odoo>

