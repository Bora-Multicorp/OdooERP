<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_inherit_ks_templates" model="ir.ui.view">
            <field name="name">product.template.form.ks.templates</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="inside">
                    <field name="is_advance_payment_product" string="Is Advance Payment Product"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
