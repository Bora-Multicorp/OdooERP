<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_ks_templates_stamp" model="ir.ui.view">
        <field name="name">res.company.form.ks.templates.stamp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="stamp_image" widget="image" options="{'size': [100, 100]}" class="oe_inline" string="Company Stamp"/>
            </xpath>
        </field>
    </record>
</odoo>
