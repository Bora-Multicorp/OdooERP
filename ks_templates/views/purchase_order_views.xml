<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Round Off field in totals section -->
        <record id="view_purchase_order_form_inherit_ks_templates_round_off" model="ir.ui.view">
            <field name="name">purchase.order.form.ks.templates.round.off</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@class='oe_subtotal_footer']/field[@name='tax_totals']" position="before">
                    <field name="ks_round_off" string="Round Off" widget="monetary"/>
                </xpath>
            </field>
        </record>

        <!-- Add Authorised Signatory, Bank and Extra PO fields to Purchase Order -->
        <record id="view_purchase_order_form_inherit_ks_templates_sign_bank" model="ir.ui.view">
            <field name="name">purchase.order.form.ks.templates.sign.bank</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='purchase_delivery_invoice']/group" position="inside">
                    <group string="Extra PO Fields">
                        <field name="ks_destination" placeholder="Destination"/>
                        <field name="ks_despatched_through" placeholder="Despatched Through"/>
                    </group>
                    <group string="Bank &amp; Signature">
                        <field name="ks_bank_id" placeholder="Select Bank"/>
                        <field name="ks_remarks" placeholder="Remarks" colspan="2"/>
                        <field name="ks_authorised_signatory" widget="signature" string="Authorised Signatory"/>
                    </group>
                </xpath>
            </field>
        </record>
        <!-- Exclude advance payment products from purchase order line product selection -->
        <record id="view_purchase_order_form_inherit_ks_advance_product_domain" model="ir.ui.view">
            <field name="name">purchase.order.form.ks.advance.product.domain</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                    <attribute name="domain">[('product_tmpl_id.is_advance_payment_product', '=', False)]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
