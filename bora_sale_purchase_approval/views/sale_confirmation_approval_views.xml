<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the sales order form view to add our custom fields and buttons -->
        <record id="view_order_form_inherit_approval" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.approval</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="is_hidden_for_approval" invisible="True"/>
                </xpath>
                    <xpath expr="//field[@name='state']" position="replace">

                    <!-- Custom approval states -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="custom_draft,confirmation_pending,approved,rejected"
                            invisible="is_approved"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,sale"
                            invisible="not is_approved"/>
<!--                           invisible="state in ('custom_draft','confirmation_pending','approved','rejected')"/>-->

                </xpath>
                <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                    <attribute name="invisible">state not in ('approved')</attribute>
                </xpath>
                <!-- Add the approval and rejection wizard buttons for all pending states -->
                <xpath expr="//header" position="inside">
                    <button name="action_draft_confirm"
                            string="Confirm" type="object" class="btn-primary"
                            invisible="state not in ('custom_draft','cancel_draft') or is_approved"
                            confirm="Do you want to confirm this order?"/>

                    <button name="%(approve_sale_order_wizard_action)d" string="Approve" type="action"
                            class="oe_highlight"
                            invisible="state in ('draft', 'rejected') or assigned_to != uid or is_approved"/>
                    <button name="%(reject_sale_order_wizard_action)d" string="Reject" type="action"
                            class="oe_highlight"
                            invisible="state in ('draft', 'rejected') or assigned_to != uid or is_approved"/>
                </xpath>

                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Confirm Approval Authorities" name="approval_users">
                        <field name="is_approved" invisible="1"/>
                        <group>
                            <field name="assigned_to"
                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                                   invisible="not assigned_to" readonly="1"/>
                            <field name="existing_user_ids" invisible="1" widget="many2many_tags"/>
                        </group>
                        <field name="confirm_approval_users_ids" nolabel="1" help="Define the approval roles."
                               readonly="1">
                            <list editable="bottom">
                                <field name="sequence"/>
                                <field name="user_id" widget="many2one_avatar_user"
                                       options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="remark"/>
                                <field name="state" readonly="1"/>
                                <field name="action_date" readonly="1"/>
                            </list>
                            <form>
                                <group>
                                    <field name="user_id"
                                           options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                    <field name="state"/>
                                    <field name="remark"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="saleorder_approval_view_list" model="ir.ui.view">
            <field name="name">Sale Order Approval</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <list string="Order Approval" create="false" delete="false">
                    <field name="assigned_to"/>
                    <field name="create_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
        <record id="saleorder_approval_action" model="ir.actions.act_window">
            <field name="name">Sale Order Approval</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
