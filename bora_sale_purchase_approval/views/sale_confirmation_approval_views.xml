<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the sales order form view to add our custom fields and buttons -->
        <record id="view_order_form_inherit_approval" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.approval</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="so_confirm_approval_authorities_page" string="Confirmation Approval Authorities"
                          invisible="not so_approval_users_ids_for_confirmation">
                        <group>
                            <div class="o_row o_align_right" invisible="not so_assigned_to_form_confirmation">
                                <label for="so_assigned_to_form_confirmation"/>
                                <field name="so_assigned_to_form_confirmation"
                                       options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                                       invisible="not so_assigned_to_form_confirmation" readonly="1"/>
                                <button name="action_suspend" string="Suspend" type="object" class="btn-primary"
                                        groups="base.group_system"/>
                            </div>
                        </group>
                        <field name="so_approval_users_ids_for_confirmation" nolabel="1"
                               help="Define the SO confirm approval roles." readonly="1">
                            <list create="false">
                                <field name="sequence"/>
                                <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                                <field name="group" readonly="1" column_invisible="1"/>
                                <field name="remark" readonly="1"/>
                                <field name="state" readonly="1"/>
                                <field name="action_date" readonly="1"/>
                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="%(approve_so_confirm_wizard_action)d" string="Approve" type="action"
                            class="oe_highlight" invisible="so_assigned_to_form_confirmation != uid"/>
                    <button name="%(reject_so_confirm_wizard_action)d" string="Reject" type="action"
                            class="oe_highlight" invisible="so_assigned_to_form_confirmation != uid"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
