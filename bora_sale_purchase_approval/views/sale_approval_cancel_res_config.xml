<odoo>
    <record id="view_so_canceallation_approvers_form" model="ir.ui.view">
        <field name="name">sale.order.confirmation.approvers.form</field>
        <field name="model">sale.order.cancellation.approvers</field>
        <field name="arch" type="xml">
            <form string="Cancallation Approvers" class="oe_form_configuration o_base_settings" create="false">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="group"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_so_cancllation_approvers_tree" model="ir.ui.view">
        <field name="name">sales.order.cancellation.approvers.tree</field>
        <field name="model">sale.order.cancellation.approvers</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Confirmation Approvers">
                <field name="sequence" widget="handle" class="o_data_cell_sequence"/>
                <field name="sequence"/>
                <field name="default_user"/>
                <field name="user_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                <field name="group"/>
            </list>
        </field>
    </record>
    <record id="action_so_cancellation_approvers" model="ir.actions.act_window">
        <field name="name">Cancellation Approvers</field>
        <field name="res_model">sale.order.cancellation.approvers</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your purchase order cancellation approvers here.
            </p>
        </field>
    </record>
    <menuitem id="menu_sale_order_cancel_approval_config"
              name="Sale Order Cancellation Approvers"
              parent="sale.menu_sale_config"
              action="action_so_cancellation_approvers"
              sequence="1001"
              groups="base.user_admin"/>

</odoo>