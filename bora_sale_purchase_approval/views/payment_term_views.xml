<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the sales order form view to add our custom fields and buttons -->
        <record id="view_payment_form_inherit_approval" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.approval</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Show banner above form -->
                <xpath expr="//sheet" position="before">
                    <field name="credit_status_message" readonly="1" widget="html"/>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="attributes">
                    <attribute name="readonly">state=='sale'</attribute>
                </xpath>

                <!-- keep payment_term modifications -->
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="is_pending_approval" invisible="1"/>
                    <field name="is_payment_approved" invisible="1"/>
                    <field name="is_payment_rejected" invisible="1"/>
                    <field name="credit_due_date"
                           invisible="payment_term_id not in [%(bora_sale_purchase_approval.custom_account_payment_term_credit)d]"/>
                </xpath>

                <!-- Add custom buttons -->
                <xpath expr="//header" position="inside">
                    <!-- Submit button -->
                    <button name="confirm_submit_form" string="Submit Credit Approval" type="object"
                            class="oe_highlight"
                            confirm="Do you want to submit credit approval request?"
                            invisible="payment_term_id not in [%(bora_sale_purchase_approval.custom_account_payment_term_credit)d]
                                       or is_pending_approval
                                       or is_payment_approved
                                       or is_payment_rejected"/>

                    <!-- Approve button -->
                    <button name="%(approve_payment_term_wizard_action)d" string="Credit Approve" type="action"
                            class="oe_highlight"
                            invisible="not is_pending_approval or credit_assigned_to != uid or is_payment_rejected"/>

                    <!-- Reject button -->
                    <button name="%(reject_payment_term_wizard_action)d" string="Credit Reject" type="action"
                            class="oe_highlight"
                            invisible="not is_pending_approval or credit_assigned_to != uid or is_payment_rejected"/>
                    <button name="action_reset_credit_approval"
                            string="Reset Credit Approval"
                            type="object"
                            class="btn-secondary"
                            confirm="Are you sure you want to reset the credit approval process?"
                            invisible="is_payment_rejected != True or user_id != uid"/>
                </xpath>

                <!-- Approval page -->
                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Credit Approval Authorities" name="approval_users"
                          invisible="payment_term_id not in [%(bora_sale_purchase_approval.custom_account_payment_term_credit)d] or (not is_pending_approval and not credit_approval_users_ids) ">
                        <field name="is_payment_approved" invisible="1"/>
                        <group>
                            <field name="credit_assigned_to"
                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}" readonly="1"/>
                            <field name="existing_user_ids" invisible="1" widget="many2many_tags"/>
                        </group>
                        <field name="credit_approval_users_ids" nolabel="1" help="Define the approval roles."
                               readonly="1">
                            <list editable="bottom">
                                <field name="sequence"/>
                                <field name="user_id" widget="many2one_avatar_user"
                                       options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="remark"/>
                                <field name="state" readonly="1"/>
                                <field name="action_date" readonly="1"/>
                            </list>
                            <form>
                                <group>
                                    <field name="user_id"
                                           options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                    <field name="state"/>
                                    <field name="remark"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="payment_term_approval_view_list" model="ir.ui.view">
            <field name="name">Payment term Approval</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <list string="Payment Approval" create="false" delete="false">
                    <field name="credit_assigned_to"/>
                    <field name="create_date"/>
                    <field name="credit_status_message" widget="html"/>
                </list>
            </field>
        </record>
        <record id="payment_approval_action" model="ir.actions.act_window">
            <field name="name">Payment term Approval</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
