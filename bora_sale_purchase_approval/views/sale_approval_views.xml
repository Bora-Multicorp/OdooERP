<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the sales order form view to add our custom fields and buttons -->
        <record id="view_order_form_inherit_cancel_approval" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.approval</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="old_state" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="cancel_approval_authorities_page" string="Cancellation Approval Authorities" invisible="not so_approval_users_ids_for_cancellation">
                    <div class="o_row o_align_right" invisible="not so_assigned_to_form_cancellation">
                        <label for="so_assigned_to_form_cancellation"/>
                        <field name="so_assigned_to_form_cancellation" options="{'no_edit': True, 'no_create': True, 'no_open': True}" readonly="1"/>
                        <button name="action_so_suspend" string="Suspend" type="object" class="btn-primary" groups="base.group_system"/>
                    </div>
                    <field name="so_approval_users_ids_for_cancellation" nolabel="1" help="Define the SO cancel approval roles." readonly="1">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="remark"/>
                            <field name="state" readonly="1"/>
                            <field name="action_date" readonly="1"/>
                        </list>
                        <form>
                            <group>
                                <field name="user_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="state"/>
                                <field name="remark"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="%(approve_so_cancel_wizard_action)d" string="Approve" type="action" class="oe_highlight" invisible="so_assigned_to_form_cancellation != uid"/>
                <button name="%(reject_so_cancel_wizard_action)d" string="Reject" type="action" class="oe_highlight" invisible="so_assigned_to_form_cancellation != uid"/>
            </xpath>
        </field>
        </record>

    </data>
</odoo>
