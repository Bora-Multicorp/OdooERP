<?xml version="1.0"?>
<odoo>
    <record id="confirm_cancel_so_wizard_view_form" model="ir.ui.view">
        <field name="name">confirm.cancel.so.wizard.form</field>
        <field name="model">cancel.so.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Cancellation Request">
                <group>
                    <field name="remark" placeholder="Enter remarks for sale order cancellation"/>
                </group>
                <footer>
                    <button name="action_approve_so_cancel" string="Approve" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="approve_so_cancel_wizard_action" model="ir.actions.act_window">
        <field name="name">Approve Cancel Request</field>
        <field name="res_model">cancel.so.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="confirm_cancel_so_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{
            'default_sale_id': active_id,
            }
        </field>
    </record>
</odoo>