<?xml version="1.0"?>
<odoo>
    <!-- Form View for the Sales Order Approval Wizard -->
    <record id="approve_sale_order_wizard_view_form" model="ir.ui.view">
        <field name="name">approve.sale.order.wizard.form</field>
        <field name="model">approve.sale.order.wizard</field>
          <field name="arch" type="xml">
         <form string="Approval Confirmation Request">
                <group>
                    <field name="remark" placeholder="Enter remarks for sale order confirmation"/>
                </group>
                <footer>
                    <button name="action_approve_so_confirm" string="Approve" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="approve_so_confirm_wizard_action" model="ir.actions.act_window">
        <field name="name">Approve Confirmation Request</field>
        <field name="res_model">approve.sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="approve_sale_order_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{
            'default_sale_id': active_id,
            }
        </field>
    </record>
</odoo>