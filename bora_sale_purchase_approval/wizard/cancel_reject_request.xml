<?xml version="1.0"?>
<odoo>
    <record id="cancel_reject_so_wizard_view_form" model="ir.ui.view">
        <field name="name">cancel.reject.so.wizard.view.form</field>
        <field name="model">reject.cancel.so.wizard</field>
        <field name="arch" type="xml">
            <form string="Rejection Cancellation Request">
                <group>
                    <field name="remark" placeholder="Enter remarks for sale order cancellation"/>
                </group>
                <footer>
                    <button name="action_reject_so_cancellation" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="reject_so_cancel_wizard_action" model="ir.actions.act_window">
        <field name="name">Reject Cancel Request</field>
        <field name="res_model">reject.cancel.so.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cancel_reject_so_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{
            'default_order_id': active_id,
            }
        </field>
    </record>
</odoo>