<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================
         PO APPROVAL USER VIEWS
         ============================================= -->

    <!-- Form View -->
    <record id="po_approval_user_form_view" model="ir.ui.view">
        <field name="name">po.approval.user.form</field>
        <field name="model">po.approval.user</field>
        <field name="arch" type="xml">
            <form string="PO Approval User">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pending_approvals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-clock-o">
                            <field name="pending_approval_count" widget="statinfo" string="Pending"/>
                        </button>
                        <button name="action_view_pending_approvals"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check-circle"
                                context="{'view_approved': True}">
                            <field name="total_approved_count" widget="statinfo" string="Approved"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_title">
                        <label for="user_id" string="Approval User"/>
                        <h1>
                            <field name="user_id" placeholder="Select User..." options="{'no_create': True}"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Configuration">
                            <field name="approval_level" widget="radio"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>

                        <group string="User Information">
                            <field name="user_email" widget="email"/>
                            <field name="user_phone" widget="phone"/>
                        </group>
                    </group>

<group string="Help" class="oe_edit_only">
    <div class="alert alert-info" role="alert">
        <h5><i class="fa fa-info-circle"/> Approval Level Guide</h5>
        <ul class="mb-0">
            <li><strong>PM1 - First Level Approver:</strong> User will only appear in PM1 dropdown on Purchase Orders.</li>
            <li><strong>PM2 - Second Level Approver:</strong> User will only appear in PM2 dropdown on Purchase Orders.</li>
            <li><strong>Both PM1 and PM2:</strong> User will appear in both PM1 &amp; PM2 dropdowns.</li>
        </ul>
    </div>
</group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <!-- List (Tree) View - FIXED -->
    <record id="po_approval_user_list_view" model="ir.ui.view">
        <field name="name">po.approval.user.list</field>
        <field name="model">po.approval.user</field>
        <field name="arch" type="xml">
            <list string="PO Approval Users" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="user_id"/>
                <field name="user_email"/>
                <field name="approval_level" widget="badge"
                       decoration-info="approval_level == 'pm1'"
                       decoration-success="approval_level == 'pm2'"
                       decoration-warning="approval_level == 'both'"/>
<!--                <field name="pending_approval_count" string="Pending"/>-->
<!--                <field name="total_approved_count" string="Approved"/>-->
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="po_approval_user_kanban_view" model="ir.ui.view">
        <field name="name">po.approval.user.kanban</field>
        <field name="model">po.approval.user</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="user_id"/>
                <field name="approval_level"/>
<!--                <field name="pending_approval_count"/>-->
                <field name="total_approved_count"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <field name="user_id" widget="many2one_avatar_user" options="{'display_avatar_name': True}"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="badge text-bg-secondary">
                                    <t t-if="record.approval_level.raw_value == 'pm1'">PM1</t>
                                    <t t-elif="record.approval_level.raw_value == 'pm2'">PM2</t>
                                    <t t-else="">Both</t>
                                </span>
                                <span>
<!--                                    <i class="fa fa-clock-o text-warning"/> <field name="pending_approval_count"/>-->
                                    <i class="fa fa-check-circle text-success ms-2"/> <field name="total_approved_count"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="po_approval_user_search_view" model="ir.ui.view">
        <field name="name">po.approval.user.search</field>
        <field name="model">po.approval.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="user_email"/>
                <filter string="PM1 Approvers" name="filter_pm1" domain="[('approval_level', 'in', ['pm1', 'both'])]"/>
                <filter string="PM2 Approvers" name="filter_pm2" domain="[('approval_level', 'in', ['pm2', 'both'])]"/>
                <separator/>
                <filter string="Has Pending Approvals" name="filter_pending" domain="[('pending_approval_count', '>', 0)]"/>
                <separator/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Approval Level" context="{'group_by': 'approval_level'}"/>
                    <filter string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_po_approval_user" model="ir.actions.act_window">
        <field name="name">PO Approval Users</field>
        <field name="res_model">po.approval.user</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="po_approval_user_search_view"/>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_po_approval_config"
              name="PO Approval"
              parent="purchase.menu_purchase_config"
              sequence="100"/>

    <menuitem id="menu_po_approval_users"
              name="Approval Users"
              parent="menu_po_approval_config"
              action="action_po_approval_user"
              sequence="10"/>

</odoo>
