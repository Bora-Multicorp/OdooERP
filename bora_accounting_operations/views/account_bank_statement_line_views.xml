<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_line_tree_bank_rec_widget_inherit_debit_credit" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.bank.rec.widget.inherit.debit.credit</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="debit_amount" string="Debit" readonly="1"/>
                <field name="credit_amount" string="Credit" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
