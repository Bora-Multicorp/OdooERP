<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QUESTIONS -->
    <record id="sh_survey_matrix_adv_survey_question_form" model="ir.ui.view">
        <field name="name">sh.survey.matrix.adv.survey.questino.form</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']//group//group//field[@name='matrix_subtype']" position="after">
                 <field name="add_an_item" invisible="question_type != 'matrix' or matrix_subtype != 'sh_custom_matrix'" />
            </xpath>
            <xpath expr="//field[@name='suggested_answer_ids']//list//field[@name='value']" position="after">
                <field name="sh_value_type" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="sh_matrix_range_min" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="sh_matrix_range_max" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="sh_matrix_range_step" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="is_email" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="is_mobile" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="is_pincode" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="is_acc_no" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="is_ifsc" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
                <field name="que_sh_many2one_model_id" domain="[('transient','=',False)]" options='{"no_open": True, "no_create": True}'/>
            </xpath>
            <xpath expr="//field[@name='matrix_row_ids']//list//field[@name='value']" position="after">
                <field name="row_hide" column_invisible="parent.matrix_subtype != 'sh_custom_matrix'"/>
            </xpath>
        </field>
    </record>

    <!-- USER INPUT LINES
            .. note:: these views are useful mainly for technical users/administrators -->
    <record id="sh_survey_matrix_adv_survey_user_input_line_form" model="ir.ui.view">
        <field name="name">sh.survey.matrix.adv.survey.user.input.line.form</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_view_form" />
        <field name="arch" type="xml">
            <field name="suggested_answer_id" position="replace">
                <field
                    name="suggested_answer_id"
                    colspan="2"
                    invisible="answer_type not in ['suggestion','ans_sh_color',
	                'ans_sh_email','ans_sh_url','ans_sh_time','ans_sh_range','ans_sh_week','ans_sh_month','ans_sh_password','ans_sh_file']"
                />
            </field>
        </field>
    </record>
</odoo>
