<odoo>
    <record id="view_warehouse_form_inherit_responsible_email" model="ir.ui.view">
        <field name="name">stock.warehouse.form.inherit.responsible.email</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="responsible_person_ids" widget="many2many_tags"/>
                <field name="email"/>
                <field name="warehouse_type"/>
            </xpath>
        </field>
    </record>
</odoo>
