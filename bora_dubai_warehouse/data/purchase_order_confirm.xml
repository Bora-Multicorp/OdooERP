<odoo>
    <data noupdate="1">
        <record id="email_template_3pl_po_notification" model="mail.template">
            <field name="name">3PL PO Notification for Bora Dubai</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Incoming Stock for PO: {{ object.name }}</field>
             <field name="email_from">{{ user.email_formatted }}</field>
            <field name="body_html" type="html">
                <p>Hello,</p>
                <p>This is to notify you of an incoming shipment for Purchase Order <b><t t-out="object.name"/></b>. Please prepare to receive the following items.</p>

                <p><b>Purchase Order Details:</b></p>
                <ul>
                    <li><b>Supplier:</b> <t t-out="object.partner_id.name"/></li>
                    <li><b>Delivery to:</b> <t t-out="object.picking_type_id.warehouse_id.name"/></li>
                    <li><b>Order Deadline:</b> <t t-out="object.date_order"/></li>
                </ul>

                <p><b>Products to be Received:</b></p>
                <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background-color: #f2f2f2;">
                            <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">Product</th>
                            <th style="padding: 8px; border: 1px solid #ddd; text-align: left;">SKU</th>
                            <th style="padding: 8px; border: 1px solid #ddd; text-align: right;">Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="object.order_line" t-as="line">
                            <tr>
                                <td style="padding: 8px; border: 1px solid #ddd; text-align: left;"><t t-out="line.product_id.display_name"/></td>
                                <td style="padding: 8px; border: 1px solid #ddd; text-align: left;"><t t-out="line.product_id.default_code"/></td>
                                <td style="padding: 8px; border: 1px solid #ddd; text-align: right;"><t t-out="line.product_qty"/> <t t-out="line.product_uom.name"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <br/>
                <p>Best regards,</p>
            </field>
        </record>
    </data>
</odoo>