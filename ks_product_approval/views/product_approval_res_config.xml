<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="ks_product_approval_config_view_form" model="ir.ui.view">
        <field name="name">product.approval.config.view.form</field>
        <field name="model">product.approval.config</field>
        <field name="arch" type="xml">
            <form string="Product Approval Settings" class="oe_form_configuration o_base_settings" create="false">
                <sheet>
                    <group>
                        <field name="existing_user_ids" invisible="1"/>
                        <field name="user_id" options="{'no_create': True, 'no_create_edit': True}"
                               domain="[('id', 'not in', existing_user_ids)]"/>
                        <field name="default_approver"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ks_product_approval_config_view_list" model="ir.ui.view">
        <field name="name">product.approval.config.view.list</field>
        <field name="model">product.approval.config</field>
        <field name="arch" type="xml">
            <list string="Product Approval Settings">
                <field name="sequence" widget="handle" class="o_data_cell_sequence"/>
                <field name="user_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                <field name="default_approver"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ks_product_approval_config" model="ir.actions.act_window">
        <field name="name">Product Approval Settings</field>
        <field name="res_model">product.approval.config</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- Menu item under Inventory > Configuration -->
    <menuitem id="menu_ks_product_approval_config"
              name="Product Approval Users"
              parent="stock.menu_stock_config_settings"
              action="action_ks_product_approval_config"
              groups="base.user_admin"
              sequence="100"/>
</odoo>
