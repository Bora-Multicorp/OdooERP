<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="web.Ribbon" t-inherit="web.Ribbon" t-inherit-mode="extension">
    <xpath expr="//div[contains(@class, 'ribbon')]" position="replace">
      <t t-if="!(props.text === 'Archived' and props.record?.data?.is_hidden_for_approval)">
        <div class="ribbon ribbon-top-right">
          <span t-att-class="classes" t-att-title="props.title">
            <t t-esc="props.text"/>
          </span>
        </div>
      </t>
    </xpath>
  </t>

</templates>