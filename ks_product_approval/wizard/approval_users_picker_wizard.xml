<odoo>
    <record id="view_ks_product_approval_user_picker_wizard" model="ir.ui.view">
        <field name="name">view.product.approval.user.picker.wizard</field>
        <field name="model">product.approval.user.picker.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Users to Approval">
                <sheet>
                    <group>
                        <div class="o_form_label o_text_warning" style="margin-bottom: 10px;">
                            Product requires approval, an approval request will be generated for the selected
                            authorities.
                        </div>
                        <field name="user_ids_according_to_user_selection" invisible="1"/>
                        <field name="approver1_users" widget="many2many_tags"
                               domain="[('id', 'not in', approver2_users)]"
                               options="{'color_field': 'color', 'no_edit': True, 'no_create': True, 'no_open': True}"/>
                        <field name="approver2_users" widget="many2many_tags"
                               domain="[('id', 'not in', approver1_users)]"
                               options="{'color_field': 'color', 'no_edit': True, 'no_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Add Users" type="object" name="add_users_for_approval" class="btn-primary"
                            invisible="add_button_disabled == 1"
                            confirm="Are you sure you want to add the selected users for approval?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ks_product_approval_user_picker_wizard" model="ir.actions.act_window">
        <field name="name">Product Approval User Picker</field>
        <field name="res_model">product.approval.user.picker.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_product_id': active_id,
            }
        </field>
    </record>
</odoo>