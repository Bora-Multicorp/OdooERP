<!-- Product Approval Email Template -->
<odoo>
    <data>
        <record id="ks_product_approval_email_template" model="mail.template">
            <field name="name">Product Approved Template</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="subject">Product approval for : {{ object.name }}</field>
            <field name="description">Product Approved Email Template</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Dear Sir/Madam</p>
                    <p>Product is Approved for following:</p>
                    <table style="width:60%; border-collapse: collapse; font-family: Arial, sans-serif;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <strong>Name</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <t t-out="object.name or ''"></t>
                            </td>
                        </tr>

                    </table>
                    <table style="width: 60%; border-collapse: collapse; font-family: Arial, sans-serif;">
                        <thead>
                            <tr>
                                <th style="padding: 8px; border: 1px solid #ddd;">Approver Name</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Action Date</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Remarks</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="object.approval_users_ids" t-as="line">
                                <tr>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.user_id.name or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.action_date or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.remark or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.state or ''"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <br/>
                    <p>Thanks and Regards.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>