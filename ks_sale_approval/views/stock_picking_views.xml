<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_stock_picking_delivery_approval_form" model="ir.ui.view">
        <field name="name">stock.picking.delivery.approval.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- POD fields (hidden) -->
            <xpath expr="//sheet" position="before">
                <field name="ks_pod_sent" invisible="1"/>
            </xpath>

            <!-- POD ribbon — shown after POD email is sent (top-right corner) -->
            <xpath expr="//sheet/*[1]" position="before">
                <widget name="web_ribbon" title="Delivered" bg_color="text-bg-success"
                        invisible="not ks_pod_sent"/>
            </xpath>

            <!-- Upload POD button in header -->
            <xpath expr="(//button[@name='button_validate'])[1]" position="before">
                <button name="action_upload_pod"
                        string="Upload POD"
                        type="object"
                        class="btn-info"
                        invisible="state not in ('waiting', 'assigned', 'done') or ks_pod_sent"/>
            </xpath>

            <!-- Hidden computed fields for button visibility -->
            <xpath expr="//sheet" position="before">
                <field name="ks_is_delivery_pm_user" invisible="1"/>
                <field name="ks_is_delivery_admin" invisible="1"/>
                <field name="ks_is_delivery_dual_approval" invisible="1"/>
                <field name="ks_delivery_approved" invisible="1"/>
                <field name="ks_show_delivery_approve_button" invisible="1"/>
                <field name="ks_show_delivery_reject_button" invisible="1"/>
                <field name="ks_show_delivery_update_button" invisible="1"/>
                <field name="ks_validate_pm1_id" invisible="1"/>
                <field name="ks_validate_pm2_id" invisible="1"/>
                <field name="ks_validate_pm1_approved" invisible="1"/>
                <field name="ks_validate_pm2_approved" invisible="1"/>
                <field name="ks_validate_request_user_id" invisible="1"/>
            </xpath>

            <!-- ============================================================ -->
            <!-- Approval action buttons — before FIRST Validate only         -->
            <!-- NO extra Validate button added here — base one is reused     -->
            <!-- ============================================================ -->
            <xpath expr="(//button[@name='button_validate'])[1]" position="before">

                <!-- Re-open wizard when state stuck in approval_pending with no PM1 (X was clicked) -->
                <button name="ks_action_request_delivery_approval"
                        string="Select Approvers"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'approval_pending' or ks_validate_pm1_id"/>

                <!-- Normal User: Update Approvals while pending -->
                <button name="action_update_delivery_approvals"
                        string="Update Approvals"
                        type="object"
                        class="btn-warning"
                        invisible="not ks_show_delivery_update_button"
                        confirm="This will cancel the current approval request and let you choose new approvers. Continue?"/>

                <!-- PM: Approve -->
                <button name="ks_action_approve_delivery"
                        string="Approve"
                        type="object"
                        class="btn-success"
                        invisible="not ks_show_delivery_approve_button"/>

                <!-- PM: Reject -->
                <button name="ks_action_reject_delivery"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        invisible="not ks_show_delivery_reject_button"/>

            </xpath>

            <!-- Button 1: oe_highlight — visible when assigned/waiting; add approval_pending to its hide list -->
            <xpath expr="//button[@name='button_validate'][hasclass('oe_highlight')]" position="attributes">
                <attribute name="invisible">state in ('draft', 'confirmed', 'done', 'cancel', 'approval_pending')</attribute>
            </xpath>

            <!-- Button 2: o_btn_validate — visible when draft/confirmed; add approval_pending to its hide list -->
            <xpath expr="//button[@name='button_validate'][hasclass('o_btn_validate')]" position="attributes">
                <attribute name="invisible">state in ('waiting', 'assigned', 'done', 'cancel', 'approval_pending')</attribute>
            </xpath>

            <!-- ============================================================ -->
            <!-- Status bar — add approval_pending                            -->
            <!-- ============================================================ -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,waiting,confirmed,assigned,approval_pending,done</attribute>
            </xpath>

            <!-- ============================================================ -->
            <!-- Banners                                                       -->
            <!-- ============================================================ -->
            <xpath expr="//sheet" position="before">

                <!-- Approval Pending -->
                <div class="alert alert-warning mb-0"
                     invisible="state != 'approval_pending'"
                     role="alert">
                    <strong>⏳ Approval Pending</strong> — This delivery is waiting for PM approval before it can be validated.
                    <br/>
                    <span invisible="not ks_validate_pm1_id">
                        <strong>PM1 (<field name="ks_validate_pm1_id" readonly="1" nolabel="1" class="d-inline"/>):</strong>
                        <span invisible="ks_validate_pm1_approved"> ⏳ Pending</span>
                        <span invisible="not ks_validate_pm1_approved"> ✅ Approved</span>
                    </span>
                    <span invisible="not ks_validate_pm2_id">
                        &#160;&#160;|&#160;&#160;
                        <strong>PM2 (<field name="ks_validate_pm2_id" readonly="1" nolabel="1" class="d-inline"/>):</strong>
                        <span invisible="ks_validate_pm2_approved"> ⏳ Pending</span>
                        <span invisible="not ks_validate_pm2_approved"> ✅ Approved</span>
                    </span>
                </div>

                <!-- Approved — delivery is being completed automatically -->
                <div class="alert alert-success mb-0"
                     invisible="not ks_delivery_approved or state == 'done' or ks_is_delivery_admin or ks_is_delivery_pm_user"
                     role="alert">
                    ✅ <strong>Approved</strong> — Your delivery has been approved and is being completed.
                </div>

                <!-- Not yet submitted — normal user, picking in Ready state only -->
                <div class="alert alert-info mb-0"
                     invisible="state != 'assigned' or ks_delivery_approved or ks_is_delivery_admin or ks_is_delivery_pm_user"
                     role="alert">
                    🔒 <strong>Approval Required</strong> — Click <strong>Validate</strong> to submit this delivery for approval.
                </div>

            </xpath>

            <!-- ============================================================ -->
            <!-- Approval History tab                                         -->
            <!-- ============================================================ -->
            <xpath expr="//notebook" position="inside">
                <page string="Approval History" name="delivery_approval_history"
                      invisible="state != 'approval_pending' and not ks_validate_pm1_id">
                    <group>
                        <group string="Approval Request">
                            <field name="ks_validate_request_user_id" string="Requested By" readonly="1"/>
                            <field name="ks_validate_request_date" string="Request Date" readonly="1"/>
                            <field name="ks_validate_request_reason" string="Reason" readonly="1"/>
                        </group>
                        <group string="Approvers">
                            <field name="ks_validate_pm1_id" string="Approver 1 (PM1)" readonly="1"/>
                            <field name="ks_validate_pm1_approved" string="PM1 Approved" readonly="1"/>
                            <field name="ks_validate_pm2_id" string="Approver 2 (PM2)" readonly="1"
                                   invisible="not ks_validate_pm2_id"/>
                            <field name="ks_validate_pm2_approved" string="PM2 Approved" readonly="1"
                                   invisible="not ks_validate_pm2_id"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
