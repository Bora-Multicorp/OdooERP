<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sale Order Form View - Add Approval Buttons and Fields -->
    <record id="ks_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.ks.approval.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Add computed fields for button visibility (invisible) -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="ks_is_pm_user" invisible="1"/>
                <field name="ks_is_normal_user" invisible="1"/>
                <field name="ks_is_admin_user" invisible="1"/>
                <field name="ks_can_edit" invisible="1"/>
                <field name="ks_qty_only_edit" invisible="1"/>
                <field name="ks_show_approve_confirm_button" invisible="1"/>
                <field name="ks_show_reject_confirm_button" invisible="1"/>
                <field name="ks_show_approve_cancel_button" invisible="1"/>
                <field name="ks_show_reject_cancel_button" invisible="1"/>
                <field name="ks_show_approve_edit_button" invisible="1"/>
                <field name="ks_show_reject_edit_button" invisible="1"/>
                <field name="ks_show_request_edit_button" invisible="1"/>
                <field name="ks_show_complete_edit_button" invisible="1"/>
                <field name="ks_show_update_approval_button" invisible="1"/>
                <field name="ks_show_update_cancel_approval_button" invisible="1"/>
                <field name="ks_show_update_edit_approval_button" invisible="1"/>
                <field name="ks_confirm_pm1_approved" invisible="1"/>
                <field name="ks_confirm_pm2_approved" invisible="1"/>
                <field name="ks_cancel_pm1_approved" invisible="1"/>
                <field name="ks_cancel_pm2_approved" invisible="1"/>
                <field name="ks_edit_pm1_approved" invisible="1"/>
                <field name="ks_edit_pm2_approved" invisible="1"/>
                <field name="ks_edit_approved" invisible="1"/>
                <field name="ks_edit_request_user_id" invisible="1"/>
                <field name="ks_is_dual_approval" invisible="1"/>
            </xpath>

            <!-- Hide Unlock button from normal users (locking is managed automatically by the approval workflow) -->
            <xpath expr="//button[@name='action_unlock']" position="attributes">
                <attribute name="invisible">not locked or ks_is_normal_user</attribute>
            </xpath>

            <!-- Hide Lock button from normal users (auto-locked on confirmation) -->
            <xpath expr="//button[@name='action_lock']" position="attributes">
                <attribute name="invisible">locked or state != 'sale' or ks_is_normal_user</attribute>
            </xpath>

            <!-- Hide original Cancel button for normal users when SO is confirmed -->
            <!-- Admin users should see the standard Cancel button (not hidden) -->
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state not in ['draft', 'sent', 'sale'] or not id or locked or (state == 'sale' and ks_is_normal_user and not ks_is_admin_user)</attribute>
            </xpath>

            <!-- Add PM Approval Buttons -->
            <xpath expr="//button[@name='action_cancel']" position="after">
                <!-- ====== PM USER BUTTONS ====== -->
                
                <!-- Approve Confirmation Button (PM Users only) -->
                <button name="ks_action_approve_confirmation" 
                        type="object"
                        string="Approve"
                        class="btn-success"
                        invisible="not ks_show_approve_confirm_button"
                        data-hotkey="v"/>
                
                <!-- Reject Confirmation Button (PM Users only) -->
                <button name="ks_action_reject_confirmation" 
                        type="object"
                        string="Reject"
                        class="btn-danger"
                        invisible="not ks_show_reject_confirm_button"
                        data-hotkey="r"/>

                <!-- Approve Cancel Button (PM Users only) -->
                <button name="ks_action_approve_cancel" 
                        type="object"
                        string="Approve Cancel"
                        class="btn-success"
                        invisible="not ks_show_approve_cancel_button"
                        data-hotkey="v"/>
                
                <!-- Reject Cancel Button (PM Users only) -->
                <button name="ks_action_reject_cancel" 
                        type="object"
                        string="Reject Cancel"
                        class="btn-danger"
                        invisible="not ks_show_reject_cancel_button"
                        data-hotkey="r"/>

                <!-- Approve Edit Button (PM Users only) -->
                <button name="ks_action_approve_edit" 
                        type="object"
                        string="Approve Edit"
                        class="btn-success"
                        invisible="not ks_show_approve_edit_button"
                        data-hotkey="e"/>
                
                <!-- Reject Edit Button (PM Users only) -->
                <button name="ks_action_reject_edit" 
                        type="object"
                        string="Reject Edit"
                        class="btn-danger"
                        invisible="not ks_show_reject_edit_button"
                        data-hotkey="r"/>

                <!-- ====== NORMAL USER BUTTONS ====== -->
                
                <!-- Request Cancel Button (Normal Users only, when SO is confirmed) -->
                <!-- Admin users should NOT see this - they use standard Cancel button -->
                <button name="action_cancel"
                        type="object"
                        string="Request Cancel"
                        class="btn-warning"
                        invisible="state != 'sale' or ks_is_pm_user or ks_edit_approved or ks_is_admin_user"
                        data-hotkey="c"/>

                <!-- Update Approvals Button (original requester, while approval_pending) -->
                <button name="action_update_approvals"
                        type="object"
                        string="Update Approvals"
                        class="btn-warning"
                        invisible="not ks_show_update_approval_button"
                        data-hotkey="u"
                        confirm="This will cancel the current approval request and let you choose new approvers. Continue?"/>

                <!-- Update Cancel Approvals Button (requester, while cancel_pending) -->
                <button name="action_update_cancel_approvals"
                        type="object"
                        string="Update Cancel Approvals"
                        class="btn-warning"
                        invisible="not ks_show_update_cancel_approval_button"
                        confirm="This will cancel the current cancel-approval request and let you choose new approvers. Continue?"/>

                <!-- Update Edit Approvals Button (requester, while edit_pending) -->
                <button name="action_update_edit_approvals"
                        type="object"
                        string="Update Edit Approvals"
                        class="btn-warning"
                        invisible="not ks_show_update_edit_approval_button"
                        confirm="This will cancel the current edit-approval request and let you choose new approvers. Continue?"/>

                <!-- Request Edit Button (Normal Users only, when SO is confirmed) -->
                <!-- Admin users should NOT see this - they can edit directly -->
                <button name="ks_action_request_edit"
                        type="object"
                        string="Request Edit"
                        class="btn-info"
                        invisible="not ks_show_request_edit_button or ks_is_admin_user"
                        data-hotkey="e"/>

                <!-- Complete Edit Button (Normal user who requested edit, after approval) -->
                <button name="ks_action_complete_edit" 
                        type="object"
                        string="Complete Edit"
                        class="btn-primary"
                        invisible="not ks_show_complete_edit_button"
                        data-hotkey="d"/>
            </xpath>

            <!-- Update statusbar to show new states -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,approval_pending,sale</attribute>
            </xpath>

            <!-- Add Approval Info Section in Other Information page -->
            <xpath expr="//page[@name='other_information']//group" position="after">
                <group name="ks_approval_info" string="Approval Information" 
                       invisible="state not in ('approval_pending', 'cancel_pending', 'edit_pending') and not ks_edit_approved">
                    <!-- Confirmation Request Info -->
                    <group string="Confirmation Request" 
                           invisible="state != 'approval_pending'" col="4">
                        <field name="ks_confirm_request_user_id" readonly="1"/>
                        <field name="ks_confirm_request_date" readonly="1"/>
                        <field name="ks_confirm_pm1_approved" readonly="1" widget="boolean" string="PM1 Approved"/>
                        <field name="ks_confirm_pm2_approved" readonly="1" widget="boolean" string="PM2 Approved"
                               invisible="not ks_is_dual_approval"/>
                    </group>
                    
                    <!-- Cancel Request Info -->
                    <group string="Cancel Request" 
                           invisible="state != 'cancel_pending'" col="4">
                        <field name="ks_cancel_request_user_id" readonly="1"/>
                        <field name="ks_cancel_request_date" readonly="1"/>
                        <field name="ks_cancel_request_reason" readonly="1"/>
                        <newline/>
                        <field name="ks_cancel_pm1_approved" readonly="1" widget="boolean" string="PM1 Approved"/>
                        <field name="ks_cancel_pm2_approved" readonly="1" widget="boolean" string="PM2 Approved"
                               invisible="not ks_is_dual_approval"/>
                    </group>

                    <!-- Edit Request Info -->
                    <group string="Edit Request" 
                           invisible="state != 'edit_pending' and not ks_edit_approved" col="4">
                        <field name="ks_edit_request_user_id" readonly="1"/>
                        <field name="ks_edit_request_date" readonly="1"/>
                        <field name="ks_edit_request_reason" readonly="1"/>
                        <newline/>
                        <field name="ks_edit_pm1_approved" readonly="1" widget="boolean" string="PM1 Approved"/>
                        <field name="ks_edit_pm2_approved" readonly="1" widget="boolean" string="PM2 Approved"
                               invisible="not ks_is_dual_approval"/>
                        <field name="ks_edit_approved" readonly="1" widget="boolean" 
                               invisible="state != 'sale'"
                               string="Currently Editable"/>
                    </group>
                </group>
            </xpath>

            <!-- Order lines remain editable; only tax field is readonly (see ks_sale_order tax_fields_readonly_views.xml).
                 Price/discount are still restricted by ks_can_edit_price in the line view below. -->

            <!-- Make partner_id readonly when in approval states (admin users can always edit) -->
            <xpath expr="//field[@name='partner_id'][not(ancestor::field)]" position="attributes">
                <attribute name="readonly">((state in ('cancel', 'sale', 'approval_pending', 'cancel_pending', 'edit_pending') or (state == 'sale' and ks_is_normal_user and not ks_edit_approved)) and not ks_is_admin_user) or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock payment terms for normal users after approval -->
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock salesperson for normal users after approval (targets the form field inside Other Info tab) -->
            <xpath expr="//group[@name='sales_person']//field[@name='user_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock tax on order lines -->
            <xpath expr="//field[@name='order_line']//list//field[@name='tax_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- Lock order line non-qty fields for qty-only edit mode -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="attributes">
                <attribute name="readonly">parent.ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">parent.ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="attributes">
                <attribute name="readonly">parent.ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom']" position="attributes">
                <attribute name="readonly">parent.ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="attributes">
                <attribute name="readonly">parent.ks_qty_only_edit</attribute>
            </xpath>
            <!-- Lock Invoice/Delivery address for qty-only edit mode -->
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock remaining header/Other Info fields not covered by Odoo's native locked condition -->
            <xpath expr="//field[@name='company_id'][not(ancestor::field)][not(@invisible='1')]" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock Project field (from sale_project) -->
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock Incoterm and Incoterm Location (from sale_stock) -->
            <xpath expr="//field[@name='incoterm']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='incoterm_location']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock Tracking section fields (Other Info tab) -->
            <xpath expr="//group[@name='sale_reporting']//field[@name='origin']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_reporting']//field[@name='campaign_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_reporting']//field[@name='medium_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_reporting']//field[@name='source_id']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock ks_no_tax_allowed (No Tax checkbox) when SO is locked -->
            <xpath expr="//field[@name='ks_no_tax_allowed']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

            <!-- Lock stock_decifient (Stock Deficient checkbox) when SO is locked -->
            <xpath expr="//field[@name='stock_decifient']" position="attributes">
                <attribute name="readonly">not ks_can_edit or ks_qty_only_edit</attribute>
            </xpath>

        </field>
    </record>

    <!-- Add banner for approval states -->
    <record id="ks_sale_order_form_banner" model="ir.ui.view">
        <field name="name">sale.order.form.ks.approval.banner</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <!-- Approval Pending Banner -->
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'approval_pending'">
                    <strong>⏳ Approval Pending:</strong> This Sale Order is waiting for confirmation approval.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_confirm_pm1_approved">✓ PM1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_confirm_pm1_approved">⏳ PM1 Pending</span>
                    <span invisible="not ks_is_dual_approval">&amp;nbsp;</span>
                    <span class="badge bg-success" invisible="not ks_confirm_pm2_approved or not ks_is_dual_approval">✓ PM2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_confirm_pm2_approved or not ks_is_dual_approval">⏳ PM2 Pending</span>
                </div>

                <!-- Cancel Pending Banner -->
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="state != 'cancel_pending'">
                    <strong>🚫 Cancel Pending:</strong> This Sale Order is waiting for cancellation approval.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_cancel_pm1_approved">✓ PM1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_cancel_pm1_approved">⏳ PM1 Pending</span>
                    <span invisible="not ks_is_dual_approval">&amp;nbsp;</span>
                    <span class="badge bg-success" invisible="not ks_cancel_pm2_approved or not ks_is_dual_approval">✓ PM2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_cancel_pm2_approved or not ks_is_dual_approval">⏳ PM2 Pending</span>
                </div>

                <!-- Edit Pending Banner -->
                <div class="alert alert-info mb-0" role="alert"
                     invisible="state != 'edit_pending'">
                    <strong>📝 Edit Pending:</strong> This Sale Order is waiting for edit approval.
                    <br/>
                    <span class="badge bg-success" invisible="not ks_edit_pm1_approved">✓ PM1 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_edit_pm1_approved">⏳ PM1 Pending</span>
                    <span invisible="not ks_is_dual_approval">&amp;nbsp;</span>
                    <span class="badge bg-success" invisible="not ks_edit_pm2_approved or not ks_is_dual_approval">✓ PM2 Approved</span>
                    <span class="badge bg-secondary" invisible="ks_edit_pm2_approved or not ks_is_dual_approval">⏳ PM2 Pending</span>
                </div>

                <!-- Edit Approved Banner (Editable Mode for the requester) -->
                <div class="alert alert-success mb-0" role="alert"
                     invisible="not ks_show_complete_edit_button">
                    <strong>✏️ Edit Mode:</strong> Edit has been approved. You can now edit this Sale Order. 
                    Click <strong>"Complete Edit"</strong> when done to lock the SO again.
                </div>

                <!-- Locked SO Banner for Normal Users -->
                <div class="alert alert-secondary mb-0" role="alert"
                     invisible="state != 'sale' or ks_is_pm_user or ks_edit_approved">
                    <strong>🔒 Confirmed:</strong> This Sale Order is confirmed. 
                    Use <strong>"Request Edit"</strong> to request edit permission or <strong>"Request Cancel"</strong> to request cancellation.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Sale Order Line - Price field restriction for normal users (inline list) -->
    <record id="ks_sale_order_line_price_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.ks.price.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <!-- Add computed field to inline list view -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="before">
                <field name="ks_can_edit_price" column_invisible="1"/>
                <field name="ks_min_unit_price" optional="hide" string="Min. Price (Purchase)"/>
            </xpath>
            <!-- Unit price editable unless qty-only edit mode -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">parent.ks_qty_only_edit</attribute>
            </xpath>
            <!-- Discount editable unless qty-only edit mode -->
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 or parent.ks_qty_only_edit</attribute>
            </xpath>
            <!-- Add computed field to inline form view (min price display only) -->
            <xpath expr="//field[@name='order_line']//form//field[@name='price_unit']" position="before">
                <field name="ks_can_edit_price" invisible="1"/>
                <field name="ks_min_unit_price" invisible="not product_id" readonly="1"/>
            </xpath>
            <!-- Unit price always editable in form (no readonly) -->
            <xpath expr="//field[@name='order_line']//form//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit List View to show new states with decoration -->
    <record id="ks_sale_order_list_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.ks.approval.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="decoration-warning">state == 'approval_pending'</attribute>
                <attribute name="decoration-danger">state == 'cancel_pending'</attribute>
                <attribute name="decoration-info">state == 'edit_pending'</attribute>
            </xpath>
        </field>
    </record>

