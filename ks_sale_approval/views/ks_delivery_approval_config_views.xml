<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delivery Approval Configuration Form View -->
    <record id="ks_delivery_approval_config_form" model="ir.ui.view">
        <field name="name">ks.delivery.approval.config.form</field>
        <field name="model">ks.delivery.approval.config</field>
        <field name="arch" type="xml">
            <form string="Delivery Approval Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Global Delivery Approval Configuration"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>Global Configuration:</strong> This configuration applies to all companies. Only one active configuration is allowed.
                    </div>
                    <group>
                        <group string="Approval Mode">
                            <field name="ks_approval_mode" widget="radio"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Validation Approvers" name="validate_approvers">
                            <group>
                                <group string="Approver 1 Users">
                                    <field name="ks_validate_pm1_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"
                                           context="{'show_email': True}"
                                           placeholder="Select users for Approval 1"/>
                                </group>
                                <group string="Approver 2 Users"
                                       invisible="ks_approval_mode == 'single'">
                                    <field name="ks_validate_pm2_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"
                                           context="{'show_email': True}"
                                           placeholder="Select users for Approval 2"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 invisible="ks_approval_mode != 'single'">
                                <strong>Single PM Approval:</strong> Only one approver from Approval 1 list is required to validate Delivery Orders.
                                Users will select an approver when requesting validation approval.
                            </div>
                            <div class="alert alert-info" role="alert"
                                 invisible="ks_approval_mode != 'dual'">
                                <strong>Two PM Approval:</strong> Both Approver 1 and Approver 2 must approve before Delivery Orders can be validated.
                                Users will select approvers from each list when requesting approval.
                                Approver 2 cannot approve until Approver 1 has approved.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Delivery Approval Configuration List View -->
    <record id="ks_delivery_approval_config_list" model="ir.ui.view">
        <field name="name">ks.delivery.approval.config.list</field>
        <field name="model">ks.delivery.approval.config</field>
        <field name="arch" type="xml">
            <list string="Delivery Approval Configurations">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="ks_approval_mode"/>
                <field name="ks_validate_pm1_ids" widget="many2many_tags"/>
                <field name="ks_validate_pm2_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_ks_delivery_approval_config" model="ir.actions.act_window">
        <field name="name">Delivery Approval Configuration</field>
        <field name="res_model">ks.delivery.approval.config</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Delivery Order Approval Workflow
            </p>
            <p>
                Set up PM approvers for Delivery Order validation requests.
                You can choose between single PM approval or require both PM1 and PM2 to approve.
            </p>
        </field>
    </record>

    <!-- Menu under Inventory > Configuration (Admin only) -->
    <menuitem
        id="menu_ks_delivery_approval_config"
        name="Delivery Approval Configuration"
        action="action_ks_delivery_approval_config"
        parent="stock.menu_warehouse_config"
        sequence="20"
        groups="base.group_system"/>
</odoo>
