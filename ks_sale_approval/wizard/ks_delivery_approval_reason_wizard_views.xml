<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_delivery_approval_reason_wizard_form" model="ir.ui.view">
        <field name="name">ks.delivery.approval.reason.wizard.form</field>
        <field name="model">ks.delivery.approval.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Reason">
                <group>
                    <field name="ks_picking_id" readonly="1"/>
                    <field name="ks_action_type" invisible="1"/>
                    <field name="ks_is_rejection" invisible="1"/>
                    <field name="ks_action_label" string="Action" readonly="1"/>
                    <field name="ks_reason" string="Reason"
                           placeholder="Please enter a reason (required)..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_submit" type="object"
                            string="Confirm Rejection" class="btn-danger"
                            invisible="not ks_is_rejection"/>
                    <button name="action_submit" type="object"
                            string="Confirm Approval" class="btn-success"
                            invisible="ks_is_rejection"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
