<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ks_delivery_approval_request_wizard_form" model="ir.ui.view">
        <field name="name">ks.delivery.approval.request.wizard.form</field>
        <field name="model">ks.delivery.approval.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Delivery Approval">
                <sheet>
                    <group>
                        <field name="ks_picking_id" invisible="1"/>
                        <field name="ks_approver1_user_ids" invisible="1"/>
                        <field name="ks_approver2_user_ids" invisible="1"/>
                        <field name="ks_approver1_filtered_ids" invisible="1"/>
                        <field name="ks_approver2_filtered_ids" invisible="1"/>
                        <field name="ks_show_approver2" invisible="1"/>
                        <field name="ks_is_update_mode" invisible="1"/>
                        <field name="ks_approval_info" nolabel="1" readonly="1"/>
                    </group>
                    <group>
                        <field name="ks_approver1_user"
                               options="{'no_create': True, 'no_create_edit': True}"
                               placeholder="Select Approver 1"
                               widget="many2one"/>
                        <field name="ks_approver2_user"
                               options="{'no_create': True, 'no_create_edit': True}"
                               placeholder="Select Approver 2"
                               widget="many2one"
                               invisible="not ks_show_approver2"/>
                        <field name="ks_reason" placeholder="Optional reason..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_request" type="object"
                            string="OK" class="btn-primary"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
