<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval/Rejection Reason Wizard Form View -->
    <record id="ks_sale_approval_reason_wizard_form" model="ir.ui.view">
        <field name="name">ks.sale.approval.reason.wizard.form</field>
        <field name="model">ks.sale.approval.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Reason">
                <field name="ks_price_below_purchase_warning" invisible="1"/>
                <div class="alert alert-warning mb-3" role="alert" invisible="not ks_price_below_purchase_warning">
                    <field name="ks_price_below_purchase_warning" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="ks_sale_order_id" readonly="1"/>
                    <field name="ks_action_type" invisible="1"/>
                    <field name="ks_is_rejection" invisible="1"/>
                    <field name="ks_action_type_label" string="Action Type" readonly="1"/>
                    <field name="ks_reason" 
                           string="Reason"
                           placeholder="Please enter a reason (required)..."
                           required="1"/>
                </group>
                <footer>
                    <button name="action_submit" 
                            type="object" 
                            string="Confirm Rejection" 
                            class="btn-danger"
                            invisible="not ks_is_rejection"/>
                    <button name="action_submit" 
                            type="object" 
                            string="Confirm Approval" 
                            class="btn-success"
                            invisible="ks_is_rejection"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

