<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         UC-A03: Extend Chart of Accounts list view
         Adds: Parent Account, Child Accounts, Layered Accounts, Depth, Is Leaf
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_account_list_layered" model="ir.ui.view">
        <field name="name">account.account.list.layered.coa</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">

            <!-- Add columns after the account name -->
            <xpath expr="//list" position="inside">
                <field name="layered_parent_id"
                       string="Parent Account"
                       optional="show"
                       decoration-muted="not layered_parent_id"/>
                <field name="is_parent_account"
                       string="Is Parent"
                       optional="show"
                       widget="boolean"/>
                <field name="layered_is_leaf"
                       string="Is Leaf"
                       optional="show"
                       widget="boolean"/>
                <field name="layered_depth"
                       string="Depth Level"
                       optional="show"/>
                <field name="layered_child_ids"
                       string="Child Accounts"
                       optional="show"
                       widget="many2many_tags"/>
                <field name="layered_account_ids"
                       string="Layered Accounts"
                       optional="hide"
                       widget="many2many_tags"/>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         UC-A02 / UC-A05: Extend Account form view
         Adds: Parent Account field + hierarchy info + action buttons
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_account_form_layered" model="ir.ui.view">
        <field name="name">account.account.form.layered.coa</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">

            <!-- Insert Layered COA section before the chatter -->
            <xpath expr="//sheet" position="inside">

                <group string="Layered Chart of Accounts" name="layered_coa_group"
                       attrs="{'invisible': False}">

                    <group>
                        <field name="layered_parent_id"
                               string="Parent Account"
                               attrs="{'readonly': [('is_parent_account', '=', True)]}"
                               help="Select a parent account of the same type to place this account in a hierarchy. Parent accounts must share the same account type."/>
                        <field name="layered_depth"
                               string="Hierarchy Depth Level"
                               readonly="1"/>
                        <field name="is_parent_account"
                               string="Is Parent Account"
                               readonly="1"
                               widget="boolean"/>
                        <field name="layered_is_leaf"
                               string="Is Leaf Account (Postable)"
                               readonly="1"
                               widget="boolean"/>
                    </group>

                    <group>
                        <field name="layered_child_ids"
                               string="Direct Child Accounts"
                               readonly="1"
                               widget="many2many_tags"/>
                        <field name="layered_account_ids"
                               string="All Descendant Accounts"
                               readonly="1"
                               widget="many2many_tags"/>
                    </group>

                </group>

            </xpath>

            <!-- Action buttons in statusbar area -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Convert to Parent button — only for leaf accounts with no moves -->
                <button name="action_convert_to_parent"
                        type="object"
                        string="Convert to Parent"
                        icon="fa-sitemap"
                        class="oe_stat_button"
                        attrs="{'invisible': [('is_parent_account', '=', True)]}"
                        groups="account.group_account_manager"
                        help="UC-A05: Convert this leaf account to a parent account. Requires zero balance and no existing journal entries."/>

                <!-- Reclassify Transactions button — only when moves exist -->
                <button name="action_open_reclassify_wizard"
                        type="object"
                        string="Reclassify Transactions"
                        icon="fa-exchange"
                        class="oe_stat_button"
                        groups="account.group_account_user"
                        help="UC-A06: Transfer all journal entry lines from this account to another account before hierarchy conversion."/>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         UC-A06: Reclassify Transactions Wizard view
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_layered_coa_reclassify_wizard_form" model="ir.ui.view">
        <field name="name">layered.coa.reclassify.wizard.form</field>
        <field name="model">layered.coa.reclassify.wizard</field>
        <field name="arch" type="xml">
            <form string="Reclassify Transactions">
                <sheet>
                    <div class="o_form_view_container">

                        <div class="alert alert-info" role="alert">
                            <strong>Layered COA — Reclassification (UC-A06)</strong><br/>
                            This wizard creates a reclassification journal entry that transfers
                            the net balance of the source account to the selected target account.
                            Use this before converting an account that has transactions into a parent account.
                        </div>

                        <group>
                            <group string="Source">
                                <field name="source_account_id" readonly="1"/>
                                <field name="source_account_type" readonly="1" invisible="1"/>
                                <field name="move_line_count" string="Journal Lines to Reclassify" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                            <group string="Target">
                                <field name="target_account_id" required="1"/>
                            </group>
                        </group>

                        <group string="Reclassification Details">
                            <field name="journal_id" required="1"/>
                            <field name="reclassification_date" required="1"/>
                            <field name="notes" placeholder="Optional notes or reference for this reclassification..."/>
                        </group>

                    </div>
                </sheet>
                <footer>
                    <button name="action_reclassify"
                            type="object"
                            string="Reclassify &amp; Post Entry"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Search view extension — filter by hierarchy position
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_account_search_layered" model="ir.ui.view">
        <field name="name">account.account.search.layered.coa</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[last()]" position="after">
                <separator/>
                <filter string="Parent Accounts Only"
                        name="filter_parent_accounts"
                        domain="[('is_parent_account', '=', True)]"
                        help="Show only accounts that have child accounts (not postable)."/>
                <filter string="Leaf Accounts Only"
                        name="filter_leaf_accounts"
                        domain="[('layered_is_leaf', '=', True)]"
                        help="Show only leaf (child) accounts that accept transactions."/>
                <filter string="Root Accounts"
                        name="filter_root_accounts"
                        domain="[('layered_parent_id', '=', False)]"
                        help="Show only top-level accounts with no parent assigned."/>
                <group expand="0" string="Group By">
                    <filter string="Parent Account"
                            name="groupby_parent"
                            context="{'group_by': 'layered_parent_id'}"/>
                    <filter string="Hierarchy Depth"
                            name="groupby_depth"
                            context="{'group_by': 'layered_depth'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Server action: Bulk assign parent account
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_layered_coa_bulk_assign_parent" model="ir.actions.server">
        <field name="name">Assign Parent Account</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="binding_model_id" ref="account.model_account_account"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = {
        'name': 'Assign Parent Account',
        'type': 'ir.actions.act_window',
        'res_model': 'layered.coa.assign.parent.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {
            'default_account_ids': records.ids,
        },
    }
        </field>
    </record>

</odoo>
