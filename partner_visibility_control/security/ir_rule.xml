        <!-- Rule 2: Bypass rule - See All Contacts group sees everything -->
        <record id="rule_contact_visibility_bypass" model="ir.rule">
            <field name="name">Contact: see all contacts (authority bypass)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('partner_visibility_control.group_contact_visibility_all'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_contact_sales_executive_visibility" model="ir.rule">
            <field name="name">Contact: visible to assigned Sales Executives only</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">
                ['|', ('user_ids', '!=', False), ('salesperson_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 3: Global company filter (AND with all rules above).
             If contact has a company set, only users belonging to that
             company can see it. Contacts with no company are visible to all. -->
