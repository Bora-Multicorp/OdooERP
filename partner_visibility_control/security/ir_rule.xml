<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Record Rule: Contact visible only to assigned Sales Executives.

            For non-admin internal users a contact is readable only when:
              - The current user is listed in salesperson_ids  (assigned), OR
              - No sales executives have been assigned yet     (unassigned contacts
                remain visible to everyone so they can be picked up).

            Admin / Technical users (base.group_system) are deliberately excluded
            from this rule's group list so they always see all contacts.
        -->
        <record id="rule_contact_sales_executive_visibility" model="ir.rule">
            <field name="name">Contact: visible to assigned Sales Executives only</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">
                [('salesperson_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
