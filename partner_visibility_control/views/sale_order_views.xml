<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inject the 'filter_by_salesperson' flag into the partner_id field
        context on the sale.order form view.

        This flag is read by ResPartner._search (res_partner.py) to append
        [('salesperson_ids', 'in', [uid])] via expression.AND to every
        search originating from this field — autocomplete dropdown and
        "Search More" dialog alike.

        XPath precision:
          [@widget='res_partner_many2one'] targets exactly the main editable
          customer field.  Without this attribute filter, the xpath matches
          the first partner_id occurrence in the view (a read-only header
          field) which has nothing to do with the search dropdown.

        Context preservation:
          We copy Odoo's original context keys verbatim so that the
          res_partner_many2one widget continues to work correctly:
            res_partner_search_mode → tells the widget to search customers
            show_address / show_vat → controls address display in the field
    -->
    <record id="sale_order_form_view_inherit_partner_domain"
            model="ir.ui.view">
        <field name="name">sale.order.form.partner.visibility.context</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']"
                   position="attributes">
                <attribute name="domain">[('customer_rank', '&gt;', 0)]</attribute>
                <attribute name="context">{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True, 'filter_by_salesperson': True}</attribute>
            </xpath>

        </field>
    </record>

</odoo>
