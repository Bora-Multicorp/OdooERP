<odoo>
    <record id="view_order_form_inherit_manual_rate" model="ir.ui.view">
        <field name="name">sale.order.form.manual.rate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Manual Exchange Rate" invisible="is_bora_company != True">
                    <field name="is_exchange"/>
                    <field name="rate" invisible="not is_exchange"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="is_bora_company" invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
