<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit_manual_rate" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.manual.rate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="is_bora_electronics" invisible="1"/>
                <field name="is_exchange" invisible ="not is_bora_electronics" readonly="locked"/>
                <field name="manual_exchange_rate" invisible="not is_bora_electronics or not is_exchange" readonly="locked"/>
            </xpath>
        </field>
    </record>
</odoo>