<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 
            Record Rule: Allow KS Payment Access group
            Only users in this group can access account.payment records.
            This rule allows full access to all payments for users in the group.
        -->
        <record id="payment_rule_ks_payment_access" model="ir.rule">
            <field name="name">Payments: KS Payment Access Group Only</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ks_payment_access_control.group_ks_payment_access'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- 
            Block other groups that might have default access to payments
            This ensures only KS Payment Access group can access payments.
        -->
        <record id="payment_rule_block_invoice_users" model="ir.rule">
            <field name="name">Payments: Block Invoice Users</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">[('id', 'in', [])]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <record id="payment_rule_block_readonly_users" model="ir.rule">
            <field name="name">Payments: Block Readonly Users</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">[('id', 'in', [])]</field>
            <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>

