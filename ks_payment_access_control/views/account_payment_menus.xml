<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Hide Customer Payments menu for users not in KS Payment Access group -->
        <!-- Use (6, 0, [...]) to replace all groups with only KS Payment Access group -->
        <record id="account.menu_action_account_payments_receivable" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('ks_payment_access_control.group_ks_payment_access')])]"/>
        </record>
        
        <!-- Hide Vendor Payments menu for users not in KS Payment Access group -->
        <!-- Use (6, 0, [...]) to replace all groups with only KS Payment Access group -->
        <record id="account.menu_action_account_payments_payable" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('ks_payment_access_control.group_ks_payment_access')])]"/>
        </record>
    </data>
</odoo>

