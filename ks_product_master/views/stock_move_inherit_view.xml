<odoo>
    <data>
        <record id="view_stock_move_form_inherit" model="ir.ui.view">
            <field name="name">stock.move.form.inherit</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_stock_move_operations"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="show_IMEI_field" invisible="1"/>
                    <field name="show_IMEI_field2" invisible="1"/>
                    <field name="hide_imei_fields" invisible="1"/>
                </xpath>
                <xpath expr="//widget[@name='import_lots']" position="after">
                    <button name="action_open_upload_csv_wizard" type="object" string="Upload File" class="btn btn-link" invisible="not display_import_lot"/>
                    <button name="action_download_sample_xlsx" type="object" string="Download Sample Template" class="btn btn-link" invisible="not display_import_lot"/>
                </xpath>
            </field>
        </record>

        <record id="view_transfer_form_inherit_no_create_product" model="ir.ui.view">
          <field name="name">stock.picking.form.inherit.no.create</field>
          <field name="model">stock.picking</field>
          <field name="inherit_id" ref="stock.view_picking_form"/>
          <field name="arch" type="xml">
              <xpath expr="//field[@name='move_ids_without_package']//list/field[@name='product_id']"
                     position="attributes">
                  <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_open': True}</attribute>
              </xpath>
              <xpath expr="//field[@name='partner_id']"
                     position="attributes">
                  <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_open': True}</attribute>
              </xpath>
          </field>
        </record>

        <record id="view_stock_move_line_operation_tree_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.tree.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_name']" position="after">
                    <field name="imei" placeholder="IMEI No."
                           column_invisible="not parent.hide_imei_fields or not parent.show_IMEI_field" required="1"/>
                    <field name="imei2" placeholder="IMEI No."
                           column_invisible="not parent.hide_imei_fields or not parent.show_IMEI_field2" required="1"/>
                    <!-- Made In Country — shown in both the picking Detailed Ops tab and
                         the Stock Move popup. optional="show" means visible by default;
                         users can hide it via the column toggle menu. -->
                    <field name="made_in_country_id"
                           string="Made In"
                           context="{'no_create_edit': True}"
                           optional="show"
                           readonly="state == 'done'"/>
                </xpath>
            </field>
        </record>

        <!-- Add lot_name, imei, imei2 to the detailed operations list view -->
        <record id="view_move_line_detailed_op_imei_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.detailed.op.imei.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <!-- Make lot_name always visible (override context-based column_invisible) -->
                <xpath expr="//field[@name='lot_name']" position="attributes">
                    <attribute name="column_invisible">False</attribute>
                    <attribute name="optional">show</attribute>
                </xpath>
                <!-- Add imei and imei2 after lot_name -->
                <xpath expr="//field[@name='lot_name']" position="after">
                    <field name="imei" string="IMEI" optional="show"
                           readonly="state in ('done', 'cancel') and is_locked"/>
                    <field name="imei2" string="IMEI 2" optional="show"
                           readonly="state in ('done', 'cancel') and is_locked"/>
                </xpath>
            </field>
        </record>
        <!-- Add imei and imei2 to stock.view_move_line_tree (Move Lines history list) -->
        <record id="view_move_line_tree_imei_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.tree.imei.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="imei" string="IMEI 1" optional="show"/>
                    <field name="imei2" string="IMEI 2" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
