<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AD Margin Report Wizard Form View -->
    <record id="view_ad_margin_report_wizard_form" model="ir.ui.view">
        <field name="name">ad.margin.report.wizard.form</field>
        <field name="model">ad.margin.report.wizard</field>
        <field name="arch" type="xml">
            <form string="AD Margin Report">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Report Name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- AD Margin Report Wizard Action -->
    <record id="action_ad_margin_report_wizard" model="ir.actions.act_window">
        <field name="name">AD Margin Report</field>
        <field name="res_model">ad.margin.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- AD Margin Report Header - List View (Master: all saved reports; New button creates new report) -->
    <record id="view_ad_margin_report_header_list" model="ir.ui.view">
        <field name="name">ad.margin.report.header.list</field>
        <field name="model">ad.margin.report.header</field>
        <field name="arch" type="xml">
            <list string="AD Margin Reports" create="1" delete="1" edit="1">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="message_follower_ids" column_invisible="1"/>
                <field name="activity_ids" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- AD Margin Report Header - Form View (name, dates, filters; Generate button; lines read-only) -->
    <record id="view_ad_margin_report_header_form" model="ir.ui.view">
        <field name="name">ad.margin.report.header.form</field>
        <field name="model">ad.margin.report.header</field>
        <field name="arch" type="xml">
            <form string="AD Margin Report">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_generate_lines" string="Generate" type="object" class="btn-primary"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" nolabel="1">
                                <list string="AD Margin" default_order="partner_id, product_id, invoice_date, mop_date" create="0" delete="0" decoration-info="sales_quantity > 0">
                                    <field name="partner_id" optional="hide"/>
                                    <field name="party_name" string="Party" readonly="1"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="item_name" string="Item Name" readonly="1"/>
                                    <field name="item_alias" string="Item" readonly="1"/>
                                    <field name="invoice_date" string="Invoice Date" optional="show"/>
                                    <field name="mop_date" string="MOP Date" optional="show"/>
                                    <field name="sales_rate" string="Sales Rate" readonly="1"/>
                                    <field name="sales_quantity" string="Sales Qty" readonly="1"/>
                                    <field name="mop" string="MOP" readonly="1"/>
                                    <field name="x_gst_mop" string="X GST MO" readonly="1"/>
                                    <field name="diff" string="Diff" readonly="1"/>
                                    <field name="margin" string="Margin" readonly="1"/>
                                    <field name="total" string="Total" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- AD Margin Report Header - Search View -->
    <record id="view_ad_margin_report_header_search" model="ir.ui.view">
        <field name="name">ad.margin.report.header.search</field>
        <field name="model">ad.margin.report.header</field>
        <field name="arch" type="xml">
            <search string="AD Margin Reports">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </search>
        </field>
    </record>

    <!-- AD Margin Report Lines - List View (standalone: all lines, editable) -->
    <record id="view_ad_margin_report_list" model="ir.ui.view">
        <field name="name">ad.margin.report.list</field>
        <field name="model">ad.margin.report</field>
        <field name="arch" type="xml">
            <list string="AD Margin Report" default_order="partner_id, product_id, invoice_date, mop_date" decoration-info="sales_quantity > 0" editable="bottom" create="1" delete="1">
                <field name="report_id" optional="show"/>
                <field name="party_name" string="Party" readonly="1"/>
                <field name="item_name" string="Item Name" readonly="1"/>
                <field name="item_alias" string="Item" readonly="1"/>
                <field name="invoice_date" string="Invoice Date" optional="show"/>
                <field name="mop_date" string="MOP Date" optional="show"/>
                <field name="sales_rate" string="Sales Rate" sum="Total:"/>
                <field name="sales_quantity" string="Sales Quantity" sum="Total:"/>
                <field name="mop" string="MOP" sum="Total:"/>
                <field name="x_gst_mop" string="X GST MO" sum="Total:" readonly="1"/>
                <field name="diff" string="Diff" sum="Total:" readonly="1"/>
                <field name="margin" string="Margin" sum="Total:" readonly="1"/>
                <field name="total" string="Total" sum="Total:" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- AD Margin Report Search View -->
    <record id="view_ad_margin_report_search" model="ir.ui.view">
        <field name="name">ad.margin.report.search</field>
        <field name="model">ad.margin.report</field>
        <field name="arch" type="xml">
            <search string="AD Margin Report">
                <field name="party_name"/>
                <field name="item_name"/>
                <field name="item_alias"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter string="Date From" name="date_from" domain="[('invoice_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date To" name="date_to" domain="[('invoice_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Party Name" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Invoice Date" name="group_by_invoice_date" context="{'group_by': 'invoice_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- AD Margin Master List Action (saved reports - main entry) -->
    <record id="action_ad_margin_report_header" model="ir.actions.act_window">
        <field name="name">AD Margin</field>
        <field name="res_model">ad.margin.report.header</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ad_margin_report_header_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AD Margin report
            </p>
            <p>
                Click "New" to create a report. Fill report name, dates and filters, then open the record and click "Generate" to create report lines. Lines are read-only.
            </p>
        </field>
    </record>

    <!-- AD Margin Lines Action (all lines from all reports) -->
    <record id="action_ad_margin_report" model="ir.actions.act_window">
        <field name="name">AD Margin Report</field>
        <field name="res_model">ad.margin.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_ad_margin_report_search"/>
        <field name="context">{'search_default_group_by_partner': 1}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_ad_margin_report"
              name="AD Margin"
              parent="stock.menu_warehouse_report"
              action="action_ad_margin_report_header"
              sequence="101"/>
    <!-- Generate new AD Margin report (wizard) -->
    <menuitem id="menu_ad_margin_report_generate"
              name="Generate AD Margin Report"
              parent="stock.menu_warehouse_report"
              action="action_ad_margin_report_wizard"
              sequence="102"/>
</odoo>
