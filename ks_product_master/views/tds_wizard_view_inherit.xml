<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tds_entry_view_form_inherit_ks_product_master" model="ir.ui.view">
        <field name="name">l10n_in.withhold.wizard.view.form.inherit.ks</field>
        <field name="model">l10n_in.withhold.wizard</field>
        <field name="inherit_id" ref="l10n_in_withholding.tds_entry_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='withhold_line_ids']//list//field[@name='tax_id']" position="attributes">
                <attribute name="domain">[('l10n_in_tds_tax_type', '=', l10n_in_tds_tax_type), ('company_id', 'in', [parent.company_id, False])]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
