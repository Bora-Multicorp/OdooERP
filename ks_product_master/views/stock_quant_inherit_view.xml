<odoo>
    <data>
        <record id="view_stock_quant_tree_inherit" model="ir.ui.view">
            <field name="name">stock.quant.tree.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//list/field[@name='lot_id']" position="after">
                    <field name="imei" column_invisible="not context.get('show_IMEI')"/>
                    <field name="imei2" column_invisible="not context.get('show_IMEI2')"/>
                    <field name="activation_status" column_invisible="not context.get('show_IMEI')" groups="base.group_system"/>
                    <field name="activation_date"/>
                    <field name="specs_made" optional="show" string="Spec Made For"/>
                    <field name="made_country" optional="show" readonly="1" string="Made In"/>
                </xpath>
            </field>
        </record>
        <record id="view_stock_quant_form_editable_inherit" model="ir.ui.view">
            <field name="name">stock.quant.form.editable.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_form_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="imei" invisible="not context.get('show_IMEI')"/>
                    <field name="imei2" invisible="not context.get('show_IMEI2')"/>
                    <field name="activation_status" invisible="not context.get('show_IMEI')" groups="base.group_system"/>
                    <field name="specs_made"/>
                    <field name="made_country" readonly="1"/>
                </xpath>
            </field>
        </record>
        <record id="view_stock_quant_tree_inventory_editable_inherit" model="ir.ui.view">
            <field name="name">stock.quant.tree.inventory_editable</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//list/field[@name='lot_id']" position="after">
                    <field name="imei" optional="hidden"/>
                    <field name="imei2" optional="hidden"/>
                    <field name="activation_status" optional="hidden" groups="base.group_system"/>
                    <field name="activation_date" optional="hidden"/>
                    <field name="active_months" readonly="1" optional="hidden"/>
                    <field name="specs_made" optional="hidden"/>
                    <field name="made_country" optional="hidden" readonly="1"/>
                </xpath>
            </field>
        </record>
        <record id="view_stock_quant_search_inherit_activation_status_group" model="ir.ui.view">
            <field name="name">stock.quant.search.inherit.activation.status.group</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.quant_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter string="Activation Status" name="group_by_activation_status"
                            context="{'group_by':'activation_status'}"/>
                </xpath>
            </field>
        </record>

        <!-- Menu: All sold stock.quant that have IMEI, grouped by activation_status -->
        <record id="action_stock_quant_sold_not_activated" model="ir.actions.act_window">
            <field name="name">Sold &amp; Not Activated</field>
            <field name="res_model">stock.quant</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('location_id.usage', '=', 'customer'), '|', ('imei', '!=', False), ('imei2', '!=', False)]</field>
            <field name="context">{'show_IMEI': True, 'show_IMEI2': True, 'search_default_group_by_activation_status': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No sold stock with IMEI
                </p>
                <p>
                    This list shows all stock delivered to customers (sold) that have an IMEI number, grouped by activation status.
                    Use &quot;Update Activation Status using CSV&quot; to update activation from an Excel file.
                </p>
            </field>
        </record>
        <menuitem id="menu_stock_quant_sold_not_activated"
                  name="Sold &amp; Not Activated"
                  parent="stock.menu_stock_warehouse_mgmt"
                  action="action_stock_quant_sold_not_activated"
                  sequence="201"
                  groups="ks_product_master.group_activation_status_update"/>
    </data>
</odoo>