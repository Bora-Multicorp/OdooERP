<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Funnel Wizard Form View -->
    <record id="view_margin_analysis_report_wizard_form" model="ir.ui.view">
        <field name="name">margin.analysis.report.wizard.form</field>
        <field name="model">margin.analysis.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Funnel">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="brand_id"/>
                            <field name="category_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Funnel Wizard Action -->
    <record id="action_margin_analysis_report_wizard" model="ir.actions.act_window">
        <field name="name">Funnel</field>
        <field name="res_model">margin.analysis.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Funnel List View -->
    <record id="view_margin_analysis_report_tree" model="ir.ui.view">
        <field name="name">margin.analysis.report.tree</field>
        <field name="model">margin.analysis.report</field>
        <field name="arch" type="xml">
            <list string="Funnel" default_order="product_id" decoration-info="purchase_actual_qty > 0" editable="bottom">
                <field name="brand_id" string="Brand" optional="show"/>
                <field name="item_name" string="Item Name" readonly="1"/>
                <field name="item_alias" string="Item Alias" readonly="1"/>
                <field name="purchase_actual_qty" string="Purchase Actual Quantity" sum="Total:" readonly="1"/>
                <field name="purchase_rate" string="Purchase Rate" sum="Total:" readonly="1"/>
                <field name="nlc" string="NLC" sum="Total:" readonly="1"/>
                <field name="mop" string="MOP" sum="Total:"/>
                <field name="funnal" string="Funnal" sum="Total:" readonly="1"/>
                <field name="funnal_percent" string="%" sum="Total:" readonly="1"/>
                <field name="total_funnal" string="Total Funnal" sum="Total:" readonly="1"/>
                <field name="gst_funnal" string="x GST Funnal" sum="Total:" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Funnel Search View -->
    <record id="view_margin_analysis_report_search" model="ir.ui.view">
        <field name="name">margin.analysis.report.search</field>
        <field name="model">margin.analysis.report</field>
        <field name="arch" type="xml">
            <search string="Funnel">
                <field name="item_name"/>
                <field name="item_alias"/>
                <field name="product_id"/>
                <filter string="Date From" name="date_from" domain="[('date_from', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date To" name="date_to" domain="[('date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Brand" name="group_by_brand" context="{'group_by': 'brand_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Date From" name="group_by_date_from" context="{'group_by': 'date_from'}"/>
                    <filter string="Date To" name="group_by_date_to" context="{'group_by': 'date_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Funnel Action -->
    <record id="action_margin_analysis_report" model="ir.actions.act_window">
        <field name="name">Funnel</field>
        <field name="res_model">margin.analysis.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_margin_analysis_report_search"/>
        <field name="context">{'search_default_group_by_product': 1}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_margin_analysis_report"
              name="Funnel"
              parent="stock.menu_warehouse_report"
              action="action_margin_analysis_report_wizard"
              sequence="100"/>
</odoo>

