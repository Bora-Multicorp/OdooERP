<odoo>
    <data>
        <record id="update_activation_status_using_csv_form" model="ir.ui.view">
            <field name="name">activation.status.wizard.form</field>
            <field name="model">activation.status.wizard</field>
            <field name="arch" type="xml">
                <form string="Update Activation Status using CSV">
                    <group>
                        <field name="csv_file" filename="filename"
                               options="{'accepted_file_extensions': '.csv, .xls, .xlsx, .xlsm'}"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_process_file" string="Submit" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                        <div style="margin-left:auto;">

                            <a class="btn btn-primary" role="button" type="object" name="your_method_name">Download
                                Sample Format File
                            </a>

                        </div>
                    </footer>
                </form>
            </field>
        </record>
        <record id="update_activation_status_using_csv" model="ir.actions.act_window">
            <field name="name">Update Activation Status using CSV</field>
            <field name="res_model">activation.status.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <!-- Opens in a modal -->
            <field name="view_id" ref="update_activation_status_using_csv_form"/>
        </record>
        <menuitem id="activation_status_update_using_csv" name="Update Activation Status using CSV"
                  action="update_activation_status_using_csv"
                  parent="stock.menu_stock_warehouse_mgmt" sequence="202"/>
    </data>
</odoo>