<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data noupdate="0">
        <record id="product_attribute_box_type" model="product.attribute">
            <field name="name">Box Type</field>
            <field name="display_type">radio</field>
            <field name="create_variant">always</field>
        </record>

        <!-- Attribute Value A -->
        <record id="product_attribute_value_box_type_master" model="product.attribute.value">
            <field name="name">Master Carton</field>
            <field name="attribute_id" ref="product_attribute_box_type"/>
        </record>

        <!-- Attribute Value B -->
        <record id="product_attribute_value_box_type_loose" model="product.attribute.value">
            <field name="name">Loose</field>
            <field name="attribute_id" ref="product_attribute_box_type"/>
        </record>

        <record id="product_category_type_mobile" model="product.category">
            <field name="name">Mobile Phone</field>
            <field name="product_attributes" eval="[(4, ref('ks_product_master.product_attribute_box_type'))]"/>
        </record>

<!--        <record id="product_category_type_tablet" model="product.category">-->
<!--            <field name="name">Tablet</field>-->
<!--        </record>-->
<!--        <record id="product_category_type_accessory" model="product.category">-->
<!--            <field name="name">Accessory</field>-->
<!--        </record>-->
        <record id="product_category_type_harddisk" model="product.category">
            <field name="name">Hard Disk</field>
        </record>
        <record id="product_category_type_laptop" model="product.category">
            <field name="name">Other Laptop</field>
        </record>
        <record id="product_category_type_apple_imac" model="product.category">
            <field name="name">Apple iMac</field>
        </record>
        <record id="product_category_type_apple_laptops" model="product.category">
            <field name="name">Apple Laptops</field>
        </record>
        <record id="product_category_type_toner_inks" model="product.category">
            <field name="name">Toner &amp; Inks</field>
        </record>
        <record id="product_category_type_printers" model="product.category">
            <field name="name">Printer</field>
        </record>
<!--        <record id="product_category_type_packaging_material" model="product.category">-->
<!--            <field name="name">Packaging Material</field>-->
<!--        </record>-->
    </data>
</odoo>


        <!-- ALERT - on adding / removing any category from here, a change in 'product_template_inherit_view.xml' is required for field 'categ_id' -->
