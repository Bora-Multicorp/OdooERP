<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_approval_user_picker_wizard" model="ir.ui.view">
        <field name="name">partner.approval.user.picker.wizard.form</field>
        <field name="model">partner.approval.user.picker.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Approval Users">
                <sheet>
                    <group>
                        <field name="partner_id" invisible="1"/>
                        <field name="ks_is_update_mode" invisible="1"/>
                        <field name="approver1_user_ids" invisible="1"/>
                        <field name="approver2_user_ids" invisible="1"/>
                        <field name="ks_approval_info" widget="html" readonly="1" nolabel="1"/>
                        <field name="approver1_user" options="{'no_create': True}" required="1"/>
                        <field name="approver2_user" options="{'no_create': True}" required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="add_users_for_approval" class="btn-primary"
                            invisible="add_button_disabled == 1"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
