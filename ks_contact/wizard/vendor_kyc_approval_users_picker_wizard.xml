<odoo>
    <record id="view_kyc_vendor_approval_user_picker_wizard" model="ir.ui.view">
        <field name="name">view.kyc.vendor.approval.user.picker.wizard</field>
        <field name="model">vendor.kyc.approval.user.picker.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Users">
                <sheet>
                    <group>
                        <div class="o_form_label o_text_warning" style="margin-bottom: 10px;">
                            Kyc submission requires approval, an approval request will be generated for the selected
                            authorities.
                        </div>
                        <field name="user_ids_according_to_user_selection" invisible="1"/>
                        <field name="approval_level_1_user_id" readonly="1"/>
                        <field name="approval_level_2_user_id" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="add_users_for_approval" class="btn-primary"
                            invisible="add_button_disabled == 1"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kyc_vendor_approval_user_picker_wizard" model="ir.actions.act_window">
        <field name="name">KYC Vendor Approval User Picker</field>
        <field name="res_model">vendor.kyc.approval.user.picker.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_kyc_id': active_id,
            }
        </field>
    </record>
</odoo>

