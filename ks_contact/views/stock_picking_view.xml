<odoo>
    <data>
        <record id="view_picking_form_inherit_dynamic_partner_domain" model="ir.ui.view">
    <field name="name">stock.picking.form.inherit.partner.domain</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id']" position="attributes">
            <attribute name="domain">
                [('is_vendor', '=', True), ('is_kyc', '=', True)] if picking_type_code == 'incoming' else [('is_customer', '=', True)] if picking_type_code == 'outgoing' else []
            </attribute>
            <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
        </xpath>
    </field>
</record>
    </data>
</odoo>