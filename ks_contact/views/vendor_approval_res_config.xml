<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="vendor_approval_config_view_form" model="ir.ui.view">
        <field name="name">vendor.approval.config.view.form</field>
        <field name="model">vendor.approval.config</field>
        <field name="arch" type="xml">
            <form string="Vendor Approval Settings">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" 
                                   options="{'no_create': True}"
                                   required="1"/>
                        </group>
                        <group>
                            <field name="approver_type" required="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" style="margin-top: 10px;">
                        <strong>Note:</strong> Configure approvers for vendor approval process. 
                        A user can be configured as both Approver 1 and Approver 2 (separate records).
                        This configuration is global and not company-specific.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="vendor_approval_config_view_list" model="ir.ui.view">
        <field name="name">vendor.approval.config.view.list</field>
        <field name="model">vendor.approval.config</field>
        <field name="arch" type="xml">
            <list string="Vendor Approval Settings">
                <field name="user_id" 
                       options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                <field name="approver_type"/>
            </list>
        </field>
    </record>

    <!-- Action (Admin only) -->
    <record id="action_vendor_approval_config" model="ir.actions.act_window">
        <field name="name">Vendor Approval Settings</field>
        <field name="res_model">vendor.approval.config</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure Vendor Approval Settings</p>
            <p>
                Set up Approver 1 and Approver 2 users for vendor KYC approval workflow.
                A user can be configured for both approver types (create separate records).
            </p>
        </field>
    </record>

    <!-- Menu item under Contacts > Configuration (Admin only) -->
    <menuitem id="menu_vendor_approval_config"
              name="Vendor Approval Settings"
              parent="contacts.res_partner_menu_config"
              action="action_vendor_approval_config"
              groups="base.group_system"
              sequence="100"/>
</odoo>
