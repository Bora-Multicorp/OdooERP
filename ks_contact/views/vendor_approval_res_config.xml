<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="vendor_approval_config_view_form" model="ir.ui.view">
        <field name="name">vendor.approval.config.view.form</field>
        <field name="model">vendor.approval.config</field>
        <field name="arch" type="xml">
            <form string="Vendor Approval Settings" class="oe_form_configuration o_base_settings" create="false">
                <sheet>
                    <group>
                        <field name="existing_user_ids" invisible="1"/>
                        <field name="user_id" options="{'no_create': True, 'no_create_edit': True}" domain="[('id', 'not in', existing_user_ids)]"/>
                        <field name="default_approver"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="vendor_approval_config_view_list" model="ir.ui.view">
        <field name="name">vendor.approval.config.view.list</field>
        <field name="model">vendor.approval.config</field>
        <field name="arch" type="xml">
            <list string="Vendor Approval Settings">
                <field name="sequence" widget="handle" class="o_data_cell_sequence"/>
                   <field name="default_user" column_invisible="1"/>
                <field name="user_id"   options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                <field name="default_approver"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vendor_approval_config" model="ir.actions.act_window">
        <field name="name">Vendor Approval Settings</field>
        <field name="res_model">vendor.approval.config</field>
        <!--<field name="view_id" ref="vendor_approval_config_view_form"/>-->
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your vendor approvers here.</p>
        </field>
    </record>

    <!-- Menu item under Contacts > Configuration -->
    <menuitem id="menu_vendor_approval_config"
              name="Vendor Approval Users"
              parent="contacts.res_partner_menu_config"
              action="action_vendor_approval_config"
              groups="base.user_admin"
              sequence="100"/>
</odoo>
