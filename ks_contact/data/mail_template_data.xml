<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="survey.mail_template_user_input_invite" model="mail.template">
            <field name="name">KYC Form: Invite</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">{{ object.survey_id.display_name }} survey</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ (object.partner_id.email_formatted or object.email) }}</field>
            <field name="description">Sent to user when you share a KYC form</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-out="object.partner_id.name or 'participant'">User</t>
                        <br/>
                        <br/>
                        We are sharing a KYC form and your response would be appreciated.
                        <div style="margin: 16px 0px 16px 0px;">
                            <a t-att-href="(object.get_start_url())"
                               style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">

                                Start
                            </a>
                        </div>

                        <t t-if="object.survey_id.certification">
                            We wish you good luck!
                        </t>
                        <t t-else="">
                            Thank you.
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Vendor KYC Approval Assignment (Internal Email) - sent to assigned approver when approval request is submitted -->
        <record id="assign_to_email_template" model="mail.template">
            <field name="name">Vendor KYC Approval Assignment (Internal Email)</field>
            <field name="model_id" ref="model_res_partner_kyc_approval"/>
            <field name="subject">Vendor KYC Approval Required – {{ object.partner_id.name or object.display_name }}</field>
            <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.assigned_to.email if object.assigned_to else '' }}</field>
            <field name="partner_to">{{ object.assigned_to.partner_id.id if object.assigned_to else '' }}</field>
            <field name="description">Sent to assigned approver when a vendor KYC approval request is submitted</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.assigned_to.name or 'User'">User</t>,
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        A Vendor KYC approval request has been assigned to you for the following vendor:
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <strong>Vendor Name:</strong> <t t-out="object.partner_id.name or ''">Vendor</t>
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Kindly review the submitted KYC documents and proceed with the approval or necessary action in the system.
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Regards,<br/>
                        <strong><t t-out="(object.partner_id.company_id.name if object.partner_id.company_id else user.company_id.name) or 'Company'">Company Name</t></strong>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.assigned_to.lang if object.assigned_to else '' }}</field>
        </record>

        <!-- KYC Approval Email Template -->
        <record id="kyc_approval_email_template" model="mail.template">
            <field name="name">KYC Approved Template</field>
            <field name="model_id" ref="model_res_partner_kyc_approval"/>
            <field name="subject">KYC is approved for : {{ object.partner_id.name }}</field>
            <field name="description">KYC Approved Email Template</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Dear Sir/Madam</p>
                    <p>KYC is Approved for following:</p>
                    <table style="width:60%; border-collapse: collapse; font-family: Arial, sans-serif;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <strong>Name</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <t t-out="object.partner_id.name or ''"></t>
                            </td>
                        </tr>
                        <tr>
                            <td style="width:20%;padding:8px;border:1px solid #ddd;">
                                <strong>Approval Date</strong>
                            </td>
                            <td style="width:20%;padding:8px;border:1px solid #ddd;">
                                <t t-out="format_datetime(object.approval_date)"></t>
                            </td>
                        </tr>
                    </table>
                    <table style="width: 60%; border-collapse: collapse; font-family: Arial, sans-serif;">
                        <thead>
                            <tr>
                                <th style="padding: 8px; border: 1px solid #ddd;">Approver Name</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Action Date</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Remarks</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="object.approval_users_ids" t-as="line">
                                <tr>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.user_id.name or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.action_date or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.remark or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.state or ''"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <br/>
                    <p>Thanks and Regards.</p>
                </div>
            </field>
        </record>

        <!-- Vendor Re-KYC Confirmation Request - sent to vendor when Re-KYC is submitted -->
        <record id="mail_template_vendor_rekyc_confirmation_request" model="mail.template">
            <field name="name">Vendor Re-KYC Confirmation Request</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Vendor KYC Re-confirmation Request – {{ object.company_id.name or user.company_id.name }}</field>
            <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email or '' }}</field>
            <field name="partner_to">{{ object.id }}</field>
            <field name="description">Sent to vendor when a Re-KYC confirmation request is submitted</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.name or 'Vendor'">Vendor</t>,
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        As part of our periodic compliance process, we are conducting a <strong>re-confirmation of vendor KYC records.</strong>
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Please find below the KYC details currently available in our records:
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <strong>Vendor Name:</strong> <t t-out="object.name or ''">Vendor</t><br/>
                        <strong>Registered Address:</strong> <t t-out="object.street or ''"/>, <t t-out="object.city or ''"/>, <t t-out="object.state_id.name if object.state_id else ''"/>, <t t-out="object.country_id.name if object.country_id else ''"/><br/>
                        <strong>GST Number:</strong> <t t-out="object.vat or ''">GST</t><br/>
                        <strong>Contact Person:</strong> <t t-out="object.name or ''">Contact</t><br/>
                        <strong>Email:</strong> <t t-out="object.email or ''">Email</t><br/>
                        <strong>Phone:</strong> <t t-out="object.phone or ''">Phone</t>
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Kindly review the above details and confirm the following:
                    </p>
                    <ul style="margin: 0px; padding: 0px 0px 0px 20px; font-size: 13px;">
                        <li>If there are <strong>no material changes</strong>, please reply to this email confirming that the above details remain unchanged.</li>
                        <li>If there are <strong>any changes</strong>, please share the updated details along with the relevant supporting documents.</li>
                    </ul>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Your confirmation will help us ensure that our records remain accurate and up to date.
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        We appreciate your cooperation.
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        To update your KYC details, please click the button below. Your existing information has been pre-filled for your convenience:
                    </p>
                    <br/>
                    <p style="margin-top: 16px; margin-bottom: 16px;">
                        <t t-if="object.rekyc_survey_url">
                            <a t-att-href="object.rekyc_survey_url"
                               style="display: inline-block; padding: 10px 24px; background-color: #0d6efd; color: #ffffff !important; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 14px;">
                                Update KYC
                            </a>
                        </t>
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Warm regards,<br/>
                        <strong><t t-out="object.company_id.name or user.company_id.name or 'Company'">Company Name</t></strong>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.lang }}</field>
        </record>

        <!-- KYC Rejection Email Template -->
        <record id="kyc_rejection_email_template" model="mail.template">
            <field name="name">KYC Rejection Template</field>
            <field name="model_id" ref="model_res_partner_kyc_approval"/>
            <field name="subject">KYC is rejected for : {{ object.partner_id.name }}</field>
            <field name="description">KYC Rejection Email Template</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Dear Sir/Madam</p>
                    <p>KYC is Rejected for following:</p>
                    <table style="width:60%; border-collapse: collapse; font-family: Arial, sans-serif;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <strong>Name</strong>
                            </td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <t t-out="object.partner_id.name or ''"></t>
                            </td>
                        </tr>
                    </table>
                    <table style="width: 60%; border-collapse: collapse; font-family: Arial, sans-serif;">
                        <thead>
                            <tr>
                                <th style="padding: 8px; border: 1px solid #ddd;">Name</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Action Date</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Remarks</th>
                                <th style="padding: 8px; border: 1px solid #ddd;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="object.approval_users_ids" t-as="line">
                                <tr>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.user_id.name or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.action_date or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.remark or ''"/>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #ddd;">
                                        <t t-out="line.state or ''"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <br/>
                    <p>Thanks and Regards.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
