<odoo>
    <record id="view_stock_valuation_layer_tree_inherit_usd" model="ir.ui.view">
        <field name="name">stock.valuation.layer.tree.usd</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value']" position="after">
                <field name="usd_value" invisible="not is_aed_company"/>
            </xpath>
        </field>
    </record>
</odoo>

