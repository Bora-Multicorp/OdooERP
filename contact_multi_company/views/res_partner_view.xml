<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="res_partner_form_view_multi_company">
        <field name="name">res.partner form view (with multi-company)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Hide the original single-company field -->
            <xpath
                expr="//page[@name='sales_purchases']//group[@name='misc']/field[@name='company_id'][@groups='base.group_multi_company']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Add the multi-company field in its place -->
            <xpath
                expr="//page[@name='sales_purchases']//group[@name='misc']/field[@name='company_id'][@groups='base.group_multi_company']"
                position="after"
            >
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
