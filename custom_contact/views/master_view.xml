<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Type -->
        <record id="res_partner_location_type_view_form" model="ir.ui.view">
            <field name="name">Type</field>
            <field name="model">res.partner.location.type</field>
            <field name="arch" type="xml">
                <form string="Type">
                    <sheet>
                        <group col="4">
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="res_partner_location_type_view_list" model="ir.ui.view">
            <field name="name">Type</field>
            <field name="model">res.partner.location.type</field>
            <field name="arch" type="xml">
                <list string="Type" editable="bottom">
                    <field name="name"/>
