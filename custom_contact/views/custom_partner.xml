<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.custom.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='contact_addresses']/field[@name='child_ids']/form/sheet/group/group[2]"
                   position="after">
                <group>
                    <field name="custom_type" widget="selection"/>
                    <field name="custom_address_type" widget="selection"/>
                    <field name="tally_name"/>
                    <field name="purpose"/>
                </group>
            </xpath>
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="%(vendor_kyc_wizard_action)d" string="Vendor/Customer KYC" type="action"
                            class="btn btn-primary"
                            display="always"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="is_vendor"/>
                <field name="is_customer"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="vendor_customer_details" string="Vendor/Customer KYC Details">
                    <group>
                        <!--<field name="vendor_customer_email"/>-->
                        <field name="point_of_contact"/>
                        <field name="business_legal_name"/>
                        <field name="business_trade_name"/>
                        <field name="business_street"/>
                        <field name="business_city"/>
                        <field name="business_pincode"/>
                        <field name="additional_street"/>
                        <field name="additional_city"/>
                        <field name="additional_zip"/>
                        <field name="additional_phone"/>
                        <field name="additional_email"/>
                        <field name="const_business"/>
                        <field name="no_partner_director"/>
                        <field name="director_name"/>
                        <field name="director_phone"/>
                        <field name="director_email"/>
                        <field name="aadhaar_card"/>
                        <field name="pan_card"/>
                        <field name="gst_no"/>
                        <field name="udyam_number"/>
                        <field name="gst_certificate" widget="many2many_binary"/>
                        <field name="udyam_document" widget="many2many_binary"/>
                        <field name="gst_return_duration"/>
                        <field name="shop_photos" widget="many2many_binary"/>
                        <field name="shop_videos" widget="many2many_binary"/>
                        <field name="bank_cheque_attachments" widget="many2many_binary"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>