<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--Vendor Creation block from purchase order form-->
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="replace">
                <field name="partner_id" widget="res_partner_many2one"
                       context="{'res_partner_search_mode': 'supplier', 'show_vat': True}"
                       options="{'no_create': True, 'no_create_edit': True}"
                       placeholder="Name, TIN, Email, or Reference" readonly="state in ['cancel', 'done', 'purchase']"/>
            </xpath>
        </field>
    </record>
    <!--Customer Creation block from sale order form-->
    <record id="sale_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="replace">
                <field name="partner_id" widget="res_partner_many2one"
                       options="{'no_create': True, 'no_create_edit': True}"
                       context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                       placeholder="Type to find a customer..." readonly="state in ['cancel', 'sale']"/>
            </xpath>
        </field>
    </record>

    <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="path">vendors</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('supplier_rank','>', 0)]</field>
        <field name="context">{'search_default_supplier': 1,'res_partner_search_mode': 'supplier', 'default_is_company':
            True, 'default_supplier_rank': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new supplier in your address book
            </p>
            <p>
                Odoo helps you easily track all activities related to a supplier.
            </p>
        </field>
    </record>

    <record id="account.res_partner_action_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="path">customers</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('customer_rank','>', 0)]</field>
        <field name="context">{'search_default_customer': 1,'res_partner_search_mode': 'customer', 'default_is_company':
            True, 'default_customer_rank': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new customer in your address book
            </p>
            <p>
                Odoo helps you easily track all activities related to a customer.
            </p>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.custom.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_survey_response"
                        icon="fa-star"
                        groups="sales_team.group_sale_salesman"
                        context="{'default_partner_id': id}">
                    <field string="KYC Survey" name="survey_count" widget="statinfo"/>
                </button>
            </div>
            <xpath expr="//notebook/page[@name='contact_addresses']/field[@name='child_ids']/form/sheet/group/group[2]"
                   position="after">
                <group>
                    <field name="custom_type" widget="selection"/>
                    <field name="custom_address_type" widget="selection"/>
                    <field name="tally_name"/>
                    <field name="purpose"/>
                </group>
            </xpath>
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="%(vendor_kyc_wizard_action)d" string="KYC Form" type="action"
                            class="btn btn-primary" invisible="is_kyc or (not is_vendor)"
                            display="always"/>
                    <button name="%(rekyc_request_wizard_action)d" string="Re-KYC" type="action"
                            class="oe_highlight" invisible="not is_approved"/>
                    <!--invisible="not is_approved or (deadline and deadline &lt;= context_today())"/>-->
                </header>
            </xpath>
            <field name="street" position="attributes">
                <attribute name="widget">upper_case</attribute>
            </field>
            <field name="street2" position="attributes">
                <attribute name="widget">upper_case</attribute>
            </field>
            <field name="city" position="attributes">
                <attribute name="widget">upper_case</attribute>
            </field>
            <field name="l10n_in_pan" position="attributes">
                <attribute name="widget">upper_case</attribute>
            </field>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_vendor" readonly="is_kyc"/>
                <field name="is_customer" readonly="is_kyc"/>
                <field name="is_kyc" readonly="1"/>
                <field name="is_approved" readonly="1" invisible="not is_approved"/>
                <field name="approval_date" readonly="1" invisible="not approval_date"/>
                <field name="deadline" readonly="1" invisible="not deadline"/>
                <field name="is_rejected" readonly="1" invisible="not is_rejected"/>
                <field name="rejection_date" readonly="1" invisible="not rejection_date"/>
                <field name="rejection_reason" readonly="1" invisible="not rejection_reason"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="vendor_customer_details" string="KYC Form Details">
                    <field name="kyc_details">
                        <list create="False" edit="False" delete="False">
                            <field name="email"/>
                            <field name="point_of_contact"/>
                            <field name="poc_user"
                                   options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="business_legal_name"/>
                            <field name="is_same_trade_name"/>
                            <field name="business_trade_name"/>
                            <!--<field name="const_business"/>-->
                            <!--<field name="no_partner_director"/>-->
                            <!--<field name="director_name"/>
                            <field name="director_phone"/>
                            <field name="director_email"/>-->
                            <field name="deadline"/>
                            <field name="state"/>
                        </list>
                        <form create="False" edit="False" delete="False">
                            <header>
                                <field name="state" widget="statusbar"/>
                            </header>
                            <sheet>
                                <group>
                                    <field name="partner_id" readonly="1" invisible="1"/>
                                    <field name="email" placeholder="Your Answer"/>
                                    <field name="point_of_contact" placeholder="Your Answer" widget="upper_case"/>
                                    <!--<field name="user_id"
                                           options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>-->
                                </group>
                                <group string="KYC Form (Company Details)" name="kyc_company_details">
                                    <field name="business_legal_name" placeholder="Your Answer" widget="upper_case"/>
                                    <field name="is_same_trade_name"/>
                                    <field name="business_trade_name" placeholder="Your Answer" widget="upper_case"/>
                                    <field name="address_detail">
                                        <list editable="bottom">
                                            <field name="business_street" placeholder="Your Answer"
                                                   widget="upper_case"/>
                                            <field name="business_city" placeholder="Your Answer" widget="upper_case"/>
                                            <field name="business_pincode" placeholder="Your Answer"/>
                                            <field name="business_phone" placeholder="Your Answer"/>
                                            <field name="business_email" placeholder="Your Answer"/>
                                            <field name="business_state_id"
                                                   options="{'no_create': True, 'no_create_edit': True}"
                                                   domain="[('country_id', '=', 'India')]"/>
                                            <field name="business_country_id"
                                                   options="{'no_create': True, 'no_create_edit': True}"
                                                   domain="[('code', '=', 'IN')]"/>
                                        </list>
                                        <form>
                                            <field name="business_street" placeholder="Your Answer"
                                                   widget="upper_case"/>
                                            <field name="business_city" placeholder="Your Answer" widget="upper_case"/>
                                            <field name="business_pincode" placeholder="Your Answer"/>
                                            <field name="business_phone" placeholder="Your Answer"/>
                                            <field name="business_email" placeholder="Your Answer"/>
                                            <field name="business_state_id"
                                                   options="{'no_create': True, 'no_create_edit': True}"
                                                   domain="[('country_id', '=', 'India')]"/>
                                            <field name="business_country_id"
                                                   options="{'no_create': True, 'no_create_edit': True}"
                                                   domain="[('code', '=', 'IN')]"/>
                                        </form>
                                    </field>
                                    <field name="const_business" widget="radio"/>
                                    <field name="other_business" string="Please Specify"
                                           invisible="const_business != 'Other'"
                                           required="const_business == 'Other'"/>
                                    <!--<field name="other_business" string="Please Specify"
                                           placeholder="If Other Please Specify"
                                           invisible="const_business != %(custom_contact.constitution_business_other)d"
                                           required="const_business == %(custom_contact.constitution_business_other)d"/>-->
                                    <!--<field name="no_partner_director" widget="radio"/>-->
                                </group>
                                <group string="Director/Owner Details" name="kyc_sole_proprietor">
                                    <field name="no_partner_director" widget="radio" options="{'horizontal': true}"/>
                                    <field name="directors_detail" string="Director/Partner">
                                        <list editable="bottom">
                                            <field name="designation" widget="upper_case"/>
                                            <field name="name" widget="upper_case"/>
                                            <field name="contact_no"/>
                                            <field name="email"/>
                                            <field name="aadhaar_card_filename" column_invisible="1"/>
                                            <field name="aadhaar_card" filename="aadhaar_card_filename"
                                                   options="{'accepted_file_extensions': 'image/*, .pdf'}" column_invisible="1"/>
                                            <field name="pan_card_filename" readonly="1" column_invisible="1"/>
                                            <field name="pan_card" filename="pan_card_filename" column_invisible="1"/>
                                             <field name="aadhaar_card_attachments" widget="many2many_attachment_preview"/>
                                             <field name="pan_card_attachments" widget="many2many_attachment_preview"/>
                                        </list>
                                        <form>
                                            <field name="designation" widget="upper_case"/>
                                            <field name="name" widget="upper_case"/>
                                            <field name="contact_no"/>
                                            <field name="email"/>
                                            <field name="aadhaar_card_filename" invisible="1"/>
                                            <field name="aadhaar_card" filename="aadhaar_card_filename"
                                                   options="{'accepted_file_extensions': 'image/*, .pdf'}" column_invisible="1"/>
                                            <field name="pan_card_filename" readonly="1" invisible="1"/>
                                            <field name="pan_card" filename="pan_card_filename"
                                                   options="{'accepted_file_extensions': 'image/*, .pdf'}" column_invisible="1"/>
                                             <field name="aadhaar_card_attachments" widget="many2many_attachment_preview"/>
                                             <field name="pan_card_attachments" widget="many2many_attachment_preview"/>
                                        </form>
                                    </field>
                                    <!--                                    <field name="director_name" placeholder="Your Answer"-->
                                    <!--                                           required="const_business not in ['Partnership', 'Pvt Ltd Co.', 'LLP']"-->
                                    <!--                                           invisible="const_business in ['Partnership', 'Pvt Ltd Co.', 'LLP']"/>-->
                                    <!--                                    <field name="director_phone" placeholder="Your Answer"-->
                                    <!--                                           required="const_business not in ['Partnership', 'Pvt Ltd Co.', 'LLP']"-->
                                    <!--                                           invisible="const_business in ['Partnership', 'Pvt Ltd Co.', 'LLP']"/>-->
                                    <!--                                    <field name="director_email" placeholder="Your Answer"-->
                                    <!--                                           required="const_business not in ['Partnership', 'Pvt Ltd Co.', 'LLP']"-->
                                    <!--                                           invisible="const_business in ['Partnership', 'Pvt Ltd Co.', 'LLP']"/>-->

                                    <!--                                    <field name="aadhaar_card_filename" invisible="1"/>-->
                                    <!--                                    <field name="aadhaar_card" filename="aadhaar_card_filename" options="{'accepted_file_extensions': 'image/*, .pdf'}"-->
                                    <!--                                           required="const_business not in ['Partnership', 'Pvt Ltd Co.', 'LLP']"-->
                                    <!--                                           invisible="const_business in ['Partnership', 'Pvt Ltd Co.', 'LLP']"/>-->
                                    <!--                                    <field name="pan_card_filename" readonly="1" invisible="1"/>-->
                                    <!--                                    <field name="pan_card" filename="pan_card_filename" options="{'accepted_file_extensions': 'image/*, .pdf'}"-->
                                    <!--                                           required="const_business not in ['Partnership', 'Pvt Ltd Co.', 'LLP']"-->
                                    <!--                                           invisible="const_business in ['Partnership', 'Pvt Ltd Co.', 'LLP']"/>-->
                                    <field name="pan_no" placeholder="Your Answer" widget="upper_case"/>
                                    <field name="pan_card_document" widget="many2many_attachment_preview"
                                           options="{'accepted_file_extensions': 'image/*, .pdf', 'number_of_files': 5}"
                                           required="const_business in ['Partnership', 'Pvt Ltd Co.', 'LLP']"/>
                                    <field name="aadhaar_pan_link" widget="radio" options="{'horizontal': true}"/>
                                    <field name="gst_no" placeholder="Your Answer" widget="upper_case"/>
                                    <field name="udyam_number" placeholder="Your Answer" widget="upper_case"/>
                                    <field name="gst_certificate" widget="many2many_attachment_preview"
                                           options="{'accepted_file_extensions': 'image/*, .pdf', 'number_of_files': 5}"/>
                                    <field name="udyam_document" widget="many2many_attachment_preview"
                                           options="{'accepted_file_extensions': 'image/*, .pdf', 'number_of_files': 5}"
                                           required="const_business in ['Sole Proprietor', 'HUF(Karta)']"/>
                                    <field name="shop_act_document" widget="many2many_attachment_preview"
                                           options="{'accepted_file_extensions': 'image/*, .pdf', 'number_of_files': 5}"
                                           required="const_business in ['Sole Proprietor', 'HUF(Karta)']"/>
                                    <field name="gst_return_duration" placeholder="Your Answer"/>
                                    <field name="shop_photos" widget="many2many_attachment_preview"
                                           options="{'accepted_file_extensions': 'image/*', 'number_of_files': 10}"/>
                                    <field name="shop_videos" widget="many2many_attachment_preview"
                                           options="{'accepted_file_extensions': 'video/*', 'number_of_files': 10}"/>
                                    <field name="comp_google_loc" placeholder="eg. Lat : 22.3511148 Long: 78.6677428"/>

                                    <field name="partner_llp_filename" invisible="1"/>
                                    <field name="partner_llp" filename="partner_llp_filename"
                                           invisible="const_business not in ['Partnership', 'LLP']"/>
                                    <field name="moa_aoa" widget="many2many_attachment_preview"
                                           options="{'accepted_file_extensions': 'video/*', 'number_of_files': 10}"
                                           invisible="const_business not in ['Pvt Ltd Co.']"/>
                                    <field name="cin_no" placeholder="Your Answer" widget="upper_case"
                                           invisible="const_business not in ['Pvt Ltd Co.']"/>
                                    <field name="electricity_bill" widget="many2many_attachment_preview"
                                           options="{'accepted_file_extensions': 'image/*, .pdf', 'number_of_files': 10}"/>
                                </group>
                                <group string="Bank Details(Please provide all required bank Details Carefully)"
                                       name="bank_details">
                                    <field name="bank_detail">
                                        <list editable="bottom">
                                            <field name="bank_name" placeholder="Your Answer" widget="upper_case"/>
                                            <field name="account_no" placeholder="Your Answer"/>
                                            <field name="ifsc_code" placeholder="Your Answer" widget="upper_case"/>
                                            <field name="bank_address" placeholder="Your Answer" widget="upper_case"/>
                                            <field name="bank_cheque_attachments" widget="many2many_attachment_preview"/>
                                        </list>
                                        <form>
                                            <field name="bank_name" placeholder="Your Answer" widget="upper_case"/>
                                            <field name="account_no" placeholder="Your Answer"/>
                                            <field name="ifsc_code" placeholder="Your Answer" widget="upper_case"/>
                                            <field name="bank_address" placeholder="Your Answer" widget="upper_case"/>
                                            <field name="bank_cheque_attachments" widget="many2many_attachment_preview"/>
                                        </form>
                                    </field>
                                </group>
                                <notebook>
                                    <page string="Approval Authorities" name="approval_users">
                                        <group>
                                            <field name="assigned_to"
                                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                                                   invisible="not assigned_to" readonly="1"/>
                                            <field name="existing_user_ids" widget="many2many_tags" invisible="1"/>
                                            <field name="deadline"/>
                                        </group>
                                        <field name="approval_users_ids" nolabel="1" help="Define the approval roles."
                                               readonly="1">
                                            <list editable="bottom">
                                                <field name="sequence"/>
                                                <field name="user_id" widget="many2one_avatar_user"
                                                       options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                                <field name="remark"/>
                                                <field name="state" readonly="1"/>
                                                <field name="action_date" readonly="1"/>
                                            </list>
                                            <form>
                                                <group>
                                                    <field name="user_id"
                                                           options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                                    <field name="state"/>
                                                    <field name="remark"/>
                                                </group>
                                            </form>
                                        </field>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>