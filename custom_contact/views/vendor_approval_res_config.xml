<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="vendor_approval_config_view_form" model="ir.ui.view">
        <field name="name">vendor.approval.config.view.form</field>
        <field name="model">vendor.approval.config</field>
        <field name="arch" type="xml">
            <form string="Vendor Approval Settings" class="oe_form_configuration o_base_settings">
                <header>
                    <button string="Save" type="object" name="set_config_values" class="oe_highlight"/>
                    <button string="Discard" type="object" name="cancel" special="cancel"/>
                </header>
                <sheet>
                    <group>
                        <field name="vendor_approval_users" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vendor_approval_config" model="ir.actions.act_window">
        <field name="name">Vendor Approval Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vendor.approval.config</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <!-- Menu item under Contacts > Configuration -->
    <menuitem id="menu_vendor_approval_config"
              name="Vendor Approval Users"
              parent="contacts.res_partner_menu_config"
              action="action_vendor_approval_config"
              sequence="100"/>
</odoo>
