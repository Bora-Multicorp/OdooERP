<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Scheduler for Pending Request Follow Up-->
        <record id="ir_cron_scheduler_kyc_expiry_followup" model="ir.cron">
            <field name="name">KYC Expiry: Follow Up</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=10, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="model_id" ref="base.model_res_partner"/>
            <!--<field name="code">model.trigger_email_kyc_expiry_follow_up()</field>-->
            <field name="code">model.trigger_schedule_activity_kyc_expiry_follow_up()</field>
            <field name="state">code</field>
        </record>

        <record id="kyc_expiry_reminder_template" model="mail.template">
            <field name="name">KYC Expiry Reminder</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">
                KYC Expiry Reminder for {{ object.name }} - Deadline: {{ format_date(object.deadline) }}
            </field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Dear Sir/Madam</p>
                    <p>This is a reminder that KYC of
                        <strong>
                            <t t-out="object.name or ''"></t>
                        </strong>
                        expire soon.
                    </p>
                    <p>
                        <strong>Deadline:</strong>
                        <t t-out="format_date(object.deadline)"></t>
                    </p>
                    <p>Please take action to update KYC before expiry.</p>
                    <br/>
                    <p>Thanks and Regards.</p>
                </div>
            </field>
        </record>

    </data>
</odoo>