<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Scheduler for Pending Request Follow Up-->
        <record id="ir_cron_scheduler_kyc_expiry_followup" model="ir.cron" forcecreate="True">
            <field name="name">KYC Expiry: Follow Up</field>
            <field name="model_id" ref="model_approval_detail"/>
            <field name="state">code</field>
            <field name="code">model.trigger_email_kyc_expiry_follow_up()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field eval="False" name="doall" />
        </record>
    </data>
</odoo>