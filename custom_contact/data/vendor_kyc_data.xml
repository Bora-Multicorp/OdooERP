<?xml version ="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Vendor Kyc Form -->
        <record model="survey.survey" id="vendor_kyc_form_survey">
            <field name="title">Bora Multicorp</field>
            <field name="survey_type">survey</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="access_mode">public</field>
            <field name="questions_layout">page_per_section</field>
            <field name="users_can_go_back" eval="True"/>
            <field name="users_login_required" eval="False"/>
            <!--<field name="survey_image" type="base64" file="survey_management/static/description/img/corbiz_logo.jpg"/>-->
            <field name="is_attempts_limited" eval="True"/>
            <field name="attempts_limit">1</field>
            <field name="description" type="html">
                <h2>Welcome to Bora Multicorp</h2>
                <p>The name, email, and photo associated with your Google account will be recorded when you upload files
                    and submit this form
                </p>
                <p>Any files that are uploaded will be shared outside of the organization they belong to.
                </p>
            </field>
        </record>
        <!-- Page1: -->
        <record model="survey.question" id="vendor_kyc_form_survey_p1">
            <field name="title"></field>
            <field name="survey_id" ref="vendor_kyc_form_survey"/>
            <field name="sequence">1</field>
            <field name="question_type" eval="False"/>
            <field name="is_page" eval="True"/>
        </record>
        <!-- Email -->
        <record model="survey.question" id="email_kyc_survey">
            <field name="title">Email</field>
            <field name="survey_id" ref="vendor_kyc_form_survey"/>
            <field name="sequence">2</field>
            <field name="question_type">char_box</field>
            <field name="constr_mandatory">True</field>
            <field name="validation_email">True</field>
            <field name="save_as_email">True</field>
            <field name="question_placeholder">Your Answer</field>
        </record>
        <!-- Point of Contact / Purchase Manager (Bora Multicorp) -->
