<?xml version="1.0"?>
<odoo>
    <record id="vendor_kyc_wizard_view_form" model="ir.ui.view">
        <field name="name">vendor.kyc.wizard.form</field>
        <field name="model">vendor.kyc.wizard</field>
        <field name="arch" type="xml">
            <form string="Vendor KYC">
                <sheet>
                    <group>
                        <field name="partner_id" readonly="1" invisible="1"/>
                        <field name="email" placeholder="Your Answer"/>
                        <field name="point_of_contact" placeholder="Your Answer"/>
                    </group>
                    <group string="KYC Form (Company Details)" name="kyc_company_details">
                        <group string="Principal Place of Business">
                            <field name="business_legal_name" placeholder="Your Answer"/>
                            <field name="business_trade_name" placeholder="Your Answer"/>
                            <field name="business_street" placeholder="Your Answer"/>
                            <field name="business_city" placeholder="Your Answer"/>
                            <field name="business_pincode" placeholder="Your Answer"/>
                        </group>
                        <group string="Additional Place of Business">
                            <field name="additional_street" placeholder="Your Answer"/>
                            <field name="additional_city" placeholder="Your Answer"/>
                            <field name="additional_zip" placeholder="Your Answer"/>
                            <field name="additional_phone" placeholder="Your Answer"/>
                            <field name="additional_email" placeholder="Your Answer"/>
                        </group>
                        <group>
                            <field name="const_business" widget="radio"/>
                            <field name="other_business" string="Please Specify"
                                   invisible="const_business != 'Other'"
                                   required="const_business == 'Other'"/>
                            <!--<field name="other_business" string="Please Specify"
                                   placeholder="If Other Please Specify"
                                   invisible="const_business != %(custom_contact.constitution_business_other)d"
                                   required="const_business == %(custom_contact.constitution_business_other)d"/>-->
                            <!--<field name="no_partner_director" widget="radio"/>-->
                        </group>
                    </group>
                    <group string="Director/Owner Details" name="kyc_sole_proprietor">
                        <group>
                            <field name="director_name" placeholder="Your Answer"/>
                            <field name="director_phone" placeholder="Your Answer"/>
                            <field name="director_email" placeholder="Your Answer"/>
                            <field name="aadhaar_card" placeholder="Your Answer" widget="image"/>
                            <field name="pan_card" placeholder="Your Answer" widget="image"/>
                            <field name="gst_no" placeholder="Your Answer"/>
                            <field name="udyam_number" placeholder="Your Answer"/>
                            <field name="gst_certificate" widget="many2many_binary"
                                   options="{'accepted_file_extensions': 'image/*, .pdf', 'number_of_files': 5}"/>
                            <field name="udyam_document" widget="many2many_binary"
                                   options="{'accepted_file_extensions': 'image/*, .pdf', 'number_of_files': 5}"/>
                            <field name="gst_return_duration" placeholder="Your Answer"/>
                            <field name="shop_photos" widget="many2many_binary"
                                   options="{'accepted_file_extensions': 'image/*', 'number_of_files': 10}"/>
                            <field name="shop_videos" widget="many2many_binary"
                                   options="{'accepted_file_extensions': 'video/*', 'number_of_files': 10}"/>
                        </group>
                    </group>
                    <group string="Bank Details(Please provide all required bank Details Carefully)"
                           name="bank_details">
                        <group>
                            <field name="bank_name" placeholder="Your Answer"/>
                            <field name="account_no" placeholder="Your Answer"/>
                            <field name="ifsc_code" placeholder="Your Answer"/>
                            <field name="bank_address" placeholder="Your Answer"/>
                            <field name="bank_cheque_attachments" widget="many2many_binary"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_vendor_kyc_done" string="Done" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vendor_kyc_wizard_action" model="ir.actions.act_window">
        <field name="name">KYC Form</field>
        <field name="res_model">vendor.kyc.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="vendor_kyc_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="context">{
            'default_partner_id': active_id,
            }
        </field>
    </record>
</odoo>
