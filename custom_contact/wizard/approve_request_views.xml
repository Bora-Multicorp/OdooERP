<?xml version="1.0"?>
<odoo>
    <record id="approve_request_wizard_view_form" model="ir.ui.view">
        <field name="name">approve.request.wizard.form</field>
        <field name="model">approve.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Request Form">
                <group>
                    <field name="approval_user_id" readonly="1"/>
                    <field name="remark"/>
                </group>
                <footer>
                    <button name="action_approve_request" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="approve_request_wizard_action" model="ir.actions.act_window">
        <field name="name">Approve Request</field>
        <field name="res_model">approve.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="approve_request_wizard_view_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_approve_request_wizard"/>
        <field name="context">{
            'default_approval_user_id': active_id,
            }
        </field>
    </record>
</odoo>
