<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bora_debit_note_approval_request_wizard_form" model="ir.ui.view">
        <field name="name">bora.debit.note.approval.request.wizard.form</field>
        <field name="model">bora.debit.note.approval.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request for Approval">
                <field name="bora_dn_move_id" invisible="1"/>
                <field name="bora_dn_approver1_user_ids" invisible="1"/>
                <field name="bora_dn_approver2_user_ids" invisible="1"/>
                <field name="bora_dn_approver1_filtered_ids" invisible="1"/>
                <field name="bora_dn_approver2_filtered_ids" invisible="1"/>
                <field name="bora_dn_show_approver2" invisible="1"/>
                <field name="bora_dn_is_update_mode" invisible="1"/>
                <field name="bora_dn_pm1_already_approved" invisible="1"/>
                <field name="bora_dn_approval_info" widget="html" readonly="1" nolabel="1"/>
                <group>
                    <field name="bora_dn_approver1_user"
                           options="{'no_create': True}"
                           domain="[('id', 'in', bora_dn_approver1_filtered_ids), ('share', '=', False)]"
                           readonly="bora_dn_pm1_already_approved"/>
                    <field name="bora_dn_approver2_user"
                           options="{'no_create': True}"
                           domain="[('id', 'in', bora_dn_approver2_filtered_ids), ('share', '=', False)]"
                           required="bora_dn_show_approver2"
                           invisible="not bora_dn_show_approver2"/>
                    <field name="bora_dn_reason"/>
                </group>
                <footer>
                    <button name="action_confirm_request" string="OK" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
