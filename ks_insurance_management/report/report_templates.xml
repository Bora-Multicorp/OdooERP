<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Fire &amp; Burglary Report ──────────────────────────────────── -->
  <record id="action_report_fire_burglary" model="ir.actions.report">
    <field name="name">Fire &amp; Burglary Report</field>
    <field name="model">insurance.report.wizard</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">ks_insurance_management.report_fire_burglary_template</field>
    <field name="attachment_use" eval="False"/>
  </record>

  <template id="report_fire_burglary_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page">
          <t t-set="policies" t-value="o._get_policies()"/>

          <!-- Header -->
          <div class="row mb-3">
            <div class="col-12 text-center">
              <h2 style="color:#1F3864; border-bottom:2px solid #1F3864; padding-bottom:6px;">
                Fire &amp; Burglary Insurance Report
              </h2>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-6">
              <t t-if="o.company_ids">
                <strong>Companies: </strong>
                <t t-foreach="o.company_ids" t-as="c">
                  <span class="badge badge-secondary mr-1"><t t-esc="c.name"/></span>
                </t>
              </t>
            </div>
            <div class="col-3">
              <t t-if="o.date_from or o.date_to">
                <strong>Period: </strong>
                <t t-esc="o.date_from or ''"/> – <t t-esc="o.date_to or ''"/>
              </t>
            </div>
            <div class="col-3 text-right">
              <strong>Status: </strong>
              <t t-if="o.include_expired">Active &amp; Expired</t>
              <t t-else="">Active Only</t>
            </div>
          </div>

          <!-- Table -->
          <table class="table table-bordered table-sm table-hover" style="font-size:12px;">
            <thead style="background-color:#1F3864; color:#fff;">
              <tr>
                <th class="text-center">#</th>
                <th>Policy No.</th>
                <th>Type</th>
                <th>Company</th>
                <th>Insurer</th>
                <th class="text-right">Sum Insured (₹)</th>
                <th class="text-right">Premium (₹)</th>
                <th class="text-center">Premium %</th>
                <th class="text-right">Avg Inventory (₹)</th>
                <th class="text-center">Expiry Date</th>
                <th class="text-center">Status</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="policies" t-as="p">
                <tr t-attf-style="background-color: #{'#fff3f3' if p.state == 'expired' else '#f3fff3'};">
                  <td class="text-center"><t t-esc="p_index + 1"/></td>
                  <td><strong><t t-esc="p.policy_number or '-'"/></strong></td>
                  <td><t t-esc="p.insurance_type_id.name or '-'"/></td>
                  <td><t t-esc="p.company_id.name or '-'"/></td>
                  <td><t t-esc="p.insurance_company_id.name or '-'"/></td>
                  <td class="text-right"><t t-esc="'{:,.2f}'.format(p.sum_insured)"/></td>
                  <td class="text-right"><t t-esc="'{:,.2f}'.format(p.premium)"/></td>
                  <td class="text-center"><t t-esc="'{:.2f}%'.format(p.premium_percentage)"/></td>
                  <td class="text-right"><t t-esc="'{:,.2f}'.format(p._get_avg_inventory())"/></td>
                  <td class="text-center"><t t-esc="p.expiry_date"/></td>
                  <td class="text-center">
                    <span t-attf-style="padding:2px 8px; border-radius:4px; font-weight:bold; color:#fff; background-color:#{'#28a745' if p.state == 'active' else '#dc3545'};">
                      <t t-esc="p.state.upper()"/>
                    </span>
                  </td>
                </tr>
              </t>
            </tbody>
            <tfoot style="background-color:#e8edf4; font-weight:bold;">
              <tr>
                <td colspan="5" class="text-right">Total (<t t-esc="len(policies)"/> policies)</td>
                <td class="text-right"><t t-esc="'{:,.2f}'.format(sum(policies.mapped('sum_insured')))"/></td>
                <td class="text-right"><t t-esc="'{:,.2f}'.format(sum(policies.mapped('premium')))"/></td>
                <td colspan="4"></td>
              </tr>
            </tfoot>
          </table>

          <p class="text-muted mt-2" style="font-size:10px;">
            Report generated on <t t-esc="time.strftime('%d/%m/%Y')"/>
          </p>
        </div>
        </t>
      </t>
    </t>
  </template>

  <!-- ── Marine Insurance Report ──────────────────────────────────────── -->
  <record id="action_report_marine" model="ir.actions.report">
    <field name="name">Marine Insurance Report</field>
    <field name="model">insurance.report.wizard</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">ks_insurance_management.report_marine_template</field>
    <field name="attachment_use" eval="False"/>
  </record>

  <template id="report_marine_template">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page">
          <t t-set="policies" t-value="o._get_policies()"/>

          <!-- Header -->
          <div class="row mb-3">
            <div class="col-12 text-center">
              <h2 style="color:#1F3864; border-bottom:2px solid #1F3864; padding-bottom:6px;">
                Marine Insurance Report
              </h2>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-6">
              <t t-if="o.company_ids">
                <strong>Companies: </strong>
                <t t-foreach="o.company_ids" t-as="c">
                  <span class="badge badge-secondary mr-1"><t t-esc="c.name"/></span>
                </t>
              </t>
            </div>
            <div class="col-3">
              <t t-if="o.date_from or o.date_to">
                <strong>Period: </strong>
                <t t-esc="o.date_from or ''"/> – <t t-esc="o.date_to or ''"/>
              </t>
            </div>
            <div class="col-3 text-right">
              <strong>Status: </strong>
              <t t-if="o.include_expired">Active &amp; Expired</t>
              <t t-else="">Active Only</t>
            </div>
          </div>

          <!-- Table -->
          <table class="table table-bordered table-sm table-hover" style="font-size:12px;">
            <thead style="background-color:#1F3864; color:#fff;">
              <tr>
                <th class="text-center">#</th>
                <th>Policy No.</th>
                <th class="text-center">Applicability</th>
                <th>Company</th>
                <th>Insurer</th>
                <th class="text-right">Sum Insured (₹)</th>
                <th class="text-right">Premium (₹)</th>
                <th class="text-center">Premium %</th>
                <th class="text-right">Balance Sum Insured (₹)</th>
                <th class="text-center">Expiry Date</th>
                <th class="text-center">Status</th>
                <th class="text-center">Declarations</th>
                <th>Remarks</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="policies" t-as="p">
                <tr t-attf-style="background-color: #{'#fff3f3' if p.state == 'expired' else '#f3fff3'};">
                  <td class="text-center"><t t-esc="p_index + 1"/></td>
                  <td><strong><t t-esc="p.policy_number or '-'"/></strong></td>
                  <td class="text-center">
                    <t t-esc="{'exim':'EXIM','domestic':'Domestic','both':'Both','russia':'Russia Only'}.get(p.insurance_type_id.marine_applicability, '-')"/>
                  </td>
                  <td><t t-esc="p.company_id.name or '-'"/></td>
                  <td><t t-esc="p.insurance_company_id.name or '-'"/></td>
                  <td class="text-right"><t t-esc="'{:,.2f}'.format(p.sum_insured)"/></td>
                  <td class="text-right"><t t-esc="'{:,.2f}'.format(p.premium)"/></td>
                  <td class="text-center"><t t-esc="'{:.2f}%'.format(p.premium_percentage)"/></td>
                  <td class="text-right">
                    <strong><t t-esc="'{:,.2f}'.format(p.balance_sum_insured)"/></strong>
                  </td>
                  <td class="text-center"><t t-esc="p.expiry_date"/></td>
                  <td class="text-center">
                    <span t-attf-style="padding:2px 8px; border-radius:4px; font-weight:bold; color:#fff; background-color:#{'#28a745' if p.state == 'active' else '#dc3545'};">
                      <t t-esc="p.state.upper()"/>
                    </span>
                  </td>
                  <td class="text-center"><t t-esc="len(p.declaration_ids)"/></td>
                  <td></td>
                </tr>
              </t>
            </tbody>
            <tfoot style="background-color:#e8edf4; font-weight:bold;">
              <tr>
                <td colspan="5" class="text-right">Total (<t t-esc="len(policies)"/> policies)</td>
                <td class="text-right"><t t-esc="'{:,.2f}'.format(sum(policies.mapped('sum_insured')))"/></td>
                <td class="text-right"><t t-esc="'{:,.2f}'.format(sum(policies.mapped('premium')))"/></td>
                <td></td>
                <td class="text-right"><t t-esc="'{:,.2f}'.format(sum(policies.mapped('balance_sum_insured')))"/></td>
                <td colspan="4"></td>
              </tr>
            </tfoot>
          </table>

          <p class="text-muted mt-2" style="font-size:10px;">
            * Declarations and Remarks columns are for reference only and do not affect calculations.
            Report generated on <t t-esc="time.strftime('%d/%m/%Y')"/>
          </p>
        </div>
        </t>
      </t>
    </t>
  </template>

