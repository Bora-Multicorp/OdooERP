<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="insurance_policy_form_view" model="ir.ui.view">
    <field name="name">insurance.policy.form</field>
    <field name="model">insurance.policy</field>
    <field name="arch" type="xml">
      <form string="Insurance Policy">
        <header>
          <!-- Request Payment: shown when no active payment request exists -->
          <button name="action_request_payment" string="Submit for Approval" type="object"
                  class="btn-primary"
                  invisible="payment_status in ('requested', 'approved', 'paid')"/>
          <field name="is_pending_approver" invisible="1"/>
          <!-- Approval buttons: shown only to the selected approver when request is pending -->
          <button name="action_approve_payment" string="Approve" type="object"
                  class="btn-success"
                  invisible="payment_status != 'requested' or not is_pending_approver"
                  confirm="Approve this approval request and create a draft payment?"/>
          <button name="action_reject_payment" string="Reject" type="object"
                  class="btn-danger"
                  invisible="payment_status != 'requested' or not is_pending_approver"
                  confirm="Reject this payment request?"/>
          <!-- Top Up Addon: shown when policy state is active -->
          <button name="action_topup_addon" string="Top Up Addon" type="object"
                  class="btn-secondary"
                  invisible="state != 'active'"/>
          <button name="action_mark_expired" string="Mark as Expired" type="object"
                  class="btn-danger" invisible="state != 'active'"
                  confirm="Mark this policy as Expired?"/>
          <field name="has_pending_renewal" invisible="1"/>
          <button name="action_renew_policy" string="Renew Policy" type="object"
                  class="btn-success" invisible="state not in ('active', 'expired') or has_pending_renewal"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"
                 readonly="False"/>
        </header>
        <sheet>
          <field name="is_policy_number_editable" invisible="1"/>
          <!-- Payment status ribbon -->
          <widget name="web_ribbon" title="Payment Pending" bg_color="text-bg-danger"
                  invisible="payment_status == 'paid'"/>
          <widget name="web_ribbon" title="Paid" bg_color="text-bg-success"
                  invisible="payment_status != 'paid'"/>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object"
                    name="action_view_declarations" icon="fa-file-text"
                    invisible="not id">
              <field name="declaration_ids" widget="statinfo" string="Declarations"/>
            </button>
            <button class="oe_stat_button" type="object"
                    name="action_view_policy_payments" icon="fa-credit-card"
                    invisible="not id">
              <field name="payment_count" widget="statinfo" string="Payments"/>
            </button>
          </div>
          <div class="oe_title"><h1><field name="policy_number" readonly="not is_policy_number_editable"/></h1></div>
          <group>
            <group string="Policy Information">
              <field name="policy_number" readonly="not is_policy_number_editable"/>
              <field name="insurance_type_id" readonly="state != 'draft'"/>
              <field name="insurance_category_id" readonly="1"/>
              <field name="policy_type" readonly="state != 'draft'"/>
              <field name="insurance_company_id" readonly="state != 'draft'"/>
              <field name="agent_id" readonly="state != 'draft'"/>
              <field name="company_id" groups="base.group_multi_company"
                     readonly="state != 'draft'"/>
              <field name="property_ids" widget="many2many_tags" string="Collateral Security"
                     readonly="state != 'draft'"/>
            </group>
            <group string="Financial Details">
              <field name="currency_id" readonly="state != 'draft'"/>
              <field name="payment_status" widget="badge"
                     invisible="payment_count == 0"
                     decoration-muted="payment_status == 'draft'"
                     decoration-warning="payment_status == 'requested'"
                     decoration-info="payment_status == 'approved'"
                     decoration-success="payment_status == 'paid'"/>
              <field name="is_paid" widget="boolean_toggle" readonly="1"/>
              <field name="topup_flag" widget="boolean_toggle" readonly="1"/>
              <field name="initial_sum_insured" string="Sum Insured" required="1"
                     readonly="state != 'draft'"/>
              <field name="sum_insured_words" readonly="1"/>
              <field name="premium" required="1" readonly="state != 'draft'"/>
              <field name="premium_percentage" readonly="1"/>
              <field name="sum_insured" readonly="1"
                     invisible="not is_marine"
                     string="Remaining Sum Insured"/>
              <field name="balance_sum_insured" readonly="1"
                     invisible="not is_fire_burglary"/>
              <field name="total_premium_paid" readonly="1"/>
              <field name="start_date" readonly="state != 'draft'"/>
              <field name="expiry_date" readonly="state != 'draft'"/>
              <field name="tolerance_percent"
                     invisible="not is_marine and not is_fire_burglary"
                     readonly="state != 'draft'"/>
              <field name="tolerance_notified" readonly="1"
                     invisible="not is_marine and not is_fire_burglary"
                     widget="boolean_toggle"/>
            </group>
          </group>
          <group invisible="policy_type != 'individual' or (not is_marine and not is_fire_burglary)"
                 string="Warehouse Coverage">
            <field name="warehouse_id" readonly="state != 'draft'"
                   help="The warehouse this policy covers. Marine: balance reduces as goods are shipped out. Fire &amp; Burglary: balance = Sum Insured minus current stock value here."/>
          </group>
          <group invisible="policy_type != 'floater'" string="Floater Covered Locations">
            <field name="floater_location_ids" widget="many2many_tags" nolabel="1"
                   readonly="state != 'draft'"/>
          </group>
          <notebook>
            <page string="Declarations">
              <field name="declaration_ids" readonly="1">
                <list>
                  <field name="name"/><field name="declaration_type"/>
                  <field name="date_from"/><field name="date_to"/>
                  <field name="declaration_amount"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'sent'"
                         decoration-warning="state == 'confirmed'"
                         decoration-info="state == 'draft'"/>
                </list>
              </field>
            </page>
            <page string="Payments">
              <field name="payment_ids" readonly="1">
                <list>
                  <field name="name"/><field name="date"/>
                  <field name="amount"/><field name="state"/>
                </list>
              </field>
            </page>
            <page string="Top-up History">
              <field name="payment_ids" readonly="1"
                     domain="[('is_topup', '=', True)]">
                <list>
                  <field name="name"/>
                  <field name="ins_type_id" string="Insurance Type"/>
                  <field name="ins_company_id" string="Company Name"/>
                  <field name="ins_insurance_company_id" string="Insurance Company"/>
                  <field name="ins_sum_insured_words" string="Cover Amount (in words)"/>
                  <field name="amount" string="Premium (Incl. GST)"/>
                  <field name="ins_agent" string="Agent"/>
                  <field name="ins_expiry_date" string="Expiry Date"/>
                  <field name="date" string="Date"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'posted'"
                         decoration-warning="state == 'draft'"/>
                </list>
              </field>
            </page>
            <page string="Renewal History" name="renewal_history">
              <field name="renewal_history_ids" readonly="1">
                <list create="0" delete="0">
                  <field name="expired_policy_number" string="Expired Policy No"/>
                  <field name="start_date" string="Expired Policy Start Date"/>
                  <field name="end_date" string="Expired Policy End Date"/>
                  <field name="description" string="Description"/>
                  <field name="policy_type" string="Policy Type" optional="show"/>
                  <field name="payment_id" string="Linked Payment" optional="show"/>
                  <field name="payment_state" string="Payment Status" widget="badge"
                         decoration-success="payment_state == 'posted'"
                         decoration-warning="payment_state in ('draft', 'in_process')"
                         decoration-danger="payment_state == 'cancel'"/>
                  <field name="can_update_policy_no" column_invisible="True"/>
                  <field name="is_policy_number_updated" column_invisible="True"/>
                  <button name="action_update_policy_number"
                          string="Update Policy No"
                          type="object"
                          class="btn-primary"
                          invisible="not can_update_policy_no"/>
                  <button name="action_update_policy_number"
                          string="Update Policy No"
                          type="object"
                          class="btn-secondary text-muted opacity-50"
                          invisible="can_update_policy_no"/>
                </list>
              </field>
            </page>
            <page string="Notes"><field name="notes"/></page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="insurance_policy_list_view" model="ir.ui.view">
    <field name="name">insurance.policy.list</field>
    <field name="model">insurance.policy</field>
    <field name="arch" type="xml">
      <list decoration-danger="state == 'expired'" decoration-success="state == 'active'" decoration-muted="state == 'draft'">
        <field name="policy_number"/>
        <field name="insurance_type_id"/><field name="insurance_category_id"/>
        <field name="policy_type"/><field name="insurance_company_id"/>
        <field name="agent_id"/>
        <field name="initial_sum_insured" string="Sum Insured"/>
        <field name="sum_insured" string="Remaining Sum Insured" optional="show"/>
        <field name="balance_sum_insured" optional="show"/>
        <field name="premium"/><field name="start_date"/><field name="expiry_date"/>
        <field name="payment_count" column_invisible="True"/>
        <field name="payment_status" widget="badge"
               invisible="payment_count == 0"
               decoration-muted="payment_status == 'draft'"
               decoration-warning="payment_status == 'requested'"
               decoration-info="payment_status == 'approved'"
               decoration-success="payment_status == 'paid'"/>
        <field name="is_paid" widget="boolean_toggle" readonly="1"/>
        <field name="state" widget="badge"
               decoration-muted="state == 'draft'"
               decoration-success="state == 'active'"
               decoration-danger="state == 'expired'"/>
      </list>
    </field>
  </record>

  <record id="insurance_policy_kanban_view" model="ir.ui.view">
    <field name="name">insurance.policy.kanban</field>
    <field name="model">insurance.policy</field>
    <field name="arch" type="xml">
      <kanban default_group_by="insurance_category_id" sample="1">
        <field name="policy_number"/>
        <field name="insurance_type_id"/>
        <field name="insurance_category_id"/>
        <field name="insurance_company_id"/>
        <field name="agent_id"/>
        <field name="initial_sum_insured"/>
        <field name="sum_insured"/>
        <field name="balance_sum_insured"/>
        <field name="premium"/>
        <field name="expiry_date"/>
        <field name="state"/>
        <field name="currency_id"/>
        <field name="is_marine"/>
        <field name="is_fire_burglary"/>
        <field name="warehouse_id"/>
        <templates>
          <t t-name="card">
            <t t-set="is_expired" t-value="record.state.raw_value === 'expired'"/>
            <div t-attf-class="oe_kanban_global_click border-start border-3 #{is_expired ? 'border-danger' : 'border-success'} ps-2">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <strong class="text-truncate"><field name="policy_number"/></strong>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'expired'"/>
              </div>
              <div class="text-muted small mb-1">
                <field name="insurance_type_id"/>
                <t t-if="record.policy_number.raw_value">
                  &amp;nbsp;·&amp;nbsp;<field name="policy_number"/>
                </t>
              </div>
              <div class="row g-0 mb-1">
                <div class="col-6">
                  <span class="text-muted small">Insurer: </span>
                  <span class="small"><field name="insurance_company_id"/></span>
                </div>
                <div class="col-6">
                  <span class="text-muted small">Agent: </span>
                  <span class="small"><field name="agent_id"/></span>
                </div>
              </div>
              <div class="row g-0 mb-1">
                <div class="col-6">
                  <span class="text-muted small">Sum Insured: </span>
                  <span class="small fw-bold">
                    <field name="initial_sum_insured" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                  </span>
                </div>
                <t t-if="record.is_marine.raw_value">
                  <div class="col-6">
                    <span class="text-muted small">Remaining: </span>
                    <span class="small fw-bold">
                      <field name="sum_insured" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </span>
                  </div>
                </t>
                <t t-if="record.is_fire_burglary.raw_value">
                  <div class="col-6">
                    <span class="text-muted small">Balance: </span>
                    <span class="small fw-bold">
                      <field name="balance_sum_insured" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </span>
                  </div>
                </t>
              </div>
              <div class="small">
                <span class="text-muted">Expiry: </span>
                <field name="expiry_date"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="insurance_policy_search_view" model="ir.ui.view">
    <field name="name">insurance.policy.search</field>
    <field name="model">insurance.policy</field>
    <field name="arch" type="xml">
      <search>
        <field name="policy_number"/>
        <field name="insurance_type_id"/>
        <field name="insurance_company_id"/>
        <field name="agent_id"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <filter name="active_policies" string="Active" domain="[('state','=','active')]"/>
        <filter name="expired_policies" string="Expired" domain="[('state','=','expired')]"/>
        <separator/>
        <filter name="marine" string="Marine" domain="[('is_marine','=',True)]"/>
        <filter name="fire_burglary" string="Fire &amp; Burglary" domain="[('is_fire_burglary','=',True)]"/>
        <filter name="misc" string="Miscellaneous" domain="[('is_misc','=',True)]"/>
        <separator/>
        <filter name="expiring_30" string="Expiring in 30 Days"
                domain="[('state','=','active'),('expiry_date','&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')),('expiry_date','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
        <group expand="0" string="Group By">
          <filter name="grp_type" string="Insurance Type" context="{'group_by':'insurance_type_id'}"/>
          <filter name="grp_cat" string="Category" context="{'group_by':'insurance_category_id'}"/>
          <filter name="grp_state" string="Status" context="{'group_by':'state'}"/>
          <filter name="grp_company" string="Company" context="{'group_by':'company_id'}"/>
          <filter name="grp_insurer" string="Insurer" context="{'group_by':'insurance_company_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_insurance_policy" model="ir.actions.act_window">
    <field name="name">Insurance Policies</field>
    <field name="res_model">insurance.policy</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="search_view_id" ref="insurance_policy_search_view"/>
    <field name="context">{'search_default_active_policies': 1}</field>
  </record>

  <!-- ══ Renewal History Form View ══════════════════════════════════════════════ -->
  <record id="insurance_policy_renewal_history_form_view" model="ir.ui.view">
    <field name="name">insurance.policy.renewal.history.form</field>
    <field name="model">insurance.policy.renewal.history</field>
    <field name="arch" type="xml">
      <form string="Renewal History">
        <header>
          <field name="can_update_policy_no" invisible="1"/>
          <button name="action_update_policy_number"
                  string="Update Policy No"
                  type="object"
                  class="btn-primary"
                  invisible="not can_update_policy_no"/>
        </header>
        <sheet>
          <group>
            <group string="Expired Policy Details">
              <field name="expired_policy_number" readonly="1"/>
              <field name="start_date" readonly="1"/>
              <field name="end_date" readonly="1"/>
              <field name="description" readonly="1"/>
              <field name="policy_type" readonly="1"/>
              <field name="insurance_type_id" readonly="1"/>
            </group>
            <group string="Renewal &amp; Payment">
              <field name="payment_id" readonly="1"/>
              <field name="payment_state" widget="badge"
                     decoration-success="payment_state == 'posted'"
                     decoration-warning="payment_state in ('draft', 'in_process')"
                     decoration-danger="payment_state == 'cancel'"/>
              <field name="renewal_premium" readonly="1"/>
              <field name="new_start_date" readonly="1"/>
              <field name="new_end_date" readonly="1"/>
              <field name="new_sum_insured" readonly="1"/>
              <field name="is_policy_number_updated" readonly="1" widget="boolean_toggle"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ══ Renew Policy Wizard Form View ══════════════════════════════════════════ -->
  <record id="insurance_policy_renew_wizard_form" model="ir.ui.view">
    <field name="name">insurance.policy.renew.wizard.form</field>
    <field name="model">insurance.policy.renew.wizard</field>
    <field name="arch" type="xml">
      <form string="Renew Insurance Policy">
        <sheet>
          <div class="oe_title">
            <h2>Renew Policy: <field name="current_policy_number" class="oe_inline" readonly="1"/></h2>
          </div>
          <group>
            <group string="Current Policy Details">
              <field name="policy_id" invisible="1"/>
              <field name="company_id" invisible="1"/>
              <field name="currency_id" invisible="1"/>
              <field name="insurance_type_id" readonly="1"/>
              <field name="current_expiry_date" readonly="1"/>
            </group>
            <group string="Renewal Parameters">
              <field name="renewal_premium" widget="monetary" options="{'currency_field': 'currency_id'}"/>
              <field name="new_sum_insured" widget="monetary" options="{'currency_field': 'currency_id'}"/>
              <field name="new_start_date"/>
              <field name="new_expiry_date"/>
              <field name="journal_id"/>
            </group>
          </group>
          <group>
            <field name="notes" placeholder="Any renewal notes or remarks..."/>
          </group>
        </sheet>
        <footer>
          <button name="action_confirm" string="Confirm Renewal" type="object" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ══ Update Policy Number Wizard Form View ══════════════════════════════════ -->
  <record id="insurance_update_policy_number_wizard_form" model="ir.ui.view">
    <field name="name">insurance.update.policy.number.wizard.form</field>
    <field name="model">insurance.update.policy.number.wizard</field>
    <field name="arch" type="xml">
      <form string="Update Policy Number">
        <sheet>
          <group>
            <field name="renewal_history_id" invisible="1"/>
            <field name="policy_id" invisible="1"/>
            <field name="old_policy_number" readonly="1" string="Expired Policy No"/>
            <field name="new_policy_number" placeholder="Enter fresh / new policy number" required="1"/>
          </group>
        </sheet>
        <footer>
          <button name="action_confirm" string="Update Policy Number" type="object" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
