<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_insurance_category" model="ir.module.category">
        <field name="name">Insurance Management</field>
        <field name="sequence">100</field>
    </record>
    <record id="group_insurance_user" model="res.groups">
        <field name="name">Insurance User</field>
        <field name="category_id" ref="module_insurance_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_insurance_admin" model="res.groups">
        <field name="name">Insurance Administrator</field>
        <field name="category_id" ref="module_insurance_category"/>
        <field name="implied_ids" eval="[(4, ref('group_insurance_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
